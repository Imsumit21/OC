ted_at": "2025-11-06T16:28:15Z", "updated_at": "2025-11-19T04:39:51Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2374", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-2434", "project_id": null, "team_id": "team_ENG", "parent_id": "ENG-2405", "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_fc22d5941b2aeb5c", "state_id": "PR", "cycle_id": null, "identifier": "ENG-2434", "number": 2434, "title": "Tile Dozer - UI Optimization", "description": null, "priority": 2, "estimate": null, "due_date": null, "started_at": "2025-11-18T23:19:16Z", "completed_at": null, "canceled_at": null, "archived_at": null, "time_in_status_minutes": 124734, "labels": [], "links": [], "relations": [], "is_archived": false, "created_at": "2025-11-06T16:28:21Z", "updated_at": "2025-11-19T04:39:48Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2375", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-2435", "project_id": null, "team_id": "team_ENG", "parent_id": "ENG-2405", "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_fc22d5941b2aeb5c", "state_id": "PR", "cycle_id": null, "identifier": "ENG-2435", "number": 2435, "title": "Lucky Drop - UI Optimization", "description": null, "priority": 2, "estimate": null, "due_date": null, "started_at": "2025-11-18T23:19:19Z", "completed_at": null, "canceled_at": null, "archived_at": null, "time_in_status_minutes": 124735, "labels": [], "links": [], "relations": [], "is_archived": false, "created_at": "2025-11-06T16:28:25Z", "updated_at": "2025-11-19T04:39:44Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2376", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-2436", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-2436", "number": 2436, "title": "New symbols creates visual bugs and non matchable in memory and river tile.", "description": "Version or date: Dev_iOS_1784\n\n### Description: \n\nAfter the addition of new symbol, both memory tile and river tile breaks. \n\n* The tiles with the symbol are not matchable\n* The symbol isn't visible\n* And it gives error every time it's clicked. \n\n[https://console.firebase.google.com/project/domino-delights/crashlytics/app/ios:com.harmonygames.dominodelights/issues/ba319a202a38faed3f829e306064e72c?time=24h&types=crash&versions=0.2.1786%20(1786)&sessionEventKey=e6cfb05501434cf28d8d6ff212774f87_[CREDIT_CARD_NUMBER_6421]](https://console.firebase.google.com/project/domino-delights/crashlytics/app/ios:com.harmonygames.dominodelights/issues/ba319a202a38faed3f829e306064e72c?time=24h&types=crash&versions=0.2.1786%20(1786)&sessionEventKey=e6cfb05501434cf28d8d6ff212774f87_[CREDIT_CARD_NUMBER_6421])\n\n### Visual References:\n\n[ScreenRecording_[CREDIT_CARD_NUMBER_6420]_1.MP4]([URL_53025])\n\n![IMG_5410.png]([URL_53024])\n\n### Expected Outcome: is to blend them into symbol pool for both games and fix the visual & functional issues along with the error. \n\n### Steps to Repro\n\n1. Play memory or river tile\n2. Observer that they are broken", "priority": 2, "estimate": null, "due_date": null, "started_at": "2025-11-11T16:08:22Z", "completed_at": "2025-11-14T17:14:54Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 131179, "labels": ["DD 2.1", "Bug"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-11-06T17:00:45Z", "updated_at": "2025-11-14T17:14:54Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2385", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-252", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-252", "number": 252, "title": "Saga Map: bottom UI menu unclickable - iOS", "description": "The saga map UI menu buttons at the bottom of the screen are very difficult to click or unclickable. I can click them 1 out of 10 times.\n\n![IMG_3644.jpg]([URL_49918])", "priority": 1, "estimate": 1, "due_date": null, "started_at": "2023-10-09T17:57:50Z", "completed_at": "2024-01-03T06:27:43Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1112467, "labels": ["Sprint 5 - October 13th", "Improvement", "Marketing"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-10-06T23:03:26Z", "updated_at": "2024-01-03T06:27:43Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2399", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-265", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-265", "number": 265, "title": "Gameplay: Draw Pile and the matching tile need to repositioned (iOS)", "description": "The position of the tiles from the draw pile and the matching tile seem to be off on IOS. Please bring them back to their intended positions.", "priority": 3, "estimate": 0, "due_date": null, "started_at": "2023-10-09T17:39:08Z", "completed_at": "2024-04-18T15:36:22Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 959278, "labels": ["Sprint 6 - October 27th", "Bug", "Marketing", "Friends & Family Build September"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-10-06T23:35:37Z", "updated_at": "2024-04-18T15:36:22Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2428", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-293", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-293", "number": 293, "title": "WebGL Gameplay UI Missing Some Elements:", "description": "'@[PERSON_NAME_0054] said:\n\n> WebGL Gameplay UI Missing Some Elements:\n\n![image.png]([URL_49956])\n\nTop right at the streak bar there is some background coming through the icons.\n\nBottom right the tile placement in hand isn't always correct, this includes:\n\nWhen game starts it's shoved at the corner\n\n![image.png]([URL_49955])\n\n![image.png]([URL_49954])\n\nHorizon piece also misplaced\n\n![image.png]([URL_49953])\n\nSingle piece needs to be moved slightly lower\n\n![image.png]([URL_49952])\n\nWe are missing a 2nd layer of the domino rack.\n\n![image.png]([URL_49951])\n\nThis one below is what it looked like in Figma\n\n![image.png]([URL_49950])", "priority": 1, "estimate": null, "due_date": null, "started_at": "2023-10-30T18:06:30Z", "completed_at": "2024-01-03T06:27:19Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1112467, "labels": ["Sprint 6 - October 27th", "Bug", "Main Game", "Friends & Family Build September"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-10-11T17:37:07Z", "updated_at": "2024-03-06T19:45:26Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2433", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-299", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-299", "number": 299, "title": "Strange tile location on screen", "description": "'@[PERSON_NAME_0054] said:\n\n> Strange tile location on screen\n> pieces are blocked and not sitting in front of the domino rack.\n\n![image.png]([URL_49962])", "priority": 2, "estimate": null, "due_date": null, "started_at": "2023-10-16T15:31:27Z", "completed_at": "2024-04-18T15:35:25Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 959279, "labels": ["Bug", "Main Game"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-10-15T22:12:02Z", "updated_at": "2024-04-18T15:35:25Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2441", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-306", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "EPI-1", "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_cc3e90160f490686", "state_id": "Canceled", "cycle_id": null, "identifier": "ENG-306", "number": 306, "title": "Integrate Character Animation In Main Game", "description": "Assets to be delivered by [PERSON_NAME_0083]", "priority": 0, "estimate": null, "due_date": null, "started_at": "2023-10-23T17:39:49Z", "completed_at": null, "canceled_at": "2023-10-31T08:52:15Z", "archived_at": null, "time_in_status_minutes": 1204482, "labels": ["Sprint 6 - October 27th"], "links": [], "relations": [{"target": "ENG-19", "type": "duplicates"}], "is_archived": false, "created_at": "2023-10-16T18:07:51Z", "updated_at": "2023-10-31T08:52:17Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2442", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-307", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-307", "number": 307, "title": "Character UI Integration", "description": null, "priority": 0, "estimate": null, "due_date": n