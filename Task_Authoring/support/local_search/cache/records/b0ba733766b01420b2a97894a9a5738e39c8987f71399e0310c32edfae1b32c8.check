}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2695", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-544", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-544", "number": 544, "title": "Vanishing tile prefab, punishment, disappearing VFX", "description": "There are 3 parts to this.\n\n1) Vanishing tile prefab (bubble looking tile)\n\n2) When vanishing tile disappears, it should steal player's cards away.\n\nVideo here of the tile + punishment\n\n[vanishingV3.mp4]([URL_50047])\n\n3) Vanishing tile itself \"pops and disappears\"", "priority": 1, "estimate": null, "due_date": null, "started_at": "2024-01-08T16:22:27Z", "completed_at": "2024-01-24T18:02:17Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1081532, "labels": ["VFX Integration", "Submission Blocker", "Spells/Abilities"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-01-04T03:49:16Z", "updated_at": "2024-01-24T18:02:17Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2699", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-548", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-548", "number": 548, "title": "Character Token Polish", "description": "We need to increase size of token by \\~25%\n\nGetting multiple tokens in a single level should put them in a stack with a number indicator.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-01-24T18:02:09Z", "completed_at": "2024-04-18T21:31:09Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 958923, "labels": ["Main Game"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-01-24T02:03:03Z", "updated_at": "2024-04-18T21:31:09Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2716", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-563", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-563", "number": 563, "title": "Troubleshooting Advanced Tile Combos", "description": "[[URL_50056])", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-01-29T18:54:28Z", "completed_at": "2024-04-18T21:30:28Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 958924, "labels": ["Sprint 10 - Feb 2nd", "Main Game"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-01-29T18:54:18Z", "updated_at": "2024-04-18T21:30:28Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2717", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-564", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-564", "number": 564, "title": "Re center Avatar on Saga map to last level played", "description": null, "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-01-29T18:55:24Z", "completed_at": "2024-04-18T21:30:24Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 958924, "labels": ["Sprint 11 - Feb 16th", "Bug", "World Map"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-01-29T18:55:23Z", "updated_at": "2024-04-18T21:30:24Z"}}, {"file": "HarmonyGames_Other_Services/Se