0, "estimate": null, "due_date": null, "started_at": "2023-11-13T19:38:04Z", "completed_at": "2024-04-18T15:33:02Z", "canceled_at": null, "archived_at": "2024-10-19T05:45:54Z", "time_in_status_minutes": 959281, "labels": ["Sprint 8 - November 24th", "Main Game"], "links": [], "relations": [], "is_archived": true, "created_at": "2023-11-13T19:37:54Z", "updated_at": "2024-04-18T15:33:02Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2577", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-433", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ART-321", "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-433", "number": 433, "title": "Add Nathan Into Main Game Play On Bottom Left of Screen", "description": "Update 1/2/2024. @Marcus says that it's in the game already, just need to be merged? PR? Or something else?", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-01-03T06:57:36Z", "completed_at": "2024-04-18T15:33:46Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 959281, "labels": ["VFX Integration", "Characters", "Submission Blocker", "Improvement"], "links": [], "relations": [{"target": "ART-321", "type": "blocks"}], "is_archived": false, "created_at": "2023-11-13T19:38:31Z", "updated_at": "2024-04-18T15:33:46Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2578", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-434", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-434", "number": 434, "title": "Update Character Profile To Use Animated Version of Sophie", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-01-23T05:57:00Z", "canceled_at": null, "archived_at": "2024-07-24T01:49:25Z", "time_in_status_minutes": 1083697, "labels": ["Sprint 9 - December 8th"], "links": [], "relations": [], "is_archived": true, "created_at": "2023-11-13T19:39:08Z", "updated_at": "2024-01-23T05:57:00Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2587", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-442", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ART-293", "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-442", "number": 442, "title": "Unity Integration for Clean Up Animation + End Card", "description": "This is the animation that happens at end of the game:\n\n1) Clean up animation is the screen where \"LEVEL COMPLETE\" text appears, along with animation of tiles left in hand being converted into coins with VFX. If the player loses it will say \"LEVEL FAILED\" along with animation of tiles falling off the board\n\n2) The end card is the final screen after the clean up animation where it shows the total rewards earned including lives (if any), coins, boosts, etc. This will be accompanied by a character animation.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2023-11-27T05:38:13Z", "completed_at": "2024-04-18T15:34:45Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 959280, "labels": ["VFX Integration", "Sprint 8 - November 24th"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-11-14T02:03:47Z", "updated_at": "2024-04-18T15:34:45Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2589", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-447", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-447", "number": 447, "title": "Timer for life is ticking even at max life", "description": "I was at 5 lives and the timer is counting, however I suspect this is because the max life cap is erroneously set at 10.", "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-01-03T06:57:28Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1112437, "labels": ["Sprint 9 - December 8th", "Bug", "Mini Game"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-11-18T21:08:25Z", "updated_at": "2024-01-03T06:57:28Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2591", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-449", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-449", "number": 449, "title": "Navigational Bottom UI visual glitch after hitting back arrow from character screen", "description": "1) Go to character screen.\n\n2) Press the back arrow button located slightly above the bottom navigational bar.\n\n3) Glitch happens and the bottom bar is truncated into small segments\n\nSeen here:\n\n![image.png]([URL_49999])", "priority": 2, "estimate": null, "due_date": null, "started_at": "2023-11-20T21:03:19Z", "completed_at": "2024-04-18T15:35:39Z", "canceled_at": null, "archived_at": "2024-10-19T05:45:57Z", "time_in_status_minutes": 959279, "labels": ["Sprint 8 - November 24th", "Bug"], "links": [], "relations": [], "is_archived": true, "created_at": "2023-11-18T21:27:28Z", "updated_at": "2024-04-18T15:35:39Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2596", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-453", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-453", "number": 453, "title": "Ending Game through End Game Button Behavior Incorrect", "description": "Currently if we were to end game using the \"end game\" button that appears when you run out of tiles in hand, we get a 2 phase end screen. The initial prompt with the \"try again\" button needs to be removed. This is for future implementation when we are optimizing for monetization.\n\nFor the time being, pressing end game should behave exactly like losing a level organically with the end screen and sad Sophie animation.\n\nSo please remove this:\n\n![Screenshot_20231118_133515_Domino Delights.jpg]([URL_50003])\n\nAnd implement the regular end game card from a normal losing funnel.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2023-11-20T21:03:10Z", "completed_at": "2024-04-18T15:35:35Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 959279, "labels": ["Sprint 8 - November 24th", "Bug"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-11-18T21:36:26Z", "updated_at": "2024-04-18T15:35:35Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2598", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-455", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-455", "number": 455, "title": "Screens invoked by bottom navigation bar needs to close first before a new one is invoked", "description": "Currently clicking on a different button in the navigation bar before hitting X or closing the current one, will leave it open, this leads to multiple UIs layered on top of each other. See video:\n\n[Screen_Recording_20231118_134546_Domino Delights.mp4]([URL_50006])", "priority": 2, "estimate": null, "due_date": null, "started_at": "2023-11-20T21:03:07Z", "completed_at": "2024-04-18T15:35:33Z", "canceled_at": null, "archived_at": "2024-10-19T05:45:57Z", "time_in_status_minutes": 959279, "labels": ["Sprint 8 - November 24th", "Bug"], "links": [], "relations": [], "is_archived": true, "created_at": "2023-11-18T21:46:07Z", "updated_at": "2024-04-18T15:35:33Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2599", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-456", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-456", "number": 456, "title": "Change Zone 3 to Zone 1 For Chapter Transition Screen", "description": "Our first 300 levels are all zone 1. This is for Alpha. After alpha every 300 levels = 1 zone.\n\n![image.png]([URL_50007])", "priority": 2, "estimate": null, "due_date": null, "started_at": "2023-11-20T23:17:56Z", "completed_at": "2024-04-18T15:35:31Z", "canceled_at": null, "archived_at": "2024-10-19T05:45:52Z", "time_in_status_minutes": 959279, "labels": ["Sprint 8 - November 24th", "Bug"], "links": [], "relations": [], "is_archived": true, "created_at": "2023-11-18T21:57:48Z", "updated_at": "2024-04-18T15:35:31Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2601", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-458", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-458", "number": 458, "title": "UI needs to be removed at end screens", "description": "The top UI needs to be removed with an outro when the game ends.\n\n![image.png]([URL_50009])\n\nThere are other UI here that needs to be removed as well, the wheel menu and the end game button\n\n![Screenshot_20231120_104519_Domino Delights.jpg]([URL_50008])", "priority": 2, "estimate": null, "due_date": null, "started_at": "2023-11-20T21:03:01Z", "completed_at": "2024-04-18T15:34:47Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 959279, "labels": ["Sprint 8 - November 24th", "Bug"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-11-18T22:00:24Z", "updated_at": "2024-04-18T15:34:47Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2609", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-466", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-466", "number": 466, "title": "Update Core Game Top HUD UI", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": "2023-11-27T19:01:13Z", "completed_at": "2024-01-03T06:22:34Z", "canceled_at": null, "archived_at": "2024-07-04T01:32:28Z", "time_in_status_minutes": 1112472, "labels": ["Sprint 9 - December 8th"], "links": [], "relations": [], "is_archived": true, "created_at": "2023-11-27T19:01:13Z", "updated_at": "2024-01-03T06:22:34Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2610", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-467", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-467", "number": 467, "title": "Gift Box Hook Up", "description": null, "priority"