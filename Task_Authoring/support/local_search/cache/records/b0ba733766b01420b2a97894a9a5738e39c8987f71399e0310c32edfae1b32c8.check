, "started_at": null, "completed_at": "2024-02-20T17:34:36Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1042680, "labels": ["Sprint 11 - Feb 16th", "World Map"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-02-14T00:54:42Z", "updated_at": "2024-02-20T17:34:36Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2753", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-597", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-597", "number": 597, "title": "Add Event For Conveyor Belt End Game", "description": "Replay\n\nHome", "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-03-18T17:32:18Z", "canceled_at": null, "archived_at": "2024-09-19T02:55:40Z", "time_in_status_minutes": 1003802, "labels": ["Sprint 13 - March 15th"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-02-20T18:06:03Z", "updated_at": "2024-03-18T17:32:18Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2757", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-600", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_c77c50cc15c5342d", "state_id": "Done", "cycle_id": null, "identifier": "ENG-600", "number": 600, "title": "Current level button animation", "description": "I've did a itween animation on the button inside the level prefab. But I did a clone of the level prefab, it's in the same folder on my branch. We just need to activate this itween animation just on the current level \n\n[pushbuttonfar.mp4]([URL_50069])\n\n![image-2.png]([URL_50068])", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-03-04T17:55:05Z", "completed_at": "2024-04-18T21:29:53Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 958924, "labels": ["VFX Integration"], "links": [], "relations": [{"target": "ENG-614", "type": "relates"}], "is_archived": false, "created_at": "2024-02-21T21:06:01Z", "updated_at": "2024-04-18T21:29:53Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2760", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-603", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_cc3e90160f490686", "state_id": "Canceled", "cycle_id": null, "identifier": "ENG-603", "number": 603, "title": "Finalizing Streak Rewards Tutorial Triggers", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-02-26T19:11:07Z", "completed_at": null, "canceled_at": "2024-04-18T16:08:59Z", "archived_at": "2024-10-19T05:45:54Z", "time_in_status_minutes": 959245, "labels": ["Sprint 12 - March 1st"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-02-26T19:11:07Z", "updated_at": "2024-04-18T16:08:59Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2768", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-610", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-610", "number": 610, "title": "Change Sophie level 2 upgrade requirement to fit FTUE experience", "description": "By default, Sophie costs 60 stars and 10 tokens to upgrade from level 1 -> 2\n\nWe need to dramatically reduce this, for Sophie, as a one off, to accommodate FTUE.\n\nNew star cost = 5 stars\n\nNew token cost = 1 token", "priority": 1, "estimate": null, "due_date": null, "started_at": "2024-03-04T17:54:52Z", "completed_at": "2024-04-18T16:58:14Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 959196, "labels": ["Characters"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-02-29T01:27:53Z", "updated_at": "2024-04-18T16:58:14Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2775", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-617", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-617", "number": 617, "title": "New End Cards", "description": "End Level End card \n\nYou Did It! End card\n\nEpic Win! End card\n\nMegawin! End Card\n\n---\n\nEnd cards with symbol, After you geet Megawin! End card for example. but we have a new tile that we want to promote, (ex: wildcard tile) we shift sophie off the screen and introduce the tile and we say from what level you gona get it. (see video below for reference)", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-03-06T17:29:20Z", "completed_at": "2024-03-18T17:31:10Z", "canceled_at": null, "archived_at": "2025-04-15T07:35:22Z", "time_in_status_minutes": 1003803, "labels": ["VFX Integration", "Sprint 13 - March 15th"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-03-04T18:45:43Z", "updated_at": "2024-03-18T17:31:10Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2776", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-618", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-618", "number": 618, "title": "Fix Sophie's Streak Rewards Animation", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-03-06T17:31:41Z", "completed_at": "2024-03-18T17:31:18Z", "canceled_at": null, "archived_at": "2024-09-19T02:55:39Z", "time_in_status_minutes": 1003803, "labels": ["Sprint 13 - March 15th"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-03-04T18:46:14Z", "updated_at": "2024-03-18T17:31:18Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2795", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-635", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_c77c50cc15c5342d", "state_id": "Done", "cycle_id": null, "identifier": "ENG-635", "number": 635, "title": "New Streak Bonus Coins Animation", "description": "[bottomUI_Coins_Faster.mp4]([URL_50087])\n\n![newUIStrakeCoins.JPG]([URL_50086])\n\nBecause we moved the UI at the bottom we had to do new animation for the coins. We need to swap the prefab thats in the Board scene with the new prefab that i did that contains the new animation. Please also consider that this require two aditional thing. When this gets triggered we need the yellow flash effect that we had before at the start position of the coins. Also we need sophie to do the thumbs up animation, basically we trigger ThumbsUp from the character controller animator.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-03-06T17:27:52Z", "completed_at": "2024-03-18T17:31:09Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1003803, "labels": ["VFX Integration", "Sprint 13 - March 15th"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-03-06T13:01:55Z", "updated_at": "2024-03-18T17:31:09Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2818", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-657", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-657", "number": 657, "title": "Bug Fix - Disable world map scrolling for tutorial step highlighting level 3 node", "description": "After level 2 ends, player exits to Saga map for the first time.\n\nWe highlight level 3 node with a spotlight.\n\nBut we still allow players to scroll the saga map.\n\nWe need to disable scrolling at this step, so they can only click on level 3 node and that's it.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-03-13T22:31:53Z", "completed_at": "2024-03-18T17:31:07Z", "canceled_at": null, "archived_at": "2024-09-19T02:55:39Z", "time_in_status_minutes": 1003803, "labels": ["Sprint 13 - March 15th"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-03-11T22:55:27Z", "updated_at": "2024-03-18T17:31:07Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2822", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-660", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Canceled", "cycle_id": null, "identifier": "ENG-660", "number": 660, "title": "has_played_mini-game didn\u2019t make it to Singular", "description": "'@Leonard said:\n\n> it looks like has_played_mini-game didn\u2019t make it to Singular", "priority": 4, "estimate": null, "due_date": null, "started_at": null, "completed_at": null, "canceled_at": "2025-05-05T19:23:14Z", "archived_at": null, "time_in_status_minutes": 408971, "labels": ["Sprint 18 - May 24th"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-03-17T04:49:59Z", "updated_at": "2025-05-05T19:23:14Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2828", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-666", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-666", "number": 666, "title": "Camera Movement Saga Map", "description": "Camera movement only should happen when you complete a level for the first time", "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-03-18T20:20:26Z", "completed_at": "2024-04-18T11:37:21Z", "canceled_at": null, "archived_at": "2024-10-19T05:46:01Z", "time_in_status_minutes": 959517, "labels": ["Sprint 14 - March 29th"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-03-18T17:49:57Z", "updated_at": "2024-04-18T11:37:21Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2840", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-677", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-677", "number": 677, "title": "Lockout Character Profile button on Navigation until First Character Token Earned", "description": "Currently first token earned at level 10, this might change in the future.\n\nUntil player FINISHES THAT LEVEL VICTORIOUSLY, the character profile button needs to remain locked.", "priority": 1, "estimate": null, "due_date": null, "started_at": "2024-04-01T16:55:47Z", "completed_at": "2024-04-18T16:57:49Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 959196, "labels": ["Characters", "Improvement"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-03-18T21:11:42Z", "updated_at": "2024-04-18T16:57:49Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2862", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-697", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-697", "number": 697, "title": "Nate's screen unlock is bugged", "description": "'@Leonard said:\n\n> Nate unlock screen is bugged.\n\n![IMG_5908.png]([URL_50123])", "priority": 3, "estimate": null, "due_date": null, "started_at": "2024-04-04T21:55:51Z", "completed_at": "2024-04-18T17:16:25Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 959178, "labels": ["Sprint 15 - April 12th"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-04-04T18:24:07Z", "updated_at": "2024-04-18T17:16:25Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2867", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-701", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-701", "number": 701, "title": "Megatile doesn't get removed when clicked, requires additional click", "description": "'@Leonard said:\n\n> [[URL_50126]) She clicks the megatile but megatile doesn\u2019t get removed. She has to click one more time.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-04-11T18:43:10Z", "completed_at": "2024-04-18T17:33:56Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 959160, "labels": ["Sprint 15 - April 12th"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-04-06T23:20:42Z", "updated_at": "2024-04-18T17:33:56Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2868", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-702", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-702", "number": 702, "title": "Tutorial text blocking matching tiles in level 1 on tablet, causing confusion for user", "description": "'@Leonard said:\n\n> the tutorial text blocks the tiles to match on this tablet in level 1 - she has no idea what she is matching with. We need to move up the text box. This is a **Tablet Android 8\" Whoop TAB-8US2 WiFi , T-mobile , 32GB which supports** 1280 x 800 resolution. Not sure what the aspect ratio is\n>\n> ![image.png]([URL_50130])", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-04-11T19:17:20Z", "completed_at": "2024-04-26T16:51:39Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 947683, "labels": ["Sprint 15 - April 12th"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-04-07T00:50:37Z", "updated_at": "2024-04-26T16:51:39Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2878", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-711", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-711", "number": 711, "title": "Every chat bubble needs to lock out all user interaction for 0.5 seconds.", "description": "Whenever a chat bubble appears from a tutorial, we need to disable all user interaction and clicks for 0.5 seconds.\n\nThis will prevent players from accidentally fast clicking through chat bubbles and instructions by accident.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-04-17T02:20:02Z", "completed_at": "2024-04-26T17:25:23Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 947649, "labels": ["FTUE"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-04-12T18:45:04Z", "updated_at": "2024-04-26T17:25:23Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2883", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-717", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-717", "number": 717, "title": "Lock /Hide Wildtile Booster in Level 1", "description": "In the Level 1 tutorial, we need to hide/lock the wild tile. I got locked myself up because the wild tile was pulled in the draw pile.\u00a0 \n\n![image.png]([URL_50154])", "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-04-16T17:37:05Z", "completed_at": "2024-04-18T11:11:48Z", "canceled_at": null, "archived_at": "2024-10-19T05:45:58Z", "time_in_status_minutes": 959542, "labels": ["Submission Blocker", "Django Blocker"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-04-15T21:32:48Z", "updated_at": "2024-04-18T11:11:48Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2884", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-718", "project_id": null, "team_id": "team_ENG", "parent_id": "ENG-717", "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-718", "number": 718, "title": "Because I ran out of gold, I also broke level 3 tutorial and couldn\u2019t pull gold tile.", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-04-17T01:24:53Z", "completed_at": "2024-04-18T11:10:46Z", "canceled_at": null, "archived_at": "2024-10-19T05:45:58Z", "time_in_status_minutes": 959544, "labels": ["Submission Blocker", "Django Blocker"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-04-15T21:33:01Z", "updated_at": "2024-04-18T11:10:46Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2887", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-721", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-721", "number": 721, "title": "Quest Objective Tooltip Persistence", "description": "Pre-level objective tooltip is spawned after closing the pop-up and reopen again (regardless off the level node) \n\n![image.png]([URL_50156])", "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-04-17T00:58:17Z", "completed_at": "2024-04-18T11:02:35Z", "canceled_at": null, "archived_at": "2024-10-19T05:46:00Z", "time_in_status_minutes": 959552, "labels": ["Submission Blocker", "Django Blocker"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-04-15T21:40:13Z", "updated_at": "2024-04-18T11:02:35Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2892", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-728", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-728", "number": 728, "title": "Disable the Wheel", "description": "* We need to disable the wheel eventually for the entire game (not a blocker)", "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-04-17T00:53:30Z", "completed_at": "2024-04-18T11:02:30Z", "canceled_at": null, "archived_at": "2024-10-19T05:45:58Z", "time_in_status_minutes": 959552, "labels": ["Django Blocker"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-04-15T21:48:26Z", "updated_at": "2024-04-18T11:02:30Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2900", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-736", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-736", "number": 736, "title": "'+3 Card Tutorial Triggering", "description": "* +3 card tutorial didn\u2019t trigger at level 6 - I purposely ran out of tiles.", "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-04-17T01:25:18Z", "completed_at": "2024-04-18T11:22:41Z", "canceled_at": null, "archived_at": "2024-10-19T05:46:00Z", "time_in_status_minutes": 959532, "labels": ["Django Blocker"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-04-15T21:59:08Z", "updated_at": "2024-04-18T11:22:41Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2901", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-737", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-737", "number": 737, "title": "Wheel Boosters Synchornization with the actual locks/unlcoks", "description": "What\u2019s the plan with the wheel? I see all icons are locked on the wheel but the wild tile is available on the main gameboard. I think at the minimum the wild tile behavior should match meaning if it\u2019s un/locked on the main board, then it\u2019s un/locked on the wheel. Same goes for bomb tiles and +3 cards\n\n![image.png]([URL_50164])", "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-04-17T01:17:35Z", "completed_at": "2024-04-18T11:10:54Z", "canceled_at": null, "archived_at": "2024-10-19T05:45:59Z", "time_in_status_minutes": 959543, "labels": ["Django Blocker"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-04-15T22:01:20Z", "updated_at": "2024-04-18T11:10:54Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2908", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-747", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-747", "number": 747, "title": "Add tool tip when players click on a locked feature", "description": "See screenshots for mockup. This is the same tool tip used in the pre level dialog.\n\nIt pops up when user clicks on the locked feature.\n\n\"Unlock after level 10\" for character\n\"Unlock after level 12\" for mini game\n\n(please correct my level # if I'm wrong)\n\nTool tip stays on screen unless player clicks anywhere else on screen, which will remove the tool tip.\n\n![image.png]([URL_50167])", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-04-17T02:19:56Z", "completed_at": "2024-04-22T09:33:20Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 953881, "labels": ["World Map"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-04-15T22:46:24Z", "updated_at": "2024-04-22T09:33:20Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2912", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-750", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-750", "number": 750, "title": "Cinematic Matching Breaks the Flow (animation, layouts visuals, tutorial)", "description": "* **Date:** April 16, 2024\n* **App Version:** 0.1.824\n* **Device:** iPhone 11\n* **Bug / Issue:**\n  * The cinematic match feature is too fragile and disrupts the tutorial, tile animations, and board visuals.\n  * Interruptions in the animation flow occur frequently.\n  * Every match without waiting for a nudge to appear on the next tiles creates this problem.\n* **Expected Outcome:**\n  * The animation should be interrupted without any disruption in the flow.\n* **Step Descriptions to Reproduce:**\n  * Perform any match without waiting for a nudge to appear on the next tiles.\n* **Bug Visuals:**\n  * Bug visuals can be viewed at the following link:\n    * \n\n      ![image.png]([URL_50170])", "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-04-17T20:25:25Z", "completed_at": "2024-04-19T01:25:59Z", "canceled_at": null, "archived_at": "2024-10-19T05:46:00Z", "time_in_status_minutes": 958688, "labels": ["Submission Blocker", "Django Blocker"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-04-16T18:54:24Z", "updated_at": "2024-04-19T01:25:59Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2915", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-754", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Canceled", "cycle_id": null, "identifier": "ENG-754", "number": 754, "title": "Finish chapter tutorial not triggered but it 's the ongoing tutorial in the debug menu.", "description": "**Description:** When accessing the Debug menu on iPhone 11 (Version 0.1.824), it displays that the user is in the \"finish chapter\" tutorial, but the tutorial isn't being triggered. The expected behavior is for the \"finish chapter\" tutorial to be activated when accessing the Debug menu.\n\n**Steps to Reproduce:**\n\n1. Open the application on an iPhone 11 device.\n2. Navigate to the Debug menu.\n3. Observe that the \"finish chapter\" tutorial is displayed.\n4. Note that the tutorial is not being triggered.\n\n**Expected Behavior:** The \"finish chapter\" tutorial should be triggered when accessing the Debug menu on iPhone 11.\n\n**Attachments:** Screenshot: \n\n![image.png]([URL_50171])", "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-04-19T19:05:43Z", "completed_at": null, "canceled_at": "2024-04-22T08:55:31Z", "archived_at": "2024-10-23T06:02:11Z", "time_in_status_minutes": 953919, "labels": ["Django Blocker"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-04-16T19:09:12Z", "updated_at": "2024-04-22T08:55:31Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2928", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-767", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-767", "number": 767, "title": "Level 3 Star Revision", "description": "Getting 1 star in Level 3 (objective based)", "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-04-19T13:11:56Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 957982, "labels": ["Improvement"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-04-15T22:14:12Z", "updated_at": "2024-04-19T13:11:56Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2963", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-799", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-690", "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-799", "number": 799, "title": "Modification of VFX speed and delay between clicks on cinematic match tutorial", "description": "![image.png]([URL_50196])\n\nFirst tile - x speed (current)\nSecond tile - 1.5x\nThird tile - 1.5x", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-04-19T18:44:40Z", "completed_at": "2024-04-22T11:59:31Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 953735, "labels": ["Django Blocker"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-04-19T11:09:12Z", "updated_at": "2024-04-22T12:05:06Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2967", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-802", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-802", "number": 802, "title": "Minigame tutorial is triggered when I quit and open the game again", "description": "Minigame tutorial is triggered when I quit and open the game again before level13. This is not a blocker but it needs to be fixed. \n\nExpected outcome would be that the game should be in its default flow. \n\n![image.png]([URL_50199])", "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-04-30T14:53:48Z", "canceled_at": null, "archived_at": "2024-11-01T06:20:22Z", "time_in_status_minutes": 942091, "labels": [], "links": [], "relations": [], "is_archived": true, "created_at": "2024-04-19T19:33:06Z", "updated_at": "2024-04-30T14:53:48Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2969", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-804", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-804", "number": 804, "title": "Disable exclamation mark on Sophie for the entire game.", "description": "Exclamation mark lost its function after disabling the wheel menu. We should remove the exclamation mark from Sophie as well.", "priority": 3, "estimate": null, "due_date": null, "started_at": "2024-04-19T23:46:20Z", "completed_at": "2024-04-26T15:27:05Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 947767, "labels": [], "links": [], "relations": [], "is_archived": false, "created_at": "2024-04-19T23:36:17Z", "updated_at": "2024-04-26T15:27:05Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2974", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-809", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ART-548", "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-809", "number": 809, "title": "Implement a new end game flow", "description": "The new end game flow consolidates various \"outs\" when players run out of moves. It looks like this:\n\n![image.png]([URL_50205])\n\n![image.png]([URL_50204])\n\nThe center screen triggers automatically when the players have run out of moves, this is defined by:\n\n* Players have no more cards left in their hand.\n* There are no available moves on the board to match with the last tile in hand.\n\nOnce the player is in that screen, they have all the options you see here, and they are:\n\n1. X button which leads to the screen on the right that allows users to quit the level or retry the level. If the user hits the X button we direct them \"are you sure you want to quit?\" screen shared above.If they hit quit, we'll show \"you lost\" screen as we currently do. The screen should say \"you lost a life\" and with home and retry button, playing sophie's sad animation. If they hit \"resume\" we take them back to \"out of moves\" screen.\n2. \"Tap Here to see the board\" let players see the screen.\n3. A continue button with a gold cost of 2200, that also adds +5 cards to player's draw pile.\n4. Some shop options to buy some random stuff\n\nAlso add 2-second delay between running out of moves on the board and bringing up the \"out of moves\" pop-up so the players can study the screen\n\nWhen players are viewing the board, they have the ability to use the boosters on the bottom bar. If they click anywhere else that's not a legal move or interactable object, the \"Out of moves\" (Screen in the center) will re-appear again.\n\nLink to Figma here:\n\n[[URL_50203])", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-05-06T17:19:44Z", "completed_at": "2024-06-17T15:45:24Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 892994, "labels": ["Sprint 17 - May 10th", "Improvement", "Main Game"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-04-22T05:56:05Z", "updated_at": "2024-06-17T15:45:56Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2978", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-812", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-812", "number": 812, "title": "Mini-game tutorial -Bug in minigame icon highlighted", "description": "0.884\n\nA user gets stuck at level 12 during the mini-game tutorial because the button is unclickable. However, quitting the game and relaunching it again solves the issue about the minigame tutorial.\n\n[[URL_50206])\n\n Steps to repro:\n\n1. Play the game until level 12\n2. Finish the level 12\n3. Wait for the minigame tutorial", "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-04-30T14:54:02Z", "canceled_at": null, "archived_at": "2024-11-01T06:20:22Z", "time_in_status_minutes": 942091, "labels": ["Bug", "Django Blocker"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-04-22T10:38:11Z", "updated_at": "2024-04-30T14:54:02Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2985", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-819", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-819", "number": 819, "title": "Dimming for a milisecond on level 3 loading", "description": "After saga map tutorial, I started to play level 3. After the puzzle loads, while the tiles are flying towards their location, the screen is dimmed for a milisec. \n\nVersion : 0.886 \n\n[[URL_50214])\n\n**Steps to Repro**\n\nStart the level 3 after the saga map tutorial.", "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-05-03T16:57:19Z", "completed_at": "2024-05-07T18:44:15Z", "canceled_at": null, "archived_at": "2024-11-08T07:20:26Z", "time_in_status_minutes": 931730, "labels": [], "links": [], "relations": [], "is_archived": true, "created_at": "2024-04-22T16:14:17Z", "updated_at": "2024-05-07T18:44:15Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3001", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-834", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-834", "number": 834, "title": "Foresight Bug - The revealed child tile thanks to foresight is shaking when there is match missed.", "description": "**Version : 0.910**\n\nThe tile that is flipped because of foresight ability is shaking and creates false blunder effect when it's a child tile. \n\n**Expected Outcome:**\n\nIt shouldn't shake or considered as a possible match when it has a parent tile or tiles.\n\n**Steps to Repro:**\n\n1. Select Nathan as the hero\n2. Start a level\n3. Complete 5-matches streak\n4. Intentionally miss matches with the tile revealed\n5. Observes its shaking\n\n[RPReplay_Final1713983937.MP4]([URL_50230])", "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-07-15T07:46:28Z", "canceled_at": null, "archived_at": "2025-01-16T07:20:34Z", "time_in_status_minutes": 833028, "labels": [], "links": [], "relations": [], "is_archived": true, "created_at": "2024-04-24T18:43:29Z", "updated_at": "2024-07-15T07:46:28Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3005", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-838", "project_id": null, "team_id": "team_ENG", "parent_id": "ENG-809", "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-838", "number": 838, "title": "Board Interaction After a Win - When the level is a win, buttons on the board should not be interactable.", "description": "**Version : 0.1265**\n\n**Device: iphone11**\n\nAfter the win guaranteed, during the chapter complete animation, all the buttons in the board are still clickable. That creates many different problem depending on the button (includes boosters, hand tiles, settings etc.).  \n\n1. I can still draw tiles even though the win is guaranteed. \n\n[RPReplay_Final1714051539.MP4]([URL_50234])\n\n2. I can even use +3 booster or wild tile booster so it's just waste of coins since there is no effect of it.\n3. I can even end level if I complete the levels with no tiles left. \n\n   ![image.png]([URL_50233])\n4. Setting screen is overlapping with win screen etc.\n\n**Expected Result** \n\nAfter a win, all buttons or tapping should be locked since they are not necessary anymore. It should be triggered as soon as the last tile on the board is matched like with the level complete animation. \n\n**Steps to Repro**\n\n1. Match the last tile of a level\n2. Then instantly start to tap on any button you want \ud83d\ude04", "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-06-26T02:22:28Z", "completed_at": "2024-07-01T08:31:26Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 853143, "labels": [], "links": [], "relations": [], "is_archived": false, "created_at": "2024-04-25T17:02:37Z", "updated_at": "2024-07-01T08:31:26Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3013", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-845", "project_id": null, "team_id": "team_ENG", "parent_id": "ENG-788", "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-845", "number": 845, "title": "Sophie's animations Overlap with the store opened within the level", "description": "**Version : 0.1265**\n\nDevice : **iphone11**\n\nWhen I tap on \"+\" in coins, the in-game store opens up and the store screen overlaps Sophie and wildtile. \n\n**Expected Outcome:**\n\nIt should show only the store screen without any overlap. \n\n**Steps to Repro:**\n\n1. Play a level\n2. Make a streak to trigger VFX and animations \n3. Tap on \"+\" icon on the coins\n4. Observe the overlap of Sophie\n\n[RPReplay_Final1714402775.MP4]([URL_50271])", "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-06-27T20:51:27Z", "completed_at": "2024-07-08T13:30:52Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 842763, "labels": [], "links": [], "relations": [], "is_archived": false, "created_at": "2024-04-29T15:24:22Z", "updated_at": "2024-07-08T13:30:52Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3029", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-861", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-861", "number": 861, "title": "First Time Tutorial Breaks after the first level", "description": "**Version : 0.932**\n\n**Device : iPhone 11**\n\nStarting from 0.932 version, this problem occurs. \n\nAfter finishing the first level, I directed to saga map instead of level 2. \n\n[RPReplay_Final1714480483.MP4]([URL_50282])", "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-05-03T15:18:16Z", "completed_at": "2024-05-07T18:43:44Z", "canceled_at": null, "archived_at": "2024-11-08T07:20:26Z", "time_in_status_minutes": 931731, "labels": [], "links": [], "relations": [], "is_archived": true, "created_at": "2024-04-30T17:28:22Z", "updated_at": "2024-05-07T18:43:44Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3040", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-871", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-871", "number": 871, "title": "Darken all the dimmed areas for both ios and android", "description": "All the dimmed screen should be darker. \n\nIt should be 3 times more dark than the current ones. \n\nFor instance if the darkness is 20%, it would be better by 60% etc. in order to check what is the best outcome for our likings.\n\n![image.png]([URL_50293])\n\n![image.png]([URL_50292])", "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-05-07T17:35:16Z", "completed_at": "2024-05-09T18:03:31Z", "canceled_at": null, "archived_at": "2024-11-10T07:21:24Z", "time_in_status_minutes": 928891, "labels": [], "links": [], "relations": [], "is_archived": true, "created_at": "2024-05-03T17:57:11Z", "updated_at": "2024-05-09T18:03:31Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3041", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-872", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-872", "number": 872, "title": "Nathan Foresight VFX bugs", "description": "**Version: 0.967**\n\n**Device : iPhone 11**\n\n1. Foresight is functionally done but the animations is blocked in the middle again and Nathan stays in the same pose for next animation trigger.\n2. It's triggered by +1 rewards, every time if there is a +1 streak reward, it uses +1 animation but gives tile reveal. \n\n[RPReplay_Final1714759796.MP4]([URL_50294])", "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-05-29T22:13:15Z", "completed_at": "2024-06-25T08:40:45Z", "canceled_at": null, "archived_at": "2024-12-26T07:20:50Z", "time_in_status_minutes": 861774, "labels": [], "links": [], "relations": [], "is_archived": true, "created_at": "2024-05-03T19:47:39Z", "updated_at": "2024-06-25T08:40:45Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3046", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-877", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-877", "number": 877, "title": "Appointment Mechanic", "description": "A button that allows players to collect 500 gold every hour.\n\n1 hour timer.\n\nWe'll get the UI team to come up with a button.\n\nThis button will reside on the saga map screen.\n\n300 Coin per hour", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-05-09T15:59:29Z", "completed_at": "2024-05-09T18:03:24Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 928891, "labels": ["Bug", "Sprint 17 - May 10th"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-05-06T17:48:42Z", "updated_at": "2024-05-20T17:40:04Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3047", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-878", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-878", "number": 878, "title": "Big Ass Arrow for FTUE", "description": "Marcus make a big arrow, [PERSON_NAME_0067] implements it so [PERSON_NAME_0040] can use it in her FTUE steps\n\nTo hide and unhide the arrow just hide the parent game object (GiantArrowPivot)\n\nPosition GiantArrowPivot object in the canvas where the arrow needs to point at.\n\nRight now i've put the game object to be in the popup canvas group because i wanted to be over the rest of the stuff on screen so i dont know how it will be in the tutorial stage.\n\nIn the end we should make a prefab out of it if we ever going to change the aspect of this arrow or the animation of it.\n\nVfx_Board_NewArrowPointerBig.unity is the test scene u can find the object\n\n[theArrowFunction.mp4]([URL_50295])", "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-08-12T17:27:06Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 793499, "labels": ["Sprint 18 - May 24th", "FTUE"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-05-06T17:50:42Z", "updated_at": "2024-08-12T17:27:06Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3055", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-885", "project_id": null, "team_id": "team_ENG", "parent_id": "ENG-809", "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-885", "number": 885, "title": "End game scenario Issues", "description": "**End game scenario**\n\n* +3 tutorial is triggered showing the earlier position of +3 tiles.\n* Amount of coins isn\u2019t updated within the level when +5 tile boost is used. (It\u2019s updated in the saga map)\n* Match hint nudge is above the end game screen.\n\n  [RPReplay_Final1715163882.MP4]([URL_50307])\n* The end screen isn\u2019t triggered automatically by no move left. \n\n[RPReplay_Final1715194804 (1).MP4]([URL_50306])", "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-05-14T23:18:26Z", "completed_at": "2024-06-17T16:21:07Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 872833, "labels": [], "links": [], "relations": [], "is_archived": false, "created_at": "2024-05-08T19:17:07Z", "updated_at": "2024-06-17T16:21:07Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3058", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-888", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-888", "number": 888, "title": "Nathan reveal streak issues", "description": "**Nathan reveal streak issues**\n\n* Nathan reveal streak causes an issue like the last tile that completes the streak is staying on the board.\n* Reveal streak animation is interrupted by the streak end since it breaks the flow. \n* Reveal sprite is persistent after completing the reveal streak like in 4 and 6 streaks the sprite stays the same.\n* 6 streak reward is +1 tile. When it\u2019s achieved, the +1 tile vfx starts but it also reveals a tile.\n* 4 streak is correctly giving coins but the sprite stays as reveal.\n\n[RPReplay_Final1715170363.MP4]([URL_50311])", "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-05-29T22:14:29Z", "completed_at": "2024-06-25T08:40:41Z", "canceled_at": null, "archived_at": "2024-12-26T07:20:48Z", "time_in_status_minutes": 861774, "labels": [], "links": [], "relations": [], "is_archived": true, "created_at": "2024-05-08T19:33:31Z", "updated_at": "2024-06-25T08:40:41Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3064", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-893", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-877", "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-893", "number": 893, "title": "Appointment UI Engineering Implementation", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-07-03T13:00:19Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 849994, "labels": ["VFX Integration", "Sprint 18 - May 24th"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-05-13T17:45:37Z", "updated_at": "2024-07-03T13:00:19Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3065", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-894", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-894", "number": 894, "title": "Streak Announcer", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-06-26T05:03:47Z", "canceled_at": null, "archived_at": "2024-12-26T07:20:49Z", "time_in_status_minutes": 860551, "labels": ["Sprint 18 - May 24th"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-05-13T17:49:49Z", "updated_at": "2024-06-26T05:03:47Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3066", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-895", "project_id": null, "team_id": "team_ENG", "parent_id": "ENG-894", "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-895", "number": 895, "title": "Implement Text and Audio Playing", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-06-26T01:59:44Z", "completed_at": "2024-06-26T01:59:50Z", "canceled_at": null, "archived_at": "2024-12-26T07:20:49Z", "time_in_status_minutes": 860735, "labels": ["Sprint 18 - May 24th"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-05-13T17:49:49Z", "updated_at": "2024-06-26T01:59:50Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3068", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-897", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ART-532", "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-897", "number": 897, "title": "Implement new Character UI with in-depth skill information", "description": "Figma Link [HERE]([URL_50313])", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-06-11T21:13:02Z", "completed_at": "2024-07-02T13:40:46Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 851394, "labels": ["VFX Integration", "Characters", "Sprint 19 - June 14th"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-05-13T17:57:46Z", "updated_at": "2024-07-02T13:40:46Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3073", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-902", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-902", "number": 902, "title": "Implement End Game Offers to End Game Screen", "description": "Implement End Game Offers to Endgame screen. \n\nThe first offer will be only available until it's purchased.\n\nThe second offer will be present in every end game screen after the first purchase. \n\n[ART-573](https://linear.app/harmonygames-games/issue/ART-573/out-of-moves-bundle-art)", "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-05-15T22:29:25Z", "completed_at": "2024-06-17T16:20:25Z", "canceled_at": null, "archived_at": "2024-12-18T07:20:58Z", "time_in_status_minutes": 872834, "labels": [], "links": [], "relations": [{"target": "ART-573", "type": "relates"}], "is_archived": true, "created_at": "2024-05-15T17:49:34Z", "updated_at": "2024-06-17T16:20:25Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3075", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-904", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-904", "number": 904, "title": "Update coin payout - need assistance making the changes", "description": "I added a new tab called \u201cLeonardo Coin Payout by Level\u201d\n\nit\u2019s the exact same format as of last time, just different values\n\nand also a slight update to the mini-game\n\nFor details please see slack Conversation and [[URL_50320])\n\nWe also need to update the initial coin balance from 10K to 5K.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-05-20T23:23:31Z", "completed_at": "2024-06-17T15:57:15Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 872857, "labels": ["Sprint 18 - May 24th", "Leonardo Blocker"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-05-15T22:52:43Z", "updated_at": "2024-06-17T15:57:15Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3078", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-907", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-907", "number": 907, "title": "Rebalance Sophie", "description": "Please rebalance Sophie according to this table. This should also prevent her from firing off her passive abilities during tutorial since she will no longer have that ability at level 1.\n\n![image.png]([URL_50321])", "priority": 1, "estimate": null, "due_date": null, "started_at": "2024-05-16T18:52:11Z", "completed_at": "2024-06-17T15:27:25Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 872887, "labels": ["Sprint 18 - May 24th", "Characters"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-05-16T18:49:08Z", "updated_at": "2024-06-17T15:27:25Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3080", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-909", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ART-555", "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_c77c50cc15c5342d", "state_id": "Done", "cycle_id": null, "identifier": "ENG-909", "number": 909, "title": "Streak Anouncer Implementation", "description": "[anouncer031.mp4]([URL_50326])\n\nImplement the streak award anouncer. \n\nIn the text Game object parent you will have all of the variations of the text. make the correct one visibile. I think the logic on it is to be random. But keep in mind it has to match the audio file of the spoken word!\n\n![image.png]([URL_50325])\n\nScene name is: Vfx_Board_StreakAnounce\n\nThe button in the middle just turns on the StreakAnouncer and the animation starts.\n\nThe main gameobject starts at 0 size thats why u dont see it thats how the animation works", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-05-30T05:38:14Z", "completed_at": "2024-06-17T13:38:04Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 872996, "labels": ["VFX Integration"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-05-17T19:31:27Z", "updated_at": "2024-06-17T13:38:04Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3082", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-910", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-908", "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_c77c50cc15c5342d", "state_id": "Done", "cycle_id": null, "identifier": "ENG-910", "number": 910, "title": "Apointment Coins Vfx Implementation", "description": "![image.png]([URL_50328])\n\nSo in the Chapter_1_Scene_modified2.unity scene you will find the playCoins-TEMPORARY game object button that i use to trigger the animation from CoinsVfx.\n\nThe only problem is that each coin needs to have set to its destination that game object. wich is the icon of the balance at the top of the screen.\n\nWe want this to be dynamic so in case the UI it's different for diferent kind of screens, then the coins will still fly to where the balance is!\n\n![image.png]([URL_50327])", "priority": 1, "estimate": null, "due_date": null, "started_at": "2024-05-20T23:23:59Z", "completed_at": "2024-06-17T14:34:37Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 872940, "labels": ["VFX Integration", "Leonardo Blocker"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-05-17T19:38:06Z", "updated_at": "2024-06-17T14:34:37Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3083", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-911", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Canceled", "cycle_id": null, "identifier": "ENG-911", "number": 911, "title": "Sophie Voice Implementation for Tutorial steps", "description": "'> [[URL_50329]) is the location for voice files\n\nThe mp3s will be triggered at the steps where we have the following tutorial text \n\nhello_there.mp3 - Hello there! I\u2019m Sophie, the Queen of Tiliaterra, a land where magic manifests as tiles. These tiles blossom across our lands, infused with the energy we harvest to fuel our kingdom.\n\ntap_a_tile.mp3 **- Tap a tile** on the board and match it with the tile **at the bottom.**\n\ndraw_a_new.mp3 - No playable tiles, tap to **draw a new tile.**\n\ngreat_job.mp3 - Great job! A **4-match streak gives 150 coins**! Next up, try a **5-match streak to get an extra tile** in draw pile.\n\nexcellent!.mp3 - Excellent! Let\u2019s go for a **6-match streak**, which adds **two more tiles** to the draw pile.\n\nincredible.mp3 - Incredible! **Longer streaks** gives **better bonuses**.", "priority": 3, "estimate": null, "due_date": null, "started_at": null, "completed_at": null, "canceled_at": "2024-07-19T00:20:52Z", "archived_at": null, "time_in_status_minutes": 827713, "labels": ["Sprint 18 - May 24th"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-05-18T18:39:17Z", "updated_at": "2024-07-19T00:20:52Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3087", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-915", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-877", "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-915", "number": 915, "title": "Notification Icon needs to be exclamation mark", "description": "The exclamation mark looks like this, and will apply to appointment mechanic, character profile and mini game.\n\nThe exclamation mark appears on character screen when: A new character is unlocked, but players have not visited that section\n\nThe exclamation mark only appears on the mini game icon in TWO instances as of 5/21/2024:\n\n1) Player finishes level 12, a red notification icon will appear on mini game icon\n\n2) Player unlocks memory game at chapter 2 level 6. When player return to Saga map, tutorial message will appear, red notification will appear as will on the mini game icon.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-05-21T16:13:58Z", "completed_at": "2024-06-17T15:18:39Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 872896, "labels": ["Hot Leo", "Sprint 18 - May 24th", "Main Game"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-05-20T17:40:04Z", "updated_at": "2024-09-09T21:19:01Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3096", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-923", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-914", "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-923", "number": 923, "title": "Rewind currently can't be locked in FTUE", "description": null, "priority": 1, "estimate": null, "due_date": null, "started_at": "2024-05-21T20:44:02Z", "completed_at": "2024-06-17T13:31:28Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 873003, "labels": ["Submission Blocker"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-05-21T16:57:20Z", "updated_at": "2024-06-17T13:31:28Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3103", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-930", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-930", "number": 930, "title": "Able to win and lose at the same time", "description": "'@[PERSON_NAME_0054] said:\n\n> @[PERSON_NAME_0067] I manage to win and lose at the same time, check this out \ud83d\ude06\n\n![Screenshot_20240521_173919_Domino Adventures.jpg]([URL_50346])\n\nI also noticed if you use bomb as your last match to remove all pieces, and you have no more draw pile, it will think you have no matches and lost, and I get the same win and lose at the same time condition\n\n[Screen_Recording_20240521_174407_Domino Adventures.mp4]([URL_50345])\n\nThere are several instances the game things I'm out of moves when in fact I've cleared the board and won.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-05-23T05:21:12Z", "completed_at": "2024-06-17T14:53:19Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 872921, "labels": ["Bug", "Leonardo Blocker"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-05-22T17:32:35Z", "updated_at": "2024-06-17T14:53:19Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3113", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-941", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-941", "number": 941, "title": "Purchase enchanted starter pack during out-of-moves screen without redirecting to shop for confirmation - rebirth", "description": "'@Leonard said:\n\n> Purchase flow for enchanted starter pack at out-of-moves screen, making sure that players don\u2019t have to redirected to the shop for purchase confirmation - rebirth", "priority": 3, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-07-19T00:21:06Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 827713, "labels": ["Sprint 19 - June 14th"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-05-23T19:53:39Z", "updated_at": "2024-07-19T00:21:06Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3117", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-945", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-945", "number": 945, "title": "Strange behavior when using the setting button to quit with the new OOM dialog. See video", "description": "'@[PERSON_NAME_0054] said:\n\n> @[PERSON_NAME_0067] The setting button to quit, when used in conjunction with the new OOM dialog, creates strange undesired behavior, see video", "priority": 1, "estimate": null, "due_date": null, "started_at": "2024-05-24T21:17:36Z", "completed_at": "2024-06-17T14:42:32Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 872932, "labels": ["Submission Blocker", "Bug", "Leonardo Blocker"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-05-24T17:10:50Z", "updated_at": "2024-06-17T14:42:32Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3118", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-946", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-946", "number": 946, "title": "Coin balance overlay doesn't cover the background balance, leading to ghosting effect", "description": "'@[PERSON_NAME_0054] said:\n\n> the coin balance is still not exactly over the background one here. So it looks like some ghosting effect.\n\n![image.png]([URL_50356])", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-05-25T00:11:09Z", "completed_at": "2024-06-17T13:54:59Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 872979, "labels": ["Submission Blocker", "Leonardo Blocker"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-05-24T17:31:07Z", "updated_at": "2024-06-17T13:54:59Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3122", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-950", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-950", "number": 950, "title": "Quitting via settings button has 3 bugs", "description": "'@[PERSON_NAME_0054] said:\n\n> Quitting via settings button still has 2 bugs.\n\n1. Old UI in the confirmation dialog.\n2. The quitting animation has a gift box power-up VFX happening in the background.\n3. Tutorial arrow bleeds through this quitting flow\n\n![image.png]([URL_50362])\n\nOld dialog needs to be updated\n\n[Screen_Recording_20240524_194958_Domino Adventures.mp4]([URL_50361])\n\nNew UI for quitting flow here: [[URL_50360])", "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-08-08T15:39:16Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 797995, "labels": ["Bug", "Leonardo Blocker"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-05-25T02:48:42Z", "updated_at": "2024-08-08T15:39:16Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3123", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-951", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-951", "number": 951, "title": "Level number overlaps, making it look ugly", "description": "'@Leonard said:\n\n> Not a blocker but out of moves and level number overlaps. Looks ugly\n\n![IMG_6488.png]([URL_50363])", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-05-28T16:50:26Z", "completed_at": "2024-06-17T13:55:28Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 872979, "labels": ["Hot Leo"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-05-28T15:53:24Z", "updated_at": "2024-06-17T13:55:28Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3137", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-965", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-965", "number": 965, "title": "Need to move \"rewind\" button higher up to avoid confusion with \"card you pull\" button", "description": "I think we need to move rewind back up. Card you pull and rewind are way too close to each other now. All action is squeezed in a tiny space.\n\nthe rewind is currently around the bunny ears. We want move it up to top of the bunny ears\n\n![image.png]([URL_50369])", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-05-30T22:11:18Z", "completed_at": "2024-06-17T13:43:20Z", "canceled_at": null, "archived_at": "2024-12-18T07:20:57Z", "time_in_status_minutes": 872991, "labels": ["Hot Leo"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-05-28T17:57:10Z", "updated_at": "2024-06-17T13:43:20Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3145", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-972", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-972", "number": 972, "title": "If I quit from settings there is no Sophie in the screen", "description": "'@Marcus said:\n\n> If I quit from settings there is no Sophie in the screen - 0.1.1221\n>\n> ![image.png]([URL_50375])", "priority": 3, "estimate": null, "due_date": null, "started_at": "2024-05-30T21:52:34Z", "completed_at": "2024-06-17T15:04:54Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 872909, "labels": ["Hot Leo"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-05-30T19:21:26Z", "updated_at": "2024-06-17T15:04:54Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3150", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-977", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-977", "number": 977, "title": "Disable Nathan's bomb VFX due to a new bug where he doesn't throw bombs yet", "description": "'@Leonard said:\n\n> can someone disable Nathan\u2019s bomb VFX? it\u2019s a new bug - he doesn\u2019t throw bombs yet", "priority": 1, "estimate": null, "due_date": null, "started_at": "2024-06-04T21:01:09Z", "completed_at": "2024-06-17T13:28:37Z", "canceled_at": null, "archived_at": "2024-12-18T07:20:48Z", "time_in_status_minutes": 873006, "labels": ["Hot Leo"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-05-30T21:10:22Z", "updated_at": "2024-06-17T13:28:37Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3152", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-979", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-979", "number": 979, "title": "Streak reward effect and animation not synced", "description": "'@[PERSON_NAME_0067] said:\n\n> the streak reward effect has always been not synced with the animation", "priority": 3, "estimate": null, "due_date": null, "started_at": "2024-06-04T06:07:03Z", "completed_at": "2024-07-08T15:05:59Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 842668, "labels": ["Sprint 19 - June 14th"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-05-30T22:37:21Z", "updated_at": "2024-07-08T15:05:59Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3154", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-980", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-980", "number": 980, "title": "The steak announcer blocks the upper side of the board briefly, causing a delay in fast matches", "description": "'@Leonard said:\n\n> the steak announcer blocks the upper side of the board for 0.5 secs or so -if you want to do a fast match you can\u2019t @[PERSON_NAME_0067]", "priority": 4, "estimate": null, "due_date": null, "started_at": "2024-05-31T03:39:28Z", "completed_at": "2024-06-17T15:10:50Z", "canceled_at": null, "archived_at": "2024-12-18T07:20:56Z", "time_in_status_minutes": 872903, "labels": ["Hot Leo"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-05-31T01:57:08Z", "updated_at": "2024-06-17T15:10:50Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3155", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-981", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-981", "number": 981, "title": "Update Sophie and Nate's 4-streak rewards to +50 instead of +150. Can you do it easily?", "description": "'@Leonard said:\n\n> @[PERSON_NAME_0067] one more last ticket for you. We would like to reduce 4-streak rewards for both Sophie and Nate from +150 to +50. Is this something you can update relatively easy?", "priority": 1, "estimate": null, "due_date": null, "started_at": "2024-05-31T03:36:16Z", "completed_at": "2024-06-17T15:01:33Z", "canceled_at": null, "archived_at": "2024-12-18T07:20:57Z", "time_in_status_minutes": 872913, "labels": ["Hot Leo"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-05-31T02:38:51Z", "updated_at": "2024-06-17T15:01:34Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3166", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-991", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-991", "number": 991, "title": "Change Character Levels to support 40 levels max", "description": "With new skills built\n\nTable of skill progression for Sophie and Nate found [HERE]([URL_50378])", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-06-04T21:00:59Z", "completed_at": "2024-06-27T14:49:32Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 858525, "labels": ["Characters", "Sprint 19 - June 14th"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-06-04T17:09:53Z", "updated_at": "2024-06-27T14:49:32Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3170", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-995", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-991", "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-995", "number": 995, "title": "Create Nate's new passive skill", "description": "2 new passive skills:\n\n1) Start the game with jumbo tile in hand with all 4 symbols eligible to be matched\n\n2) Start the game with a gold tile in hand.\n\nThese are passive skills that players obtain as they upgrade Nate's level. The skill table is seen here:\n\n![image.png]([URL_50383])", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-06-10T17:29:08Z", "completed_at": "2024-07-02T13:40:52Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 851393, "labels": ["Characters", "Sprint 19 - June 14th"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-06-06T21:06:21Z", "updated_at": "2024-07-02T13:40:52Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3174", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-999", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-999", "number": 999, "title": "Booster price for +3 card is incorrect, it should be 1800 instead of 2500", "description": "'@Leonard said:\n\n> Booster price for +3 card is not implemented correctly. It should be 1800 instead of 2500\n\n![IMG_6613.png]([URL_50395])", "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-07-15T07:41:49Z", "canceled_at": null, "archived_at": "2025-01-16T07:20:30Z", "time_in_status_minutes": 833032, "labels": ["Sprint 19 - June 14th"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-06-07T17:59:09Z", "updated_at": "2024-07-15T07:41:49Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3359", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ZOM-249", "project_id": "dbab77c7-f871-4888-abf8-d98b52a41624", "team_id": "team_ZOM", "parent_id": "ZOM-294", "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ZOM-249", "number": 249, "title": "Enhance damage display duration and visibility in game", "description": "New rule:\n\nAfter initial damage, HP bar stays permanently visible.\n\nAlso increase damage amount dealt duration by 0.5 seconds.", "priority": 1, "estimate": null, "due_date": null, "started_at": "2025-06-26T23:17:45Z", "completed_at": "2025-07-01T14:18:44Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 327196, "labels": ["Improvement", "30 June"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-06-12T02:12:49Z", "updated_at": "2025-07-01T14:18:44Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3366", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ZOM-255", "project_id": "dbab77c7-f871-4888-abf8-d98b52a41624", "team_id": "team_ZOM", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Backlog", "cycle_id": null, "identifier": "ZOM-255", "number": 255, "title": "Tap to skip kill cam + Dimming the board area and only keeping the top portion lit.", "description": "Before we start this, let's discuss how much effort this will take.\n\nIf player tabs 3x after kill cam is triggered, it prompts the victory screen and fades the background. This will allow the player to hit exit to exit the level, despite any animation from the kill cam still playing.", "priority": 3, "estimate": null, "due_date": null, "started_at": null, "completed_at": null, "canceled_at": null, "archived_at": null, "time_in_status_minutes": 191685, "labels": ["Feature"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-06-12T22:04:11Z", "updated_at": "2025-10-03T16:49:41Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3410", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ZOM-295", "project_id": "dbab77c7-f871-4888-abf8-d98b52a41624", "team_id": "team_ZOM", "parent_id": "ZOM-294", "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ZOM-295", "number": 295, "title": "Refill health and push monster back should reset ALL enrage status.", "description": "* Refill health and push monster back should reset ALL enrage status. Right now monsters do not get buffed, however a single enrage will buff them to the previous enraged level, whatever that might be.", "priority": 1, "estimate": null, "due_date": null, "started_at": "2025-07-04T00:09:26Z", "completed_at": "2025-07-04T16:40:40Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 322734, "labels": ["Bug", "30 June"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-06-23T19:45:43Z", "updated_at": "2025-07-04T16:40:40Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3439", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ZOM-321", "project_id": "dbab77c7-f871-4888-abf8-d98b52a41624", "team_id": "team_ZOM", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Canceled", "cycle_id": null, "identifier": "ZOM-321", "number": 321, "title": "Identify and fix multiple bugs in the game", "description": "'@[PERSON_NAME_0054] said:\n\n> There is several bugs in the game right now:\n\n[[IDENTIFIER_48353]]([URL_52623])", "priority": 3, "estimate": null, "due_date": null, "started_at": null, "completed_at": null, "canceled_at": "2025-06-30T16:30:02Z", "archived_at": null, "time_in_status_minutes": 328508, "labels": ["Bug"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-06-28T05:33:12Z", "updated_at": "2025-06-30T16:30:02Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3442", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ZOM-324", "project_id": null, "team_id": "team_ZOM", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ZOM-324", "number": 324, "title": "Coin amount is not updated on home screen and core game.", "description": "* When the rewards are granted or coins are spent in the home screen, changes on coin balance is not updated. \n  * It requires scene change or clicking on the shop button to refresh the UI.\n\n[VID_[CREDIT_CARD_NUMBER_6272].mp4]([URL_52632])\n\n[ScreenRecording_[CREDIT_CARD_NUMBER_6271]_1.MP4]([URL_52631])\n\n[Record_[CREDIT_CARD_NUMBER_6270].mp4]([URL_52630])\n\n[ScreenRecording_[CREDIT_CARD_NUMBER_6269]_1.MP4]([URL_52629])", "priority": 1, "estimate": null, "due_date": null, "started_at": "2025-07-04T21:54:45Z", "completed_at": "2025-07-07T11:11:14Z", "canceled_at": null, "archived_at": "2026-01-08T04:37:46Z", "time_in_status_minutes": 318743, "labels": ["Bug"], "links": [], "relations": [], "is_archived": true, "created_at": "2025-06-30T10:45:30Z", "updated_at": "2025-07-07T11:11:14Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3445", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ZOM-327", "project_id": null, "team_id": "team_ZOM", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ZOM-327", "number": 327, "title": "The item replacement VFX doesn't show the correct visuals", "description": "The problem is only happening on ios and unity editor. Didn't have the same problem on android build. \n\nAs it can be seen here, the item replacement cards are just placeholder. It always shows the grapes as 4 items.  \n\n![image.png]([URL_52635])\n\nThe actual items that are replacing are also visible but the placeholder ones are overshadowing so they are not even visible. This is the only frame I saw them.\n\n![image.png]([URL_52634])\n\nAnd here is the video. \n\n[ScreenRecording_[CREDIT_CARD_NUMBER_6273]_1.MP4]([URL_52633])\n\nAction items are:\n\n1. Remove the placeholder visuals\n2. Make sure that actual replacement items are visible\n3. Put 1 sec of input blocker ONLY to the settings button.", "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2025-07-02T16:57:42Z", "canceled_at": null, "archived_at": "2026-01-03T04:36:05Z", "time_in_status_minutes": 325597, "labels": ["15 July", "Bug"], "links": [], "relations": [], "is_archived": true, "created_at": "2025-07-01T14:26:30Z", "updated_at": "2025-07-02T16:57:42Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3446", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ZOM-328", "project_id": null, "team_id": "team_ZOM", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ZOM-328", "number": 328, "title": "Nuke cannot be launched", "description": "ios 865, the nuke doesn't explode, it appears on the board but clicking on it doesn't do anything.\n\n[ScreenRecording_[CREDIT_CARD_NUMBER_6275]_1.MP4]([URL_52637])\n\n[ScreenRecording_[CREDIT_CARD_NUMBER_6274]_1.mov]([URL_52636])\n\nExpected Outcome is to spawn nuke and clicking on it should launch and kill every zombies in the field.", "priority": 1, "estimate": null, "due_date": null, "started_at": "2025-07-04T02:59:29Z", "completed_at": "2025-07-04T16:40:38Z", "canceled_at": null, "archived_at": "2026-01-05T04:38:11Z", "time_in_status_minutes": 322734, "labels": ["15 July", "Bug"], "links": [], "relations": [], "is_archived": true, "created_at": "2025-07-02T16:44:21Z", "updated_at": "2025-07-04T16:40:38Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3484", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ZOM-362", "project_id": "dbab77c7-f871-4888-abf8-d98b52a41624", "team_id": "team_ZOM", "parent_id": "ZOM-244", "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ZOM-362", "number": 362, "title": "Loading time in black screen is too long.", "description": "After the fix for shader compiling, now they're downloaded in the black screen and it takes around 15 to 20 secs to even see the splash screen. \n\nIt happens every time the app is started regardless of if it's the first instance or not. \n\n[ScreenRecording_[CREDIT_CARD_NUMBER_6284]_1.MP4]([URL_52655])", "priority": 1, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2025-07-11T15:15:10Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 312739, "labels": ["Bug"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-07-09T13:40:17Z", "updated_at": "2025-07-11T15:15:10Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3504", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ZOM-380", "project_id": null, "team_id": "team_ZOM", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Canceled", "cycle_id": null, "identifier": "ZOM-380", "number": 380, "title": "When boss killed by DOT, the levels end prematurely.", "description": "* You can see the level how there are lots of bosses, and none of the time the fast forwarding boss spawn worked.\n* Sometimes the kill cam doesn't trigger either and the level ends. I think in this single video we see all the variations of how a level prematurely ends\n\n[[CREDIT_CARD_NUMBER_6292].5898555.mp4]([URL_52680])", "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": null, "canceled_at": "2025-09-04T10:26:53Z", "archived_at": null, "time_in_status_minutes": 233827, "labels": ["Bug"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-07-12T15:03:24Z", "updated_at": "2025-09-04T10:26:53Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3613", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ZOM-481", "project_id": null, "team_id": "team_ZOM", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ZOM-481", "number": 481, "title": "Zombie Health bar persists too long after death.", "description": "When the zombies die, their health bar is still present after a sec.  \n\nThe video below is in 0.3x. It shows that the health bar can clutter and cause visual noise. \n\nHowever, as you can notice in the video, it might also cause mistargets. If the items are matched fast enough, the first object matched after a zombie is killed can still target the dead zombie. Therefore, some items can be used for nothing which can also prevents balancing the board population. \n\n[persistent health bar - Made with Clipchamp.mp4]([URL_52796])", "priority": 1, "estimate": null, "due_date": null, "started_at": "2025-10-07T16:41:35Z", "completed_at": "2025-10-13T16:29:26Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 177305, "labels": ["Bug"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-08-14T18:02:51Z", "updated_at": "2025-10-13T16:29:26Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3637", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ZOM-503", "project_id": null, "team_id": "team_ZOM", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ZOM-503", "number": 503, "title": "Giving lives in teams are unresponsive", "description": "Giving lives in teams are unresponsive and it requires a tab change to reflect the actual value of lives given. \n\n[teams giving lives.mp4]([URL_52817])", "priority": 3, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2025-09-22T15:11:03Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 207623, "labels": ["Bug"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-08-25T12:51:51Z", "updated_at": "2025-09-22T15:11:03Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3682", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ZOM-546", "project_id": "dbab77c7-f871-4888-abf8-d98b52a41624", "team_id": "team_ZOM", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Todo", "cycle_id": null, "identifier": "ZOM-546", "number": 546, "title": "Bug: refill algorithm spawns fewer items over time", "description": "'@[PERSON_NAME_0054] said:\n\n> @[PERSON_NAME_0120] There is still a bug where the refill algorithm over time is spawning less and less item each refill. Eventually with not a lot of items on the board", "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": null, "canceled_at": null, "archived_at": null, "time_in_status_minutes": 217495, "labels": ["Bug"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-09-15T18:39:28Z", "updated_at": "2025-10-13T16:50:12Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3691", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ZOM-554", "project_id": null, "team_id": "team_ZOM", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ZOM-554", "number": 554, "title": "Quiting level mid tornado boost breaks the object physics", "description": "When I quit the level while the Tornado booster is active, all the objects in the following levels float around the board as if they\u2019re drifting in space. This issue doesn\u2019t just affect the current level, it also affects the objects in the following levels. To fix it, I had to kill the game \n\n[[CREDIT_CARD_NUMBER_6357].5794574.mp4]([URL_52862])", "priority": 1, "estimate": null, "due_date": null, "started_at": "2025-10-02T23:27:38Z", "completed_at": "2025-10-08T12:58:50Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 184968, "labels": ["Bug"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-09-19T19:55:23Z", "updated_at": "2025-10-08T12:58:50Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3700", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ZOM-562", "project_id": null, "team_id": "team_ZOM", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ZOM-562", "number": 562, "title": "Orphan items in boss arena", "description": "After refills, sometimes objects are not spawned as sets 3 items. It happens along with refill. The objects should be spawned as sets no matter what. \n\n[ScreenRecording_[CREDIT_CARD_NUMBER_6362]_1.MP4]([URL_52871])\n\n**Expected behavior is to refill objects by 3 items (1 set) not one by one so the orphan items can be fixed.**\n\n[ScreenRecording_[CREDIT_CARD_NUMBER_6361]_1.MP4]([URL_52870])\n\nExpected behavior is to refill objects by 3 items (1 set) not one by one so the orphan items can be fixed.", "priority": 1, "estimate": null, "due_date": null, "started_at": "2025-10-06T23:35:47Z", "completed_at": "2025-10-08T12:58:53Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 184715, "labels": ["Bug"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-09-22T20:02:01Z", "updated_at": "2025-10-08T12:58:53Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3704", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ZOM-566", "project_id": null, "team_id": "team_ZOM", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_fc22d5941b2aeb5c", "state_id": "In Validation", "cycle_id": null, "identifier": "ZOM-566", "number": 566, "title": "Collect&Win Analytics", "description": "Analytic logs for collect&win\n\n* [[URL_52879])\n* [[URL_52878])", "priority": 2, "estimate": null, "due_date": null, "started_at": "2025-10-02T16:14:45Z", "completed_at": null, "canceled_at": null, "archived_at": null, "time_in_status_minutes": 193160, "labels": [], "links": [], "relations": [], "is_archived": false, "created_at": "2025-09-30T16:26:02Z", "updated_at": "2025-10-02T16:14:45Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3705", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ZOM-567", "project_id": "dbab77c7-f871-4888-abf8-d98b52a41624", "team_id": "team_ZOM", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_c77c50cc15c5342d", "state_id": "Done", "cycle_id": null, "identifier": "ZOM-567", "number": 567, "title": "Endless Mode Core game Vfx", "description": "So during Endless Mode gameplay we needed to add some vfx at the bottom of the game\n\n[EndlessMode_Bottom001.mp4]([URL_52883])\n\nI've modified the EndlessModeBar prefab and changed the bar\n\n![image.png]([URL_52882])\n\nThe old one it's still in there. The new one has some overwrites that i dont wana push to it because the variant its used somewere else as well. these modifications will just sit as they are in the EndlessModeBar prefab.\n\nSo we need to CONNECT this new bar to the code and to make it function!\n\nI've also added a dotween animation to the multiplier text as well as the power text. They need to trigger each time the text changes!\n\n![image.png]([URL_52881])\n\nI also added dotween animation as u can see to the top zombie count number . we need to trigger that dotween animation each time the text changes and u kill a zombie.\n\nOther modifications that i dont think requires any programing is that the NukeButton has some visual effect behind it when its active. thats it.\n\n---\n\nThere is another problem!\n\n![image.png]([URL_52880])\n\nSo our core gameplay UI camera doesnt have Post Processing set to ON, because of that the vfx wont glow and look bad.\n\nThe problem is that if we set it to ON , it will be on for all the quality settings, low med and high.\n\nI dont think it will work on Low evin if its ON because post processing there its disabled from the rendering file settings i think.\n\nThe problem is that gameplay scene needs a gameobject that holds 3 UI cameras with 3 different settings. We are interesting in the post processing on and off. So for low we should have it off.  But i dont know how all this function as UI camera is used by the canvas if we swap it it might brake the canvas. All i want its that on high we have Post Processing!\n\n---\n\nThe branch where is all these is: Marcus/EndlessMode_Vfx_NewUnity\n\nPlease note that i'm still working on that branch to change InfiniteBoss arena part of the core gameplay as well\u2026\n\nGood Luck!", "priority": 1, "estimate": null, "due_date": null, "started_at": "2025-10-08T20:44:06Z", "completed_at": "2025-10-13T16:29:34Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 177305, "labels": ["VFX Integration", "VFX", "Core Game"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-10-01T12:26:53Z", "updated_at": "2025-10-13T16:29:34Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3724", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ZOM-584", "project_id": "dbab77c7-f871-4888-abf8-d98b52a41624", "team_id": "team_ZOM", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_c77c50cc15c5342d", "state_id": "Done", "cycle_id": null, "identifier": "ZOM-584", "number": 584, "title": "Infinite Boss Arena Vfx", "description": "[BossArena_Final_Functionality002.mp4]([URL_52919])\n\nSo this is how it needs to look the boss arena part of the game, we dont have anithing at the bottom, we have a new bar at the top in 2 stages.\n\nPlease dont mind the zombie and background at the top i coudlnt made it to renceord the boss arena background and boss. Also to stop and play the gameobjects i had them hidden and active thats why at some point they dont show at all for a second (like tha bar), but in the final product we should not do that, it was just me recording.\n\nThe prefabs i've worked on are: InfiniteBoss_Bar and EdgeGlow\n\n![image.png]([URL_52918])\n\nthis is where they sit in the canvas.\n\n# **The bar Functionality:**\n\nLoading_Bar Yellow has in the Fill Area two versions of the bar, one its yellow_Fill and one it's rapid_fire_yellowFill.\n\n![image.png]([URL_52917])\n\nWe are going to work with Unity Slider because \n\n![image.png]([URL_52916])\n\nslider gives me a handle object that i can place particles at the edge of the bar and it will stick to no matter what value is set\n\nSo the functionality goes like this:\n\nYou first have the bar emptu and its the yellow_Fill active and rapid_fire_yellowFill deactivated, you kill zombies and then the bar value increases untill u get to full bar. at that moment we need to deactivate yellow_Fill and activate rapid_fire_yellowFill bar version and also we need to activate the EdgeGlow prefab in canvas so we have the nice fire around the screen. The edgeGlow it's made in such way that if u change resolution the fire will move to the new edge of the screen, for example ipad version\u2026\n\n[[CREDIT_CARD_NUMBER_6384].2793646.mp4]([URL_52915])\n\nThe multiplier has a dotween animation that it's required to play/restart each time the amount changes!\n\n[[CREDIT_CARD_NUMBER_6383].5663292.mp4]([URL_52914])\n\nSo the icon on the left (the trampouline on fire) is in two stages, one static like that , and the other one sits in the rapid_fire_yellowFill version of the bar wich is animated, but both are in the Fill Area and thats under the Handle and the particles at the edge of the bar will show on top of the trampouline so to fix that\n\n![image.png]([URL_52913])\n\nWhen we get to 0.116 amount of the bar then i belive we should just hide the particles but if the value goes up again after that we should re-activate them.\n\n---\n\nSo my working branch it's EndlessMode_Vfx_NewUnity\n\nit's where i have the stuff for the endless mode as well, you have the previous tickets on that.\n\nat this point i'm on unity6000.2.6f1 but there are some security issues with unity and i belive we are going to move to a patched unity version soon, so this branch needs to be updated from main as soon as Blake upgrades it, probably it's best to clone this branch and then pull from main \ud83d\ude42 \n\nGood Luck!", "priority": 1, "estimate": null, "due_date": null, "started_at": "2025-10-08T20:44:02Z", "completed_at": "2025-10-13T16:29:28Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 177305, "labels": ["VFX Integration", "VFX"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-10-03T14:51:25Z", "updated_at": "2025-10-13T16:29:28Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3726", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ZOM-586", "project_id": "dbab77c7-f871-4888-abf8-d98b52a41624", "team_id": "team_ZOM", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "ZOM-586", "number": 586, "title": "Change Backgrounds In the Game", "description": "Please add the new backgrounds in to the game. The backgrounds can be found on Figma on this page. \n\n\n![image.png]([URL_52921])\n\n[https://www.figma.com/design/TvRw8na5iGd3NynbSRUGFy/Zombie-Match-3D?node-id=13-7&p=f&t=MeI1RhrJXAeSWFe1-0](https://www.figma.com/design/TvRw8na5iGd3NynbSRUGFy/Zombie-Match-3D?node-id=13-7&p=f&t=MeI1RhrJXAeSWFe1-0)\n\nPlease note these backgrounds are designed for iPad size and needs to optimized for various device sizes. Follow the general practice in place and if you have any questions, talk with [PERSON_NAME_0120], who set the system in the first place. For any lightning issues, please check in with Marcus. \n\nPlease let me know the branch name you'll be working on, in the comments on Linear below. \n\nWe will use the port image for the infinite boss mode and the rest of the backgrounds will rotate inside the main game.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2025-10-06T17:50:52Z", "completed_at": "2025-10-14T12:21:28Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 176113, "labels": [], "links": [], "relations": [], "is_archived": false, "created_at": "2025-10-03T16:37:03Z", "updated_at": "2025-10-14T12:21:28Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3739", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ZOM-598", "project_id": null, "team_id": "team_ZOM", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Todo", "cycle_id": null, "identifier": "ZOM-598", "number": 598, "title": "Item to bones animation doesn't work properly", "description": "When I maxed out a card, it's still can be rewarded. Those surplus cards are converted to bones. However, the current conversion and animation works differently. \n\n[Record_[CREDIT_CARD_NUMBER_6389]_232bce8c0fd071e3b7a1963a264fccd2.mp4]([URL_52927])\n\n* Sometimes the converting animation wasn't triggered\n* Sometimes when a card pack opened, the bone icon stays there\n* Sometimes a card might be open from the start of the pack opening. \n* Sometimes only 1 card is converted to bones while the other looks the same.\n* The amount the bones are converted is not clear. It sometimes updates sometimes not with different scores.", "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": null, "canceled_at": null, "archived_at": null, "time_in_status_minutes": 184681, "labels": ["Bug", "Hot Fix - Global Launch"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-10-08T13:32:55Z", "updated_at": "2025-10-14T14:50:47Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3748", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ZOM-606", "project_id": null, "team_id": "team_ZOM", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Todo", "cycle_id": null, "identifier": "ZOM-606", "number": 606, "title": "The game froze after putting it into background for a while", "description": "The duration can change based on the device because it's about ram usage. But ideally if the app is in the background, after certain duration, the app should be restarted from the splash screen. \n\nI feel like 15min would be enough to restart the app again.", "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": null, "canceled_at": null, "archived_at": null, "time_in_status_minutes": 172157, "labels": ["Bug", "Hot Fix - Global Launch"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-10-14T12:25:17Z", "updated_at": "2025-10-17T16:43:04Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3754", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ZOM-611", "project_id": null, "team_id": "team_ZOM", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "In Progress", "cycle_id": null, "identifier": "ZOM-611", "number": 611, "title": "Card upgrade sync issues", "description": "Usually the card upgrades done successfully but there are some instances where my card amount is lost but the upgrade doesn't happen. \n\n* The first time upgrade didn't sync and my cards are lost on ios (as guest account) didn't happen on android. \n\n  [ScreenRecording_[CREDIT_CARD_NUMBER_6394]_1 (1).MP4]([URL_52945])\n* It might not sync and it can be lost after completing some levels. \n\n[ScreenRecording_[CREDIT_CARD_NUMBER_6396]_1.MP4]([URL_52944])\n\n![image.png]([URL_52943])\n\n* Killing the app after the last upgrade quickly\n\nI upgraded many items at the same time, the last upgrade of round table wasn't synced. \n\n![image.png]([URL_52942])\n\n![image.png]([URL_52941])\n\nThe expected condition should be like when the amount is reduced and the reduced amount is synced, the card level data should be also synced for sure.", "priority": 1, "estimate": null, "due_date": null, "started_at": "2025-10-17T20:49:09Z", "completed_at": null, "canceled_at": null, "archived_at": null, "time_in_status_minutes": 171285, "labels": ["Bug", "Hot Fix - Global Launch"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-10-14T14:21:25Z", "updated_at": "2025-10-17T20:49:09Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3755", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ZOM-612", "project_id": null, "team_id": "team_ZOM", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ZOM-612", "number": 612, "title": "Zombie lane rewards are doubled except cards", "description": "All zombie lane rewards except cards (boosts, currencies) are doubled when it's granted. \n\n* Prelevel boosters\n\n  [ScreenRecording_[CREDIT_CARD_NUMBER_6399]_1.MP4]([URL_52948])\n* In-game boosters\n\n  [ScreenRecording_[CREDIT_CARD_NUMBER_6398]_1.MP4]([URL_52947])\n* Currencies\n\n  [ScreenRecording_[CREDIT_CARD_NUMBER_6397]_1.MP4]([URL_52946])", "priority": 1, "estimate": null, "due_date": null, "started_at": "2025-10-17T20:42:45Z", "completed_at": "2025-10-20T15:58:23Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 167256, "labels": ["Bug", "Hot Fix - Global Launch"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-10-14T14:28:38Z", "updated_at": "2025-10-20T15:58:23Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3758", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ZOM-615", "project_id": null, "team_id": "team_ZOM", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ZOM-615", "number": 615, "title": "When the rapid fire starts on boss arena with an active nuke, he nuke is not clickable.", "description": "Nuke is spawned when the board is completely cleared out. And the rapid fire starts after filling the bar. \n\nWhen nuke is spawned while also there is an active rapid fire, the nuke is not clickable anymore until the end of the level.\n\n[ScreenRecording_[CREDIT_CARD_NUMBER_6402]_1.MP4]([URL_52952])", "priority": 1, "estimate": null, "due_date": null, "started_at": "2025-10-14T16:16:52Z", "completed_at": "2025-10-20T12:22:52Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 167471, "labels": ["Bug", "Hot Fix - Global Launch"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-10-14T14:46:07Z", "updated_at": "2025-10-20T12:22:52Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3759", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ZOM-616", "project_id": null, "team_id": "team_ZOM", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Regression", "cycle_id": null, "identifier": "ZOM-616", "number": 616, "title": "Weird outline issues on players name in certain places", "description": "* Plague race\n\n  ![image.png]([URL_52954])\n* Boss arena leaderboard\n\n  ![image.png]([URL_52953])\n* Endless Horde leaderboard", "priority": 3, "estimate": null, "due_date": null, "started_at": "2025-10-14T16:17:12Z", "completed_at": null, "canceled_at": null, "archived_at": null, "time_in_status_minutes": 167224, "labels": ["Easy Fix - Just do it!", "Bug", "Hot Fix - Global Launch"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-10-14T14:48:36Z", "updated_at": "2025-10-20T16:30:15Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3768", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ZOM-624", "project_id": "dbab77c7-f871-4888-abf8-d98b52a41624", "team_id": "team_ZOM", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "ZOM-624", "number": 624, "title": "Make The First 3 Levels Use The Original Buildings Background", "description": "Right now, the game has a rotating background image system that was previously done.\n\nPlease iterate the system so that: \n\nLevels 1,2, and 3 use the original buildings background that we had. \n\nNote: I'd make a system so that we can add to the list of numbers a certain background can be used at. That way if we iterate, it can be a simple line change. Please consider this approach if it's not too much additional time.", "priority": 1, "estimate": null, "due_date": null, "started_at": "2025-10-20T17:23:52Z", "completed_at": "2025-10-23T11:46:42Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 163188, "labels": [], "links": [], "relations": [], "is_archived": false, "created_at": "2025-10-20T17:23:52Z", "updated_at": "2025-10-23T11:46:42Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3814", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ZOM-668", "project_id": null, "team_id": "team_ZOM", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "In Validation", "cycle_id": null, "identifier": "ZOM-668", "number": 668, "title": "Make sure event tokens are doubled", "description": "Currently they  are not doubled after ad watch but they should be as well.", "priority": 1, "estimate": null, "due_date": null, "started_at": "2025-10-24T00:11:32Z", "completed_at": null, "canceled_at": null, "archived_at": null, "time_in_status_minutes": 157151, "labels": ["Hot Fix - Global Launch"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-10-23T16:22:28Z", "updated_at": "2025-10-27T16:23:24Z"}}], "records_checked": 3852, "files_selected": 1, "files_completed": 1, "scan_complete": true, "errors": []}}, "files_read_this_call": 1, "sources": [{"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "manifest_sha256": "b299d01377efd99db02ba7f6bb072a6d539b00d970b492b9e79b68353d3f5310", "freshness": "0c8cb14eff44696bf96f29fd29e43b66c16bb8f3b05dd3444d4fdf354ff98c37"}], "scan_complete": true, "persona_filtered": false, "backend": "grouped-record-scan", "scope_note": "Exact direct fields in selected arrays. No SQL is applied. Absence/uniqueness is supported only within complete declared scopes. Manifest hashes are declared provenance, not fresh full-content hashes."}, "checksum": "593f6f2faba3cc3fe4ddc5d20c5fa25eea77ff9c94f4ee27d579063067ae20d6"}