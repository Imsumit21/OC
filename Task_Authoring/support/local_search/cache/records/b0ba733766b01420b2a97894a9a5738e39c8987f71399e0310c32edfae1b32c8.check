inear/data.json", "pointer": "/issues/2547", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-406", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-406", "number": 406, "title": "Sophie character lingers bottom left corner after game ends", "description": "![image.png]([URL_49988])\n\n\"**Kage Bunshin no Jutsu\"**", "priority": 2, "estimate": null, "due_date": null, "started_at": "2023-11-16T16:02:49Z", "completed_at": "2024-04-18T15:35:27Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 959279, "labels": ["Bug", "Main Game"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-11-09T22:43:25Z", "updated_at": "2024-04-18T15:35:27Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2554", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-412", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-412", "number": 412, "title": "Inventory Items", "description": "Make sure we are storing the quantity of these items owned\n[[URL_49994])\n\nTime duration based boosts ARE NOT kept in the inventory. They are only activated when we hand them out as a reward or they buy a IAP package.\n\nIf a player already have a 2 hour left on an infinite boost, activating another 30 minute infinite life boost will bring the total duration to 2 hour and 30 minutes\n\nNow here are the things that are actually tracked in the inventory:\n\ncurrencies: gems, gold, character token, stars\n\nin-game activated boosts from the wheel menu: dynamite tile, wild card tile, +3 card boost", "priority": 0, "estimate": null, "due_date": null, "started_at": "2023-11-17T01:48:24Z", "completed_at": "2024-01-03T06:22:37Z", "canceled_at": null, "archived_at": "2024-07-04T01:32:28Z", "time_in_status_minutes": 1112472, "labels": ["Sprint 8 - November 24th"], "links": [], "relations": [], "is_archived": true, "created_at": "2023-11-13T19:00:29Z", "updated_at": "2024-01-03T06:22:37Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2556", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-414", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-442", "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-414", "number": 414, "title": "MegaWin UI VFX PopUp", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": "2023-11-15T15:08:49Z", "completed_at": "2024-01-03T06:23:42Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1112471, "labels": ["VFX Integration", "Sprint 8 - November 24th"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-11-13T19:04:26Z", "updated_at": "2025-07-22T01:12:49Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2557", "field": "assignee_id", "value": "usr_4e13bd40cc73d0fc", "record": {"id": "ENG-415", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-442", "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-415", "number": 415, "title": "Epic Win PopUp", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": "2023-11-15T06:22:33Z", "completed_at": "2024-01-03T06:23:43Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1112471, "labels": ["VFX Integration", "Sprint 8 - November 24th"], "links": [], "relations": [], "