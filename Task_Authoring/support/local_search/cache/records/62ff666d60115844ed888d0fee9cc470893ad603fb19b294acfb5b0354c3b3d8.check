ns": [], "created_at": "2024-09-09T22:19:57Z", "updated_at": "2024-09-09T22:20:27Z", "merged_at": "2024-09-09T22:20:27Z", "closed_at": "2024-09-09T22:20:27Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/1941", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/GameOfDominoes#998", "repo_id": "harmonygames-Games/GameOfDominoes", "number": 998, "title": "ENG-1306: \"Out of Moves\" Screen Overlay Stuck After Visiting Shop Description", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "- Restoring missing references to CharacterDisplay\r\n- Saved reference to out of moves coroutine to prevent popping twice", "base_ref": "develop", "base_sha": "b363a13ab798bd7bf05f27e4614566cc1fb1fdba", "head_ref": "[PERSON_NAME_0067]/ENG-1306", "head_sha": "e159bbba320f5019cf38f484d902cbea9a921f96", "additions": 17, "deletions": 12, "changed_files": 2, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2024-09-09T22:53:07Z", "updated_at": "2024-09-09T23:26:09Z", "merged_at": "2024-09-09T23:26:08Z", "closed_at": "2024-09-09T23:26:08Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2217", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/match3d#250", "repo_id": "harmonygames-Games/match3d", "number": 250, "title": "ZOM-249: Enhance damage display duration and visibility in game", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "- Updated Bar.cs to increase damage dealt duration and make bar stay visible on first hit\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **Bug Fixes**\n  * Improved the hiding animation so it only triggers when appropriate, preventing unintended hide sequences.\n* **Style**\n  * Extended the duration of damage text visual effects for a smoother fade-out and scale-down experience.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "35bce5d65f6b480596e7a21b92036d53b690c90c", "head_ref": "[PERSON_NAME_0067]/ZOM-249", "head_sha": "8a1f761ec2a250cdde5dcba2880f391b13e313fc", "additions": 3, "deletions": 3, "changed_files": 1, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME", "EMPLOYEE_0003_GITHUB_USERNAME"], "created_at": "2025-06-26T23:33:22Z", "updated_at": "2025-06-27T12:54:05Z", "merged_at": "2025-06-27T12:54:05Z", "closed_at": "2025-06-27T12:54:05Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2225", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/match3d#258", "repo_id": "harmonygames-Games/match3d", "number": 258, "title": "ZOM-244: Fix bug with instantiating throwing objects causing jitter", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "- Updated ItemSpawner and ProjectileManager to preload projectiles on SpawnObject at start\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **New Features**\n  * Introduced preloading of projectiles to improve spawning performance and responsiveness.\n  \n* **Performance Improvements**\n  * Implemented a pooling system for projectiles, reducing instantiation overhead during gameplay.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "0cf40d4fdc31251e14bfcf5c66ebb9ac92edf470", "head_ref": "[PERSON_NAME_0067]/ZOM-244", "head_sha": "a5ec97e394e5efe62939995f03bc5c2dcd095a33", "additions": 27, "deletions": 1, "changed_files": 2, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-07-01T01:34:15Z", "updated_at": "2025-07-01T08:31:29Z", "merged_at": "2025-07-01T08:31:29Z", "closed_at": "2025-07-01T08:31:29Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2240", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/match3d#271", "repo_id": "harmonygames-Games/match3d", "number": 271, "title": "ZOM-295: Refill health and push monster back should reset ALL enrage status", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "- Fixed Enraged newly spawn monster walking slow and dealing low damage\r\n- Added ResetEnragedCounter method to reset all enrage status\r\n- Added Set Invincible CoreGame Debug option for testing\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **New Features**\n  * Added a new \"Set Invincible\" option to the debug menu, allowing players to instantly become invincible during gameplay.\n* **Improvements**\n  * Monsters now consistently receive the correct enrage level immediately after spawning.\n  * Added the ability to reset the monster enrage counter when restoring after defeat, ensuring balanced gameplay.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "bfcf83c6cc40bf7726785a3257c59ffa197e1bd3", "head_ref": "[PERSON_NAME_0067]/ZOM-295", "head_sha": "2f1c9a2251dd59ea40b7a64f09231de80ff466ed", "additions": 17, "deletions": 2, "changed_files": 4, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0025_GITHUB_USERNAME", "EMPLOYEE_0032_GITHUB_USERNAME", "EMPLOYEE_0003_GITHUB_USERNAME"], "created_at": "2025-07-04T00:17:49Z", "updated_at": "2025-07-04T13:29:30Z", "merged_at": "2025-07-04T13:29:30Z", "closed_at": "2025-07-04T13:29:30Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2241", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/match3d#272", "repo_id": "harmonygames-Games/match3d", "number": 272, "title": "ZOM-328: Nuke cannot be launched", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "- Added misssing OnObjectMatched call\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **Bug Fixes**\n  * Improved the behavior of the Nuke action to ensure it triggers object matching correctly and sends a usage event for better tracking.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "bfcf83c6cc40bf7726785a3257c59ffa197e1bd3", "head_ref": "[PERSON_NAME_0067]/ZOM-328", "head_sha": "f1b83e53eea3a889338701d86dde0ec84ef90577", "additions": 3, "deletions": 1, "changed_files": 1, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0025_GITHUB_USERNAME", "EMPLOYEE_0032_GITHUB_USERNAME", "EMPLOYEE_0003_GITHUB_USERNAME"], "created_at": "2025-07-04T03:02:35Z", "updated_at": "2025-07-04T13:28:03Z", "merged_at": "2025-07-04T13:28:03Z", "closed_at": "2025-07-04T13:28:03Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2247", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/match3d#278", "repo_id": "harmonygames-Games/match3d", "number": 278, "title": "ZOM-324: Coin amount is not updated on home screen and core game.", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0003_GITHUB_USERNAME", "body": "- Updated AddCoins to send OnCoinsAdded event after updating Coins value\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **Bug Fixes**\n  * Improved coin update notifications to ensure events are triggered after the coin amount has been updated.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "16e01e9395ee98cd67aaa64a0dbc4729e34e807c", "head_ref": "[PERSON_NAME_0067]/ZOM-324", "head_sha": "b1756eb25b1df7afe8bad52ac8061fe187cc95ce", "additions": 1, "deletions": 1, "changed_files": 1, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0025_GITHUB_USERNAME", "EMPLOYEE_0003_GITHUB_USERNAME"], "created_at": "2025-07-04T22:00:21Z", "updated_at": "2025-07-04T22:25:39Z", "merged_at": "2025-07-04T22:25:39Z", "closed_at": "2025-07-04T22:25:39Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2253", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/match3d#283", "repo_id": "harmonygames-Games/match3d", "number": 283, "title": "ZOM-244: Fix bug with instantiating throwing objects causing jitter", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "- Updated ProjectileManager to replace expensive MeshCollider that causes jitter on first time object match.\r\n\r\nAbout the issue:\r\nUnity is trying to create a convex MeshCollider at runtime, most of the projectile mesh we're using has too many polygons (over 256 triangles that is the Unity limit), for that reason Unity can\u2019t generate a proper convex hull, so it tries to build a partial/approximate one on the fly, this is slow and happens during gameplay, which causes lag/stutter.\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **New Features**\n  * Improved projectile collision handling to ensure consistent and accurate collider shapes for projectiles.\n  * Added a shader variant collection to enhance rendering performance through precompiled shader configurations.\n  * Introduced automatic shader variant preloading on startup to reduce runtime shader compilation delays.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "421bd59acfb28a2390f4d81ad7a3fbba26907369", "head_ref": "[PERSON_NAME_0067]/ZOM-244-1", "head_sha": "5a2ec15797a5cb5a814eea02a9e4f7d7edfda99e", "additions": 401, "deletions": 2, "changed_files": 7, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-07-08T00:15:11Z", "updated_at": "2025-07-08T23:28:19Z", "merged_at": "2025-07-08T23:28:19Z", "closed_at": "2025-07-08T23:28:19Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2353", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/match3d#373", "repo_id": "harmonygames-Games/match3d", "number": 373, "title": "Teams UI polishes and chat history fix", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n- Bug Fixes\n  - Stopped life regeneration countdown when you\u2019re at max lives.\n  - More Lives screen now shows a disabled state when no free lives are available.\n  - Lives Bank panel adapts to team status; counters and empty-state messages display correctly; labels now explicitly show \u201cLives\u201d.\n  - Team chat shows history in correct order and only displays live requests from teammates, reducing noise.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "8ae2c39fca47e42c48b7aeea04664e3e8c928f17", "head_ref": "[PERSON_NAME_0067]/teamsPolish", "head_sha": "b960b01357456c884eeeb6e7c357c2f74772c878", "additions": 1577, "deletions": 448, "changed_files": 6, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-08-11T20:52:56Z", "updated_at": "2025-08-11T23:45:00Z", "merged_at": "2025-08-11T23:44:59Z", "closed_at": "2025-08-11T23:44:59Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2372", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/match3d#390", "repo_id": "harmonygames-Games/match3d", "number": 390, "title": "Team Chat Improvements and Loading spinners", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n- New Features\n  - Load older chat messages by scrolling to the top (infinite scroll).\n  - Preserves your current view while older messages load.\n  - Shows a loading indicator on initial chat load and a top spinner when fetching history.\n\n- UI\n  - Added animated loading spinners to the chat interface for clearer feedback during data loading.\n\n- Chores\n  - Included new spinner animations and related assets to support the improved loading experience.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "f32cd1eaff4c3471fa66ceae078f876af5160bfd", "head_ref": "[PERSON_NAME_0067]/teamChatImprovements", "head_sha": "d36af9c4ca91013568c847364aea12b8a7f225ec", "additions": 11476, "deletions": 21, "changed_files": 36, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-08-20T01:48:30Z", "updated_at": "2025-08-26T17:43:26Z", "merged_at": "2025-08-26T17:43:26Z", "closed_at": "2025-08-26T17:43:26Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2408", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/match3d#422", "repo_id": "harmonygames-Games/match3d", "number": 422, "title": "Giving lives in teams fix and Popup animations", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "- Updated Team chat live request items to use help count from server\r\n- Added tween animations to LivesBank and MoreLives popups\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n- New Features\n  - Smooth entry animations added to More Lives and Lives Bank panels; they play consistently even when the game is paused.\n\n- Bug Fixes\n  - Team chat live-request cards now show accurate total helps and user-help status.\n  - Progress bars, fill amounts, and help button states update reliably from the shared help counts, preventing desyncs.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "d6c5b6d4c1b0e94033e814909ff8b3fda866abe3", "head_ref": "[PERSON_NAME_0067]/askLivesFix", "head_sha": "96c4149448adc9e8d38b72d4ae24b42170f1bd81", "additions": 135, "deletions": 51, "changed_files": 7, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-08T23:59:03Z", "updated_at": "2025-09-09T14:39:47Z", "merged_at": "2025-09-09T14:39:02Z", "closed_at": "2025-09-09T14:39:02Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2458", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/match3d#468", "repo_id": "harmonygames-Games/match3d", "number": 468, "title": "Collect And Win", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **New Features**\n  * Added \"Collect & Win\" live event: collect tokens in levels, track progress, claim stage rewards and a grand prize; main screen, progress widget, info panel, stage/prize items, and level-end token display.\n\n* **Improvements**\n  * Tokens spawn in unlocked levels, persist on level win, can be saved/claimed; new VFX/animations and reward-screen queuing.\n\n* **Developer Tools**\n  * Debug panel options to add tokens and reset event data; new backend requests to support the flow.\n\n* **Chores**\n  * Added sprites, prefabs, materials and asset metadata for the event.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "f5c0bb3a977a2d9b4e6b9559cd382d65548cb6c0", "head_ref": "[PERSON_NAME_0067]/winAndCollect", "head_sha": "648e2c7b9c1d9e263f4b43a45e135ba9fa6002fd", "additions": 54216, "deletions": 32, "changed_files": 127, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-26T20:16:25Z", "updated_at": "2025-09-29T16:13:50Z", "merged_at": "2025-09-29T16:13:50Z", "closed_at": "2025-09-29T16:13:50Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2461", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/match3d#470", "repo_id": "harmonygames-Games/match3d", "number": 470, "title": "Collect And Win minor bugs fixes", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Fixes:\r\n* When the page opened, it shows placeholder images at first.\r\n* After level completion, it first shows placeholder icon and progress for the event, then shows the correct one\r\n* In every level, I got two errors both backend and client. \r\n* In Boss arena and endless mode, the c&w UI is visible. \n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n- Refactor\n  - Collect & Win screens now use pooled UI items for faster loading, smoother scrolling, reduced flicker, improved ordering and cleanup when refreshing content.\n- New Features\n  - Auto-scrolls to the first unclaimed reward/grand prize when opening the screen.\n  - Reward and grand-prize items now reflect claimed state (labels hidden for claimed stages).\n- Bug Fixes\n  - Next Reward icon visibility corrected based on event lock.\n  - Token counter/panel shown only when relevant (avoids Endless/Infinite Boss modes).\n  - UI elements remain hidden until data/initialization to prevent brief flashes.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "88879d8bb88eef8203be592f5189a76d17f3b782", "head_ref": "[PERSON_NAME_0067]/winAndCollectMinorBugs", "head_sha": "4935e9483a95d78b3a58d18794bacd97816787e8", "additions": 166, "deletions": 33, "changed_files": 10, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-29T21:22:50Z", "updated_at": "2025-09-30T15:51:15Z", "merged_at": "2025-09-30T15:51:15Z", "closed_at": "2025-09-30T15:51:15Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2468", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/match3d#477", "repo_id": "harmonygames-Games/match3d", "number": 477, "title": "Collect And Win Analytics and title change", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n- New Features\n  - App emits and tracks Collect & Win start and reward-claimed events (includes event duration, stage, and reward details).\n- Improvements\n  - Total event duration now computed from explicit start and end times for more accurate reporting.\n  - Screens update and report timing consistently across flows.\n- Bug Fixes\n  - Initial color/state corrected to avoid an unintended default on load.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "166dc182aad2c6de4df28992268ea65e9600754a", "head_ref": "[PERSON_NAME_0067]/collectAndWinAnalytics", "head_sha": "8544a28e108d2c870f1bd5b961e235ed566830df", "additions": 97, "deletions": 13, "changed_files": 9, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-30T22:26:30Z", "updated_at": "2025-10-02T16:44:58Z", "merged_at": "2025-10-02T16:43:03Z", "closed_at": "2025-10-02T16:43:03Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2474", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/match3d#482", "repo_id": "harmonygames-Games/match3d", "number": 482, "title": "Collect and Win Improvements", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "- Tablet improvements\r\n- Lock state consistency\r\n- Highlights on in game tokens\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **Style**\n  * Collect & Win progress UI now visually indicates lock state: the color bottle icon appears desaturated when locked and returns to full color when unlocked.\n  * Enhances clarity at a glance, helping players quickly distinguish locked from unlocked states without extra prompts.\n  * Visual-only update; no impact on gameplay, rewards, or progression.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "08c50c1a5a15705c8b09f330b10a5ef8bb3ff1bd", "head_ref": "[PERSON_NAME_0067]/collectAndWinImprovements", "head_sha": "d7401a2516d32bc5a125bbdd26b42639924118de", "additions": 270, "deletions": 179, "changed_files": 10, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-10-02T23:11:21Z", "updated_at": "2025-10-06T15:54:33Z", "merged_at": "2025-10-06T15:54:32Z", "closed_at": "2025-10-06T15:54:32Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2475", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/match3d#483", "repo_id": "harmonygames-Games/match3d", "number": 483, "title": "ZOM-554: Quiting level mid tornado boost breaks the object physics", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Cancel tornado coroutine before quitting to prevent no gravity on following levels\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **Bug Fixes**\n  * Tornado booster now cleanly stops when exiting settings, preventing lingering effects and visuals.\n  * Game physics reliably restore to normal after the tornado booster ends or is canceled, avoiding abnormal object behavior.\n  * Improved shutdown flow to prevent stuck boosters and potential performance or performance-impacting issues when quitting settings.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "5000fe26be2dc22679a52b599de88d9d8df6c920", "head_ref": "[PERSON_NAME_0067]/zom-554", "head_sha": "49dd4a9a38056a58ee95d9af515d87b99c97b5b3", "additions": 156, "deletions": 58, "changed_files": 3, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-10-02T23:30:10Z", "updated_at": "2025-10-06T15:55:23Z", "merged_at": "2025-10-06T15:55:23Z", "closed_at": "2025-10-06T15:55:23Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2478", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/match3d#486", "repo_id": "harmonygames-Games/match3d", "number": 486, "title": "ZOM-586: Change Backgrounds In the Game", "state": "closed", "merged": false, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": null, "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n- New Features\n  - The game now selects a random alternative background at start for added visual variety.\n  - Infinite boss levels use a dedicated infinite background while other backgrounds are disabled to prevent overlap.\n  - Added new parallax background themes: Beach, Cave, Desert, Port, and Winter for richer environments.\n  - Graceful handling when no alternative backgrounds are configured, ensuring consistent visuals.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "4057cc418ae267eee787ef1354addd8ffc5af236", "head_ref": "[PERSON_NAME_0067]/zom-586", "head_sha": "28a0a4766bb5dadb5eb8ce6580bfa36a21a8e89b", "additions": 728, "deletions": 5, "changed_files": 8, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-10-06T23:39:54Z", "updated_at": "2025-10-10T01:04:02Z", "merged_at": null, "closed_at": "2025-10-10T01:04:01Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2479", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/match3d#487", "repo_id": "harmonygames-Games/match3d", "number": 487, "title": "ZOM-562: Orphan items in boss arena", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "- Ensure min quantity of items spawned in endless mode\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n- New Features\n  - Endless Mode now enforces a minimum spawn count of three items per set during refills, ensuring more consistent item availability and preventing overly sparse spawns.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "397b807bf9375105dd43e8be5bebc6e28985f486", "head_ref": "[PERSON_NAME_0067]/eng-562", "head_sha": "841c47e9dc7770021afe43c292ba841c02bb8821", "additions": 7, "deletions": 4, "changed_files": 1, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-10-06T23:40:42Z", "updated_at": "2025-10-07T18:43:30Z", "merged_at": "2025-10-07T18:43:30Z", "closed_at": "2025-10-07T18:43:30Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2480", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/match3d#488", "repo_id": "harmonygames-Games/match3d", "number": 488, "title": "ZOM-554: Quiting level mid tornado boost breaks the object physics (Regression)", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "- Stop tornado booster coroutines on retry\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **Bug Fixes**\n  * Fixed an issue where the booster tornado could persist after selecting Retry, affecting the new run. The effect is now reliably cleared during retry to prevent lingering visuals, sounds, or gameplay side effects and improve stability.\n  * Players should now experience a clean reset of power-up effects when restarting, reducing confusion and ensuring consistent difficulty and pacing in subsequent runs.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "12d58ff2ddbc4bd544ddf3738d468510a430df6f", "head_ref": "[PERSON_NAME_0067]/zom-554-reg", "head_sha": "9dfd1628a9f098d0cd747fb1599b8b50b9a2d6eb", "additions": 1, "deletions": 0, "changed_files": 1, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-10-07T00:27:18Z", "updated_at": "2025-10-07T18:44:01Z", "merged_at": "2025-10-07T18:44:00Z", "closed_at": "2025-10-07T18:44:00Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2495", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/match3d#500", "repo_id": "harmonygames-Games/match3d", "number": 500, "title": "ZOM-481: Zombie Health bar persists too long after death", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "PERSON_0003_GITHUB_USERNAME", "body": "- Reduce healthbar delay duration, reduce damage text fade duration\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n- Improvements\n  - Health bars hide faster by default (delay reduced from 0.3s to 0.1s).\n  - Boss health bars now hide sooner (additional delay reduced from +1.5s to +0.5s).\n  - Bars respond quicker when filling and auto-hiding due to updated timing defaults.\n  - Damage visual effects feel snappier: fade-out and scale animations shortened (2.0s to 1.0s), speeding up exit animations.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "12692beb78eb2cde5502685bbc8b9210cc4fbc93", "head_ref": "[PERSON_NAME_0067]/zom-481", "head_sha": "bafb72d0b6320cd314ad70f181223a86fb577b4e", "additions": 5, "deletions": 5, "changed_files": 2, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-10-08T20:22:32Z", "updated_at": "2025-10-10T17:58:30Z", "merged_at": "2025-10-10T17:58:30Z", "closed_at": "2025-10-10T17:58:30Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2498", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/match3d#503", "repo_id": "harmonygames-Games/match3d", "number": 503, "title": "ZOM-567: Endless Mode Core Game VFX", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "PERSON_0003_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **New Features**\n  * Added combo and power sliders to Endless and Infinite Boss mode bars, mirroring existing fill bars for clearer progress feedback and synchronized per-frame.\n\n* **Enhancements**\n  * Power and combo fill visuals now stay in sync with slider values during timers and reductions.\n  * Score/counter text now restarts an animation on update for stronger visual feedback.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "41f390d4c8b405bf9e7f947fdbabd7eeb7e8dbfb", "head_ref": "[PERSON_NAME_0067]/zom-567", "head_sha": "afe8dd01f247194a282318082e6f5b966d89f21e", "additions": 33, "deletions": 8, "changed_files": 5, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-10-08T23:13:46Z", "updated_at": "2025-10-10T20:07:44Z", "merged_at": "2025-10-10T20:07:44Z", "closed_at": "2025-10-10T20:07:44Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2499", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/match3d#504", "repo_id": "harmonygames-Games/match3d", "number": 504, "title": "ZOM-584: Infinite Boss Arena Vfx", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0004_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **New Features**\n  * Introduced a new power/rapid-fire bar in Infinite Boss mode with power buildup, charged state, particle effects, and a manual activation button.\n  * Added a combo multiplier system with timed decay and on-screen feedback.\n  * New debug panel submenu for Infinite Modes with a quick-start option for Infinite Boss mode.\n\n* **UX Improvements**\n  * Zombie progress bar is now hidden during Infinite Boss levels to reduce on-screen clutter and focus attention on the new mechanics.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "b031451fac6e6746397e6fac26d392664be4d1d2", "head_ref": "[PERSON_NAME_0067]/zom-584", "head_sha": "837cea7048a28917802d9ebe028e5739e9e740f6", "additions": 1152, "deletions": 705, "changed_files": 6, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-10-09T00:45:41Z", "updated_at": "2025-10-10T21:48:28Z", "merged_at": "2025-10-10T21:48:27Z", "closed_at": "2025-10-10T21:48:27Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2511", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/match3d#515", "repo_id": "harmonygames-Games/match3d", "number": 515, "title": "ZOM-586: Change Backgrounds In the Game", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n- New Features\n  - Randomized gameplay background selection for varied visuals each session.\n  - Added new parallax background themes: beach, cave, desert, park (fall/summer), winter, and port.\n- Bug Fixes\n  - Prevented background overlap by fully disabling alternative backgrounds when switching to the infinite mode background.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "6d5e165966bb0a446b558e9896fd5d2c48e271d9", "head_ref": "[PERSON_NAME_0067]/zom-586", "head_sha": "b460e2b8452fce740cc7a42b91485ff312d27d8e", "additions": 1721, "deletions": 26, "changed_files": 16, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-10-10T22:50:38Z", "updated_at": "2025-10-10T23:47:03Z", "merged_at": "2025-10-10T23:47:03Z", "closed_at": "2025-10-10T23:47:03Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2518", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/match3d#521", "repo_id": "harmonygames-Games/match3d", "number": 521, "title": "ZOM-615: When the rapid fire starts on boss arena with an active nuke, he nuke is not clickable", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "- Added validation to not include Nuke in Rapid Fire settings\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **Bug Fixes**\n  * Nukes no longer trigger Rapid Fire. They now follow the standard single-use interaction, preventing accidental rapid activation.\n  * Improves control and safety when selecting or deploying a Nuke, especially during fast-paced gameplay.\n  * Aligns Nuke behavior with player expectations for deliberate, one-at-a-time use, reducing unintended actions and improving overall usability.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "697a5bdc322066f846206638c7ce5ba0b81478b8", "head_ref": "[PERSON_NAME_0067]/zom-615", "head_sha": "0a3c62c9e1e4419383966a957462347ee89c2e7c", "additions": 2, "deletions": 1, "changed_files": 1, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-10-14T22:51:28Z", "updated_at": "2025-10-18T01:58:41Z", "merged_at": "2025-10-18T01:58:41Z", "closed_at": "2025-10-18T01:58:41Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2519", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/match3d#522", "repo_id": "harmonygames-Games/match3d", "number": 522, "title": "ZOM-616: Weird outline issues on players name in certain places", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "- Fixed weird artifacts in player names", "base_ref": "main", "base_sha": "697a5bdc322066f846206638c7ce5ba0b81478b8", "head_ref": "[PERSON_NAME_0067]/zom-616", "head_sha": "b0286cf96b4f849cfb8f08ebcc4c7bdf30ffe20a", "additions": 23, "deletions": 3, "chan