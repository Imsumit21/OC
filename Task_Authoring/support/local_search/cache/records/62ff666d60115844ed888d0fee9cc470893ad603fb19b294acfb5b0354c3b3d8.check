ve character map avatar (this will be also used when moving camera)", "base_ref": "develop", "base_sha": "94ac85f5f08c8e2284709323e4ad97d110f52dcd", "head_ref": "[PERSON_NAME_0067]/tutorialUpdates", "head_sha": "5bb8bf03b27bed7734f180c0682a513557eeb923", "additions": 42, "deletions": 8, "changed_files": 4, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["PERSON_0003_GITHUB_USERNAME", "EMPLOYEE_0001_GITHUB_USERNAME"], "created_at": "2024-02-15T23:50:02Z", "updated_at": "2024-02-16T03:04:19Z", "merged_at": "2024-02-16T03:04:19Z", "closed_at": "2024-02-16T03:04:19Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/1248", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/GameOfDominoes#373", "repo_id": "harmonygames-Games/GameOfDominoes", "number": 373, "title": "Fix Tutorial highlight for ice and bomb tiles", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "- Updated DominoBombTile and DominoIceTile to create and add helper gameobjects with colliders\r\n- Updated TutorialManagerHighlight to check for ice tile and bomb tile to use helper colliders", "base_ref": "develop", "base_sha": "706f57fbab0b974c011bc77d83e9b1efeaaff2ee", "head_ref": "[PERSON_NAME_0067]/tutorialUpdates", "head_sha": "3f01f1950309d529cb030c396f3f0000829273f7", "additions": 158, "deletions": 1, "changed_files": 3, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["PERSON_0003_GITHUB_USERNAME", "EMPLOYEE_0001_GITHUB_USERNAME"], "created_at": "2024-02-17T00:06:07Z", "updated_at": "2024-02-17T01:12:26Z", "merged_at": "2024-02-17T01:12:26Z", "closed_at": "2024-02-17T01:12:26Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/1251", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/GameOfDominoes#376", "repo_id": "harmonygames-Games/GameOfDominoes", "number": 376, "title": "BombTile collider resize", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "- Resized DominoBombTile touch collider\r\n- Removed tutorial highlight collider", "base_ref": "develop", "base_sha": "e75b6ed820cc394d26923ffc3330d6bf86260d34", "head_ref": "[PERSON_NAME_0067]/bombTileColliderResize", "head_sha": "80fb230b2e88ec8caba519927aedd5ad111ff194", "additions": 3, "deletions": 54, "changed_files": 2, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["PERSON_0003_GITHUB_USERNAME", "EMPLOYEE_0001_GITHUB_USERNAME"], "created_at": "2024-02-20T18:11:46Z", "updated_at": "2024-02-20T18:33:34Z", "merged_at": "2024-02-20T18:33:34Z", "closed_at": "2024-02-20T18:33:34Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/1254", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/GameOfDominoes#379", "repo_id": "harmonygames-Games/GameOfDominoes", "number": 379, "title": "New Tutorial Actions: LockUI and UnlockUI", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "- LockUI Tutorial Action search for a HarmonyObject given an ObjectId, then check if this component is a HarmonyButton, and if yes, sets Button.Interactable as false, also updates the disabledColor so the UI does not look different on disabled state, and finally creates and add a padlock icon.\r\n- UnlockUI Tutorial Action search for a HarmonyObject given an ObjectId, check if this component is a HarmonyButton, and if yes, sets Button.Interactable to true, also search for PadLock icon child an