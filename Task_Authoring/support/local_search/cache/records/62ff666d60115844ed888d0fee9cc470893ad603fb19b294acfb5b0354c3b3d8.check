f": "master", "base_sha": "e982f29978d38c4fb5dc7688de785b70174027c7", "head_ref": "[PERSON_NAME_0067]/hearts", "head_sha": "2e4df41f71315c0dcfa3ee06eb027c7b6426786b", "additions": 23, "deletions": 33, "changed_files": 2, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0025_GITHUB_USERNAME", "PERSON_0003_GITHUB_USERNAME", "EMPLOYEE_0001_GITHUB_USERNAME"], "created_at": "2024-01-25T18:30:31Z", "updated_at": "2024-02-14T14:38:47Z", "merged_at": "2024-01-25T18:36:57Z", "closed_at": "2024-01-25T18:36:57Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/1184", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/GameOfDominoes#315", "repo_id": "harmonygames-Games/GameOfDominoes", "number": 315, "title": "Advance Tile Combo Fixes", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Fixed the following issues:\r\n\r\n- When there are both ice tile and bomb tile present in a layout I cannot draw a new piece. I can, however, make a match. If there are no available matches, then I can draw. (Please let us know if you need more repro steps)\r\n- There is a glitch in which, if I try to draw after hitting the bomb tile, an animation plays but I don\u2019t get a new draw tile. But if I click again it will allow me to draw.\r\n- When there are both bomb tiles and vanishing tiles present, I can\u2019t draw a tile as my first move. When I try, I get the shaking animation on all the tiles I could have matched.\r\n- Tokens cannot be acquired if they are exploded.\r\n- The Other part of ice tile that isn\u2019t in range of bomb tile stays despite the other half within range being exploded.", "base_ref": "master", "base_sha": "dc0471c42a09c2ffb9303650cf48e9e76e5b2dd5", "head_ref": "[PERSON_NAME_0067]/tileCombo", "head_sha": "e