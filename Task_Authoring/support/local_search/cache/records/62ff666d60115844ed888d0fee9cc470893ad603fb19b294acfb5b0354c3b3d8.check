, "record": {"id": "harmonygames-Games/GameOfDominoes#1879", "repo_id": "harmonygames-Games/GameOfDominoes", "number": 1879, "title": "ENG-2295: Increase Animation Speed by 30% in Nate\u2019s Treasure Hunt P1 Scene", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "- Increased Nates Treasure Hunt animations speed\r\n- Added debug option to test animation speed multipliers\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **New Features**\n  * Added adjustable animation speed controls for treasure hunt animations, including options to increase speed by 30%, 60%, or 90%, or restore normal speed settings.\n  * Animation speed preferences now persist across sessions.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "develop", "base_sha": "1ce6ab412fdb881a4dadf9058e73215e3fd23bf3", "head_ref": "[PERSON_NAME_0067]/ENG-2295", "head_sha": "5fb40083c2609bc8db96eb6ba7eff28949edc27e", "additions": 44, "deletions": 8, "changed_files": 2, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-10-31T01:01:29Z", "updated_at": "2025-11-04T17:07:13Z", "merged_at": "2025-11-04T17:07:12Z", "closed_at": "2025-11-04T17:07:12Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/1005", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/GameOfDominoes#188", "repo_id": "harmonygames-Games/GameOfDominoes", "number": 188, "title": "Map Level Character Token update", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "- Map Level Character Token will show on Next available level instead of last completed l