a", "head_ref": "[PERSON_NAME_0067]/ENG-1285", "head_sha": "83f3413855c8348b1df5f474f2437b85caade4c4", "additions": 209, "deletions": 33, "changed_files": 9, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2024-09-10T20:07:44Z", "updated_at": "2024-09-10T20:26:09Z", "merged_at": "2024-09-10T20:26:09Z", "closed_at": "2024-09-10T20:26:09Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/56", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/GameOfDominoes#1015", "repo_id": "harmonygames-Games/GameOfDominoes", "number": 1015, "title": "ENG-1285: Updated Missing Icons (Files I forgot to include in previous PR)", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "- Added missing changes to Julius and Nathan definitions", "base_ref": "develop", "base_sha": "d4bf17cd28845f2dce8eb0bbdeaf35dae4dcf3a0", "head_ref": "[PERSON_NAME_0067]/missingChanges", "head_sha": "7dec240260de6e5556ff968bad4c3d863eaf9366", "additions": 4, "deletions": 4, "changed_files": 2, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2024-09-10T21:51:22Z", "updated_at": "2024-09-10T23:26:39Z", "merged_at": "2024-09-10T23:26:39Z", "closed_at": "2024-09-10T23:26:39Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/57", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/GameOfDominoes#1016", "repo_id": "harmonygames-Games/GameOfDominoes", "number": 1016, "title": "ENG-1305: Level Lost Pop up allowing players to try again with 0 lives left", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "This issue was not related with +5 but with LevelLostPopup and PlayerData.UpdateLives, the player was being deducted a life on lose, then the LevelLostPopUp shows but the server was not done updating player lives, allowing players to Try Again a level with 0 life. If player managed to win the level, the next level will be blocked due to not having lives to play it, messing up with progression.\r\n\r\nFix:\r\n- Updated DominoGameManager LevelLost to show popup on UpdateLives success callback if UpdateLives is called", "base_ref": "develop", "base_sha": "c251514a7ad1fd01318ca8d29730c8d4fe520795", "head_ref": "[PERSON_NAME_0067]/ENG-1305", "head_sha": "0568609cf22d7c71c5ba987fbc5d357a7b5d4aed", "additions": 13, "deletions": 3, "changed_files": 1, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2024-09-10T22:33:50Z", "updated_at": "2024-09-10T23:31:40Z", "merged_at": "2024-09-10T23:31:40Z", "closed_at": "2024-09-10T23:31:40Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/60", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/GameOfDominoes#1019", "repo_id": "harmonygames-Games/GameOfDominoes", "number": 1019, "title": "submission blocker - mini games with missing symbols unplayable", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "- Prevent ConveyorBelt and MemoryGame to use special symbols", "base_ref": "develop", "base_sha": "14293addb103e83e152e7ddeeee37140d56ae0bb", "head_ref": "[PERSON_NAME_0067]/submissionBlockerSymbolsAndMinigames", "head_sha": "5200bfb7dea0e9e044f8d8c10ef7a26dd7364c17", "additions": 15, "deletions": 5, "changed_files": 3, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2024-09-10T23:58:06Z", "updated_at": "2024-09-11T00:05:00Z", "merged_at": "2024-09-11T00:04:59Z", "closed_at": "2024-09-11T00:04:59Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/63", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/GameOfDominoes#1021", "repo_id": "harmonygames-Games/GameOfDominoes", "number": 1021, "title": "Starting Coin Balance increase to 7500 coins", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "", "base_ref": "develop", "base_sha": "c6c76506f5a24509090bf292bea738a6c2c8e966", "head_ref": "[PERSON_NAME_0067]/startingBalance", "head_sha": "c666190f9056684d09cff9ee478d3e1e1de464d1", "additions": 1, "deletions": 1, "changed_files": 1, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2024-09-11T02:32:35Z", "updated_at": "2024-09-11T12:23:57Z", "merged_at": "2024-09-11T12:23:57Z", "closed_at": "2024-09-11T12:23:57Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/78", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/GameOfDominoes#1035", "repo_id": "harmonygames-Games/GameOfDominoes", "number": 1035, "title": "ENG-1313: Ensure All Bomb Tile Levels include Fire Tiles (NEW LOGIC)", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Proposed Logic by [PERSON_NAME_0055]:\r\nHey, so this is what we're gonna do when the min/max parameter for fire icon does not return a fire icon. If for example the parameter is set as 2-3 and nothing returns\r\nThen we decrease DOWN\r\n2 becomes 1, and if that still doesn't return, then we give up\r\nSo if we start at 4-5, then we try 3, 2, 1, then give up\r\nWe only decrease down and never up. This way hopefully we will get at least 1 fire icon. So players doesn't feel like they're ripped off\r\n\r\nChanges:\r\n- Updated BombTileMechanic GetRepeatedMarkings logic\r\n- Restored Chapter 3 symbol replace lower and upper limit values\r\n- Reverted default symbol replace lower and upper limit on DominoGameManager", "base_ref": "develop", "base_sha": "dfcac3838c901fd7922614491cc7212b265e1788", "head_ref": "[PERSON_NAME_0067]/ENG-1313", "head_sha": "fed21f8709626f2b4195aaa326acb731424497c2", "additions": 40, "deletions": 22, "changed_files": 11, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2024-09-11T21:00:25Z", "updated_at": "2024-09-11T22:28:52Z", "merged_at": "2024-09-11T22:28:52Z", "closed_at": "2024-09-11T22:28:52Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/79", "field": "author_login", "value": "PERSON_5877_GITHUB_USERNAME", "record": {"id": "harmonygames-Games/GameOfDominoes#1036", "repo_id": "harmonygames-Games/GameOfDominoes", "number": 1036, "title": "Submission Blocker - Fix for Fire tile appearing in tutorial Level 1 and other levels without bomb tiles present on board", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "", "base_ref": "develop", "base_sha": "6695c8215bc50269df7656d59bdc17a59ae01f24", "head_ref": "[PERSON_NAME_0067]/fireSymbolNewLogicFix", "head_sha": "79ce70a19c93efaf6740a92caeaadd32b1854bff", "additions": 2, "deletions": 2, "changed_files": 1, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2024-09-12T00:10:53Z", "updated_at": "2024-09-12T00:46:37Z", "merged_at": "2024-09-12T00:46:37Z", "closed_at": "2024-09-12T00:46:37Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer"