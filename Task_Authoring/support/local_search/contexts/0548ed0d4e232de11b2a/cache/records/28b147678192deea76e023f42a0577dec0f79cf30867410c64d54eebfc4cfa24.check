{"signature": "4f7ff900455ce6284d1d1186446b868bfa338eda22e86a979eea8c1a0d4b8cb2", "result": {"checks": {"check": {"scope": {"id": "check", "service": "slack", "file": "messages/C3DD99314033/2025-09.json", "pointer": "", "field": "ts", "values": ["1758277446.760689", "1758277558.989589", "1758638791.811199", "1758721819.413819"]}, "matches": [{"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C3DD99314033/2025-09.json", "pointer": "/5", "field": "ts", "value": "1758277446.760689", "record": {"id": "61b90c743d16828f7459d22caab4a5a0", "ts": "1758277446.760689", "type": "message", "user": "PERSON_6089_SLACK_ID", "text": "\u2611 In the lock state, the default green bottles are visible, but when I activate the event, the bottles update to the color of that day\u2019s event item. The bottle visuals should be updated as soon as the game starts based on the event color of the day, and this change should be reflected everywhere. :warning:", "channel": "C3DD99314033", "thread_ts": "1758277446.760689", "reply_count": 1, "reply_users_count": 1, "latest_reply": "1758277480.440839", "is_activity_message": false, "subtype": "document_comment_root", "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C3DD99314033/2025-09.json", "pointer": "/7", "field": "ts", "value": "1758277558.989589", "record": {"id": "e60f766e41126c8a8833409bfa5f969d", "ts": "1758277558.989589", "type": "message", "user": "PERSON_6089_SLACK_ID", "text": "\u2611 Even though the event duration was more than 2 days, I collected Tokens, but when I returned to the main menu it had switched to a different event. The progress was not reset. The event was renewed, but I\u2019m not sure whether the timer and progress weren\u2019t reset, or if something else happened.:warning:", "channel": "C3DD99314033", "thread_ts": "1758277558.989589", "reply_count": 1, "reply_users_count": 1, "latest_reply": "1758277587.840819", "is_activity_message": false, "subtype": "document_comment_root", "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C3DD99314033/2025-09.json", "pointer": "/51", "field": "ts", "value": "1758638791.811199", "record": {"id": "9c6b669d4e4ffd724e370c62bf254052", "ts": "1758638791.811199", "type": "message", "user": "PERSON_6089_SLACK_ID", "text": "\u2611 It resets on its own without waiting for its timer. ", "channel": "C3DD99314033", "thread_ts": "1758638791.811199", "reply_count": 1, "reply_users_count": 1, "latest_reply": "1758638838.058979", "is_activity_message": false, "subtype": "document_comment_root", "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C3DD99314033/2025-09.json", "pointer": "/55", "field": "ts", "value": "1758721819.413819", "record": {"id": "955be2f6614a862941b4a7ea40d51c4b", "ts": "1758721819.413819", "type": "message", "user": "PERSON_6089_SLACK_ID", "text": "\u2611 The rewards given are decreasing the inventory instead of increasing it:warning: ", "channel": "C3DD99314033", "thread_ts": "1758721819.413819", "reply_count": 3, "reply_users_count": 1, "latest_reply": "1758722167.997319", "is_activity_message": false, "subtype": "document_comment_root", "reactions": [], "files": [], "attachments": []}}], "records_checked": 81, "files_selected": 1, "files_completed": 1, "scan_complete": true, "errors": []}}, "files_read_this_call": 2, "sources": [{"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C3DD99314033/2025-09.json", "manifest_sha256": "79e0306988688bcfd666532eaf98ca14d77aaac3b5bdfbf069a79fc603a5216b", "freshness": "da66c3ec95982a46546621bd91621ae2f86699ee460fd976c31fbe019f19595d"}], "scan_complete": true, "persona_filtered": false, "backend": "grouped-record-scan", "scope_note": "Exact direct fields in selected arrays. No SQL is applied. Absence/uniqueness is supported only within complete declared scopes. Manifest hashes are declared provenance, not fresh full-content hashes."}, "checksum": "77321af20ca3e12a4fc130645ad7af3714b457844bb925e98a5e493b49d22fbe"}