{"signature": "41510ec94af7e38733bac7f2ff4e807b2f00583bbaf40b1bc044954352a314f2", "result": {"checks": {"check": {"scope": {"id": "check", "service": "github", "file": "data.json", "pointer": "/pull_requests", "field": "id", "values": ["harmonygames-Games/match3d#468", "harmonygames-Games/match3d#470", "harmonygames-Games/match3d#472", "harmonygames-Games/match3d#477"]}, "matches": [{"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2458", "field": "id", "value": "harmonygames-Games/match3d#468", "record": {"id": "harmonygames-Games/match3d#468", "repo_id": "harmonygames-Games/match3d", "number": 468, "title": "Collect And Win", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **New Features**\n  * Added \"Collect & Win\" live event: collect tokens in levels, track progress, claim stage rewards and a grand prize; main screen, progress widget, info panel, stage/prize items, and level-end token display.\n\n* **Improvements**\n  * Tokens spawn in unlocked levels, persist on level win, can be saved/claimed; new VFX/animations and reward-screen queuing.\n\n* **Developer Tools**\n  * Debug panel options to add tokens and reset event data; new backend requests to support the flow.\n\n* **Chores**\n  * Added sprites, prefabs, materials and asset metadata for the event.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "f5c0bb3a977a2d9b4e6b9559cd382d65548cb6c0", "head_ref": "[PERSON_NAME_0067]/winAndCollect", "head_sha": "648e2c7b9c1d9e263f4b43a45e135ba9fa6002fd", "additions": 54216, "deletions": 32, "changed_files": 127, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-26T20:16:25Z", "updated_at": "2025-09-29T16:13:50Z", "merged_at": "2025-09-29T16:13:50Z", "closed_at": "2025-09-29T16:13:50Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2461", "field": "id", "value": "harmonygames-Games/match3d#470", "record": {"id": "harmonygames-Games/match3d#470", "repo_id": "harmonygames-Games/match3d", "number": 470, "title": "Collect And Win minor bugs fixes", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Fixes:\r\n* When the page opened, it shows placeholder images at first.\r\n* After level completion, it first shows placeholder icon and progress for the event, then shows the correct one\r\n* In every level, I got two errors both backend and client. \r\n* In Boss arena and endless mode, the c&w UI is visible. \n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n- Refactor\n  - Collect & Win screens now use pooled UI items for faster loading, smoother scrolling, reduced flicker, improved ordering and cleanup when refreshing content.\n- New Features\n  - Auto-scrolls to the first unclaimed reward/grand prize when opening the screen.\n  - Reward and grand-prize items now reflect claimed state (labels hidden for claimed stages).\n- Bug Fixes\n  - Next Reward icon visibility corrected based on event lock.\n  - Token counter/panel shown only when relevant (avoids Endless/Infinite Boss modes).\n  - UI elements remain hidden until data/initialization to prevent brief flashes.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "88879d8bb88eef8203be592f5189a76d17f3b782", "head_ref": "[PERSON_NAME_0067]/winAndCollectMinorBugs", "head_sha": "4935e9483a95d78b3a58d18794bacd97816787e8", "additions": 166, "deletions": 33, "changed_files": 10, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-29T21:22:50Z", "updated_at": "2025-09-30T15:51:15Z", "merged_at": "2025-09-30T15:51:15Z", "closed_at": "2025-09-30T15:51:15Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2463", "field": "id", "value": "harmonygames-Games/match3d#472", "record": {"id": "harmonygames-Games/match3d#472", "repo_id": "harmonygames-Games/match3d", "number": 472, "title": "Implement Win&Collect into Queue Manager", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0003_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Implement Win&Collect into Queue Manager\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **Bug Fixes**\n  * Prevents premature progression during reward animations by waiting for Collect & Win status when available.\n  * Reduces unnecessary delays, improving responsiveness and shortening input-block time after rewards.\n  * Adds a timeout guard to avoid stalls if visual effects don\u2019t complete promptly.\n\n* **Refactor**\n  * Streamlined reward VFX flow with clearer, coroutine-driven sequencing.\n  * Exposed an explicit method to trigger Collect & Win status checks, allowing more precise timing with UI updates and effects.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "88879d8bb88eef8203be592f5189a76d17f3b782", "head_ref": "[PERSON_NAME_0029]/ImplementQueueManager", "head_sha": "1e446a5726619a7f165f2ed7a50a4bf46fe4f42d", "additions": 36, "deletions": 21, "changed_files": 3, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["PERSON_5877_GITHUB_USERNAME"], "created_at": "2025-09-29T22:36:36Z", "updated_at": "2025-09-30T15:53:04Z", "merged_at": "2025-09-30T15:53:04Z", "closed_at": "2025-09-30T15:53:04Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2468", "field": "id", "value": "harmonygames-Games/match3d#477", "record": {"id": "harmonygames-Games/match3d#477", "repo_id": "harmonygames-Games/match3d", "number": 477, "title": "Collect And Win Analytics and title change", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n- New Features\n  - App emits and tracks Collect & Win start and reward-claimed events (includes event duration, stage, and reward details).\n- Improvements\n  - Total event duration now computed from explicit start and end times for more accurate reporting.\n  - Screens update and report timing consistently across flows.\n- Bug Fixes\n  - Initial color/state corrected to avoid an unintended default on load.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "166dc182aad2c6de4df28992268ea65e9600754a", "head_ref": "[PERSON_NAME_0067]/collectAndWinAnalytics", "head_sha": "8544a28e108d2c870f1bd5b961e235ed566830df", "additions": 97, "deletions": 13, "changed_files": 9, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-30T22:26:30Z", "updated_at": "2025-10-02T16:44:58Z", "merged_at": "2025-10-02T16:43:03Z", "closed_at": "2025-10-02T16:43:03Z", "html_url": null}}], "records_checked": 2629, "files_selected": 1, "files_completed": 1, "scan_complete": true, "errors": []}}, "files_read_this_call": 4, "sources": [{"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "manifest_sha256": "d35cbcc83ffe5c3bc1a07052843dc96ecbc2d91630784a944b8eae8433d8c0cd", "freshness": "9d7b451a6e539599e0732e983c0b533019b0260e92ec9c372a249b6f651c5c3d"}], "scan_complete": true, "persona_filtered": false, "backend": "grouped-record-scan"