es"}, {"target": "ENG-2303", "type": "relates"}, {"target": "ENG-2305", "type": "relates"}, {"target": "ENG-2302", "type": "relates"}, {"target": "ENG-2301", "type": "relates"}], "is_archived": true, "created_at": "2025-03-25T19:16:28Z", "updated_at": "2025-06-16T12:10:20Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2170", "field": "id", "value": "ENG-2240", "record": {"id": "ENG-2240", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": null, "creator_id": "usr_cd7849ec043ab3da", "state_id": "Canceled", "cycle_id": null, "identifier": "ENG-2240", "number": 2240, "title": "Web interface for the liveops calendar", "description": "It will be nice to have a web interface to check/update the currently scheduled events. Basically an interface similar to this: [ENG-2238](https://linear.app/harmonygames-games/issue/ENG-2238/change-event-scheduler-rules-for-live-ops-events)", "priority": 4, "estimate": null, "due_date": null, "started_at": null, "completed_at": null, "canceled_at": "2025-11-05T22:01:56Z", "archived_at": null, "time_in_status_minutes": 143852, "labels": ["Server/Cloud"], "links": [], "relations": [{"target": "ENG-2238", "type": "relates"}], "is_archived": false, "created_at": "2025-03-25T19:18:02Z", "updated_at": "2025-11-05T22:01:56Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2173", "field": "id", "value": "ENG-2243", "record": {"id": "ENG-2243", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_PERSON_3138", "creator_id": "usr_PERSON_3138", "state_id": "Done", "cycle_id": null, "identifier": "ENG-2243", "number": 2243, "title": "Improve API tooling for GoD", "description": "* Format and lint\n* Update CDK", "priority": 0, "estimate": null, "due_date": null, "started_at": "2025-03-26T22:41:47Z", "completed_at": "2025-03-28T18:20:20Z", "canceled_at": null, "archived_at": "2025-09-29T02:18:36Z", "time_in_status_minutes": 463754, "labels": ["Server/Cloud"], "links": [], "relations": [], "is_archived": true, "created_at": "2025-03-26T22:41:47Z", "updated_at": "2025-03-28T18:20:20Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2174", "field": "id", "value": "ENG-2244", "record": {"id": "ENG-2244", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_PERSON_3138", "creator_id": "usr_PERSON_3138", "state_id": "Done", "cycle_id": null, "identifier": "ENG-2244", "number": 2244, "title": "Update Season Pass rewards", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": "2025-03-28T18:21:02Z", "completed_at": "2025-03-28T23:18:17Z", "canceled_at": null, "archived_at": "2025-09-29T02:18:36Z", "time_in_status_minutes": 463456, "labels": ["Server/Cloud"], "links": [], "relations": [], "is_archived": true, "created_at": "2025-03-28T18:21:02Z", "updated_at": "2025-03-28T23:18:17Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2175", "field": "id", "value": "ENG-2245", "record": {"id": "ENG-2245", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_PERSON_3138", "creator_id": "usr_PERSON_3138", "state_id": "Done", "cycle_id": null, "identifier": "ENG-2245", "number": 2245, "title": "Add new bot implementation to First Try / Axe Arena event", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": "2025-04-01T21:33:54Z", "completed_at": "2025-04-01T21:34:08Z", "canceled_at": null, "archived_at": "2025-10-02T02:20:07Z", "time_in_status_minutes": 457800, "labels": ["Server/Cloud"], "links": [], "relations": [], "is_archived": true, "created_at": "2025-03-28T20:52:03Z", "updated_at": "2025-04-01T21:34:08Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2176", "field": "id", "value": "ENG-2246", "record": {"id": "ENG-2246", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_PERSON_3138", "creator_id": "usr_PERSON_3138", "state_id": "Canceled", "cycle_id": null, "identifier": "ENG-2246", "number": 2246, "title": "Refactor Season Pass rewards", "description": "The idea is to use the new \"parse function\" to transform the special items that the client expects", "priority": 4, "estimate": null, "due_date": null, "started_at": null, "completed_at": null, "canceled_at": "2025-10-16T20:42:32Z", "archived_at": null, "time_in_status_minutes": 172732, "labels": ["Server/Cloud"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-03-28T23:18:12Z", "updated_at": "2025-10-16T20:42:32Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2177", "field": "id", "value": "ENG-2247", "record": {"id": "ENG-2247", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_PERSON_3138", "creator_id": "usr_PERSON_3138", "state_id": "Done", "cycle_id": null, "identifier": "ENG-2247", "number": 2247, "title": "Fix bots' `timeInterval` implementation", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": "2025-03-28T23:18:50Z", "completed_at": "2025-04-01T01:44:10Z", "canceled_at": null, "archived_at": "2025-10-01T02:22:04Z", "time_in_status_minutes": 458990, "labels": ["Server/Cloud"], "links": [], "relations": [], "is_archived": true, "created_at": "2025-03-28T23:18:50Z", "updated_at": "2025-04-01T01:44:10Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2179", "field": "id", "value": "ENG-2249", "record": {"id": "ENG-2249", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-2241", "assignee_id": "usr_caafeec2804b3a67", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-2249", "number": 2249, "title": "Leaderboard is broken if I don't end up top 5", "description": "Version or date: android 1554\n\n### Description: \n\nWhen the leaderboard timer expired, there is a constant null reference causing FPS drop if I didn't finish the event top 5. \n\nBasically, there are many problems caused at the same time if I'm not top 5 \n\n1. Constant null reference causing FPS drop and stuttering\n2. Continue button doesn't spawn\n3. The next session doesn't start - it always shows \"expired\"\n4. Other bots profile is starting to get \"yellow\" like they're my player. \n\n[console.firebase.google.com](https://console.firebase.google.com/project/domino-delights/crashlytics/app/android:com.harmonygames.dominodelights/issues/7eea2d3e9c0b6691722ac79ecd2d9025?time=last-twelve-hours&types=crash&sessionEventKey=67EA9E6F0271000212C86AE00F810865_[CREDIT_CARD_NUMBER_6127])\n\n### Visual References:\n\n[Record_[CREDIT_CARD_NUMBER_6126]_64875109357c738d09c3691cefc5a1e4.mp4]([URL_52217])\n\n### Expected Outcome: is to revert back changes to the old version for that or fixing the null ref. \n\nIt should show continue button with no error and clicking on continue button should end that session and start the newer leaderboard. \n\n### Steps to Repro:\n\n1. Open leaderboard menu after the event timer is expired\n2. Make sure you're not top 5. \n3. Then observe the constant null reference.\n   1. No continue button", "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2025-05-01T10:50:15Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 415244, "labels": ["Submission Blocker", "Bug"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-03-31T14:23:27Z", "updated_at": "2025-05-01T10:50:15Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2180", "field": "id", "value": "ENG-225", "record": {"id": "ENG-225", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "EPI-9", "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-225", "number": 225, "title": "Rotational Snap and Grid Snap Buggy", "description": "The rotational snap and grid align is a bit buggy.\n\nRotational snap resets for some reason here and there.\n\nSnap to grid seems to only have resolution of 2 grids sometimes instead of 1 grid, so it was hard to get symmetry in my attempt.\n\n[GameOfDominoes - PuzzlePipeline - Windows, Mac, Linux - Unity 2021.3.21f1 Personal \\_DX11\\_ [CREDIT_CARD_NUMBER_1057].mp4]([URL_49905])", "priority": 0, "estimate": null, "due_date": null, "started_at": "2023-09-28T21:01:55Z", "completed_at": "2023-10-17T00:39:12Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1225135, "labels": ["Puzzle Editor", "Bug"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-09-27T00:31:21Z", "updated_at": "2023-10-17T00:39:12Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2183", "field": "id", "value": "ENG-2252", "record": {"id": "ENG-2252", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Canceled", "cycle_id": null, "identifier": "ENG-2252", "number": 2252, "title": "Wild tiles are not matching as with two sides - it matches with only 1 side.", "description": "Version or date: Dev_iOS_1378, Dev_Android_1561,\n\n### Description: \n\nThe wildtiles (any kind of both gold and diamond tiles) are not matching the tiles with two sides available. Instead, it selects a side and I can only match with the selected side. \n\nIt happens in core game and river tile as well. \n\n### Visual References:\n\n[ScreenRecording_[CREDIT_CARD_NUMBER_6131]_1.MP4]([URL_52222])\n\n[ScreenRecording_[CREDIT_CARD_NUMBER_6130]_1.MP4]([URL_52221])\n\n### Expected Outcome: is to make the tiles available with 2 sides after matching them with gold tiles in both core game and river tile. \n\n### Steps to Repro:\n\n1. Use gold tile \n2. Match a tile\n3. Observe that only 1 side is visible and matchable.", "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": null, "canceled_at": "2025-04-21T18:52:05Z", "archived_at": null, "time_in_status_minutes": 429162, "labels": ["Cappadocia", "Bug"], "links": [], "relations": [{"target": "ENG-2257", "type": "duplicates"}], "is_archived": false, "created_at": "2025-04-01T16:04:22Z", "updated_at": "2025-04-21T18:52:05Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2184", "field": "id", "value": "ENG-2253", "record": {"id": "ENG-2253", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_PERSON_3138", "creator_id": "usr_PERSON_3138", "state_id": "Done", "cycle_id": null, "identifier": "ENG-2253", "number": 2253, "title": "Fix issue for Axe Arena where more than 49 bots are created", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": "2025-04-01T21:34:03Z", "completed_at": "2025-04-02T18:37:04Z", "canceled_at": null, "archived_at": "2025-10-03T02:16:36Z", "time_in_status_minutes": 456537, "labels": ["Server/Cloud", "Bug"], "links": [], "relations": [], "is_archived": true, "created_at": "2025-04-01T18:39:32Z", "updated_at": "2025-04-02T18:37:04Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2185", "field": "id", "value": "ENG-2254", "record": {"id": "ENG-2254", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_PERSON_3138", "creator_id": "usr_PERSON_3138", "state_id": "Done", "cycle_id": null, "identifier": "ENG-2254", "number": 2254, "title": "Debug issue where River Rush stage is not finished", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": "2025-04-02T07:53:43Z", "completed_at": "2025-04-03T21:52:42Z", "canceled_at": null, "archived_at": "2025-10-04T02:15:52Z", "time_in_status_minutes": 454902, "labels": ["Server/Cloud"], "links": [], "relations": [], "is_archived": true, "created_at": "2025-04-01T18:40:09Z", "updated_at": "2025-04-03T21:52:42Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2188", "field": "id", "value": "ENG-2257", "record": {"id": "ENG-2257", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Todo", "cycle_id": null, "identifier": "ENG-2257", "number": 2257, "title": "Change Diamond Tiles matching only 1 side.", "description": "The diamond tiles are the \"wildtiles\" that are spawning in the deck. \n\nEvery wildtile except the in-game boost and Julius' board tile conversion ability is diamond tile right now. \n\nSo diamond tile mechanic should be updated like the vide below. When the diamond tile is matched with any tile in the board. Instead of matching them with both sides, it should select a random symbol to match. So the tile matched should stay as vertical. \n\n[ScreenRecording_[CREDIT_CARD_NUMBER_6132]_1.MP4]([URL_52225])\n\nThis scenario would create better sense of boosts. Since they are different in gameplay and visuals, would be better to differentiate more. It would also increase the efficiency of in-game boost which will make it more appealing for players. \n\nHere is the list of all diamond tiles:\n\n1. Prelevel dialogue booster\n2. Every timed wildtile boost\n3. Sophie's favor 3rd reward\n4. Character abilities\n   1. Sophie\n      1. 5-streak after level 10\n   2. Nate\n      1. 6-streak from 1-10\n   3. Julius\n      1. passive at level 40\n5. In app purchases containing timed boosts.", "priority": 3, "estimate": null, "due_date": null, "started_at": null, "completed_at": null, "canceled_at": null, "archived_at": null, "time_in_status_minutes": 456736, "labels": ["DD 2.1", "Feature"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-04-02T15:18:29Z", "updated_at": "2025-10-27T14:15:19Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2190", "field": "id", "value": "ENG-2259", "record": {"id": "ENG-2259", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_PERSON_3138", "creator_id": "usr_cd7849ec043ab3da", "state_id": "Done", "cycle_id": null, "identifier": "ENG-2259", "number": 2259, "title": "Update weekly leaderboard bots to use the new system", "description": null, "priority": 3, "estimate": null, "due_date": null, "started_at": "2025-04-03T16:27:33Z", "completed_at": "2025-04-14T16:45:31Z", "canceled_at": null, "archived_at": "2025-10-15T02:50:02Z", "time_in_status_minutes": 439369, "labels": ["Server/Cloud"], "links": [], "relations": [], "is_archived": true, "created_at": "2025-04-03T16:27:33Z", "updated_at": "2025-04-14T16:45:31Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2192", "field": "id", "value": "ENG-2260", "record": {"id": "ENG-2260", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_cd7849ec043ab3da", "creator_id": "usr_cd7849ec043ab3da", "state_id": "Done", "cycle_id": null, "identifier": "ENG-2260", "number": 2260, "title": "Update the alltime leadeboard player names on prod", "description": null, "priority": 2, "estimate": null, "due_date": null, "started_at": "2025-04-03T16:28:29Z", "completed_at": "2025-04-11T23:07:48Z", "canceled_at": null, "archived_at": "2025-10-12T02:50:37Z", "time_in_status_minutes": 443306, "labels": ["Server/Cloud"], "links": [], "relations": [], "is_archived": true, "created_at": "2025-04-03T16:28:29Z", "updated_at": "2025-04-11T23:07:48Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2199", "field": "id", "value": "ENG-2267", "record": {"id": "ENG-2267", "project_id": null, "team_id": "team_ENG", "parent_id": "ENG-2262", "assignee_id": "usr_caafeec2804b3a67", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-2267", "number": 2267, "title": "Missing Translation Texts from Nate's Treasure Hunt", "description": "* Info Pop Up\n  * \"Nate's Treasure Hunt\" header\n  * \"Grand Prize\"\n  * \"All aboard for treasure Hunt! Complete seven levels without losing to claim your prize!\"\n  * \"Let's Go!\" button.\n\n    ![IMG_2213.PNG]([URL_52267])\n* Event Screen \n  * \"Nate's Treasure Hunt\" header\n  * Stage progress\n    * \"Stage {2}/3\"\n  * \"Levels:\"\n  * \"Players:\"\n  * \"Grand Prize\"\n  * \"Tap to Continue\"\n\n    ![IMG_2190.PNG]([URL_52266])\n* Event Tooltip\n  * \"Nate's Treasure Hunt\" header\n  * \"Join The Treasure Hunt\"\n  * \"Beat seven levels on your first try!\"\n  * \"Get your share of the spoils!\"\n  * \"Tap Anywhere to Continue\"\n\n    ![IMG_2191.PNG]([URL_52265])\n* Reward / Stage Completion Screen\n  * Above Part\n    * \"Nate's Treasure Hunt\" header\n    * \"Congratulations!\" header\n    * \"Stage {1} Completed\" header\n  * Reward Part\n    * \"Grand Prize\"\n    * \"You Win:\"\n  * Bottom Part\n    * \"You are sharing the Reward with other winners\"\n    * \"Tap to Claim and Start Next Stage\"\n\n      ![IMG_2217.PNG]([URL_52264])\n* Stage Progression on event icon\n  * \"Stage {2} - 0/7\"\n\n    ![IMG_2186.PNG]([URL_52263])", "priority": 1, "estimate": null, "due_date": null, "started_at": "2025-04-08T15:47:12Z", "completed_at": "2025-04-24T15:05:17Z", "canceled_at": null, "archived_at": "2025-10-25T03:03:33Z", "time_in_status_minutes": 425069, "labels": [], "links": [], "relations": [], "is_archived": true, "created_at": "2025-04-04T17:26:12Z", "updated_at": "2025-04-24T15:05:17Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2202", "field": "id", "value": "ENG-227", "record": {"id": "ENG-227", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-39", "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-227", "number": 227, "title": "Puzzle Bot Data Result Output and Level Data Output", "description": "We are attempting to have the puzzle bot \"rank\" our levels in terms of difficulty and \"streakiness\" of the levels.\n\nAs discussed, the basic level data we first want to have via designer inputs are:\n\n![image.png]([URL_49909])\n\nWe have most of these already. Parent child ratio and generational depth ratio info is found here:\n\n![image.png]([URL_49908])\n\nOnce we have information regarding the levels and along with designer inputs, we utilize our bot to play the levels to output the following like data:\n\n![image.png]([URL_49907])\n\nAfter the bot plays the level hundreds of times, we observe the average:\n\n![image.png]([URL_49906])\n\nWith both the inputs and output data, the designer can now optimize for win rate and streakiness of level, providing that the bot's playing algorithm is very close to what a typical player would do.\n\nThis task will most likely be broken into further sub tasks.", "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-01-03T07:02:08Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1112432, "labels": ["Bot"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-09-28T00:22:20Z", "updated_at": "2024-01-03T07:02:08Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2208", "field": "id", "value": "ENG-2275", "record": {"id": "ENG-2275", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_cd7849ec043ab3da", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Todo", "cycle_id": null, "identifier": "ENG-2275", "number": 2275, "title": "Dashboard for players' compentsation", "description": "What we need as something a dashboard where we can manipulate what is stored on the players' profile. \n\nAt first we should be able to detect any given player from the user-id. We need a search bar for user-ids. \n\nWe should be able to add/remove the currencies for those players. \n\nMark/unmark any tutorial that player has on their FTUE.", "priority": 4, "estimate": null, "due_date": null, "started_at": null, "completed_at": null, "canceled_at": null, "archived_at": null, "time_in_status_minutes": 445180, "labels": ["Server/Cloud", "Pupusa"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-04-10T15:53:51Z", "updated_at": "2025-05-05T18:33:15Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2211", "field": "id", "value": "ENG-2278", "record": {"id": "ENG-2278", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_PERSON_3138", "creator_id": "usr_cd7849ec043ab3da", "state_id": "Done", "cycle_id": null, "identifier": "ENG-2278", "number": 2278, "title": "Weekly leaderboard bots: debug score ranking sorting", "description": null, "priority": 3, "estimate": null, "due_date": null, "started_at": "2025-04-14T16:45:35Z", "completed_at": "2025-04-14T23:21:44Z", "canceled_at": null, "archived_at": "2025-10-15T02:50:03Z", "time_in_status_minutes": 438973, "labels": ["Server/Cloud"], "links": [], "relations": [], "is_archived": true, "created_at": "2025-04-11T23:09:23Z", "updated_at": "2025-04-14T23:21:45Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2216", "field": "id", "value": "ENG-2282", "record": {"id": "ENG-2282", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": null, "creator_id": "usr_cd7849ec043ab3da", "state_id": "Canceled", "cycle_id": null, "identifier": "ENG-2282", "number": 2282, "title": "Update NodeJS lambda runtime", "description": "![Screenshot 2025-04-15 at 09.56.58.png]([URL_52289])", "priority": 4, "estimate": null, "due_date": null, "started_at": null, "completed_at": null, "canceled_at": "2025-10-24T20:56:38Z", "archived_at": null, "time_in_status_minutes": 161198, "labels": ["Server/Cloud"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-04-15T15:58:30Z", "updated_at": "2025-10-24T20:56:38Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2217", "field": "id", "value": "ENG-2283", "record": {"id": "ENG-2283", "project_id": null, "team_id": "team_ENG", "parent_id": "ENG-2239", "assignee_id": "usr_PERSON_3138", "creator_id": "usr_PERSON_3138", "state_id": "Done", "cycle_id": null, "identifier": "ENG-2283", "number": 2283, "title": "POC for Lives Bank using Nakama", "description": null, "priority": 3, "estimate": null, "due_date": null, "started_at": "2025-04-15T20:52:30Z", "completed_at": "2025-04-21T17:30:08Z", "canceled_at": null, "archived_at": "2025-12-17T04:38:30Z", "time_in_status_minutes": 429244, "labels": ["Server/Cloud"], "links": [], "relations": [], "is_archived": true, "created_at": "2025-04-15T20:52:17Z", "updated_at": "2025-04-21T17:30:08Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2218", "field": "id", "value": "ENG-2284", "record": {"id": "ENG-2284", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-2284", "number": 2284, "title": "Missing Letter & Symbols List", "description": "'+++ ## ~~All tutorial texts,~~\n\n![image.png]([URL_52336])\n\n![image.png]([URL_52335])\n\n![image.png]([URL_52334])\n\n![image.png]([URL_52333])\n\n+++\n\n+++ ## ~~Shop and Purchase-Related,~~\n\n* ~~In the shop,~~\n  * ~~section headers~~\n  * ~~free text on free 500 coins~~\n  * ~~\"5 left\" on lives~~\n\n    ![image.png]([URL_52332])\n  * \u00a0~~pack offer names~~\n  * ~~\"at start\" text~~\n\n    ![Screenshot_[CREDIT_CARD_NUMBER_6160]-95_64875109357c738d09c3691cefc5a1e4.jpg]([URL_52331])\n\n    ![image.png]([URL_52330])\n* ~~Pop up offers~~\n  * ~~All pop up offer names~~\n\n    ![image.png]([URL_52329])\n  * ~~\"Don't show the offer within 24 hours\" text below~~\n\n    ![image.png]([URL_52328])\n  * ~~\"Purchase failed\" or \"Purchase Success\" text~~\n\n    ![Screenshot_[CREDIT_CARD_NUMBER_6159]-90_64875109357c738d09c3691cefc5a1e4.jpg]([URL_52327])\n\n    ![Screenshot_[CREDIT_CARD_NUMBER_6158]-27_64875109357c738d09c3691cefc5a1e4.jpg]([URL_52326])\n* ~~OOM screen enchanted pack names~~\n\n  ![image.png]([URL_52325])\n\n+++\n\n+++ ## In saga map & others,\n\n* ~~Event unlock texts~~\n  * ~~Bonus text on hourly collection button.~~\n\n    ![Screenshot_[CREDIT_CARD_NUMBER_6157]-45_64875109357c738d09c3691cefc5a1e4.jpg]([URL_52324])\n\n\n* ~~Sign in in the settings~~\n\n  ![image.png]([URL_52323])\n* ~~Loading text on the loading screen~~\n\n  ![image.png]([URL_52322])\n* Daily gift chest tooltip\n\n  ![image.png]([URL_52321])\n* ~~Chapter selection star and level completion progress bars~~\n\n  ![image.png]([URL_52320])\n\n+++\n\n+++ ## ~~In prelevel Dialogue,~~\n\n* ~~Diamond tile and extra tile purchase panel headers~~\n\n  ![image.png]([URL_52319])\n\n  ![image.png]([URL_52318])\n* ~~\"Level\" in prelevel dialogue and also retry pop-up~~\n* ~~\"Hard\" or \"Epic\" text on prelevel dialogue and also retry pop-up~~\n\n  ![Screenshot_[CREDIT_CARD_NUMBER_6155]-42_64875109357c738d09c3691cefc5a1e4.jpg]([URL_52317])\n\n+++\n\n+++ ## ~~In win screen,~~\n\n* ~~Level text in~~\n* ~~Reward tooltips~~\n* ~~and milestone previews~~\n\n  ![Screenshot_[CREDIT_CARD_NUMBER_6154]-43_64875109357c738d09c3691cefc5a1e4.jpg]([URL_52316])\n\n+++\n\n+++ ## ~~In board scene,~~\n\n* ~~All level objective tooltips~~ \n\n  ![Screenshot_[CREDIT_CARD_NUMBER_6153]-03_64875109357c738d09c3691cefc5a1e4.jpg]([URL_52315])\n\n+++\n\n+++ ## ~~In avatar screen,~~\n\n* ~~\"You have 3 chances to change your name\"~~\n\n  ![image.png]([URL_52314])\n* ~~\"At least 3 characters\"~~\n\n  ![image.png]([URL_52313])\n* ~~\"Forbidden word\"~~\n* ~~\"You have no chances left\"~~\n\n  ![image.png]([URL_52312])\n\n+++\n\n+++ ## In Events and Live ops,\n\n* ~~In river rush,~~\n  * ~~\"Stage\"~~\n  * ~~\"Beat the 5 levels faster text\"~~\n  * ~~Target chapter and level info~~\n\n    ![image.png]([URL_52311])\n* ~~Win and collect event names~~\n\n  ![Screenshot_[CREDIT_CARD_NUMBER_6152]-02_64875109357c738d09c3691cefc5a1e4.jpg]([URL_52310])\n\n  ![image.png]([URL_52309])\n* ~~Nate's booty~~\n  * ~~Stage \"text\"~~\n\n    ![image.png]([URL_52308])\n  * ~~\"Stage completed\" text on win screen~~\n\n    ![image.png]([URL_52307])\n  * ~~\"Stage\" text on event icon~~\n\n    ![Screenshot_[CREDIT_CARD_NUMBER_6151]-45_64875109357c738d09c3691cefc5a1e4.jpg]([URL_52306])\n* ~~\"Claim\" text on axe arena event icon.~~\n\n  ![image.png]([URL_52305])\n* Streak Fever\n  * event screen description\n\n    ![image.png]([URL_52304])\n\n+++\n\n+++ ## ~~In Character selection screen,~~\n\n* ~~Char \"level\" text~~\n\n  ![image.png]([URL_52303])\n* ~~\"at lvl\" text on abilities~~\n* ~~all ability tooltips~~\n\n  ![image.png]([URL_52302])\n\n+++\n\n+++ ## ~~In leaderboard,~~\n\n* ~~leaderboard task description (changes weekly like complete levels or collect stars)~~\n\n  ![image.png]([URL_52301])\n* ~~All record names~~\n\n  ![image.png]([URL_52300])\n  * ~~all record headers in their leaderboard~~\n\n    ![image.png]([URL_52299])\n\n+++\n\n+++ ## In Minigames and Hub,\n\n* In Tile Dozer Char Abilities\n  * All ability name and their descriptions\n\n    ![Screenshot_[CREDIT_CARD_NUMBER_6150]-29_64875109357c738d09c3691cefc5a1e4.jpg]([URL_52298])\n\n    ![Screenshot_[CREDIT_CARD_NUMBER_6149]-08_64875109357c738d09c3691cefc5a1e4.jpg]([URL_52297])\n\n    ![Screenshot_[CREDIT_CARD_NUMBER_6148]-25_64875109357c738d09c3691cefc5a1e4.jpg]([URL_52296])\n\n    ![Screenshot_[CREDIT_CARD_NUMBER_6147]-09_64875109357c738d09c3691cefc5a1e4.jpg]([URL_52295])\n\n    ![Screenshot_[CREDIT_CARD_NUMBER_6146]-63_64875109357c738d09c3691cefc5a1e4.jpg]([URL_52294])\n* ~~\"Full\" text on minigame hub~~\n\n  ![image.png]([URL_52293])\n* ~~Memory game win screen~~\n  * ~~header~~\n  * ~~score~~\n  * ~~personal best~~\n  * ~~rewards~~\n  * ~~home~~\n  * ~~replay~~\n\n    ![image.png]([URL_52292])\n\n+++\n\n+++ ## ~~In Quests,~~\n\n* ~~All quest chest tooltips~~\n\n  ![Screenshot_[CREDIT_CARD_NUMBER_6144]-74_64875109357c738d09c3691cefc5a1e4.jpg]([URL_52291])\n* ~~FTUE Quests descriptions~~\n\n  ![Screenshot_[CREDIT_CARD_NUMBER_6143]-91_64875109357c738d09c3691cefc5a1e4.jpg]([URL_52290])\n\n+++", "priority": 1, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2025-04-24T12:55:09Z", "canceled_at": null, "archived_at": "2025-10-25T03:03:33Z", "time_in_status_minutes": 425205, "labels": ["Bug"], "links": [], "relations": [], "is_archived": true, "created_at": "2025-04-16T12:12:28Z", "updated_at": "2025-04-24T12:55:09Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2229", "field": "id", "value": "ENG-2294", "record": {"id": "ENG-2294", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-2294", "number": 2294, "title": "Update Rotating Shop Slot 4 to Show Correct Star Amount (20 Stars for 100 Gems)", "description": "**Description:**\nCurrently, the fourth slot in the rotating shop does not display the correct star amount. It should offer **20 stars** in exchange for **100 gems 5 times a day**.\n\n**Expected Behavior:**\n\n* The **fourth slot** in the rotating shop should:\n  * Display **20 stars**\n  * Cost **100 gems**\n  * Show the correct icon and quantity in both the shop UI and the purchase confirmation popup", "priority": 1, "estimate": null, "due_date": null, "started_at": "2025-04-21T18:32:25Z", "completed_at": "2025-04-22T16:02:49Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 427891, "labels": ["Global Launch"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-04-18T17:29:36Z", "updated_at": "2025-04-22T16:02:49Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2233", "field": "id", "value": "ENG-2298", "record": {"id": "ENG-2298", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_cd7849ec043ab3da", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-2298", "number": 2298, "title": "Ladybug Harvest (3-day win&collect event) gives 15m infinite lives after every level completion", "description": "Version or date: ios 141 submission\n\n### Description: \n\nThe friday-to-sunday win & collect event lasting 3 days is broken because it always reset to the first stage and after every level completed, it gives 15-min infinite lives over and over again.\n\nIt doesn't happen on 2-day events, only present in the 3-day event. I don't know if it's completely backend or combination of both.  \n\n### Visual References:\n\n[ScreenRecording_[CREDIT_CARD_NUMBER_6166]_1.MP4]([URL_52356])\n\n### Expected Outcome: is to continue to next stage after completing the first stage just like other win&collect events. \n\n### Steps to Repro:\n\n1. Wait for friday\n2. Play a level\n3. Observe that 15-min infinite lives are granted\n4. Play another level\n5. Observe that stage is reset to 1 and 15-min infinite lives are granted", "priority": 1, "estimate": null, "due_date": null, "started_at": "2025-04-29T03:27:57Z", "completed_at": "2025-04-29T16:55:10Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 417759, "labels": ["Bug"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-04-21T10:53:20Z", "updated_at": "2025-04-29T16:55:10Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2238", "field": "id", "value": "ENG-2301", "record": {"id": "ENG-2301", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_cd7849ec043ab3da", "creator_id": "usr_PERSON_3138", "state_id": "Canceled", "cycle_id": null, "identifier": "ENG-2301", "number": 2301, "title": "Deployment for Nakama server", "description": "* Deploy a Nakama server instance to our AWS infrastructure. Using CDK if possible.\n* Tune the corresponding server parameters. Docs: [[URL_52376])", "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": null, "canceled_at": "2025-12-16T22:28:24Z", "archived_at": null, "time_in_status_minutes": 84786, "labels": ["Server/Cloud", "Teams", "Cookie"], "links": [], "relations": [{"target": "ENG-2239", "type": "relates"}], "is_archived": false, "created_at": "2025-04-21T17:20:57Z", "updated_at": "2025-12-16T22:28:24Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/2239", "field": "id", "value": "ENG-2302", "record": {"id": "ENG-2302", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_PERSON_3138", "creator_id": "usr_PERSON_3138", "state_id": "Done", "cycle_id": null, "identifier": "ENG-2302", "number": 2302, "title": "Setup token validation on Nakama using Go modules", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": "2025-04-21T17:33:44Z", "completed_at": "2025-06-16T12:05:48Z", "canceled_at": null, "archived_at": "2025-12-17T04:38:29Z", "time_in_status_minutes": 348928, "labels": ["Server/Cloud", "Cookie"], "links": [], "relations": [{"target": "ENG-2239", "type": "relates"}], "is_archived": true, "created_at": "2025-04-21T17:21:58Z", "