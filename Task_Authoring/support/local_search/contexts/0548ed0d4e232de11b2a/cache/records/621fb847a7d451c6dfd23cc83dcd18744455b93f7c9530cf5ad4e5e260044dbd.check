"ENG-449", "ENG-455", "ENG-463", "ENG-464", "ENG-465", "ENG-478", "ENG-48", "ENG-481", "ENG-491", "ENG-494", "ENG-515", "ENG-524", "ENG-525", "ENG-553", "ENG-578", "ENG-584", "ENG-586", "ENG-591", "ENG-592", "ENG-606", "ENG-625", "ENG-633", "ENG-634", "ENG-635", "ENG-658", "ENG-661", "ENG-679", "ENG-680", "ENG-681", "ENG-700", "ENG-704", "ENG-714", "ENG-757", "ENG-766", "ENG-786", "ENG-809", "ENG-847", "ENG-848", "ENG-849", "ENG-850", "ENG-851", "ENG-852", "ENG-853", "ENG-854", "ENG-855", "ENG-856", "ENG-862", "ENG-863", "ENG-864", "ENG-865", "ENG-866", "ENG-871", "ENG-882", "ENG-886", "ENG-911", "ENG-926", "ENG-940", "ENG-960", "ENG-961", "ENG-966", "ENG-98", "ENG-981", "ENG-983", "ENG-984", "ENG-985", "ENG-986", "ENG-987", "ENG-988", "ENG-99", "ENG-994", "EPI-10", "EPI-14", "EPI-16", "EPI-2", "EPI-24", "EPI-25", "EPI-9", "ZOM-123", "ZOM-161", "ZOM-162", "ZOM-174", "ZOM-189", "ZOM-231", "ZOM-25", "ZOM-252", "ZOM-253", "ZOM-254", "ZOM-282", "ZOM-297", "ZOM-30", "ZOM-325", "ZOM-330", "ZOM-345", "ZOM-35", "ZOM-350", "ZOM-354", "ZOM-372", "ZOM-377", "ZOM-378", "ZOM-385", "ZOM-387", "ZOM-389", "ZOM-398", "ZOM-419", "ZOM-424", "ZOM-431", "ZOM-436", "ZOM-442", "ZOM-444", "ZOM-456", "ZOM-457", "ZOM-46", "ZOM-47", "ZOM-472", "ZOM-475", "ZOM-49", "ZOM-495", "ZOM-499", "ZOM-51", "ZOM-510", "ZOM-52", "ZOM-531", "ZOM-542", "ZOM-545", "ZOM-548", "ZOM-549", "ZOM-552", "ZOM-556", "ZOM-566", "ZOM-567", "ZOM-574", "ZOM-579", "ZOM-582", "ZOM-584", "ZOM-59", "ZOM-592", "ZOM-620", "ZOM-621", "ZOM-636", "ZOM-647", "ZOM-648", "ZOM-651", "ZOM-661", "ZOM-69", "ZOM-77", "ZOM-83", "ZOM-84", "ZOM-85", "ZOM-86", "ZOM-87", "ZOM-88", "ZOM-89", "ZOM-90"]}, "matches": [{"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/115", "field": "id", "value": "ART-280", "record": {"id": "ART-280", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ART", "parent_id": null, "assignee_id": "usr_c77c50cc15c5342d", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ART-280", "number": 280, "title": "Character Animation Events When Game Ends", "description": "We need to specify how and where the character appears when the game ends in a victory/failed condition.\n\nIt should be like this:\n\n1. When game ends (win/lose), the character on bottom left of the screen will transition out via VFX, either puff of smoke, or stage exit left.\n2. Once the character exits, it appears in the foreground as the end screen comes up. The character will enter stage either via puff of smoke (similar as exit), or from bottom of screen rising up.\n3. Character does win or lose animation. (Happy or sad)", "priority": 3, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2023-11-13T18:04:12Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1185210, "labels": ["Main Game", "VFX&SOUNDS"], "links": [], "relations": [{"target": "ART-271", "type": "relates"}], "is_archived": false, "created_at": "2023-10-27T19:16:44Z", "updated_at": "2024-03-06T22:39:47Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/178", "field": "id", "value": "ART-346", "record": {"id": "ART-346", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ART", "parent_id": null, "assignee_id": "usr_c77c50cc15c5342d", "creator_id": "usr_Robert", "state_id": "Canceled", "cycle_id": null, "identifier": "ART-346", "number": 346, "title": "ART > GAMEPLAY > IMPROVED ICE TILE AND VANISHING TILE", "description": "The ice tile look is a bit \"flat\"\n\nThe number on vanishing tile looks too small to be legible to see what's going on.\n\nWhat can we do to polish and improve the looks of both these tiles?", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-01-03T06:10:46Z", "completed_at": null, "canceled_at": "2024-03-05T21:42:03Z", "archived_at": null, "time_in_status_minutes": 1022272, "labels": ["Submission Blocker", "Improvement", "GAMEPLAY", "3D ART"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-01-03T06:10:46Z", "updated_at": "2024-03-05T21:42:03Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/195", "field": "id", "value": "ART-375", "record": {"id": "ART-375", "project_id": null, "team_id": "team_ART", "parent_id": "ART-253", "assignee_id": "usr_c77c50cc15c5342d", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ART-375", "number": 375, "title": "ART: VFX>GAMEPLAY>END LEVEL CHARACTER VFX IMPROVEMENTS", "description": "The \"Smoke\" animation needs to be improved. We actually don't want a smoke.\n\nWe want to discover a way for character to transition from bottom left of the screen, to center of the screen for the end card\n\n* the end cards", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-02-07T13:30:46Z", "completed_at": "2024-03-19T15:58:12Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1002456, "labels": ["VFX Integration", "Characters", "CHARACTER", "Sprint 13 - March 15th", "Improvement", "UNITY INTEGRATION"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-01-24T03:00:07Z", "updated_at": "2024-03-19T15:58:12Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/317", "field": "id", "value": "ART-508", "record": {"id": "ART-508", "project_id": null, "team_id": "team_ART", "parent_id": null, "assignee_id": "usr_Robert", "creator_id": "usr_51f5f16d46e8cf55", "state_id": "Canceled", "cycle_id": null, "identifier": "ART-508", "number": 508, "title": "Implement Local Push Notification System and Analytics Tracking on Android and IOS > UI", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-03-06T11:37:14Z", "completed_at": null, "canceled_at": "2024-10-20T08:15:36Z", "archived_at": "2025-04-21T07:35:27Z", "time_in_status_minutes": 693319, "labels": [], "links": [], "relations": [], "is_archived": true, "created_at": "2024-03-06T11:37:02Z", "updated_at": "2024-10-20T08:15:36Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/328", "field": "id", "value": "ART-519", "record": {"id": "ART-519", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ART", "parent_id": null, "assignee_id": "usr_c77c50cc15c5342d", "creator_id": "usr_c77c50cc15c5342d", "state_id": "Done", "cycle_id": null, "identifier": "ART-519", "number": 519, "title": "Strake new symbol animations", "description": "[newStreakAnimationBottomUI.mp4]([URL_50100])\n\nI've modified the bottom symbol animation and now we have an aditional ui element that comes from somewere on the right and take the place of the next reward one", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-03-14T19:10:15Z", "completed_at": "2024-03-14T19:10:38Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 913118, "labels": ["VFX Integration", "Sprint 13 - March 15th", "Improvement", "UNITY INTEGRATION"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-03-14T19:10:15Z", "updated_at": "2024-05-20T16:56:26Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/387", "field": "id", "value": "ART-580", "record": {"id": "ART-580", "project_id": null, "team_id": "team_ART", "parent_id": null, "assignee_id": "usr_c77c50cc15c5342d", "creator_id": "usr_Victor Barnes", "state_id": "Done", "cycle_id": null, "identifier": "ART-580", "number": 580, "title": "Cinemic tutorial improvements (FTUE)", "description": "[StandardTileCinematic037.mp4]([URL_50312])\n\nFixed the tutorial cinematic to suit the new UI at the bottom.\n\nAlso the elements like prefabs and animations are now a clone so they can be switch between the dots version and the standard tile one.", "priority": 1, "estimate": null, "due_date": null, "started_at": "2024-05-22T09:16:40Z", "completed_at": "2024-05-22T14:40:40Z", "canceled_at": null, "archived_at": "2025-05-05T08:10:27Z", "time_in_status_minutes": 671164, "labels": [], "links": [], "relations": [], "is_archived": true, "created_at": "2024-05-13T16:24:37Z", "updated_at": "2024-11-04T17:30:20Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/411", "field": "id", "value": "ART-605", "record": {"id": "ART-605", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ART", "parent_id": null, "assignee_id": "usr_617cbfeb7298338c", "creator_id": "usr_c77c50cc15c5342d", "state_id": "Todo", "cycle_id": null, "identifier": "ART-605", "number": 605, "title": "Julius ingame corner position animations", "description": "![image.png]([URL_50380])\n\nBecause we changed the bottom UI\n\n![image.png]([URL_50379])\n\nWe would like to make the character to hold the staff in his right hand but holding it more in front se its not hidden like in my example.\n\nWe will need to update all the animations that are hapening at the bottom corner, Animation like lose and win it should not be afected as they are big in the middle of the screen and they are not obstructing nothing\n\nAlso we need to keep in mind this safe frame for the next characters that we are going to build.", "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": null, "canceled_at": null, "archived_at": null, "time_in_status_minutes": 891469, "labels": ["ANIMATION"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-06-04T17:45:24Z", "updated_at": "2024-06-04T17:45:24Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/415", "field": "id", "value": "ART-609", "record": {"id": "ART-609", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ART", "parent_id": "ART-577", "assignee_id": "usr_7fe31e7ec8199618", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ART-609", "number": 609, "title": "Various 3D objects that can be dropped on the game board", "description": "The list of objects are under the \"3D\" section in the GDD, but they are copy pasted here for convenience and tracking purpose.\n\n- [X] Oval Shaped Tiles - These are the only objects that players can drop in the entire game, any other objects are dropped or spawned onto the board by chance, or they appear through a user-initiated power-up.\n- [X] Jumbo Tiles - These are large size tiles with 4 icons on them, the moment they hit the platform, the entire game board will shake, possibly sending objects into various pits.\n- [X] Hero Tokens - These are the same as the main game, a material required for users to upgrade their character levels. They spawn by chance or appear as a result of a triggered event from the main Dominoes Delights game.\n- [X] Gold Tiles - These are the same as the main game, a tile that can be saved in a player\u2019s inventory that can be used in the main Dominoes Delights game, they also appear by chance or as a result of a triggered event from the main Dominoes Delights game.\n- [X] Bomb Tiles - These spawn by % chance, the % chance is tweakable through hero levels from the main game. When a fire token is pushed into the bottom pit, a random bomb tile on the board explodes, blowing nearby pieces in all directions.\n- [X] Fire Tokens - These spawn randomly whenever a bomb tile spawns. Bomb tiles and fire tokens effectively spawn as a pair on the board. When they are pushed into the bottom pit, they ignite a bomb tile on the game board.\n- [X] Jumbo Tile Token - These are a token representation of the jumbo tile. When they are collected in the bottom pit, an actual jumbo tile will drop onto the board at the tile drop area. The potency of this effect depends on certain hero levels from the main game.\n- [X] Tile Shower Token - These are a token representation of the tile shower power-up. When they are collected in the bottom pit, a tile shower happens. The potency of this effect depends on certain hero levels from the main game.\n- [X] Castle Walls Token - These are a token representation of the castle walls power-up. When they are collected in the bottom pit, a pair of castle walls rises for a brief period on the left and right pit of the game board. The duration of this effect depends on certain hero levels from the main game.\n- [X] Gems - Hard currency of the game, appears by chance.\n- [X] Stars - Upgrading currency of the game, appears by chance.\n- [ ] New Circular Tokens - These are the main tokens used in Plinko and tile dozer, purple on both sides.", "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-08-19T16:23:32Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 782111, "labels": ["Sprint 19 - June 14th", "CONCEPT", "Mini Game"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-06-06T21:29:39Z", "updated_at": "2024-08-19T16:23:32Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/438", "field": "id", "value": "ART-633", "record": {"id": "ART-633", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ART", "parent_id": null, "assignee_id": "usr_c77c50cc15c5342d", "creator_id": "usr_c77c50cc15c5342d", "state_id": "Done", "cycle_id": null, "identifier": "ART-633", "number": 633, "title": "Tile Animations", "description": "We want to make the animations more smooth and have more Harmony Games in them, we want them to be less robotic and have more of a curve path.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-07-16T13:45:35Z", "completed_at": "2024-11-04T09:19:18Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 671655, "labels": ["Sprint 21 Baklava - Aug 2nd", "VFX Integration", "Improvement", "VFX&SOUNDS"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-07-16T13:45:35Z", "updated_at": "2024-11-04T09:19:18Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/440", "field": "id", "value": "ART-635", "record": {"id": "ART-635", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ART", "parent_id": "ART-633", "assignee_id": "usr_c77c50cc15c5342d", "creator_id": "usr_c77c50cc15c5342d", "state_id": "Done", "cycle_id": null, "identifier": "ART-635", "number": 635, "title": "Tile From Deck to Hand Animation", "description": "Right now its too robotic, we would like this to be smooth as well to have a nice curve to it and some bounce at the end.", "priority": 3, "estimate": null, "due_date": null, "started_at": "2024-10-28T13:38:02Z", "completed_at": "2024-11-04T09:19:07Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 671655, "labels": ["Sprint 21 Baklava - Aug 2nd", "VFX Integration", "Improvement", "VFX&SOUNDS"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-07-16T13:49:40Z", "updated_at": "2024-11-04T09:19:07Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/460", "field": "id", "value": "ART-655", "record": {"id": "ART-655", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ART", "parent_id": "ART-609", "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_7fe31e7ec8199618", "state_id": "In Review", "cycle_id": null, "identifier": "ART-655", "number": 655, "title": "Objects Implementation to Game", "description": "'- [X] Bomb tile - Bomb tile needs to be like an in game tile, fuse lit, sits on board.\n- [X] Fire token should be a circular tile with silver SHIMMERING borders. Both sides are the fire symbol. Fire fly partiles\n- [X] Gold tile - Just our wildcard tile, should shimmer like in game.\n- [X] Jumbo tile token - circular token with jumbo tile symbol on it, both sides, silver shimmering border, some fire fly particles\n- [X] Tile shower token - same as jumbo token\n- [X] Castle wall token - same as jumbo token\n- [X] Gems - shimmer sweep\n- [X] Stars - 3D star, glow\n- [X] Coin - 3D coin from the game, shimmers, fire fly VFX.\n- [X] Hero token - What does this look like again? Same routine with the other \"tokens\". Shimmer if metallic, slight fire fly VFX.\n- [X] RoundTile same as Pinko, 1 side texture\n\nPlease do not over do the VFX, fire fly are subtle. Shimmers are also subtle. Less is more.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-08-19T08:52:08Z", "completed_at": "2024-08-19T16:39:59Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 782094, "labels": ["VFX Integration", "VFX&SOUNDS", "Mini Game"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-08-01T09:14:31Z", "updated_at": "2024-09-17T04:36:18Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/464", "field": "id", "value": "ART-659", "record": {"id": "ART-659", "project_id": null, "team_id": "team_ART", "parent_id": null, "assignee_id": "usr_51f5f16d46e8cf55", "creator_id": "usr_51f5f16d46e8cf55", "state_id": "Done", "cycle_id": null, "identifier": "ART-659", "number": 659, "title": "River Tile & Memory Tile info button and infographic screens", "description": "1. Adding an info buttons in both games + changing the header in River Tile game to achieve it\n2. Designing an info graphical explanation of the gameplay for both games", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-08-07T09:54:28Z", "completed_at": "2024-09-04T08:39:14Z", "canceled_at": null, "archived_at": "2025-03-05T07:20:18Z", "time_in_status_minutes": 759535, "labels": [], "links": [], "relations": [], "is_archived": true, "created_at": "2024-08-07T09:54:28Z", "updated_at": "2024-09-04T08:39:14Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/515", "field": "id", "value": "ART-710", "record": {"id": "ART-710", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ART", "parent_id": null, "assignee_id": "usr_Victor Barnes", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ART-710", "number": 710, "title": "Icons needed for mile stone preview at end game screen", "description": "We are missing 2:\n\nDomino Chest feature\n\nQuest feature\n\nBoth are milestone icons used at end game screen.", "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-10-02T16:50:36Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 718724, "labels": ["2D ART", "Baklava Hot Fix"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-09-17T16:50:46Z", "updated_at": "2024-10-02T16:50:36Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/535", "field": "id", "value": "ART-73", "record": {"id": "ART-73", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ART", "parent_id": "EPI-2", "assignee_id": null, "creator_id": "usr_Victor Barnes", "state_id": "Team Epic", "cycle_id": null, "identifier": "ART-73", "number": 73, "title": "ART: LIVE OPS", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": null, "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1323756, "labels": ["LIVE OPS", "Monetization"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-08-09T12:58:22Z", "updated_at": "2023-08-10T22:51:18Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/539", "field": "id", "value": "ART-733", "record": {"id": "ART-733", "project_id": null, "team_id": "team_ART", "parent_id": null, "assignee_id": "usr_51f5f16d46e8cf55", "creator_id": "usr_51f5f16d46e8cf55", "state_id": "Done", "cycle_id": null, "identifier": "ART-733", "number": 733, "title": "[Live Ops] Win Streak quest - Nathans Treasure Hunt", "description": null, "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-10-18T11:15:47Z", "completed_at": "2025-01-21T16:31:13Z", "canceled_at": null, "archived_at": "2025-10-25T03:03:32Z", "time_in_status_minutes": 558903, "labels": [], "links": [], "relations": [], "is_archived": true, "created_at": "2024-10-18T11:15:47Z", "updated_at": "2025-01-21T16:31:13Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/542", "field": "id", "value": "ART-736", "record": {"id": "ART-736", "project_id": null, "team_id": "team_ART", "parent_id": null, "assignee_id": "usr_51f5f16d46e8cf55", "creator_id": "usr_51f5f16d46e8cf55", "state_id": "Done", "cycle_id": null, "identifier": "ART-736", "number": 736, "title": "Live Ops - End Game", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-10-24T09:17:15Z", "completed_at": "2025-02-12T09:08:28Z", "canceled_at": null, "archived_at": "2025-08-13T02:10:20Z", "time_in_status_minutes": 527666, "labels": [], "links": [], "relations": [], "is_archived": true, "created_at": "2024-10-24T09:17:15Z", "updated_at": "2025-02-12T09:08:28Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/549", "field": "id", "value": "ART-742", "record": {"id": "ART-742", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ART", "parent_id": null, "assignee_id": "usr_c77c50cc15c5342d", "creator_id": "usr_c77c50cc15c5342d", "state_id": "Done", "cycle_id": null, "identifier": "ART-742", "number": 742, "title": "free Ads popup and icon", "description": "We need a popup with hammer and AD cracked\n\n[fiveCrackheads001.mp4]([URL_51607])\n\nWe also need icon for it with animation\n\n[FreeAdsicon001.mp4]([URL_51606])", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-11-11T12:17:12Z", "completed_at": "2024-11-14T10:05:41Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 657209, "labels": ["VFX Integration", "LIVE OPS", "ANIMATION", "Sprint 26 Nova - Nov 22nd"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-11-11T12:17:12Z", "updated_at": "2024-11-14T10:05:41Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/578", "field": "id", "value": "ART-770", "record": {"id": "ART-770", "project_id": null, "team_id": "team_ART", "parent_id": null, "assignee_id": "usr_c77c50cc15c5342d", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ART-770", "number": 770, "title": "River Rush VFXs and Animations", "description": "We need a couple of animations and VFXs for the river rush event for both the ships and the icons etc. I will list the animations chronologically. \n\n1. **INFINITE LIVES FLOATING ANIMATION**\n   1. The infinite lives floating to the life count. Once the event is activated, we're gonna show the infinite lives as a reward just like in any screen we do. After claiming it, the infinite lives are gonna float to life area. We might have that animation but if not we can have something similar to coins animations. \n\n      [Record_[CREDIT_CARD_NUMBER_6047]_7e28f8a8ee1b9c59216f5058661095af.mp4]([URL_52034])\n2. **MINOR ICON ANIMATION AFTER LEVEL WIN** \n   1. After level completion and returning to the saga map, the event icon should have a small animation just to emphasize something changed in the event. Take this video for instance, they use the drill machine and merges into the icon with a cool animation in 00:07. But I think we can use something like just rotating the wheel in our icon and merging it to the icon. \n\n      ![image.png]([URL_52033])\n\n      [Record_[CREDIT_CARD_NUMBER_6046]_7e28f8a8ee1b9c59216f5058661095af.mp4]([URL_52032])\n3. **SHIP IDLE ANIMATION**\n   1. Ships should have small idle animation where it just floats above the river with some circular splash. Look at the second half of the video for instance. Apart from movement animation, they have a small idle animation like just rotating drill. So we can have a small waving animation for the ships as well as small splash from the ship. \n\n      [Record_[CREDIT_CARD_NUMBER_6045]_7e28f8a8ee1b9c59216f5058661095af.mp4]([URL_52031])\n4. **SHIP MOVEMENT ANIMATION**\n   1. Ships movement will be considered as a progress bar but they will move continuously and smoothly. So the ship movement will be like a smoothed progress bar. But we also need a splash animation in the back of the ship to show that ships are moving forward. \n\n      [Record_[CREDIT_CARD_NUMBER_6045]_7e28f8a8ee1b9c59216f5058661095af.mp4]([URL_52030])\n5. **RACE WIN - COIN ANIMATION**\n   1. Once the race is over, a player's ship will pass the cross line and become invisible. When the race is over, we can show coins from the side like a confetti. Just like how they did in mine dash but we are gonna use it horizontal - from right side towards left. \n\n      [Record_[CREDIT_CARD_NUMBER_6044]_7e28f8a8ee1b9c59216f5058661095af.mp4]([URL_52029])", "priority": 0, "estimate": null, "due_date": null, "started_at": "2025-02-26T10:21:36Z", "completed_at": "2025-05-12T09:11:57Z", "canceled_at": null, "archived_at": "2025-11-13T04:04:43Z", "time_in_status_minutes": 399502, "labels": ["VFX Integration", "Cappadocia", "Sprint 30 Cappadocia -  Feb 28th"], "links": [], "relations": [{"target": "ENG-2197", "type": "relates"}], "is_archived": true, "created_at": "2025-01-30T13:50:54Z", "updated_at": "2025-05-12T09:11:57Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/597", "field": "id", "value": "DES-10", "record": {"id": "DES-10", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "DES-24", "assignee_id": "usr_Robert", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-10", "number": 10, "title": "List VFX and Animations needed for Characters", "description": "1) Where: In main gameplay, character on bottom left. When: Character ability is triggered. What: Character on bottom left partially turn towards the game board (maybe just head and partially torso) and cast a spell.\n\n2) Where: In main game play, character on bottom left. When: Player wins the level. What: Character does a small victory dance or some form of happy expression. (Fist pump, clap, cheer, etc. Something that can be used for both genders)\n\n3) Where: In main game play, character on bottom left. When: Player loses a level. What: Character does a sad frown or some form of sad expression.\n\n4) Where: In main game play, character on bottom left. When: Players staring at the game board with no action taken What: Something as simple as just eyeball movement or twiddling thumb or hand on chin to think.\n\n5) Where: In main game play, character on bottom left. When: Sophie has a passive ability that adds extra tiles to the draw pile at the beginning of the game. What: Perhaps we can incorporate a spell casting animation with tiles flying from off screen and into the draw pile. We can create a generic animation that features an interaction between the character on the bottom left of the screen, with the pile of tiles in player's hands.", "priority": 2, "estimate": null, "due_date": "2023-09-15", "started_at": "2023-08-03T21:08:11Z", "completed_at": "2023-08-10T17:09:16Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1322065, "labels": ["Characters", "Sprint 4 - September 29th"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-08-03T07:41:33Z", "updated_at": "2023-09-21T04:07:35Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/599", "field": "id", "value": "DES-108", "record": {"id": "DES-108", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": null, "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-108", "number": 108, "title": "Nathan Tutorial", "description": "We need a tutorial for Nathan. When players first get a Nathan token, that's when it will trigger the start of the FTUE specifically for Nathan\n\n1. After they get their first Nathan token, we show them how to unlock\n2. We then make them go to a pre level dialog, and show them how to change character on that dialog\n\nFlow is something like:\n\n1. User receives Nathan token\n2. \"Congrats, I think we have enough to unlock Nathan to help us on our journey, let's go to the character home\"\n3. \"This is how you unlock a new character once you have collected enough tokens!\"\n4. \"Nathan is now unlocked, let's return to our adventure and see what Nathan can do for us!\"\n5. Player gets redirected back to Saga map, we prompt a pre level dialog and we say \"Oh oops, we forgot to actually bring Nathan along for the ride, we can quickly change characters here\"\n6. We show them how to change characters from pre-level dialog.\n7. We make them play a level with Nathan\n8. At beginning of that level, we highlight the streak bar and streak bonus icon on bottom and say \"Remember, different characters have different abilities! Pay attention and see what Nathan can do!\"\n\nEnd tutorial.", "priority": 3, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-06-13T15:05:11Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 878669, "labels": ["FTUE"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-04-22T05:48:39Z", "updated_at": "2024-06-13T15:05:11Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/606", "field": "id", "value": "DES-114", "record": {"id": "DES-114", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": null, "assignee_id": "usr_fc22d5941b2aeb5c", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "DES-114", "number": 114, "title": "Design Tool Improvements", "description": "Some improvements and features we're gonna add to the editor, as time permits.", "priority": 4, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2025-05-05T17:37:14Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 409077, "labels": ["Puzzle Editor"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-06-13T15:24:54Z", "updated_at": "2025-05-05T17:37:14Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/612", "field": "id", "value": "DES-12", "record": {"id": "DES-12", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "ENG-38", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-12", "number": 12, "title": "List all the level parameters and puzzle editor functionality required", "description": "We have a live doc of this here: [[URL_13519])", "priority": 2, "estimate": null, "due_date": null, "started_at": "2023-08-08T13:21:31Z", "completed_at": "2023-08-08T16:36:12Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1322023, "labels": ["Puzzle Editor", "Sprint 1 - August 18th"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-08-04T16:14:46Z", "updated_at": "2023-08-10T17:52:04Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/634", "field": "id", "value": "DES-14", "record": {"id": "DES-14", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "DES-7", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "DES-14", "number": 14, "title": "Add wildcard into conveyor belt mini game", "description": "The conveyor belt mini game should spawn wildcard in addition to tiles needing to be matched.\n\nIf players do not match a wildcard, does the game end when wildcard reaches the bottom?", "priority": 2, "estimate": null, "due_date": "2023-08-08", "started_at": "2023-08-07T16:57:13Z", "completed_at": "2023-08-07T21:44:40Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1324543, "labels": ["Sprint 1 - August 18th", "Mini Game"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-08-04T20:22:13Z", "updated_at": "2023-08-10T20:49:35Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/727", "field": "id", "value": "DES-263", "record": {"id": "DES-263", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": null, "assignee_id": "usr_65c76e0b87aa7e9b", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "DES-263", "number": 263, "title": "[Baklava] Check Localization", "description": "From the design side, we need to make sure tutorial and milestone previews are localized properly. \n\nThe localization is done from a JSON called I2Languages. Joe has a detailed video of how to use it in the tutorial editor channel. If you add something in the milestone preview or change something without engineers please update this document. Please continue my format with localization keys.\n\nFormat: Tutorials_TutorialName_OrderMessage  --> Tutorials_BundleTile_FirstMessage etc.", "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-10-14T18:49:45Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 701325, "labels": ["Tutorial Editor", "Localization"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-08-29T19:56:21Z", "updated_at": "2024-10-14T18:49:45Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/731", "field": "id", "value": "DES-267", "record": {"id": "DES-267", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": null, "assignee_id": "usr_65c76e0b87aa7e9b", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "DES-267", "number": 267, "title": "[Baklava] Tutorials", "description": "Please do a general run both on iOS and Android. [PERSON_NAME_0050] already does an FTUE QA anyway but it pays to do a couple of tutorial runs in the game.", "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-10-14T18:49:21Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 701325, "labels": ["FTUE", "Tutorial Editor"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-08-29T21:04:24Z", "updated_at": "2024-10-14T18:49:21Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/759", "field": "id", "value": "DES-294", "record": {"id": "DES-294", "project_id": null, "team_id": "team_DES", "parent_id": null, "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Canceled", "cycle_id": null, "identifier": "DES-294", "number": 294, "title": "FTUE Improvements", "description": "Organize the alltutorials.json \n~~Chapter 1 end tutorial (input blocker)~~\n~~Vanishing Tile Tutorial (block the deck)~~\n~~Tutorial wishlist (multiple highlight)~~\n~~Enter proper event names~~ \n~~Check all fade boxes~~ \nTutorial editor document \nUpdate tutorial master sheet", "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": null, "canceled_at": "2025-04-29T11:55:10Z", "archived_at": "2025-10-30T03:03:01Z", "time_in_status_minutes": 418059, "labels": [], "links": [], "relations": [], "is_archived": true, "created_at": "2024-10-14T19:00:51Z", "updated_at": "2025-04-29T11:55:10Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/761", "field": "id", "value": "DES-296", "record": {"id": "DES-296", "project_id": null, "team_id": "team_DES", "parent_id": null, "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "In Review", "cycle_id": null, "identifier": "DES-296", "number": 296, "title": "Bot Discussion With Joe", "description": "Finalize the list of features \nRemote Difficulty", "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-10-28T15:49:00Z", "canceled_at": null, "archived_at": "2025-04-29T08:10:21Z", "time_in_status_minutes": 681345, "labels": [], "links": [], "relations": [], "is_archived": true, "created_at": "2024-10-14T19:03:09Z", "updated_at": "2024-10-28T15:49:00Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/780", "field": "id", "value": "DES-33", "record": {"id": "DES-33", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "DES-23", "assignee_id": "usr_Robert", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-33", "number": 33, "title": "Game Bottom UI Functional Requirements", "description": "Currently in our build, the bottom UI looks like this:\n\n![image.png]([URL_13529])\n\nWhen you click on a character, a circular menu appears, while the main screen dims (this dimming is not necessary or needed)\n\n![image.png]([URL_13528])\n\nThere are several outstanding questions regarding the bottom UI that needs further specification and future proofing.\n\n1. How many dominoes in our draw pile can we display? Here we are showing 9 pieces, what happens after 9? The current solution is to display a small number on the top left of the last pile indicating how many pieces are in the pile in total.\n2. Do we think the rewind button is in an optimal position?\n3. Wildcards/dynamite tile buttons will eventually be part of the circular menu and will not have their stand alone floating buttons, this is for testing only.\n4. There are discussion of a character ability that allows for an extra card slot, meaning that the eligible tile to be matched is not just the most recently drawn/matched card, but most recent card - 1 (so last 2 cards can both be matched) If this is the case, how do we prepare ourselves to make room visually for this feature?\n5. How do we want to display inventory of the boosts players have vs. cost of that boost? In the screen shot above the behavior doesn't seem ideal. I think when the players have 0 in their inventory, they should just see a coin cost, but not the count number. When the players have the boost in the inventory, then they should see just the count number, not the cost. Basically we should never be displaying both visually for each boost.", "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2023-10-13T03:36:44Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1230718, "labels": ["Main Game"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-08-10T21:52:24Z", "updated_at": "2023-10-13T03:36:44Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/785", "field": "id", "value": "DES-39", "record": {"id": "DES-39", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "DES-24", "assignee_id": "usr_Robert", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-39", "number": 39, "title": "Upgrading a character UX flow and UI work", "description": "Now that we went with avatar icon on the world saga map instead, how does the transition work when players click the character button on the navigation bottom menu bar?\n\nSome previous work found HERE\n\n![image.png]([URL_13531])\n\n![image.png]([URL_13530])", "priority": 2, "estimate": null, "due_date": "2023-09-06", "started_at": null, "completed_at": "2023-09-08T16:54:20Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1280320, "labels": ["Sprint 3 - September 15th", "Characters", "UI/UX"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-08-11T07:42:15Z", "updated_at": "2023-09-08T16:54:20Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/789", "field": "id", "value": "DES-42", "record": {"id": "DES-42", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "DES-45", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-42", "number": 42, "title": "Record Statistics on Symbols Frequency", "description": "Let's see if there are weights involved with the frequency of each symbols appearing.\n\nGoogle doc [HERE]([URL_13532]) tracking this.", "priority": 0, "estimate": null, "due_date": null, "started_at": "2023-08-11T17:24:29Z", "completed_at": "2023-08-23T04:54:53Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1290398, "labels": ["Puzzle Editor", "Sprint 1 - August 18th"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-08-11T17:24:28Z", "updated_at": "2023-09-04T18:13:41Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/790", "field": "id", "value": "DES-43", "record": {"id": "DES-43", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "EPI-9", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-43", "number": 43, "title": "Design Tasks for Puzzle Editor", "description": null, "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-01-26T17:07:58Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1078706, "labels": ["Puzzle Editor"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-08-11T17:38:13Z", "updated_at": "2024-01-26T17:07:59Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/791", "field": "id", "value": "DES-44", "record": {"id": "DES-44", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "DES-43", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-44", "number": 44, "title": "Create nomenclature on level naming", "description": "How do we want to name the levels in the file output? We want level #, but what else? If it's FTE do we want to label it? If it's boss level/hard level do we want to label it? Let's decide on a naming scheme that captures all the useful information while not overwhelming the name.\n\nMight want to consult with Blake as well.", "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2023-08-16T13:24:48Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1290398, "labels": ["Puzzle Editor"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-08-11T17:44:56Z", "updated_at": "2023-09-01T16:56:17Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/792", "field": "id", "value": "DES-45", "record": {"id": "DES-45", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "DES-43", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-45", "number": 45, "title": "Define parameters needed for the JSON file output", "description": "Star objectives, what's 2 star, 3 star? We need to specify this in JSON\n\nIf we do things other than number of tiles left in draw pile, what are they? Need to define those in the star system design. Need to be unblocked by other ticket first.\n\nDetails in related ticket [HERE](https://linear.app/harmonygames-games/issue/DES-37/star-system-objectives-list)", "priority": 2, "estimate": null, "due_date": "2023-08-18", "started_at": "2023-08-11T19:55:19Z", "completed_at": "2023-08-16T13:27:16Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1310179, "labels": ["Puzzle Editor", "Sprint 1 - August 18th"], "links": [], "relations": [{"target": "DES-37", "type": "blocks"}], "is_archived": false, "created_at": "2023-08-11T17:46:23Z", "updated_at": "2023-08-18T23:15:23Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/801", "field": "id", "value": "DES-54", "record": {"id": "DES-54", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "EPI-6", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-54", "number": 54, "title": "Create the first 10 levels of main game", "description": "Revised to 10 levels because some editor feature isn't robust enough, mostly features involving layering (parent/child).", "priority": 1, "estimate": null, "due_date": "2023-09-01", "started_at": "2023-08-30T17:21:04Z", "completed_at": "2023-09-01T14:17:43Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1290398, "labels": ["Puzzle Editor", "Sprint 2 - September 1st", "Main Game"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-08-18T16:51:10Z", "updated_at": "2023-09-01T16:56:44Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/809", "field": "id", "value": "DES-63", "record": {"id": "DES-63", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "DES-42", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-63", "number": 63, "title": "Create ~5 Test Levels With modified tile weights", "description": "I would say this can be part of the play test on Wednesday, September 13th\n\nDocument of findings can be found [HERE]([URL_13532]), but does not need to be read. See below for test plan.\n\nConclusion:\n\nBoard pieces \u2192 Weighted, approximate distribution from most to least:\n\n| 15.42% |\n| 13.24% |\n| 12.23% |\n| 11.26% |\n| 10.48% |\n| 9.88% |\n| 8.90% |\n| 7.70% |\n| 6.14% |\n| 4.74% |\n\nDraw pile pieces \u2192 Weighted, approximate distribution from most to least:\n\n| 18.75% |\n| 15.42% |\n| 13.13% |\n| 12.29% |\n| 9.79% |\n| 9.38% |\n| 7.71% |\n| 6.46% |\n| 4.58% |\n| 2.50% |\n\nI propose we create a few levels using any level on the map to do the following level tests:\n\n1. The weights of the draw pile matches the weights of the board pieces. With same weights on same symbols.\n2. The weights of the draw pile matches the weights of the board pieces. With different weights on DIFFERENT symbols. Let's try the complete inverse, meaning the heaviest weighted board piece is the least weighted piece in the draw pile and so on\u2026\n3. The weights of the draw pile is equally random, 10% chance per symbol. ZERO weights.\n4. The weights of the draw pile is more concentrated (more skewed) like it is in our data set, where the top frequency of the draw pile exceed those of the board. Matching symbols. We can maybe shift 20% of each weights to the heavier weights. So if A, B, C is 18%, 15%, 12%, then after weight shifted it A is now 18% + (15% \\* 0.2) = 21%\n\n   B is now 12% (3% went to A) + (12% \\* 0.2) = 14.4%\n\n   C is now 9.6% (2.4% went to B) + (D \\* 0.2) = \u2026.\n\n   So on..\n5. The weights of the draw pile is less concentrated, where the top frequency symbol in the draw pile is significantly lower than the frequency of that same symbol in the board pieces. Same as #4 but shift everything to the right by 20%.\n\nOther notes:\n\nEach level has 12 draw pieces, including the starting piece that's already drawn and face up. We need a layout that has \\~24 pieces.\n\nWe can use a same layout we all agree on, I would say on average it should have 3-4 tiles facing up at beginning of the level, maybe @julia.lawson can just use one of her levels.\n\nWe can maybe test this at level 10, 11, 12, 13, 14, 15, to not interfere with other levels we are testing in the first 10 levels.", "priority": 3, "estimate": null, "due_date": "2023-09-22", "started_at": "2023-09-19T05:31:43Z", "completed_at": "2023-10-09T16:07:28Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1235727, "labels": ["Puzzle Engine", "Sprint 4 - September 29th", "Main Game"], "links": [], "relations": [{"target": "DES-52", "type": "relates"}], "is_archived": false, "created_at": "2023-08-23T03:58:50Z", "updated_at": "2023-10-09T16:07:28Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/810", "field": "id", "value": "DES-64", "record": {"id": "DES-64", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "EPI-6", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-64", "number": 64, "title": "Create around ~5 levels testing variations in # of branches and other tweakable parameters in today's puzzle editor.", "description": "As discussed let's create 5 levels maybe 10-14 on the world map by messing with the extreme values on the tweakable parameters in the puzzle editor. For example the # of branches. What happens if we have 0 vs. let's say 6? Go up to 10 levels if we must. We should know behind the scenes what the parameters are set at, and we play test this next Wednesday September 6th middle of sprint 3 and gather feedback on difficulty and feelings from internal people.", "priority": 2, "estimate": null, "due_date": "2023-09-06", "started_at": "2023-09-06T10:51:12Z", "completed_at": "2023-09-06T19:55:11Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1283019, "labels": ["Sprint 3 - September 15th", "Main Game"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-09-01T00:37:54Z", "updated_at": "2023-09-06T19:55:11Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/820", "field": "id", "value": "DES-74", "record": {"id": "DES-74", "project_id": null, "team_id": "team_DES", "parent_id": null, "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "DES-74", "number": 74, "title": "Create a puzzle editor whishlist.", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": "2023-10-09T16:07:52Z", "completed_at": "2023-11-09T16:47:41Z", "canceled_at": null, "archived_at": "2024-05-10T00:58:33Z", "time_in_status_minutes": 1191047, "labels": [], "links": [], "relations": [], "is_archived": true, "created_at": "2023-10-09T16:07:52Z", "updated_at": "2023-11-09T16:47:41Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/821", "field": "id", "value": "DES-75", "record": {"id": "DES-75", "project_id": null, "team_id": "team_DES", "parent_id": null, "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "DES-75", "number": 75, "title": "Fix FF2 layouts.", "description": null, "priority": 1, "estimate": null, "due_date": null, "started_at": "2023-10-09T16:08:28Z", "completed_at": "2023-11-09T16:47:39Z", "canceled_at": null, "archived_at": "2024-05-10T00:58:33Z", "time_in_status_minutes": 1191047, "labels": ["Sprint 5 - October 13th", "Puzzle Editor", "Improvement"], "links": [], "relations": [], "is_archived": true, "created_at": "2023-10-09T16:08:28Z", "updated_at": "2023-11-09T16:47:39Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/826", "field": "id", "value": "DES-81", "record": {"id": "DES-81", "project_id": null, "team_id": "team_DES", "parent_id": null, "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "DES-81", "number": 81, "title": "Clear up puzzle editor whislist", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": "2023-11-09T16:47:55Z", "completed_at": "2023-11-13T08:43:09Z", "canceled_at": null, "archived_at": "2024-05-14T00:56:34Z", "time_in_status_minutes": 1185771, "labels": [], "links": [], "relations": [], "is_archived": true, "created_at": "2023-11-09T16:47:55Z", "updated_at": "2023-11-13T08:43:09Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/844", "field": "id", "value": "ENG-100", "record": {"id": "ENG-100", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-98", "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-100", "number": 100, "title": "Prefab Saving", "description": null, "priority": 0, "estimate": null, "due_date": "2023-08-11", "started_at": "2023-08-07T19:27:28Z", "completed_at": "2024-01-03T06:22:00Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1112472, "labels": ["Puzzle Editor", "Sprint 1 - August 18th"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-06-21T13:44:41Z", "updated_at": "2024-01-03T06:22:00Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/845", "field": "id", "value": "ENG-1000", "record": {"id": "ENG-1000", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1000", "number": 1000, "title": "Puzzle Bot Difficulty Assessor", "description": "[[URL_50398])\n\n**Level Balancer Tool:**\n3 levers to adjust difficulty that\u2019s available today:\n\n* Weights of symbols in draw pile vs. Board tiles\n* Number of cards in draw pile\n* Number if interrupts in puzzle sequence\n\n\nTherefore we need the bot to play through and also conduct sensitivity testing to help us understand for each individual level which parameter we should adjust to arrive at a certain difficulty level.\nWe set the bot to play X number of games, after that we need to track the standard set of statistics:\n- \\[-\\] Win rate. (Win/attempts)\n- \\[-\\] Average card drawn from pile on wins. Conversely, we also get average cards left in hand on wins. (Total cards - average cards used)\n- \\[-\\] Number of ACTUAL interrupts in sequence when bot played (NOT interrupts set in level editor)\nWe then get the bot to conduct sensitivity testing, 1 dimension at a time or all 3 dimension if possible, outputting the standard set of aggregated statistics\n\n* We set the bot to play X number of games for each variation in pile size. Ranging from +3,+2,+1,-1,-2,-3 (something we set, round to nearest whole number)\n* We set the bot to play X number of games for each variation in # of interrupts. Ranging from A-B number of interrupts we determine\n* We set the bot to play X number of games for each variation in weights. We use power transformation to shift the weight distribution to be both more evenly distributed or less evenly distributed. We allow the designer to set different power levels of A, B, C, D, E, F (About 6) where A-F are values > or < 1. In this case > 1 will skew the distribution more, < 1 will make the distribution more even. See [HERE]([URL_50397]) for sample table of calculation steps. Some information [HERE]([URL_50396])\n\nWe use 2 scores to measure the difference between draw pile weights vs. board pile weights. They are:\n\nJensen-Shannon Divergence - out puts value between 0 and 1. 0 = complete similarity, 1 = complete dissimilar\n\nand\n\nOverlapping Coefficients - Expressed in % overlap.\n\nBoth can be done via python script. (P and Q are the 2 probability weight distributions)\n\nStep 1) Normalization, but we should already have normalized weights and enforce it before inputting them.\n\nP_normalized = P / np.sum(P) Q_normalized = Q / np.sum(Q)\n\nStep 2) JSD calcuation python.\n\njsd = distance.jensenshannon(P_normalized, Q_normalized)\n\nStep 3) Overlapping coefficient\n\noverlap = np.sum(np.minimum(P_normalized, Q_normalized))", "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-06-10T17:26:10Z", "completed_at": "2024-08-19T11:28:20Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 782406, "labels": ["Sprint 19 - June 14th"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-06-10T17:26:10Z", "updated_at": "2024-08-19T11:28:20Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/851", "field": "id", "value": "ENG-1006", "record": {"id": "ENG-1006", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-1015", "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1006", "number": 1006, "title": "Higher funnel events are performing worse than lower funnel events", "description": "'@[PERSON_NAME_0054] said:\n\n> higher funnel events are clocking in at lower values than lower funnel events\n\n![image.png]([URL_50399])\n\nLeft Level 1 > Begin level 2?", "priority": 3, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-08-20T16:10:16Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 780684, "labels": ["Bug", "Analytics"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-06-11T01:49:41Z", "updated_at": "2024-08-20T16:10:17Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/853", "field": "id", "value": "ENG-1008", "record": {"id": "ENG-1008", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_5bdc3a787d2cdb00", "creator_id": "usr_cd7849ec043ab3da", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1008", "number": 1008, "title": "Add 'target' value to Quest to track progress", "description": "We want to have something like this in the spreadsheet:\n\n```\nIndex\tDaily Quests\t            Difficulty\tType    Target\n-------------------------------------------------------------\n1\t    Collect 1 character token\tEasy\t    Collect 1\n```\n\nOther consideration, from Leonard:\n\n```plaintext\nif it\u2019s a true false type of condition you can do 1\n0/1 when false and then goes to 1/1 when it\u2019s true\nfor stuff like \u201cfinish memory game under a minute\u201d\nfor others that have a quant goal attached, it\u2019s probably pretty straightforwrad\n```", "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-06-14T15:08:22Z", "canceled_at": null, "archived_at": "2024-12-15T07:20:54Z", "time_in_status_minutes": 877285, "labels": ["Server/Cloud", "Sprint 19 - June 14th"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-06-13T14:52:09Z", "updated_at": "2024-06-14T15:08:22Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/855", "field": "id", "value": "ENG-101", "record": {"id": "ENG-101", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-98", "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-101", "number": 101, "title": "Prefab Loading", "description": null, "priority": 0, "estimate": null, "due_date": "2023-08-11", "started_at": "2023-08-07T19:27:27Z", "completed_at": "2024-01-03T06:22:01Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1112472, "labels": ["Puzzle Editor", "Sprint 1 - August 18th"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-06-21T13:44:59Z", "updated_at": "2024-01-03T06:22:01Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/866", "field": "id", "value": "ENG-102", "record": {"id": "ENG-102", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-98", "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-102", "number": 102, "title": "Special Tile Tagging Cookie Piece", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-01-03T06:55:39Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1112439, "labels": ["Puzzle Editor"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-06-21T13:45:30Z", "updated_at": "2024-01-03T06:55:39Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/869", "field": "id", "value": "ENG-1022", "record": {"id": "ENG-1022", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": null, "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1022", "number": 1022, "title": "Playtestcloud Bug - Sophie's animation doesn't display properly", "description": "Sophie's animation isn't rendered properly and causing visual bugs in both within level and win screen. Especially players who can start from level 1 experience the issue. \n\n[[URL_50462])\n\n![]([URL_50461])", "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-08-20T16:07:53Z", "canceled_at": null, "archived_at": "2025-03-11T07:30:36Z", "time_in_status_minutes": 780686, "labels": ["Hot Leo Issues", "Bug"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-06-17T10:49:57Z", "updated_at": "2024-09-10T15:24:35Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/875", "field": "id", "value": "ENG-103", "record": {"id": "ENG-103", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-98", "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-103", "number": 103, "title": "Special Tile Tagging Reward Piece", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-01-03T06:55:40Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1112439, "labels": ["Puzzle Editor"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-06-21T13:45:39Z", "updated_at": "2024-01-03T06:55:40Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/882", "field": "id", "value": "ENG-1036", "record": {"id": "ENG-1036", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1036", "number": 1036, "title": "Streak Bar UI Bug - Its scale changes when a streak achieved", "description": "Version : 0.1269 iOS\n\nStreak bar extends from lower parts when achieved, creates misalignment in the bottom part of streak bar. \n\nAchieved points of streak bar getting bigger while the empty bars stay a little bit upper compared to the one filled with green. \n\n[RPReplay_Final1718714196.MP4]([URL_50470])\n\nObserve the streak bar with every match. Green ones getting bigger.", "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-08-20T18:56:33Z", "completed_at": "2024-08-21T14:47:14Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 779327, "labels": ["Bug"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-06-18T17:08:33Z", "updated_at": "2024-09-10T15:24:35Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/886", "field": "id", "value": "ENG-104", "record": {"id": "ENG-104", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-98", "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-104", "number": 104, "title": "Special Tile Tagging MegaPiece", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2023-09-28T19:40:19Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1251354, "labels": ["Puzzle Editor"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-06-21T13:47:37Z", "updated_at": "2023-09-28T19:40:19Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/891", "field": "id", "value": "ENG-1044", "record": {"id": "ENG-1044", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-1028", "assignee_id": null, "creator_id": "usr_4d9a08986fd1fbc9", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1044", "number": 1044, "title": "Make ball dropping more satisfying", "description": "decrease time it takes to reach the bottom", "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-06-25T02:33:24Z", "completed_at": "2024-08-12T17:11:47Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 792142, "labels": ["Sprint 22 Baklava - Aug 16th", "Mini Game"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-06-25T00:02:19Z", "updated_at": "2024-08-12T17:40:08Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/895", "field": "id", "value": "ENG-1048", "record": {"id": "ENG-1048", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_c77c50cc15c5342d", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1048", "number": 1048, "title": "Nathan Toxic remove random faceup ability implementation", "description": "[ToxicSplash100_1.mp4]([URL_50483])\n\nBefore we go to the toxic magic ability let me point out the modifs on the nathan character. So on his animator i've change it a bit the animator tree.\n\n![image.png]([URL_50482])\n\nBecause we needed the action of nathan to be faster we combined the aquire bomb animation and the trowing animation into one animation. Now the character just trows whatever he is holding onto the board or deck. To trigger his ability we just need to trigger the parameter from his animator. (deck, magic, bomb, toxic magic)\n\nNow everthing he has needs to be put in the script on his game object:\n\n![image.png]([URL_50481])\n\nThe script contains functions for specific events during the animation, they will hide and unhide the correct objects to display during the animation!\n\n![image.png]([URL_50480])\n\n# **The Toxic Magic**\nIt removes 1 tile or at Nathan 40 level it will remove two tiles. \n\n![image.png]([URL_50479])\n\nSo the animation event that triggers the toxic magic makes the nathanToxicMagic game object active. If we want 1 toxic potion to be trown we use nathanToxicMagic1 and we keep it active inside. and we just make nathanToxicMagic2 not actived.\n\nIf we want Nathan to trow two toxic botles we just have them both active inside of the nathanToxicMagic game object.\n\nThe tiles and how they disolve:\n\n![image.png]([URL_50478])\n\nbecause we got two tiles we need the potion to travel across the board to a specific position:\n\n![image.png]([URL_50477])\n\nthe position of stuffInHandLandingPosition_Board and stuffInHandLandingPosition_Board_2 should correspond to the position of the random tiles that need to be removed but just above them like in the image above.\n\nSo the toxic splash vfxEnd \n\nthere is a dot tween animation there just to make things appear and dissapear for a period of time \n\nso in order for the tile to be disolved it requires to turn off the shadow of the tile and also trigger an parameter on the domino TileBody \"toxicDisolve\"  that will play an animation of desintegration on the body of the tile and the simbol faces\n\n![image.png]([URL_50476])\n\nDuring the animation the tile basically changes the material to a special material thats a toxic disolve material.\n\nmainBoard_Nathan_RemoveAbility.unity is the scene that there is all this stuff where u can test the animations from the debug buttons on the side.\n\nBecause this will overwrite a bit the animations and animator of nathan in the develop branch i used instead Nathan_Remove_Random_Faceup_Ability branch to work this out and u can find there the scene and everthing it needs.\n\nIf you need more info and help please make sure to ping me in slack!", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-07-06T06:51:41Z", "completed_at": "2024-07-17T21:07:22Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 829347, "labels": ["VFX Integration"], "links": [], "relations": [{"target": "ART-607", "type": "relates"}], "is_archived": false, "created_at": "2024-06-26T15:29:40Z", "updated_at": "2024-07-17T21:07:22Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/897", "field": "id", "value": "ENG-105", "record": {"id": "ENG-105", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-98", "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-105", "number": 105, "title": "Use auto parenting for layout editor", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2023-07-05T14:09:14Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1374085, "labels": ["Puzzle Editor"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-06-21T13:48:17Z", "updated_at": "2023-08-03T20:57:55Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/903", "field": "id", "value": "ENG-1055", "record": {"id": "ENG-1055", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1055", "number": 1055, "title": "Streak Abilities Gameplay Bugs", "description": "* +1 wildtile isn't placed in the 3rd position for the abilities of both Sophie and Nate. It goes directly to the end.\n\n[JCTH3507.MP4]([URL_50504])\n\n* Open tile removal ability is slow due to long animation duration\n* wild tile streak reward animation is missing on Nathan.\n\n  [RNTJ0931.MP4]([URL_50503])\n* wildtiles in the hand should be replaced with wildtile on 3rd position of the deck\n\n  [TTLZ2797.MP4]([URL_50502])\n\n* mega tile in the hand passive skill spawns the mega tile & in the hand tile to be matched.\n  * they can be wasted if player starts matching direct\n\n    [XFDG2959.MP4]([URL_50501])\n\n    ly.\n* \\-2 open tile removal ability removes just 1 open tile at level 21 although it's stated as 2 in the inspector.\n  * it happens at the level 40 as well, it might be related to something else\n\n    [CFII0874.MP4]([URL_50500])\n\n    .", "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-06-27T20:52:04Z", "completed_at": "2024-07-08T15:04:44Z", "canceled_at": null, "archived_at": "2025-01-09T07:20:33Z", "time_in_status_minutes": 842670, "labels": [], "links": [], "relations": [], "is_archived": true, "created_at": "2024-06-27T19:40:08Z", "updated_at": "2024-07-08T15:04:44Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/906", "field": "id", "value": "ENG-1058", "record": {"id": "ENG-1058", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_5bdc3a787d2cdb00", "creator_id": "usr_cd7849ec043ab3da", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1058", "number": 1058, "title": "Reset the progress of the Daily and Weekly Quests", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-07-09T16:52:29Z", "canceled_at": null, "archived_at": "2025-01-10T07:20:35Z", "time_in_status_minutes": 841122, "labels": ["Server/Cloud", "Sprint 20 - July 5th"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-07-01T11:32:48Z", "updated_at": "2024-07-09T16:52:29Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/908", "field": "id", "value": "ENG-106", "record": {"id": "ENG-106", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-98", "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-106", "number": 106, "title": "Auto Center Puzzle", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": "2023-06-21T14:00:57Z", "completed_at": "2023-06-26T16:56:06Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1386878, "labels": ["Puzzle Editor"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-06-21T14:00:14Z", "updated_at": "2023-08-03T20:57:55Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/919", "field": "id", "value": "ENG-107", "record": {"id": "ENG-107", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-98", "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-107", "number": 107, "title": "Scroll wheel to dynamically scroll with size of scroll list", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": "2023-06-28T00:30:20Z", "completed_at": "2024-01-03T06:27:04Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1112467, "labels": ["Puzzle Editor"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-06-23T01:02:22Z", "updated_at": "2024-01-03T06:27:04Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/924", "field": "id", "value": "ENG-108", "record": {"id": "ENG-108", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-98", "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_cc3e90160f490686", "state_id": "Canceled", "cycle_id": null, "identifier": "ENG-108", "number": 108, "title": "Review - Merge approved into Review with approved, rejected, and unreviewed filters", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": null, "canceled_at": "2023-07-06T15:23:13Z", "archived_at": null, "time_in_status_minutes": 1372571, "labels": ["Puzzle Editor"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-06-23T01:02:40Z", "updated_at": "2023-08-03T20:57:54Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/928", "field": "id", "value": "ENG-1083", "record": {"id": "ENG-1083", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1083", "number": 1083, "title": "Infinite Rewind Tracking (Analytics)", "description": "We need to track usage of infinite rewind. This will be accomplished by extending booster_usage fields to have a new parameter called ir standing for infinite rewind. See the table below\n\n![image.png]([URL_50533])", "priority": 3, "estimate": null, "due_date": null, "started_at": "2024-07-08T16:09:40Z", "completed_at": "2025-01-16T18:05:09Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 566009, "labels": ["Sprint 20 - July 5th", "Analytics"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-07-04T18:56:49Z", "updated_at": "2025-01-16T18:05:09Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/929", "field": "id", "value": "ENG-1084", "record": {"id": "ENG-1084", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1084", "number": 1084, "title": "Hero Upgrade Tracking (Analytics)", "description": "We need to track hero upgrades according to this spec: [[URL_50535])\n\n![image.png]([URL_50534])", "priority": 3, "estimate": null, "due_date": null, "started_at": "2024-07-10T00:09:11Z", "completed_at": "2025-01-16T18:05:09Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 566009, "labels": ["Sprint 20 - July 5th", "Lava Hot Fix", "Analytics"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-07-04T19:00:01Z", "updated_at": "2025-01-16T18:05:09Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/930", "field": "id", "value": "ENG-1085", "record": {"id": "ENG-1085", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1085", "number": 1085, "title": "Shop Purchase Tracking (Analytics)", "description": "When players adds something to their cart and make a verified purchase, we'd like to know the following data\n\n[[URL_50537])\n\n![image.png]([URL_50536])", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-07-06T21:26:56Z", "completed_at": "2025-01-16T18:05:09Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 566009, "labels": ["Shop", "Analytics"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-07-04T19:03:09Z", "updated_at": "2025-01-16T18:05:09Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/935", "field": "id", "value": "ENG-109", "record": {"id": "ENG-109", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-98", "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-109", "number": 109, "title": "Review - Zoom view", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": "2023-06-26T16:56:33Z", "completed_at": "2023-06-27T23:44:27Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1385030, "labels": ["Puzzle Editor"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-06-23T01:03:22Z", "updated_at": "2023-08-03T20:57:55Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/937", "field": "id", "value": "ENG-1091", "record": {"id": "ENG-1091", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_5bdc3a787d2cdb00", "creator_id": "usr_5bdc3a787d2cdb00", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1091", "number": 1091, "title": "Add Weekly Chests to the Ingestor", "description": "* Make ingestor also transfer new Weekly Chest data Leonard created in the spreadsheet\n* Add the \"duration\" information as a string like \"daily\" and \"weekly\" to the preexisting chests table", "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-07-10T18:29:20Z", "canceled_at": null, "archived_at": "2025-01-11T07:20:42Z", "time_in_status_minutes": 839585, "labels": ["Server/Cloud"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-07-09T17:09:41Z", "updated_at": "2024-07-10T18:29:20Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/938", "field": "id", "value": "ENG-1092", "record": {"id": "ENG-1092", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_cd7849ec043ab3da", "creator_id": "usr_cd7849ec043ab3da", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1092", "number": 1092, "title": "Implement endpoint for Daily and Weekly chest progression", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-07-09T19:25:47Z", "completed_at": "2024-08-07T18:00:12Z", "canceled_at": null, "archived_at": "2025-02-08T07:20:57Z", "time_in_status_minutes": 799294, "labels": ["Server/Cloud", "Sprint 20 - July 5th"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-07-09T19:25:47Z", "updated_at": "2024-08-07T18:00:12Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/939", "field": "id", "value": "ENG-1093", "record": {"id": "ENG-1093", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_bdf01b53c6a92c5e", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1093", "number": 1093, "title": "Show red dot on \"quests\" button for new quests, unopened chests, and unclaimed completed quests (daily and weekly)", "description": "The issue is regressed where I cannot see the red dot for the new quests. \n\n---\n\n---\n\n@Leonard said:\n\n> @Samuel I didn\u2019t have a chance to write a ticket but basically the asks is to show the red dot in the following situations for \u201cquests\u201d button on the saga map\n> 1- quests refreshes and players have new quests so at their first login of the day after refresh players will see the red dot\n> 2- There are unopened chests or unclaimed quests players completed\n> 3- These rules apply for both daily and weekly quests", "priority": 3, "estimate": null, "due_date": null, "started_at": "2024-09-23T17:38:28Z", "completed_at": "2024-11-12T15:26:20Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 684594, "labels": ["Bug"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-07-09T20:27:14Z", "updated_at": "2024-11-12T15:26:20Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/940", "field": "id", "value": "ENG-1094", "record": {"id": "ENG-1094", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_5bdc3a787d2cdb00", "creator_id": "usr_5bdc3a787d2cdb00", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1094", "number": 1094, "title": "Change Chest Id's for ingestion", "description": "* Put \"d\\_\" for daily and \"w\\_\" for weekly chests as a prefix to their id (string type)", "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-07-10T16:43:47Z", "completed_at": "2024-07-10T18:29:31Z", "canceled_at": null, "archived_at": "2025-01-11T07:20:42Z", "time_in_status_minutes": 839585, "labels": ["Server/Cloud"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-07-10T16:43:47Z", "updated_at": "2024-07-10T18:29:31Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/941", "field": "id", "value": "ENG-1095", "record": {"id": "ENG-1095", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_5bdc3a787d2cdb00", "creator_id": "usr_5bdc3a787d2cdb00", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1095", "number": 1095, "title": "Create Lambda function and Cron jobs to reset chest progress daily and weekly", "description": "* Cron jobs will be scheduled for daily and weekly events to the Lambda function\n* New Lambda function \"resetChestProgress.ts\" to remove expired progress entries", "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-07-11T14:48:09Z", "completed_at": "2024-07-16T16:29:37Z", "canceled_at": null, "archived_at": "2025-01-17T07:20:34Z", "time_in_status_minutes": 831065, "labels": ["Server/Cloud"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-07-10T16:51:33Z", "updated_at": "2024-07-16T16:29:37Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/942", "field": "id", "value": "ENG-1096", "record": {"id": "ENG-1096", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_5bdc3a787d2cdb00", "creator_id": "usr_5bdc3a787d2cdb00", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1096", "number": 1096, "title": "Adjust Chests Endpoint to only serve Daily Chests", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-07-10T18:30:17Z", "completed_at": "2024-07-11T14:48:02Z", "canceled_at": null, "archived_at": "2025-01-12T07:20:47Z", "time_in_status_minutes": 838366, "labels": ["Server/Cloud"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-07-10T18:30:17Z", "updated_at": "2024-07-11T14:48:02Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/947", "field": "id", "value": "ENG-110", "record": {"id": "ENG-110", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-98", "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-110", "number": 110, "title": "Add Edit Mode To Puzzle Pipeline", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2023-07-05T14:08:38Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1374086, "labels": ["Puzzle Editor"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-06-23T01:03:57Z", "updated_at": "2023-08-03T20:57:55Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/957", "field": "id", "value": "ENG-111", "record": {"id": "ENG-111", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-98", "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-111", "number": 111, "title": "Review - Reject Button", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2023-06-27T23:44:28Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1385030, "labels": ["Puzzle Editor"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-06-23T01:04:59Z", "updated_at": "2023-08-03T20:57:55Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/968", "field": "id", "value": "ENG-112", "record": {"id": "ENG-112", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-98", "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-112", "number": 112, "title": "MultiSelect", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2023-07-05T14:08:52Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1374085, "labels": ["Puzzle Editor"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-06-28T21:41:08Z", "updated_at": "2023-08-03T20:57:55Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/978", "field": "id", "value": "ENG-1129", "record": {"id": "ENG-1129", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_PERSON_3233", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1129", "number": 1129, "title": "Quest UI Responsiveness & Experience Issues", "description": "1. When I changed the quest tab, the other tab started from the previous location which should be reset back to top\n2. Claimed quest should get sorted instantly to the bottom of list.\n3. The scrolling also lags or sometimes it locks out you from scrolling. Easy to reproduce, fast scrolling attempt will cause this.\n\n[Record_[CREDIT_CARD_NUMBER_1073]_0ed2d384a7e28d6134e98d8e5c97b585.mp4]([URL_50586])\n\nUpdated Video based on **Version : ios 1463 & android 1486**\n\n[Record_[CREDIT_CARD_NUMBER_1072]_0ed2d384a7e28d6134e98d8e5c97b585.mp4]([URL_50585])", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-10-09T05:49:21Z", "completed_at": "2024-10-16T19:01:35Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 698433, "labels": ["Lava Hot Fix", "Bug"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-07-22T18:56:21Z", "updated_at": "2024-10-16T19:01:35Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/979", "field": "id", "value": "ENG-113", "record": {"id": "ENG-113", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-98", "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-113", "number": 113, "title": "Copy & Paste", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2023-07-05T14:08:47Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1374085, "labels": ["Puzzle Editor"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-06-28T21:41:22Z", "updated_at": "2023-08-03T20:57:55Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/982", "field": "id", "value": "ENG-1132", "record": {"id": "ENG-1132", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_caafeec2804b3a67", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1132", "number": 1132, "title": "Implement VFX for \"ready to claim\" quests", "description": null, "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-07-29T17:32:30Z", "completed_at": "2024-07-29T18:11:36Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 812243, "labels": ["Sprint 21 Baklava - Aug 2nd", "Event System"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-07-29T17:32:28Z", "updated_at": "2024-07-29T18:11:36Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/984", "field": "id", "value": "ENG-1134", "record": {"id": "ENG-1134", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_49b9dfa5208d400d", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1134", "number": 1134, "title": "Fast Click Bugs - Tutorial Breaks", "description": "**Tutorial Breaks**\n\n* First Time Load Tutorial (Level 1)\n  * it can be broken by the fast taps if a tap register to match the tile before the messages appears.\n  * after being broken, it's visually broken but the progress can be made by tapping the next tiles.\n\n[first load tutorial bug.mp4]([URL_50605])\n\n* [ENG-1272](https://linear.app/harmonygames-games/issue/ENG-1272/wild-tile-tutorial-level-3)\n\n  Streak Tutorial Bug (Level 4)\n  * Fast clicking causes random draw action which leads to drawing the only tile in the deck. Since the sequence is perfectly aligned without no tile draw required. That random draw action breaks the tile sequence and there is no other deck tile to draw and compensate the error.\n  * Players can use wild tile boost or they have to quit the game or simply restart the level.\n\n  [streak tutorial bug.mp4]([URL_50604])\n* [ENG-1273](https://linear.app/harmonygames-games/issue/ENG-1273/rewind-tutorial-level-7)\n* Jumbo Tile Tutorial Bug (Level 8)\n  * If player achieves to match the jumbo tile before the tutorial dimming starts, the tutorial flow is broken because the tutorial is trying to highlight the other jumbo tile and  matching the jumbo tile doesn't remove the highlighted area.\n  * So it's a blocker, players should kill the app and open again to continue.\n\n  [mega tile bug.mp4]([URL_50603])\n* Character Token Tutorial (Level 10)\n  * If player matches the character token instantly before the tutorial is triggered, the tutorial is skipped, leading to unintended flow that we couldn't teach them what the tokens are for.\n  * It causes no blocker as I tested it thoroughly. It's just skipping the tutorial.\n\n[Screen_Recording_20240717_084213_Domino Adventures (1).mp4]([URL_50602])\n\n* Mini Game Hub Tutorial (Level 12-13)\n  * If I tap on the minigame button on the navigation bar fast enough, the MGHub tutorial highlights both the minigame button and the conveyor belt. It's not a crucial issue but might hinder the idea to show them the minigame options.\n\n[minigame hub tutorial bug.mp4]([URL_50601])", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-08-26T15:43:07Z", "completed_at": "2024-09-04T15:19:58Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 759134, "labels": ["Baklava Release", "Submission Blocker", "Bug"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-07-29T18:27:00Z", "updated_at": "2024-09-04T15:19:58Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/988", "field": "id", "value": "ENG-1138", "record": {"id": "ENG-1138", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1138", "number": 1138, "title": "Bot and Sequencer 2.0", "description": "So I think this sums up basic sequence generation:\n\n1. Sequence is generated from the 55 tile pool, tiles are selected at random. (In this example let's assume board tiles = 26)\n2. There are weights assigned, despite being randomly selected. This is for both hand tiles and board tiles. The 2 sets of weights will have an overlap %. We allow the game designer to set the weights, but we constantly compute the overlapping % between the weights. The overlapping % is simply the sum of the smaller % weight of the 2 sets. So if symbols ABC have weights 50-40-10 and set 2 ABC has 40-20-40 then the overlap in this case is 40 + 20 + 10, the smaller number of the 2 sets = 70% overlap.\n3. We take the 26 selected board tiles, and we arrange them in the longest sequence possible (we call this the \"master sequence), followed by the next longest sequence, until we are out of tiles. Chances are this will look something like 23-2-1 or 23-1-1-1. If the sequences are the same length, random is fine.\n4. We chop the sequence into smaller sub sequence using the \"chopper\" algo (each tile has X% chance of being the end of a sub sequence) So for example a 26 tile sequence can be broken up into 2-1-4-8-6-5 = 26 total. The X% is something the game designer can choose. This should make the level easier/harder. In the above example where the best sequence is 23-1-1-1, then the chopping really only happens for the first 23 tiles. And it can be broken into 5-6-8-3-1-1-1-1. If the sequence is 23-2-1 before being chopped, post chop can result in something like 8-6-6-3-1-1-1. Each tile goes through the chopping block, but obviously if that tile is already a single piece sequence, it is effectively already \"chopped\"\n5. Shuffle the order of these sub-sequences. So the above example of 2-1-4-8-6-5  becomes 6-1-4-2-5-8\n6. The sequence is now deployed onto the layout. Starting from generation 1 (top piece) and then from there there is equal chance that the sequence will continue either going deeper into the stack, or going to another top piece.\n   1. So for example, if there is a layout where it's 4 stacks of tiles, shaped in the pyramid, with 1 on top, 2 on the second layer (gen 2), 3 on the third layer (gen 3) for a total of 24 pieces, the first piece in the sequence will be 1 of the 4 gen 1 pieces.\n   2. The second piece in the sequence will be deployed with an equal chance divided between the 3 other gen 1 pieces, PLUS the 2 gen 2 pieces that are child of the first gen 1 pieces deployed. (5 total eligible targets) This means each eligible target will have 20% chance of being the 2nd piece in the sequence.\n\nThis concludes how basic sequence generation is done to avoid overlaps.\n\nThere are other things we have to allow the game designers to control:\n\n* Total number of pieces on the board\n* Total number of pieces on player's hand, including draw pile and hand tile.\n* Symbol weights, separate sets for hand tiles and board tiles\n* Chop rate %, the % chance where a tile is the last tile before it becomes delimited from remainder of the master sequence\n\nOther behaviors to account for (this list is probably constantly growing as we discover edge case)\n\n* The +3 card and +5 card boosts players can buy selects randomly from the entire tile pool. That can be 55 tiles (10 symbols), 45 tiles (9 symbols), and so on. It ignores what has already been selected as hand tiles or board tiles.\n* Streak rewards that add cards to the end of the draw pile also selects randomly from the entire pool, regardless of weights.\n* In the case that hand tiles + board tiles exceeds the pool of tiles, the priority always goes to board tiles being determined first, followed by the hand tiles, and if the pool is exhausted, additional tile will be chosen from a second but identical pool of tiles (basically a repeated pool). So in a 7 symbol tile set, the pool size is 28, and if the board has 46 tiles and hand has 12 tiles with the total of 58 tiles, the first pool of 28 will go into the 46 board tiles, and then the second pool of 28, 18 will be chosen as the board tiles so 46 total are chosen. Then after that the hand tiles are chosen from remainder of pool #2 and pool #3.\n* Jumbo tiles (2x2 tiles) are considered board tiles. They will be constructed using 2 standard tiles. The selection of the tiles that are used to construct the jumbo tile follows the board tile weights, however the selection of these tiles happens between the initial board tile selection phase and the hand tile selection phase. They are not in anyway part of the \"master\" sequence.\n* In the case where the weights set by the game designer puts the algorithm in an impossible situation, for example, the weights of symbol A is set to 50% on a 26 board tiles level (52 symbols), which will require 26 symbols, where the max in a 55 tile pool is 11, this will throw a caution to the game designer, but the algo will simply continue to pull symbol A from a repeated pool, but just for that symbol. Another less extreme example is that only 1 of the weights throws this caution, so symbol A's weight is set at 25%, which will require it to have 13 symbols. The pieces will then be pulled from repeated tile pool #2, but meanwhile the other symbols that are within the parameters, will continue to only be selected from tile pool #1.", "priority": 1, "estimate": null, "due_date": null, "started_at": "2024-08-28T15:54:29Z", "completed_at": "2024-09-10T10:36:41Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 750778, "labels": ["Sprint 22 Baklava - Aug 16th"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-08-07T16:15:01Z", "updated_at": "2024-09-10T10:36:41Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/996", "field": "id", "value": "ENG-1147", "record": {"id": "ENG-1147", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_cd7849ec043ab3da", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1147", "number": 1147, "title": "WinCollect Endpoints", "description": null, "priority": 1, "estimate": null, "due_date": null, "started_at": "2024-08-12T17:22:17Z", "completed_at": "2024-09-28T16:08:09Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 724526, "labels": ["Sprint 22 Baklava - Aug 16th", "Event System"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-08-07T18:00:58Z", "updated_at": "2024-09-28T16:08:09Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/997", "field": "id", "value": "ENG-1148", "record": {"id": "ENG-1148", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_cd7849ec043ab3da", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1148", "number": 1148, "title": "Schedule Web Interface", "description": null, "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-08-07T23:56:48Z", "completed_at": "2024-09-28T16:10:18Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 724524, "labels": ["Sprint 22 Baklava - Aug 16th", "Event System"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-08-07T18:01:07Z", "updated_at": "2024-09-28T16:10:18Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/998", "field": "id", "value": "ENG-1149", "record": {"id": "ENG-1149", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_cd7849ec043ab3da", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1149", "number": 1149, "title": "Leaderboard Research", "description": null, "priority": 3, "estimate": null, "due_date": null, "started_at": "2024-08-12T17:23:02Z", "completed_at": "2024-09-28T16:09:17Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 724525, "labels": ["Sprint 22 Baklava - Aug 16th", "Event System"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-08-07T18:01:17Z", "updated_at": "2024-09-28T16:09:17Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1004", "field": "id", "value": "ENG-1154", "record": {"id": "ENG-1154", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_caafeec2804b3a67", "creator_id": "usr_Robert", "state_id": "Canceled", "cycle_id": null, "identifier": "ENG-1154", "number": 1154, "title": "Engineering Implementation Win and Collect Live Ops Event", "description": "This feature is very similar to quests.\n\n* Integrate accessibility into UI.\n* Showing progress on button icon\n* Reward flow implementation using \u201cchest open\u201d VFX\n\nBack end work done by Douglas's team.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-08-12T17:11:28Z", "completed_at": null, "canceled_at": "2024-09-18T15:33:06Z", "archived_at": null, "time_in_status_minutes": 738961, "labels": ["Sprint 22 Baklava - Aug 16th", "Event System"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-08-07T18:35:31Z", "updated_at": "2024-09-18T15:33:06Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1006", "field": "id", "value": "ENG-1156", "record": {"id": "ENG-1156", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-839", "assignee_id": "usr_PERSON_3233", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1156", "number": 1156, "title": "List of Improvements on Compatibility across Frames (Screens & VFXs & Functionality)", "description": "The issues are listed from the unity editor in the PR rather than the main branch on iPad Pro 12.9 and iPhone 13.\n\nFunctionality\n\n* ~~The memory game in hard mode has some tiles that cannot be interacted easily in the upper row.~~\n\n  [Screen Recording [CREDIT_CARD_NUMBER_1095].mp4]([URL_50647])\n* ~~Chapter visuals are too small but they barely fits into the screen so nothing can be done about it. However, if we're gonna stick with that screen like that, I think the empty peripheral areas should be interactable to scroll.~~\n\n  [Screen Recording [CREDIT_CARD_NUMBER_1094].mp4]([URL_50646])\n* ~~Info button lost its meaning due to overlapping texts along with misalignment of the bottom text.~~\n\n  ![image.png]([URL_50645])\n\nScreen Improvements\n\n* the hand tile is placed a little bit upper from the lower hud.\n\n  ![image.png]([URL_50644])\n\n  ![image.png]([URL_50643])\n* i think we should find a better way rather than just mirroring which looks weird.\n\n  ![image.png]([URL_50642])\n* ~~The memory game end-game screen isn't fitting into the frame while also coin and live balance UIs are too close to each other.~~\u00a0\n\n  ![image.png]([URL_50641])\n* The upper currency bars are too low when there are plenty of spaces above and upgrade button overlaps with the level text of the characters.\n\n  ![image.png]([URL_50640])\n* ~~Very low priority, on the other hand, rivertile end game pop-up can be bigger while also more centralized like moving it upper.~~\n\n![image.png]([URL_50639])\n\n![image.png]([URL_50638])\n\n* It's much more better the upper bart of the banner is still not visible.\n\n  ![image.png]([URL_50637])\n\nVFX Targets\n\n* The target of coins from streak reward is slightly misplaced, floating towards next to Sophie.\n\n  [Screen Recording [CREDIT_CARD_NUMBER_1093].mp4]([URL_50636])", "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-08-08T14:51:50Z", "completed_at": "2024-08-14T14:52:01Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 789402, "labels": [], "links": [], "relations": [], "is_archived": false, "created_at": "2024-08-07T19:33:32Z", "updated_at": "2024-08-14T14:52:01Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1012", "field": "id", "value": "ENG-1162", "record": {"id": "ENG-1162", "project_id": null, "team_id": "team_ENG", "parent_id": "ENG-1185", "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Canceled", "cycle_id": null, "identifier": "ENG-1162", "number": 1162, "title": "List of Bugs that happens before the quests are populated on iOS", "description": "Those issues only happen on iOS because it took some time to get quests populated only on iOS. \n\nVersion: ios 0.1456\n\n1.  When i quit a level after opening the app for the first time, I couldn't quit. The lives are deducted, the console says that it's quitted but I'm still in the game. When that happens, out of moves screen isn't triggered as well. \n   1. When I complete the level, the character doesn't appear on the win screen.\n\n      [RPReplay_Final1722442024 (1).MP4]([URL_50661])\n\n      [RPReplay_Final1722422976 (1).MP4]([URL_50660])\n2. The memory game isn't loaded before the quests are populated. When I directly go to memory game and choose any difficulty, the tiles don't fly in to the board. \n\nSteps to Repro:\n\n1. Unlock the quests on iOS (Play until chapter 2 level 15 end)\n2. Kill the app\n3. Restart the app\n4. Either\n   1. Go to memory game and observe that tiles are not there\n   2. Go to the core game and quit the level\n\n# **As it can be seen in the videos, both of the issues starts to happen after the quests are unlocked on iOS.** \n\n[RPReplay_Final1723474385.MP4]([URL_50659])\n\n[RPReplay_Final1723474520.MP4]([URL_50658])", "priority": 1, "estimate": null, "due_date": null, "started_at": null, "completed_at": null, "canceled_at": "2024-09-25T16:58:25Z", "archived_at": null, "time_in_status_minutes": 728796, "labels": ["Submission Blocker", "Baklava Hot Fix", "Bug"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-08-12T15:13:16Z", "updated_at": "2024-09-25T16:58:25Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1036", "field": "id", "value": "ENG-1188", "record": {"id": "ENG-1188", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_EMPLOYEE_0032", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1188", "number": 1188, "title": "End Game Reward Screen Inconsistency of Font and Asymmetry", "description": "Version : ios 1463 & android 1486\n\nThe placement of amounts for both coins and tokens are different. It should be symmetrical should be placed similar to each other. \n\nAlso the font of amount texts for coins and tokens are different as well. Coin amount is like smaller  and has shadows while the token one is bigger and has outline. \n\n![image.png]([URL_50685])\n\n![image.png]([URL_50684])", "priority": 4, "estimate": null, "due_date": null, "started_at": "2024-09-05T14:06:27Z", "completed_at": "2024-09-09T14:35:18Z", "canceled_at": null, "archived_at": "2025-03-11T07:30:39Z", "time_in_status_minutes": 751979, "labels": ["Desire Release", "Bug"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-08-20T10:46:07Z", "updated_at": "2024-09-10T15:24:35Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1048", "field": "id", "value": "ENG-1206", "record": {"id": "ENG-1206", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1206", "number": 1206, "title": "Sequencer 2.1 (Enforcing rigidity and consistency in level sequence generation)", "description": "After some deep dive by [PERSON_NAME_0050] and team discussion, we have proposed a way to ensure rigidity in the sequence generation and deployment of said sequence in the layout to provide a more consistent experience when playing the game. The expected behavior of this is:\n\n* We will have less volatility playing the level, meaning the difficulty will be more or less similar. Players will finish the level with an average # of tiles left in hand with a much smaller standard deviation.\n* We will observe some specific tiles appearing in exact position or neighboring position on the level's layout, during repeated attempts.\n\nHow we will achieve this:\n\n1. We need to enforce how the sequence is generated, after selecting the board tiles from the 55-tile pool.\n2. This means we need to have a fixed algo, such as the one I proposed where we start with *the smallest value piece* such as 0/0, and if that doesn't exist, 0/1, if not 0/2. While we don't have to always start with the smallest value, what's the most important thing is that each level follows the same exact priority when it comes to creating that sequence. So you can have symbol prioritization like 3 > 5 > 0 > A > L > 6 > M > whatever.. It just needs to follow the same priority each time *for that level* when you are generating the master sequence.\n3. Next is that we need the puzzle editor to let the designer specify WHERE the chop happens which includes HOW MANY TIMES it happens. So in a 26 pieces level, the designer can specify that they want chopping at 8th tile, 16th tile, 20th tile. And in this scenario the sequence will now be broken into minimum 4 sub sequences, but chances are a bit more because of the asshole/orphaned tiles at the end.\n4. We then scrambled the order of these sequences, then deploy it to the board. So following the example above, after 3 chops + assholes, we have 5 smaller sequences A B C D E. We then scramble that so it's sometimes A C D E B and deployed in that order, and maybe on the next try for the same level it's now B E D C A.\n5. Given that asshole sequences are usually small 1-2 piece stuff, there really is only 3 \"larger\" sequences. So if you were to just visualize this in your head as A B C sequences, there are only so many ways you can arrange this when randomized. ABC, ACB, BAC, BCA, CAB, CBA. This in conjunction with symbol prioritization during sequence generation *is how we will get same tile in similar positions within a level.*", "priority": 2, "estimate": null, "due_date": "2024-08-26", "started_at": "2024-08-28T15:54:31Z", "completed_at": "2024-09-16T16:42:33Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 741772, "labels": ["Puzzle Engine", "Sprint 23 Baklava - Aug 30th", "Improvement", "Main Game"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-08-23T19:11:21Z", "updated_at": "2024-09-16T16:42:33Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1049", "field": "id", "value": "ENG-1207", "record": {"id": "ENG-1207", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_PERSON_2218", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1207", "number": 1207, "title": "Change background for different game modes in the puzzle editor", "description": "We need to have the default background for the Edit Layout tab as we have it now. But when we switch to the train level-making mode, we need to have the train-level background for it. The snowy one will be great for now.", "priority": 1, "estimate": null, "due_date": "2024-08-30", "started_at": "2024-09-02T15:58:49Z", "completed_at": "2024-09-03T09:25:38Z", "canceled_at": null, "archived_at": "2025-03-11T07:30:39Z", "time_in_status_minutes": 760929, "labels": ["Puzzle Editor"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-08-26T12:18:35Z", "updated_at": "2024-09-10T11:17:43Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1054", "field": "id", "value": "ENG-1211", "record": {"id": "ENG-1211", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_cd7849ec043ab3da", "creator_id": "usr_cd7849ec043ab3da", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1211", "number": 1211, "title": "Leaderboard: Bot system", "description": "Bot players to have initial data in the leagues", "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-09-16T11:43:35Z", "completed_at": "2024-09-28T16:10:29Z", "canceled_at": null, "archived_at": "2025-03-29T07:35:38Z", "time_in_status_minutes": 724524, "labels": [], "links": [], "relations": [], "is_archived": true, "created_at": "2024-08-26T16:00:52Z", "updated_at": "2024-09-28T16:10:29Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1056", "field": "id", "value": "ENG-1213", "record": {"id": "ENG-1213", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_cd7849ec043ab3da", "creator_id": "usr_cd7849ec043ab3da", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1213", "number": 1213, "title": "Leaderboard: League Population", "description": "Initially populate leagues with bot players and transition to real players as tiers fill up", "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-09-16T11:43:41Z", "completed_at": "2024-11-11T18:34:43Z", "canceled_at": null, "archived_at": "2025-05-12T08:10:25Z", "time_in_status_minutes": 661020, "labels": [], "links": [], "relations": [], "is_archived": true, "created_at": "2024-08-26T16:27:19Z", "updated_at": "2024-11-11T18:34:43Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1057", "field": "id", "value": "ENG-1214", "record": {"id": "ENG-1214", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_49b9dfa5208d400d", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1214", "number": 1214, "title": "Tagging Minigame UIs to use in tutorial editor", "description": "We are changing the way minigame tutorials are handled. So, for each minigame, we have an infographic we'll show the first time the game is activated. I will use Show UI, Hide UI for this, so the infographics need to be tagged as UI. Let me know if you have any questions. \n\nThey UIs are here in the Figma file \n\n[[URL_50713])", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-09-02T16:06:29Z", "completed_at": "2024-09-11T16:03:32Z", "canceled_at": null, "archived_at": "2025-03-12T07:30:22Z", "time_in_status_minutes": 749011, "labels": ["Tutorial Editor"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-08-26T16:54:38Z", "updated_at": "2024-09-11T16:03:32Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1063", "field": "id", "value": "ENG-122", "record": {"id": "ENG-122", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-171", "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-122", "number": 122, "title": "Undo Functionality", "description": null, "priority": 0, "estimate": null, "due_date": "2023-08-11", "started_at": "2023-08-07T19:27:26Z", "completed_at": "2023-09-28T19:39:12Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1251355, "labels": ["Puzzle Editor", "Sprint 1 - August 18th"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-08-07T18:11:19Z", "updated_at": "2023-09-28T19:39:12Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1064", "field": "id", "value": "ENG-1220", "record": {"id": "ENG-1220", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1220", "number": 1220, "title": "Add new tutorial triggers and actions for the reworked bomb tile", "description": "Please add both action and trigger for when the bomb tile ignites.", "priority": 1, "estimate": null, "due_date": null, "started_at": "2024-08-29T04:28:35Z", "completed_at": "2024-09-10T12:40:07Z", "canceled_at": null, "archived_at": "2025-03-11T07:30:37Z", "time_in_status_minutes": 750654, "labels": ["Sprint 23 Baklava - Aug 30th", "Tutorial Editor"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-08-27T17:05:30Z", "updated_at": "2024-09-10T12:40:07Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1067", "field": "id", "value": "ENG-1223", "record": {"id": "ENG-1223", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_65c76e0b87aa7e9b", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1223", "number": 1223, "title": "Allow Game Designer in Level Editor to Choose Starting Streak", "description": "Allow game designers to assign starting streak of 4, 5 or 6 for each individual level in the puzzle editor.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-08-29T20:20:54Z", "completed_at": "2024-09-03T13:51:06Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 760663, "labels": ["Streak System", "Improvement"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-08-28T00:48:08Z", "updated_at": "2024-09-10T11:17:43Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1098", "field": "id", "value": "ENG-1251", "record": {"id": "ENG-1251", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_49b9dfa5208d400d", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1251", "number": 1251, "title": "Vanishing tile issues", "description": "Unclear which tile it takes from draw pile when players are punished, both visually and mechanically.\n\nTiming between vanishing tile disappearing on board and punishment needs to be tweaked (slightly too long right now)\n\nVFX also doesn't seem complete (missing a dissolve?) @Marcus", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-09-13T05:15:59Z", "completed_at": "2024-09-26T10:09:37Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 727765, "labels": ["Desire Release", "Sprint 24 - September 13th", "Bug"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-09-02T16:37:28Z", "updated_at": "2024-09-26T10:09:37Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1099", "field": "id", "value": "ENG-1252", "record": {"id": "ENG-1252", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_49b9dfa5208d400d", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1252", "number": 1252, "title": "Animation polishes for main game", "description": "Discard animation when player draws new tile from pile -> hand, existing tile should be pushed down.\n\nMatch a new tile discarding animation\n\nSophie streak reward adding cards to end of draw pile has spacing issues.\n\nTiles in hand sits slightly too high, so horizontal tiles has a gap between tile and wooden UI. Vertical tiles have bottom icon visible when only the top one should be visible.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-09-02T16:40:33Z", "completed_at": "2024-09-11T16:03:49Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 749010, "labels": ["Desire Release", "Sprint 24 - September 13th", "Bug", "Main Game"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-09-02T16:40:33Z", "updated_at": "2024-09-11T16:03:49Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1103", "field": "id", "value": "ENG-1256", "record": {"id": "ENG-1256", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1256", "number": 1256, "title": "There are no quests on both devices.", "description": "version: iOS 1499 & android 1575\n\nQuests are not populated after it's unlocked. Generally, all of them are visible on both android and ios after getting unlocked. However, as of 9/3/24 no quests are shown in the section. \n\n[1000000434.mp4]([URL_50756])", "priority": 1, "estimate": null, "due_date": null, "started_at": "2024-09-04T17:41:28Z", "completed_at": "2024-09-05T15:23:41Z", "canceled_at": null, "archived_at": "2025-03-06T07:20:23Z", "time_in_status_minutes": 757691, "labels": ["Baklava Release", "Submission Blocker", "Bug"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-09-03T15:39:50Z", "updated_at": "2024-09-05T15:23:41Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1110", "field": "id", "value": "ENG-1263", "record": {"id": "ENG-1263", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-1136", "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1263", "number": 1263, "title": "Julius - +2 Gold tiles issue", "description": "* if the ability is triggered with only 1 tile available on the board that can be converted to a gold tile, both of the gold tiles spawns in the same tile. \n  * It doesn't cause any functional issue but the gold tile stays on the board even though the level is completed\n\n    [Record_[CREDIT_CARD_NUMBER_0877]_0ed2d384a7e28d6134e98d8e5c97b585.mp4]([URL_50767])", "priority": 3, "estimate": null, "due_date": null, "started_at": "2024-09-17T16:00:49Z", "completed_at": "2024-09-24T07:51:48Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 730782, "labels": ["Streak System", "Baklava Hot Fix", "Bug"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-09-04T12:12:01Z", "updated_at": "2024-09-24T07:51:48Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1173", "field": "id", "value": "ENG-1321", "record": {"id": "ENG-1321", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_49b9dfa5208d400d", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1321", "number": 1321, "title": "Reposition and Resize Coin-Reward Text for Coin 4-Streak Reward", "description": "The text size on the coin for the 4-streak reward needs to be repositioned and possibly reduced in size since it's blocking the coin icon and doesn't look appealing. Please refer to the attached screenshots for reference to ensure proper adjustments are made. For reposition suggestions and the correct font please get feedback from @[PERSON_NAME_0054] and/or @Martin.Walsh \n\n![IMG_7868.PNG]([URL_50874])\n\nPart of UI polish, both icon and text should be slightly bigger\n\n![image.png]([URL_50873])", "priority": 4, "estimate": null, "due_date": null, "started_at": "2024-09-30T16:07:23Z", "completed_at": "2024-10-02T13:43:51Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 718910, "labels": ["Easy Fix - Just do it!", "Baklava Hot Fix"], "links": [], "relations": [{"target": "ENG-1427", "type": "relates"}], "is_archived": false, "created_at": "2024-09-09T04:55:29Z", "updated_at": "2024-10-02T13:43:51Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1204", "field": "id", "value": "ENG-135", "record": {"id": "ENG-135", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-100", "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-135", "number": 135, "title": "Generate prefab data", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": "2023-08-10T12:50:03Z", "completed_at": "2024-01-03T06:26:48Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1112467, "labels": ["Puzzle Editor", "Sprint 1 - August 18th"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-08-10T12:49:19Z", "updated_at": "2024-01-03T06:26:48Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1215", "field": "id", "value": "ENG-136", "record": {"id": "ENG-136", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-100", "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-136", "number": 136, "title": "Generate Prefab Preview", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": "2023-08-10T12:49:42Z", "completed_at": "2024-01-03T06:26:47Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1112467, "labels": ["Puzzle Editor", "Sprint 1 - August 18th"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-08-10T12:49:33Z", "updated_at": "2024-01-03T06:26:47Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1234", "field": "id", "value": "ENG-138", "record": {"id": "ENG-138", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "EPI-9", "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-138", "number": 138, "title": "Domino Level Tooling", "description": null, "priority": 0, "estimate": null, "due_date": "2023-08-15", "started_at": "2023-08-11T13:45:36Z", "completed_at": "2024-01-03T06:22:02Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1112472, "labels": ["Puzzle Editor", "Sprint 1 - August 18th"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-08-11T13:45:36Z", "updated_at": "2024-01-03T06:22:02Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1240", "field": "id", "value": "ENG-1385", "record": {"id": "ENG-1385", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_caafeec2804b3a67", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1385", "number": 1385, "title": "Implement Win & Collect Live Ops Event", "description": "[PERSON_NAME_0092] & Samuel & Douglas\n\nThis feature is very similar to quests.\n\n* Integrate accessibility into UI.\n* Showing progress on button icon\n* Reward flow implementation using \u201cchest open\u201d VFX\n\nBack end work done by Douglas's team.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-09-16T16:49:27Z", "completed_at": "2024-10-03T13:59:08Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 717455, "labels": ["Baklava Hot Fix"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-09-11T18:29:02Z", "updated_at": "2024-10-03T13:59:08Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1246", "field": "id", "value": "ENG-1390", "record": {"id": "ENG-1390", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_PERSON_3233", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1390", "number": 1390, "title": "Report all compatibility issues", "description": "[https://www.figma.com/design/xAoHXeohuhi66iUs3Nk5uC/Domino-Delights%3A-Tablets?node-id=0-1&node-type=canvas&t=rIrN2vzIPEWXzlNN-0](https://www.figma.com/design/xAoHXeohuhi66iUs3Nk5uC/Domino-Delights%3A-Tablets?node-id=0-1&node-type=canvas&t=rIrN2vzIPEWXzlNN-0)\n\nART TEAM NEEDS TO CHECK IT FIRST \n\nCheck what is going on especially on tablet resolution. \n\n![image.png]([URL_50987])\n\n[[CREDIT_CARD_NUMBER_5750].9797786.mp4]([URL_50986])\n\n* The background on ipad resolution is mirrored.  \n\n  ![image.png]([URL_50985])\n* ~~The hand tile is not totally visible - the bottom HUD covers a minimal portion of the hand tile~~\n\nUPDATED ISSUE: Right now, the hand tile is not touching to the HUD - is above the HUD on the contrary.\n\n![image.png]([URL_50984])\n\n~~The rewind button is located too high that it should be more close the lower boosts for better accessibility.~~ \n\n![image.png]([URL_50983])\n\n~~The floating coin VFX after the level is completed goes off-screen then returns to the coin balance (the target)~~\n\n[[CREDIT_CARD_NUMBER_5749].2008536.mp4]([URL_50982])\n\n~~The characters, level info, \"upgrade\" and \"select\" buttons are squeezed in a small area where most of them overlaps each other because the top and bottom HUD is so huge.~~ \n\n![image.png]([URL_50981])\n\n![image.png]([URL_50980])\n\n~~Character ability scroll has crowded screen where tap to continue text, the scroll items, buttons are overlapping.~~ \n\n![image.png]([URL_50979])\n\nThe outside of the tile dozer gameplay scene is visible on ipad resolution. \n\n* ~~The top HUD and the button placement is not stretched horizontally.~~\n\n![image.png]([URL_50978])\n\n* ~~similarly character abilities are not stretched but the back button is left-aligned.~~ \n\n![image.png]([URL_50977])\n\n* ~~The info pop up for character abilities in tile dozer is left-aligned - it looks like a visual glitch~~\n\n![image.png]([URL_50976])\n\n* ~~Memory tile infographic doesn't fit into the ipad screen. - It's scaled up.~~ \n\n  ![image.png]([URL_50975])\n* Chapter complete screen top banner and text is placed too high. (See the references with iPhone 13 Pro frame)\n\n  ![image.png]([URL_50974])\n\n  ![image.png]([URL_50973])\n* ~~Profile screen UI is not stretched horizontally to fit into wider frames.~~ \n\n  ![image.png]([URL_50972])\n* The static part in quest screen covers the half of whole ipad screen. The interactable area is too small and only one quest is totally visible. \n\n  [[CREDIT_CARD_NUMBER_5748].5433639.mp4]([URL_50971])\n* The targets of character token VFX and where it's actually allocated are different. The VFX goes towards the top right of the playable area while they are placed in the top right of the actual screen. \n\n  [[CREDIT_CARD_NUMBER_5747].7782717.mp4]([URL_50970])\n* Train levels need stretched background to be compatible across different frames so that the green parts won't be visible. \n\n  [Screen Recording [CREDIT_CARD_NUMBER_5746].mp4]([URL_50969])", "priority": 1, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-09-30T14:29:13Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 721745, "labels": ["Baklava Hot Fix"], "links": [], "relations": [{"target": "ENG-1502", "type": "relates"}], "is_archived": false, "created_at": "2024-09-11T18:41:48Z", "updated_at": "2024-09-30T18:24:53Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1247", "field": "id", "value": "ENG-1391", "record": {"id": "ENG-1391", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_63fffeb4fab5233e", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1391", "number": 1391, "title": "Analytics Bugs & Tickets to submit", "description": null, "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-09-27T11:17:21Z", "canceled_at": null, "archived_at": "2025-03-28T07:35:26Z", "time_in_status_minutes": 726257, "labels": ["Baklava Hot Fix"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-09-11T18:45:24Z", "updated_at": "2024-09-27T11:17:21Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1261", "field": "id", "value": "ENG-1403", "record": {"id": "ENG-1403", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_c77c50cc15c5342d", "creator_id": "usr_fc22d5941b2aeb5c", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1403", "number": 1403, "title": "Animation of level rewards sent to the places where they are used", "description": "After level beating, users will return to the main menu and the rewards they have earned will appear in the center of the screen and then go to the location where they were used\n\n* ~~Live-ops tokens goes to live-op icons~~     \u221a\n* ~~Character tokens goes to character icon on the bottom bar~~ \u221a\n* ~~mini-game tokens goes to mini-game icon on the bottom bar~~ \u221a\n* ~~life goes to life icon at the top bar~~ \u221a <-\u2014 i added this one\n\n[aditional_Rewards001.webm]([URL_51011])\n\nAlso make this for other objects:\n\nDiamonds, coins, etc. @[PERSON_NAME_0092] \n\nWe also need to make sure the balance shows before and after. Post destiny upgrade.\n\nOnce done we create ticket for engineer to  implement.", "priority": 3, "estimate": null, "due_date": null, "started_at": "2024-11-04T09:28:04Z", "completed_at": "2025-01-09T10:11:31Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 576563, "labels": ["VFX Integration", "Nova Release", "Sprint 26 Nova - Nov 22nd"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-09-12T18:45:30Z", "updated_at": "2025-01-09T10:11:31Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1283", "field": "id", "value": "ENG-1424", "record": {"id": "ENG-1424", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1424", "number": 1424, "title": "Streamline Tutorial Copywriting and Clean Up Localization Files (English and Spanish)", "description": "Review and make the tutorial copywriting more concise in the localization files. \n\nThe localization file is here: [[URL_51036])\n\nThis includes cleaning up both the English and Spanish versions to ensure clarity and consistency. The goal is to make the text more concise while maintaining the original intent and tone of the tutorial.", "priority": 4, "estimate": null, "due_date": null, "started_at": "2024-10-14T18:05:00Z", "completed_at": "2024-11-13T15:36:07Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 677317, "labels": ["Easy Fix - Just do it!", "Lava Hot Fix"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-09-13T17:50:19Z", "updated_at": "2024-12-02T17:19:04Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1296", "field": "id", "value": "ENG-1436", "record": {"id": "ENG-1436", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_EMPLOYEE_0032", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1436", "number": 1436, "title": "Fix improper dimming issue in tiledozer FTUE intro", "description": "'@[PERSON_NAME_0077].[PERSON_NAME_0012] said:\n\n> tiledozer tutorial allows tapping tabs at the bottom if it overlaps\n\n![IMG_2554.png]([URL_51056])", "priority": 3, "estimate": null, "due_date": null, "started_at": "2024-09-23T14:55:00Z", "completed_at": "2024-09-25T13:50:29Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 728984, "labels": ["Baklava Hot Fix", "Bug"], "links": [], "relations": [{"target": "ENG-1478", "type": "relates"}], "is_archived": false, "created_at": "2024-09-13T18:23:05Z", "updated_at": "2024-09-25T13:50:29Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1318", "field": "id", "value": "ENG-1456", "record": {"id": "ENG-1456", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1456", "number": 1456, "title": "Put lock icon on \"Season Pass\" and \"Social\" (Bottom right of UI) buttons.", "description": "Current behavior of these buttons: brings a pop up that says \"Coming Soon...\"\n\nNew improved behavior: (Just put a lock icon on it so they can't click it)\n\n@[PERSON_NAME_0054] said:\n\n> [PERSON_NAME_0120] said: social popup, season pass popup - unfinished, clickable through, better to remove them and replace w message like locked quests", "priority": 3, "estimate": null, "due_date": null, "started_at": "2024-09-13T23:52:19Z", "completed_at": "2024-09-17T07:20:47Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 740893, "labels": ["Baklava Hot Fix", "Improvement"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-09-13T21:07:21Z", "updated_at": "2024-09-17T07:20:47Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1338", "field": "id", "value": "ENG-1475", "record": {"id": "ENG-1475", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_49b9dfa5208d400d", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Canceled", "cycle_id": null, "identifier": "ENG-1475", "number": 1475, "title": "The bottom navigation bar overlay issue", "description": "The bottom navigation bar should serve for the purpose of easy navigation. If any screen like minigame hub, character screen, and store is de-selected, the overlay should be disabled and we can go back to the sagamap without loading times. \n\nAs of right now, the navigation buttons are scaled down by the second click but doesn't close the screen overlay. \n\n[[CREDIT_CARD_NUMBER_5765].0508650 (1).mp4]([URL_51091])", "priority": 4, "estimate": null, "due_date": null, "started_at": null, "completed_at": null, "canceled_at": "2024-09-27T17:26:08Z", "archived_at": null, "time_in_status_minutes": 725888, "labels": ["Desire Release", "Improvement"], "links": [], "relations": [{"target": "ENG-1420", "type": "relates"}], "is_archived": false, "created_at": "2024-09-17T14:32:26Z", "updated_at": "2024-09-27T17:26:12Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1346", "field": "id", "value": "ENG-1482", "record": {"id": "ENG-1482", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_PERSON_3233", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1482", "number": 1482, "title": "Give Option To Add \"Tap to Continue\" To Dim Screens", "description": "The tutorial editor supports a dimming feature, and basically need another option with it that will show a Tap to Continue message. \n\n![image.png]([URL_51099])", "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-09-19T18:55:09Z", "completed_at": "2024-09-29T09:48:12Z", "canceled_at": null, "archived_at": "2025-03-30T07:35:40Z", "time_in_status_minutes": 723466, "labels": ["Tutorial Editor"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-09-19T17:32:35Z", "updated_at": "2024-09-29T09:48:12Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1352", "field": "id", "value": "ENG-1488", "record": {"id": "ENG-1488", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_bdf01b53c6a92c5e", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1488", "number": 1488, "title": "River Tile and Memory Tile minigames aren't loaded", "description": "## **Version 0.1.1835 (1835)**\n\n\nBoth of the minigames are not loaded currently. \n\n[Record_[CREDIT_CARD_NUMBER_5775]_0ed2d384a7e28d6134e98d8e5c97b585.mp4]([URL_51109])\n\n![Screenshot_[CREDIT_CARD_NUMBER_5774]-28_0ed2d384a7e28d6134e98d8e5c97b585.jpg]([URL_51108])\n\n[Record_[CREDIT_CARD_NUMBER_5773]_0ed2d384a7e28d6134e98d8e5c97b585.mp4]([URL_51107])", "priority": 1, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-09-20T16:54:03Z", "canceled_at": null, "archived_at": "2025-03-26T07:35:24Z", "time_in_status_minutes": 736000, "labels": ["Bug"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-09-20T14:22:50Z", "updated_at": "2024-09-25T09:47:14Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1361", "field": "id", "value": "ENG-1496", "record": {"id": "ENG-1496", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_bdf01b53c6a92c5e", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1496", "number": 1496, "title": "Key symbol count is not updated by the remove abilities of both Julius and Nate", "description": "It only gets updated by any other board action like matching\n\n[Record_[CREDIT_CARD_NUMBER_5786]_0ed2d384a7e28d6134e98d8e5c97b585.mp4]([URL_51122])\n\n[Record_[CREDIT_CARD_NUMBER_5785]_0ed2d384a7e28d6134e98d8e5c97b585 (1).mp4]([URL_51121])", "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-09-24T13:37:21Z", "canceled_at": null, "archived_at": "2025-03-26T07:35:23Z", "time_in_status_minutes": 730437, "labels": ["Bug"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-09-20T15:16:17Z", "updated_at": "2024-09-25T09:47:15Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1364", "field": "id", "value": "ENG-1499", "record": {"id": "ENG-1499", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1499", "number": 1499, "title": "Add 10 coins for repeat play wins", "description": "We need to make a final adjustment to handle coin animations graciously for both first time play and repeat play of a level. If a player wins a repeat play, the player will be awarded 10 coins regardless of how many tiles they have finish at hand.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-09-23T16:09:13Z", "completed_at": "2024-09-24T08:15:42Z", "canceled_at": null, "archived_at": "2025-03-25T07:35:24Z", "time_in_status_minutes": 730759, "labels": ["Easy Fix - Just do it!", "Baklava Hot Fix"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-09-22T23:43:07Z", "updated_at": "2024-09-24T08:15:42Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1368", "field": "id", "value": "ENG-1501", "record": {"id": "ENG-1501", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_49b9dfa5208d400d", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1501", "number": 1501, "title": "Red Dot Behavior on Characters is broken", "description": "# UPDATED ISSUE\n\nios 1938\n\nRed dot disappears after upgrading the most-recent-unlocked character but there is still another upgradable character. \n\n[RPReplay_Final1727949431.MP4]([URL_51132])\n\n---\n\n---\n\n---\n\nAfter the latest changes in the home button's functions, the red dot doesn't disappear after upgrading characters until there is no upgradeable characters left. The red dot requires a refresh to be disappeared from the button. However, the refresh function of home button is removed so the red dot is kind of persistent without any refresh.\n\n[Record_[CREDIT_CARD_NUMBER_5793]_0ed2d384a7e28d6134e98d8e5c97b585.mp4]([URL_51131])\n\n[Record_[CREDIT_CARD_NUMBER_5792]_0ed2d384a7e28d6134e98d8e5c97b585.mp4]([URL_51130])\n\nIt still disappears after playing a level, changing the chapter, visiting a mini game, and quitting the app, but it stays there without any action so players might visit again and again then get frustrated that there is no action to take in that screen. \n\nThere is also 2 kinds of red notification behavior, one of them is throbbing, while the other one is static, and both have different placements.\n\n[Screen_Recording_20240930_212027_Domino Adventures.mp4]([URL_51129])", "priority": 1, "estimate": null, "due_date": null, "started_at": "2024-10-03T02:16:55Z", "completed_at": "2024-10-21T15:07:28Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 691467, "labels": ["Lava Hot Fix", "Bug"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-09-23T09:04:56Z", "updated_at": "2024-10-21T15:07:28Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1379", "field": "id", "value": "ENG-1511", "record": {"id": "ENG-1511", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1511", "number": 1511, "title": "Julius/Lexi/Nate targetable ability with hidden bias", "description": "Julius has a removal ability that removes a \"random\" face up tile.\n\nNate has the same ability.\n\nBoth these ability will need a hidden bias in terms of targeting priority.\n\nThis bias will trigger 40% of the time, when it isn't triggered, it's random. The priority from highest to lowest to remove a tile that is:\n\n1. A face up tile that does not connect with any tile ON THE BOARD AND TILE IN HAND.\n2. A face up tile that does not connect with any tile ON THE BOARD ONLY\n3. A face up tile that does not connect with any TILE IN HAND\n4. A face up tile that's a twin tile, AKA transitory tile (Both side = same symbol)\n5. A face up tile that has only 1 of 2 symbols that connects with ANY TILE ON BOARD AND TILE IN HAND\n6. A face up tile that has only 1 of 2 symbols that connects with ANY TILE ON BOARD\n7. A face up tile that has only 1 of 2 symbols that connects with TILE IN HAND\n8. Finally, if none of the tiles satisfy any of the criteria above, random tile is removed.\n\nAt higher level Julius will remove 2 of these tiles. The target check is independent for each removal. So he can remove 2 bad piece, 2 good pieces, or 1 of each as a result.\n\nOK, for Lexi, she has a foresight ability.\n\nThe bias will trigger 30% of the time, when it's triggered, the priority is:\n\n1. Reveal any children tile with a key symbol on it. (If key symbols are present in the level\n2. Random tile if no key tiles are present\n\nThis priority might get more complex if we see more balance changes are needed to make Lexi more powerful on non-key levels", "priority": 3, "estimate": null, "due_date": null, "started_at": "2024-09-24T16:29:00Z", "completed_at": "2024-10-11T22:31:33Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 705423, "labels": ["Characters", "Desire Release", "Submission Blocker", "Improvement"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-09-24T06:25:54Z", "updated_at": "2024-10-11T22:31:33Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1395", "field": "id", "value": "ENG-1526", "record": {"id": "ENG-1526", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_49b9dfa5208d400d", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1526", "number": 1526, "title": "The memory tile mini game stuck when the streak flips up the last tile need to match", "description": "The memory game is broken when the streak reveals one of the last matching tiles. After flipping the other tile to match, the game doesn't register it as a match. It happened on hard level. \n\nThe tapping has no function in the board but it doesn't cause any other issue other than not finishing the mini game. \n\nThe game in general is still functional and you can quit from the settings. \n\n[RPReplay_Final1727266241.MP4]([URL_51186])\n\nPlease increase tile flipping speed both reveal and hide by \\~25%\n\nPlease allow players to start flipping new tiles as soon as the hiding flip animation has started.", "priority": 3, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2025-05-05T19:16:17Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 408978, "labels": ["Bug", "Destiny"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-09-25T13:38:27Z", "updated_at": "2025-05-05T19:16:17Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1397", "field": "id", "value": "ENG-1528", "record": {"id": "ENG-1528", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_7fe31e7ec8199618", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1528", "number": 1528, "title": "Lock Shop Icon on the bottom menu tab until level 10 is completed", "description": "The Shop tab starts locked for new players. It gets unlocked after a player finishes level 10 and it unlocks at the same time the character tokens become available. \n\nCaveat: Users can still access the shop via +button on gems and and coins at the top menu but it's an acceptable behavior. They are going out of their way to press tiny buttons.", "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-09-29T10:19:24Z", "canceled_at": null, "archived_at": "2025-03-30T07:35:38Z", "time_in_status_minutes": 723435, "labels": ["Baklava Hot Fix", "Acceptable Behavior"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-09-25T15:52:18Z", "updated_at": "2024-09-29T10:19:24Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1400", "field": "id", "value": "ENG-1530", "record": {"id": "ENG-1530", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_fc22d5941b2aeb5c", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1530", "number": 1530, "title": "Rotation of bomb tiles in gameplay is different from the editor", "description": "![image.png]([URL_51190])\n\n* Because the rotation of the bombs is different from the editor, in some levels the pins of the bombs are not visible. Therefore, users may not realize that the bombs are lit\n* This can be tested at Chapter 3 level 7\n\nEXPECTED OUTCOME is to bomb tile should be visible as how is in the editor", "priority": 3, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-12-04T19:08:14Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 627866, "labels": ["Easy Fix - Just do it!", "Nova Release", "Puzzle Editor", "Bug"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-09-25T19:34:42Z", "updated_at": "2024-12-04T19:08:14Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1401", "field": "id", "value": "ENG-1531", "record": {"id": "ENG-1531", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1531", "number": 1531, "title": "Update abbreviations of items rewarded in all lists", "description": "We added a couple new type of items into our earn out list, please update the abbreviations according to the spec.\n\n[[URL_51192])\n\n![image.png]([URL_51191])\n\nWe added a couple of new", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-09-30T16:25:59Z", "completed_at": "2025-01-16T18:05:09Z", "canceled_at": null, "archived_at": "2025-07-17T03:19:42Z", "time_in_status_minutes": 566009, "labels": ["Desire Release", "Analytics"], "links": [], "relations": [{"target": "ENG-1532", "type": "relates"}], "is_archived": true, "created_at": "2024-09-25T22:00:11Z", "updated_at": "2025-01-16T18:05:09Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1402", "field": "id", "value": "ENG-1532", "record": {"id": "ENG-1532", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1532", "number": 1532, "title": "Update left_level Event", "description": "We need to update left_level event on a couple of fields: [[URL_51197])\n\n1- hero -> let's capture not only the hero players are using but also the level of hero being used. I changed the field from string to list \n\n![image.png]([URL_51196])\n\n2- booster_usage -> it's needs to capture `gu` gust. Please use the new abbreviation list in [ENG-1531](https://linear.app/harmonygames-games/issue/ENG-1531/update-abbreviations-of-items-rewarded-in-all-lists) to add gust and also update other nomenclature\n\n![image.png]([URL_51195])\n\n3- level_summary -> it has new field to capture the type of the level that players are completing. this new subfield is called `lt` (level type) and R = regular, T = train, D= domino chest\n\n![image.png]([URL_51194])\n\n4- level_rewards -> it should now capture rewards from domino chest separately. For that we'll use dc:\\[list\\] as shown in the screenshot. \n\nWe also need to add count of leftover tiles as `lot`.\n\n![image.png]([URL_51193])\n\n5- Rewinds, wild tile bought sends data only as null - It's unlikely no one has ever bought a any of those in a level with their coins according to the data. We do have bought data for +3 tiles - please check the logic: [https://harmonygames.metabaseapp.com/question#](https://harmonygames.metabaseapp.com/question#)", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-09-28T23:41:50Z", "completed_at": "2025-01-16T18:05:08Z", "canceled_at": null, "archived_at": "2025-07-17T03:19:41Z", "time_in_status_minutes": 566009, "labels": ["Desire Release", "Analytics"], "links": [], "relations": [{"target": "ENG-1531", "type": "relates"}], "is_archived": true, "created_at": "2024-09-25T22:10:33Z", "updated_at": "2025-01-16T18:05:08Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1408", "field": "id", "value": "ENG-1538", "record": {"id": "ENG-1538", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1538", "number": 1538, "title": "Implement Chapter Unlock Event", "description": "We need a chapter unlock event in the game: The definition is here: \n\n[[URL_51203])\n\n![image.png]([URL_51202])", "priority": 4, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-11-04T19:15:56Z", "canceled_at": null, "archived_at": "2025-05-05T08:10:27Z", "time_in_status_minutes": 671058, "labels": ["Destiny", "Analytics"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-09-26T23:49:21Z", "updated_at": "2024-11-04T19:15:56Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1409", "field": "id", "value": "ENG-1539", "record": {"id": "ENG-1539", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1539", "number": 1539, "title": "Add New Fields to Super Properties", "description": "We want to add a couple new properties to the list of properties that we attach to every event.\n\n[[URL_51205])\n\n![image.png]([URL_51204])\n\nWe have 3 new fields \n\nplayer_balance\n\ngeneral_stats \n\nplayer_name\n\nWe can also get rid of the following fields since they will be now captured under the new fields\n\n~~memory_game_total_attempts~~\n\n~~gold_balance~~\n\n~~lives_balance~~\n\n~~hero_shards_balance~~", "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-09-29T00:59:07Z", "completed_at": "2025-01-16T18:05:08Z", "canceled_at": null, "archived_at": "2025-07-17T03:19:41Z", "time_in_status_minutes": 566009, "labels": ["Baklava Hot Fix", "Analytics"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-09-26T23:53:29Z", "updated_at": "2025-01-16T18:05:08Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1410", "field": "id", "value": "ENG-1540", "record": {"id": "ENG-1540", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1540", "number": 1540, "title": "Quest_reward_redeem event captures the updated chest content", "description": "Please make sure `chest_content` uses the new abbreviations \n\n![image.png]([URL_51206])", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-10-15T17:32:36Z", "completed_at": "2025-01-16T18:05:08Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 566009, "labels": ["Lava Hot Fix", "Analytics"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-09-26T23:55:24Z", "updated_at": "2025-01-16T18:05:08Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1411", "field": "id", "value": "ENG-1541", "record": {"id": "ENG-1541", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1541", "number": 1541, "title": "Implement liveops_completion event", "description": "We need a new event to track live ops step completions. Here is the spec [[URL_51208])\n\n![image.png]([URL_51207])", "priority": 1, "estimate": null, "due_date": null, "started_at": "2024-10-15T17:32:33Z", "completed_at": "2025-01-16T18:05:08Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 566009, "labels": ["Lava Hot Fix", "Analytics"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-09-27T00:09:57Z", "updated_at": "2025-01-16T18:05:08Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1412", "field": "id", "value": "ENG-1542", "record": {"id": "ENG-1542", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1542", "number": 1542, "title": "Implement mini_game event", "description": "We are deprecating the existing conveyor_belt and memory_game events and instead adding a more generic mini_game event that can capture data for all sorts of mini games.\n\nThe spec is here: [[URL_51210])\n\n![image.png]([URL_51209])", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-10-14T19:33:19Z", "completed_at": "2025-01-16T18:05:09Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 566009, "labels": ["Lava Hot Fix", "Analytics"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-09-27T03:22:02Z", "updated_at": "2025-01-16T18:05:09Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1413", "field": "id", "value": "ENG-1543", "record": {"id": "ENG-1543", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_EMPLOYEE_0032", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1543", "number": 1543, "title": "Implement additional reward screen for both mini games when no prizes have been won.", "description": "Update 10/4/2024: FIGMA LINK HERE [[URL_51211])\n\nLet's look at all the screens and I'll explain the behavior:\n\n![image.png]([URL_51213])\n\nWhen players are out of tokens and they try to fire a token in lucky drop or tile dozer, they get the screen pop up on the left. If they hit stay, they go back to the game. If they press exit, then they get:\n1) The screen in the middle if they have not earned anything\n\n2) The screen to the right if they have earned some rewards.\n\nHowever if the player tries to quit the game via the X button, then they are presented either the middle or the right screen immediately, per original ticket.\n\n**Below is the old ticket:**\n\nWe need an exit screen with a proper messaging when they haven't won any prizes. It looks like this:\n\n![image.png]([URL_51212])\n\nFigma link here: [[URL_51211])\n\nThe info button, when clicked, will bring up the info graphics for the respective game. Same behavior as the info button in the mini game.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-10-09T11:17:31Z", "completed_at": "2024-10-15T14:35:35Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 700139, "labels": ["Lava Hot Fix", "Improvement", "Mini Game"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-09-27T05:35:59Z", "updated_at": "2024-10-15T14:35:35Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1417", "field": "id", "value": "ENG-1547", "record": {"id": "ENG-1547", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_49b9dfa5208d400d", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Canceled", "cycle_id": null, "identifier": "ENG-1547", "number": 1547, "title": "New vanishing tile has a weird glowy line while flipping", "description": "AS you can see, the blue glow is stretching vertically while it's flipping both down and up. \n\n[RPReplay_Final1727435354.MP4]([URL_51221])", "priority": 4, "estimate": null, "due_date": null, "started_at": null, "completed_at": null, "canceled_at": "2024-10-09T22:14:42Z", "archived_at": "2025-04-10T07:35:20Z", "time_in_status_minutes": 708320, "labels": ["Baklava Hot Fix", "Bug"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-09-27T16:15:13Z", "updated_at": "2024-10-09T22:14:42Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1420", "field": "id", "value": "ENG-155", "record": {"id": "ENG-155", "project_id": null, "team_id": "team_ENG", "parent_id": "EPI-14", "assignee_id": "usr_49b9dfa5208d400d", "creator_id": "usr_cc3e90160f490686", "state_id": "Done", "cycle_id": null, "identifier": "ENG-155", "number": 155, "title": "Pull stuff off this list and create tasks that you think can fit in this sprint", "description": "Current spec on time-duration based boost from MVP GDD.\n\n## **Time Duration Boosts**\n\nThe 4 time duration boosts are purchased using gems only and are activated in the pre-level pop up dialog:\n\n* Infinite lives\n  * This can have various durations, 15 minutes, 30 minutes, 1 hour, etc.\n* \\+3 Cards to draw pile at start of the game\n  * We can also have different variants, +1 cards, +3 cards, +5 cards and the duration can also vary, similar to infinite lives\n* \\+2 Wildcards inserted into the hand at beginning of the game\n  * The wild cards are inserted into the 4th and 8th position of the player's draw pile\n* \\+1 Active card slot\n  * When both active cards in hand are eligible to be matched, the priority is as follow:\n    * The card that has a \u201cdouble\u201d match (a full piece match on both halves) is prioritized.\n    * Otherwise, the older card in hand is prioritized, this means out of the 2 cards you have in your hand, the first one that entered your hand is the \u201colder\u201d one.\n    * In a scenario where there are 3 identical cards total, 1 on the board to be matched away, and 2 in your hand, then the older, full matched card takes priority.\n* If a time duration boost is activated when there already is the same identical boost active, the duration of the newly activated boost will just be added to the existing active one.\n* You cannot remove any active boosts by disabling them prematurely, they can only expire naturally on its own when the timer reaches 0\n* There will be 4 slots for time duration boosts\n* Boosts can come in various durations: 15 minutes, 30 minutes, 1 hour, 4 hours, 8 hours.", "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2023-10-31T08:42:35Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1204492, "labels": ["Time Duration Boosts"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-08-21T18:33:00Z", "updated_at": "2023-10-31T08:42:35Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1421", "field": "id", "value": "ENG-1550", "record": {"id": "ENG-1550", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_PERSON_3233", "creator_id": "usr_fc22d5941b2aeb5c", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1550", "number": 1550, "title": "can't open the saga map of the test chapter from debug", "description": "[[CREDIT_CARD_NUMBER_5817].9848929.mp4]([URL_51224])\n\nAlthough I made a new chapter for testing and set it as visible, I cannot open my test chapter by doing Load scene or from chapter list", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-10-01T15:45:19Z", "completed_at": "2024-10-04T14:59:12Z", "canceled_at": null, "archived_at": "2025-04-05T07:35:33Z", "time_in_status_minutes": 715955, "labels": ["Puzzle Editor", "Baklava Hot Fix", "Bug"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-09-27T17:21:30Z", "updated_at": "2024-10-04T14:59:12Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1426", "field": "id", "value": "ENG-1555", "record": {"id": "ENG-1555", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_bdf01b53c6a92c5e", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1555", "number": 1555, "title": "Domino Chest Rewards Clips through board when level ends and prizes have strange placements if it is flying out of a chest that spawned on the left side of the board", "description": "Do we need to change the pathing a bit so the flying looks better?\n\nOr do we instantiate it higher above the game board?\n\n[RPReplay_Final1727795361.MP4]([URL_51228])\n\n![image.png]([URL_51227])\n\nNote the weird angle of prizes when the domino chest is on the left bottom.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-10-03T17:45:36Z", "completed_at": "2024-10-25T15:06:22Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 685708, "labels": ["Lava Hot Fix", "Bug"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-09-28T16:44:12Z", "updated_at": "2024-10-25T15:06:22Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1435", "field": "id", "value": "ENG-1563", "record": {"id": "ENG-1563", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_caafeec2804b3a67", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1563", "number": 1563, "title": "Clicking Sound Missing from a lot of button clicks", "description": "The sound we want to use is the SAME EXACT ONE as the map selection button or bottom UI menu selection sound.\n\nThat sound is missing from these following UI interactions:\n\n 1. click on a saga map node\n 2. click on settings button at home\n 3. \\+ button next to the gold coins and gems at home screen\n 4. X button exiting the shop\n 5. X button exiting settings screen\n 6. ALL the button on the settings menu\n 7. Closing the pre level dialogue\n 8. \\+ button next to the life counter\n 9. Purchasing a package button from the shop\n10. Tabs in the shop\n11. In game settings menu\n12. In game quitting button and stay button\n13. End game screen interactions\n14. +5 card out of moves screen interactions\n15. Exit game confirmation dialog\n16. Home/Retry buttons after level loss\n17. Profile clicks and the entire profile section", "priority": 4, "estimate": null, "due_date": null, "started_at": "2024-10-16T22:59:13Z", "completed_at": "2024-10-31T21:03:22Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 676711, "labels": ["Lava Hot Fix", "Improvement", "Main Game"], "links": [], "relations": [{"target": "ENG-1618", "type": "relates"}], "is_archived": false, "created_at": "2024-09-28T20:38:41Z", "updated_at": "2024-10-31T21:03:22Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1456", "field": "id", "value": "ENG-1582", "record": {"id": "ENG-1582", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_c77c50cc15c5342d", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1582", "number": 1582, "title": "In river tile game move up the bottom dock + tile upward so it's not obstructed on iOS device", "description": "Leonard attach screenshots to illustrate his complaints. Dock needs to move up.", "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-10-01T16:04:57Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 720209, "labels": ["Desire Release"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-09-30T16:32:38Z", "updated_at": "2024-10-09T15:13:07Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1462", "field": "id", "value": "ENG-1588", "record": {"id": "ENG-1588", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-1390", "assignee_id": "usr_PERSON_3233", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1588", "number": 1588, "title": "The memory tile end-game pop up is too small compared to the river tile on iPad", "description": "The memory tile end-game pop up is too small compared to the river tile on iPad\n\n* The small memory game end pop up\n\n![image.png]([URL_51270])\n\nI think we should match the size of both minigame end pop-ups. The memory game one is too small. \n\n![image.png]([URL_51269])\n\nthat screen is a little bit scaled down compared to the river tile.", "priority": 3, "estimate": null, "due_date": null, "started_at": "2024-09-30T19:51:34Z", "completed_at": "2024-10-01T11:23:01Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 720491, "labels": [], "links": [], "relations": []