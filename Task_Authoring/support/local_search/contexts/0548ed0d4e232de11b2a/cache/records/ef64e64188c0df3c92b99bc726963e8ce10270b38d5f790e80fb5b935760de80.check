{"signature": "ccd3146298ef3a66b57c6e20661a43d086425a8e2788a60ae9713f071f21f8ae", "result": {"checks": {"check": {"scope": {"id": "check", "service": "slack", "file": "messages/C3DD99314033/2025-09.json", "field": "ts", "values": ["1758277446.760689", "1758278332.829229", "1758278614.159489", "1758638347.261499", "1758721819.413819", "1758897452.326879", "1758897470.427299", "1758898264.004789"], "pointer": ""}, "matches": [{"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C3DD99314033/2025-09.json", "pointer": "/5", "field": "ts", "value": "1758277446.760689", "record": {"id": "61b90c743d16828f7459d22caab4a5a0", "ts": "1758277446.760689", "type": "message", "user": "PERSON_6089_SLACK_ID", "text": "\u2611 In the lock state, the default green bottles are visible, but when I activate the event, the bottles update to the color of that day\u2019s event item. The bottle visuals should be updated as soon as the game starts based on the event color of the day, and this change should be reflected everywhere. :warning:", "channel": "C3DD99314033", "thread_ts": "1758277446.760689", "reply_count": 1, "reply_users_count": 1, "latest_reply": "1758277480.440839", "is_activity_message": false, "subtype": "document_comment_root", "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C3DD99314033/2025-09.json", "pointer": "/23", "field": "ts", "value": "1758278332.829229", "record": {"id": "915b21e782c251f416aae085d9c4e0a3", "ts": "1758278332.829229", "type": "message", "user": "PERSON_6089_SLACK_ID", "text": "\u2610 To keep the lock state COnsistent with the other events, we should make the following changes:", "channel": "C3DD99314033", "thread_ts": "1758278332.829229", "reply_count": 1, "reply_users_count": 1, "latest_reply": "1758278344.663259", "is_activity_message": false, "subtype": "document_comment_root", "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C3DD99314033/2025-09.json", "pointer": "/27", "field": "ts", "value": "1758278614.159489", "record": {"id": "be6b716b18d9dd9573a87ca82ef23a42", "ts": "1758278614.159489", "type": "message", "user": "PERSON_6089_SLACK_ID", "text": "\u2611 We can add particle and glow effects to the in-game bottle items, similar to the pre-game boosters. Since the bottles come in different colors, the effect should use a default color(like white)", "channel": "C3DD99314033", "thread_ts": "1758278614.159489", "reply_count": 1, "reply_users_count": 1, "latest_reply": "1758278623.168899", "is_activity_message": false, "subtype": "document_comment_root", "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C3DD99314033/2025-09.json", "pointer": "/42", "field": "ts", "value": "1758638347.261499", "record": {"id": "f69b8d55b390880b435e5913f4eef2d9", "ts": "1758638347.261499", "type": "message", "user": "PERSON_6089_SLACK_ID", "text": "\u2611 Rewards given are doubled. :warning: ", "channel": "C3DD99314033", "thread_ts": "1758638347.261499", "reply_count": 5, "reply_users_count": 3, "latest_reply": "1758738241.598959", "is_activity_message": false, "subtype": "document_comment_root", "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C3DD99314033/2025-09.json", "pointer": "/55", "field": "ts", "value": "1758721819.413819", "record": {"id": "955be2f6614a862941b4a7ea40d51c4b", "ts": "1758721819.413819", "type": "message", "user": "PERSON_6089_SLACK_ID", "text": "\u2611 The rewards given are decreasing the inventory instead of increasing it:warning: ", "channel": "C3DD99314033", "thread_ts": "1758721819.413819", "reply_count": 3, "reply_users_count": 1, "latest_reply": "1758722167.997319", "is_activity_message": false, "subtype": "document_comment_root", "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C3DD99314033/2025-09.json", "pointer": "/71", "field": "ts", "value": "1758897452.326879", "record": {"id": "750a08654128af62ee435f1e19520c5b", "ts": "1758897452.326879", "type": "message", "user": "PERSON_6089_SLACK_ID", "text": "\u2610 When the page opened, it shows placeholder images at first.", "channel": "C3DD99314033", "thread_ts": "1758897452.326879", "reply_count": 1, "reply_users_count": 1, "latest_reply": "1758897466.029729", "is_activity_message": false, "subtype": "document_comment_root", "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C3DD99314033/2025-09.json", "pointer": "/75", "field": "ts", "value": "1758897470.427299", "record": {"id": "44314141dbc45151c8723ebec888cea3", "ts": "1758897470.427299", "type": "message", "user": "PERSON_6089_SLACK_ID", "text": "\u2610 The reward amounts are jiggling when I open up the event page", "channel": "C3DD99314033", "thread_ts": "1758897470.427299", "reply_count": 1, "reply_users_count": 1, "latest_reply": "1758897529.256939", "is_activity_message": false, "subtype": "document_comment_root", "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C3DD99314033/2025-09.json", "pointer": "/78", "field": "ts", "value": "1758898264.004789", "record": {"id": "1709e7c377fcc79ae3328b7de210c631", "ts": "1758898264.004789", "type": "message", "user": "PERSON_6089_SLACK_ID", "text": "\u2610 Tablet UI Improvements", "channel": "C3DD99314033", "thread_ts": "1758898264.004789", "reply_count": 2, "reply_users_count": 1, "latest_reply": "1758898484.612519", "is_activity_message": false, "subtype": "document_comment_root", "reactions": [], "files": [], "attachments": []}}], "records_checked": 81, "files_selected": 1, "files_completed": 1, "scan_complete": true, "errors": []}}, "files_read_this_call": 4, "sources": [{"file": "HarmonyGames_Other_Services/Services_Data