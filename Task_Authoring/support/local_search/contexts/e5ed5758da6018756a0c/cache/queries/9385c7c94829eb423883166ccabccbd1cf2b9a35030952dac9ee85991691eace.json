se, "errors": [], "persona_filtered": false, "scope": "JSON scalar values; excludes root/ blobs and non-JSON attachments", "stop_reason": "match limit reached; narrow by file/pointer/key or raise limit"}}, "backend": "batch-text-scan", "files_read_this_call": 4272, "scope": {"service": "slack", "file_pattern": "messages/*/202[45]-*.json"}}, "checksum": "34422f4247b338b1ca50e4340e0d31813a2aea183cb59bc58fba7a01ebb966f2"}