{"signature": "9a377bf46f9d88751caca21433076ecc9a37525698d1194dea392d9f7ebe3b91", "result": {"checks": {"check": {"scope": {"id": "check", "service": "github", "file": "data.json", "pointer": "/pull_requests", "field": "number", "values": [370, 468, 470, 471, 472, 477]}, "matches": [{"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/1245", "field": "number", "value": 370, "record": {"id": "harmonygames-Games/GameOfDominoes#370", "repo_id": "harmonygames-Games/GameOfDominoes", "number": 370, "title": "New Highlight System", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0025_GITHUB_USERNAME", "merged_by_login": "PERSON_5877_GITHUB_USERNAME", "body": "Fixed up some other tutorials\r\nMade graph editor slightly better", "base_ref": "develop", "base_sha": "03d4831b0478a590baa4e7c9e552ea46c16aaaaa", "head_ref": "Blake/tutorialFixes", "head_sha": "d2793554c8993a1bca6c1a710af8346f14b628a2", "additions": 15879, "deletions": 457, "changed_files": 189, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["PERSON_0003_GITHUB_USERNAME", "EMPLOYEE_0001_GITHUB_USERNAME"], "created_at": "2024-02-16T17:44:13Z", "updated_at": "2024-05-23T21:51:03Z", "merged_at": "2024-02-16T18:12:04Z", "closed_at": "2024-02-16T18:12:04Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/1353", "field": "number", "value": 468, "record": {"id": "harmonygames-Games/GameOfDominoes#468", "repo_id": "harmonygames-Games/GameOfDominoes", "number": 468, "title": "Level Objectives for Star Ranking [Pending UI and VFX]", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "- Added Level Objectives to PuzzlePipeline\r\n- Updated DominoGameManager.cs, DominoHand.cs, RewardsMechanic.cs and StarObjectives.cs to handle new Level Objectives", "base_ref": "develop", "base_sha": "0f483b904aed6381d50d4a10b09429859dcff25f", "head_ref": "[PERSON_NAME_0067]/puzzlePipelineObjectives", "head_sha": "3d083a4f93e5e7dc490f7d1b1ce513068faf8a62", "additions": 4096, "deletions": 475, "changed_files": 11, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["PERSON_0003_GITHUB_USERNAME", "EMPLOYEE_0001_GITHUB_USERNAME"], "created_at": "2024-03-20T23:16:44Z", "updated_at": "2024-03-21T18:29:49Z", "merged_at": "2024-03-21T18:29:49Z", "closed_at": "2024-03-21T18:29:49Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/1356", "field": "number", "value": 470, "record": {"id": "harmonygames-Games/GameOfDominoes#470", "repo_id": "harmonygames-Games/GameOfDominoes", "number": 470, "title": "Added Assets from Figma to Unity & RatingPrompt script", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0004_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Added Assets from Figma to Unity & RatingPrompt script.", "base_ref": "develop", "base_sha": "b57b495ae0c523dc8e92aaad89455b38a32c81fd", "head_ref": "Samuel/RateUsScreen", "head_sha": "a18bdf611dd16278a7f900f9007594a808e54499", "additions": 11744, "deletions": 772, "changed_files": 18, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2024-03-21T22:58:07Z", "updated_at": "2024-03-21T23:11:45Z", "merged_at": "2024-03-21T23:11:45Z", "closed_at": "2024-03-21T23:11:45Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/1357", "field": "number", "value": 471, "record": {"id": "harmonygames-Games/GameOfDominoes#471", "repo_id": "harmonygames-Games/GameOfDominoes", "number": 471, "title": "Tutorial Requirements", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0025_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0001_GITHUB_USERNAME", "body": "Adding 'Requirements' array that will only allow a tutorial to start once a certain game state exists (player has 0 lives, player has >= 50 stars, player has completed 10 levels).\r\nIt's connected to Firebase's remote config so it can be overridden by the remote config system or used in an A/B test.\r\n\r\nAlso removed legacy tutorial stuff.", "base_ref": "develop", "base_sha": "bf501b9b54be0b0b6b9b34b2625a5960d71822fe", "head_ref": "Blake/minigameAB", "head_sha": "1bc0796a8bcb2246604eaab5b49ba521b9ab672f", "additions": 925, "deletions": 26651, "changed_files": 79, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2024-03-21T23:39:51Z", "updated_at": "2024-03-22T23:01:13Z", "merged_at": "2024-03-22T19:00:48Z", "closed_at": "2024-03-22T19:00:48Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/1358", "field": "number", "value": 472, "record": {"id": "harmonygames-Games/GameOfDominoes#472", "repo_id": "harmonygames-Games/GameOfDominoes", "number": 472, "title": "Vanishing Tile Adjustments", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0001_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "+ Streakbar Refactor", "base_ref": "develop", "base_sha": "5c8bb0db5b28cc0155341616fc1925c1311b922a", "head_ref": "[PERSON_NAME_0099]/streakBarFixes", "head_sha": "0d25bb4a6d17929dbf14089db73b41d9dbefbeb1", "additions": 503, "deletions": 670, "changed_files": 17, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2024-03-22T07:40:30Z", "updated_at": "2024-04-24T17:14:06Z", "merged_at": "2024-03-25T22:37:23Z", "closed_at": "2024-03-25T22:37:23Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/1363", "field": "number", "value": 477, "record": {"id": "harmonygames-Games/GameOfDominoes#477", "repo_id": "harmonygames-Games/GameOfDominoes", "number": 477, "title": "Origin/harmonygames/Samuel/fixed tutorial pointer", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0004_GITHUB_USERNAME", "merged_by_login": "PERSON_0003_GITHUB_USERNAME", "body": "Fixed Tutorial Pointer on \"Rating Us\" screen.", "base_ref": "develop", "base_sha": "242971fb88acba6d607b4cbe3da94bf75e64cf8a", "head_ref": "origin/harmonygames/Samuel/FixedTutorialPointer", "head_sha": "388a43a7d1f282b3783bba31db7f9edbebc59508", "additions": 753, "deletions": 6, "changed_files": 11, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2024-03-23T00:21:11Z", "updated_at": "2024-03-23T00:23:33Z", "merged_at": "2024-03-23T00:23:33Z", "closed_at": "2024-03-23T00:23:33Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2350", "field": "number", "value": 370, "record": {"id": "harmonygames-Games/match3d#370", "repo_id": "harmonygames-Games/match3d", "number": 370, "title": "Collect&Win Items", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0009_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0016_GITHUB_USERNAME", "body": "Sports Item added\r\n-Baseball\r\n-Ping Pong Paddle\r\n-Bowling Pin\r\nCollect&Win Items Potion bottles Added\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **New Features**\n  * Added metadata for new 3D sports models: Baseball, Bowling Pin, and Ping Pong Paddle.\n  * Added metadata for a new 3D weapon model: Skull Potion.\n  * Added metadata for new prefab items: Collect&Win Potion (Medium Blue2, Green2, Orange2, Pink2, Red1), Baseball Small Red3, Bowling Pin Medium Red3, and PingPong Paddle Medium Red1.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "bcfc0fbc0ad3fce7c38fc8e140846f692eb1e2d3", "head_ref": "ClaireNewObjects_03", "head_sha": "235e49e243d90b7cf79b1140449a2de1eef78394", "additions": 1968, "deletions": 0, "changed_files": 24, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-08-08T13:22:06Z", "updated_at": "2025-08-13T16:12:18Z", "merged_at": "2025-08-13T16:12:18Z", "closed_at": "2025-08-13T16:12:18Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2458", "field": "number", "value": 468, "record": {"id": "harmonygames-Games/match3d#468", "repo_id": "harmonygames-Games/match3d", "number": 468, "title": "Collect And Win", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **New Features**\n  * Added \"Collect & Win\" live event: collect tokens in levels, track progress, claim stage rewards and a grand prize; main screen, progress widget, info panel, stage/prize items, and level-end token display.\n\n* **Improvements**\n  * Tokens spawn in unlocked levels, persist on level win, can be saved/claimed; new VFX/animations and reward-screen queuing.\n\n* **Developer Tools**\n  * Debug panel options to add tokens and reset event data; new backend requests to support the flow.\n\n* **Chores**\n  * Added sprites, prefabs, materials and asset metadata for the event.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "f5c0bb3a977a2d9b4e6b9559cd382d65548cb6c0", "head_ref": "[PERSON_NAME_0067]/winAndCollect", "head_sha": "648e2c7b9c1d9e263f4b43a45e135ba9fa6002fd", "additions": 54216, "deletions": 32, "changed_files": 127, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-26T20:16:25Z", "updated_at": "2025-09-29T16:13:50Z", "merged_at": "2025-09-29T16:13:50Z", "closed_at": "2025-09-29T16:13:50Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2461", "field": "number", "value": 470, "record": {"id": "harmonygames-Games/match3d#470", "repo_id": "harmonygames-Games/match3d", "number": 470, "title": "Collect And Win minor bugs fixes", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Fixes:\r\n* When the page opened, it shows placeholder images at first.\r\n* After level completion, it first shows placeholder icon and progress for the event, then shows the correct one\r\n* In every level, I got two errors both backend and client. \r\n* In Boss arena and endless mode, the c&w UI is visible. \n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n- Refactor\n  - Collect & Win screens now use pooled UI items for faster loading, smoother scrolling, reduced flicker, improved ordering and cleanup when refreshing content.\n- New Features\n  - Auto-scrolls to the first unclaimed reward/grand prize when opening the screen.\n  - Reward and grand-prize items now reflect claimed state (labels hidden for claimed stages).\n- Bug Fixes\n  - Next Reward icon visibility corrected based on event lock.\n  - Token counter/panel shown only when relevant (avoids Endless/Infinite Boss modes).\n  - UI elements remain hidden until data/initialization to prevent brief flashes.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "88879d8bb88eef8203be592f5189a76d17f3b782", "head_ref": "[PERSON_NAME_0067]/winAndCollectMinorBugs", "head_sha": "4935e9483a95d78b3a58d18794bacd97816787e8", "additions": 166, "deletions": 33, "changed_files": 10, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-29T21:22:50Z", "updated_at": "2025-09-30T15:51:15Z", "merged_at": "2025-09-30T15:51:15Z", "closed_at": "2025-09-30T15:51:15Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2462", "field": "number", "value": 471, "record": {"id": "harmonygames-Games/match3d#471", "repo_id": "harmonygames-Games/match3d", "number": 471, "title": "Samuel/zom 498 536", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0004_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Fixing UI Elements - UI polishes.\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **New Features**\n  * Leaderboard toggle now updates its text shadow color based on state for clearer visual feedback.\n\n* **Chores**\n  * Increased texture resolution and adjusted compression for multiple booster icons to improve clarity.\n  * Added new sprite assets (e.g., tornado popup, blue bar) and updated Daily Gift sprite configuration.\n  * Updated platform-specific texture settings (including Windows Store) for more consistent visuals across devices.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "88879d8bb88eef8203be592f5189a76d17f3b782", "head_ref": "Samuel/ZOM-498-536", "head_sha": "ff5bee4c66194a87e0f4fb85ea5a5a9055c9b122", "additions": 10933, "deletions": 962, "changed_files": 37, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-29T22:00:53Z", "updated_at": "2025-09-30T15:52:24Z", "merged_at": "2025-09-30T15:52:24Z", "closed_at": "2025-09-30T15:52:24Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2463", "field": "number", "value": 472, "record": {"id": "harmonygames-Games/match3d#472", "repo_id": "harmonygames-Games/match3d", "number": 472, "title": "Implement Win&Collect into Queue Manager", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0003_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Implement Win&Collect into Queue Manager\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **Bug Fixes**\n  * Prevents premature progression during reward animations by waiting for Collect & Win status when available.\n  * Reduces unnecessary delays, improving responsiveness and shortening input-block time after rewards.\n  * Adds a timeout guard to avoid stalls if visual effects don\u2019t complete promptly.\n\n* **Refactor**\n  * Streamlined reward VFX flow with clearer, coroutine-driven sequencing.\n  * Exposed an explicit method to trigger Collect & Win status checks, allowing more precise timing with UI updates and effects.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "88879d8bb88eef8203be592f5189a76d17f3b782", "head_ref": "[PERSON_NAME_0029]/ImplementQueueManager", "head_sha": "1e446a5726619a7f165f2ed7a50a4bf46fe4f42d", "additions": 36, "deletions": 21, "changed_files": 3, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["PERSON_5877_GITHUB_USERNAME"], "created_at": "2025-09-29T22:36:36Z", "updated_at": "2025-09-30T15:53:04Z", "merged_at": "2025-09-30T15:53:04Z", "closed_at": "2025-09-30T15:53:04Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2468", "field": "number", "value": 477, "record": {"id": "harmonygames-Games/match3d#477", "repo_id": "harmonygames-Games/match3d", "number": 477, "title": "Collect And Win Analytics and title change", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n- New Features\n  - App emits and tracks Collect & Win start and reward-claimed events (includes event duration, stage, and reward details).\n- Improvements\n  - Total event duration now computed from explicit start and end times for more accurate reporting.\n  - Screens update and report timing consistently across flows.\n- Bug Fixes\n  - Initial color/state corrected to avoid an unintended default on load.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "166dc182aad2c6de4df28992268ea65e9600754a", "head_ref": "[PERSON_NAME_0067]/collectAndWinAnalytics", "head_sha": "8544a28e108d2c870f1bd5b961e235ed566830df", "additions": 97, "deletions": 13, "changed_files": 9, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-30T22:26:30Z", "updated_at": "2025-10-02T16:44:58Z", "merged_at": "2025-10-02T16:43:03Z", "closed_at": "2025-10-02T16:43:03Z", "html_url": null}}], "records_checked": 2629, "files_selected": 1, "files_completed": 1, "scan_complete": true, "errors": []}}, "files_read_this_call": 5, "sources": [{"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "manifest_sha256": "d35cbcc83ffe5c3bc1a07052843dc96ecbc2d91630784a944b8eae8433d8c0cd", "freshness": "9d7b451a6e539599e0732e983c0b533019b0260e92ec9c372a249b6f651c5c3d"}], "scan_complete": true, "persona_filtered": false, "backend": "grouped-record-scan", "scope_note": "Exact direct fields in selected arrays. No SQL is applied. Absence/uniqueness is supported only within complete declared scopes. Manifest hashes are declared provenance, not fresh full-content hashes."}, "checksum": "af6e5e6736328450e4cd029384e2d8e9269ab3c7ba65d323c1b08b1eb6e4e1d3"}