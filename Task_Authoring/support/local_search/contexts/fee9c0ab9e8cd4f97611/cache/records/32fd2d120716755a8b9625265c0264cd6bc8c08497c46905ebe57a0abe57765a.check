_SLACK_ID", "record": {"id": "01a01267d6031b4e6536fb3eec8f6a68", "ts": "1754592255.396409", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "[PERSON_NAME_0022]'la bi konu\u015fal\u0131m m\u0131 belki k\u0131sadan halledebilir", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/250", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "538d635ccbd23d1cb7252feee5817d1a", "ts": "1754592311.363039", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "[PERSON_NAME_124640] [USERNAME_58658]", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "pray", "users": ["EMPLOYEE_0026_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/252", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "4fc99914e66cd9deab8ca025386e654f", "ts": "1754592560.096809", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Ben de o y\u00fczden per\u015fembeleri d\u00f6rt g\u00f6zle \u00e7ekiyorum ama sonra her per\u015fembe bi bok oluyor aslkd\u015flask\u015fd", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/253", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "0d3311a2fd61ec6a6ee434380839bde6", "ts": "1754592569.537609", "type": "message", "user":