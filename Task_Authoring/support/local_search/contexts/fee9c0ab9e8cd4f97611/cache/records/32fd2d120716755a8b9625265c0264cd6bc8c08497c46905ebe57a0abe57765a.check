"reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/94", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "a26c473f99c7619f644ff742a53514b3", "ts": "1754556733.034239", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "`[USERNAME_4583]`", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/95", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "442de0bc8849645fd54f1a826e403704", "ts": "1754556966.795569", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Bu arada her \u015fey setup oldu. \u0130stedi\u011fimiz zaman build alabiliriz branchten. Anasayfadaki d\u00fc\u011fme \u00e7al\u0131\u015f\u0131yor", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/96", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "86fa989fa7ec3fc2c2f4661e0496b30c", "ts": "1754557213.946419", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Main'i bizim branch'e mergel\u00fcyorum bike kid ve yeni objeleri alal\u0131m ordan.", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 2, "name": "+1", "users": ["EMPLOYEE_0012_SLACK_ID", "EMPLOYEE_0026_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/97", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "f25ec473d0d6c1713bb26ed398bee9de", "ts": "1754558111.835099", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "[PERSON_NAME_68414] [USERNAME_3074] variantlar\u0131 yap\u0131yorum \u015fefler hepimiz kullanaca\u011f\u0131z nas\u0131l olsa conflict yemeyelim", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/98", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "e80f12b9f95f95aaca6a5d916b7ccaee", "ts": "1754558120.109409", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "[PERSON_NAME_0040] baya\u011f\u0131 obje koymu\u015f onlar\u0131 da ekliycem edit\u00f6re", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/99", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "280fd6ba0759bbd2a75f7fd7aabbf1ef", "ts": "1754558146.126419", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "<@EMPLOYEE_0012_SLACK_ID> Biz bu eski bosslar\u0131 neden silmedik edit\u00f6rden \u00f6zel bi nedeni var m\u0131?", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/102", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "fd7f0ece29bde2e71b5861a8119d9476", "ts": "1754558956.268909", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "[PERSON_NAME_74128] sa\u011fl\u0131k", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "pray", "users": ["EMPLOYEE_0026_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/104", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "7913ae09a2ccbd0a8e31286363e61895", "ts": "1754558991.340819", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Rails olmas\u0131n bence. siz ne dersiniz", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/105", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "1b502258c24f707d87188c9a878da4f8", "ts": "1754558998.197109", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Endless i\u00e7in 35-40 aras\u0131 diyorum", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/107", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "7bf6b7a252f750660a34dbb3fcf3d2b4", "ts": "1754559062.666679", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Haa rails yapmaktan ba\u015fka \u015fans\u0131m\u0131z yoksa tabii ki railsde durabilir sorun yok", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/112", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "44041de4069b8e7fda76ae3f79a61092", "ts": "1754559140.275149", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Ben \u015fahsen bu variant'\u0131n ba\u015far\u0131l\u0131 olaca\u011f\u0131n\u0131 d\u00fc\u015f\u00fcn\u00fcyorum %35+ gibi. Ama zaten gelen level deneyiminden gelecek 1-2 level rails bir iki intro s\u0131ras\u0131 \u00e7ok fark etmeyecek o y\u00fczden zaman harcama de\u011fmez <http://101.ci|101.ci> leveli yap daha iyi", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/118", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "935d6e3fa9c23e04ffd268fc779ddb72", "ts": "1754559215.797079", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "commit [USERNAME_3078]", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/120", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "8335145ab0e017f2a7f05e297e660ce8", "ts": "1754559231.895769", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Monsterlar\u0131 [USERNAME_3079] \u00e7al\u0131\u015f\u0131yorum i\u015fin [USERNAME_34622] HALP", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/125", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "f890393041ccca4a0dc31bf3667f4427", "ts": "1754559262.493769", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Tamam sen [USERNAME_3080] ben monsterlar\u0131 \u00e7\u0131karmaya \u00e7abal\u0131yorum hunharca", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/127", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "eb5f76e72bdf78d155c693fc32b730a4", "ts": "1754559289.595279", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Abi biz domino oyununu da b\u00f6yle patlatt\u0131k", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "100", "users": ["EMPLOYEE_0026_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/128", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "5798ed3d80982e0d661b829d66bedc17", "ts": "1754559317.759369", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Tren ikinci chapter'da geliyordu. 2. chapter oyununa g\u00f6re tren leveli yap\u0131yorsun, sonra bak\u0131yorsun tak 8'e \u00e7ekiliyor, oyuncu orda hangi zorlukta \u00f6\u011frenim nokts\u0131nda diye d\u00fc\u015f\u00fcnmeden", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "100", "users": ["EMPLOYEE_0026_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/130", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "b86239b5d39ae5b80784d2e8c075c557", "ts": "1754559349.600099", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Yoksa tutorial step 1 olmu\u015f 2 olmu\u015f e\u011flenceli oyun oynat\u0131r her t\u00fcrl\u00fc. Narrative match oyunlar\u0131na bak\u0131n, diyalogdan FTUE'den 90 saniye kitledi\u011fi oluyor", "channel": "CC43664F351E", "thread_ts": "1754559349.600099", "reply_count": 1, "reply_users_count": 1, "latest_reply": "1754559414.444569", "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "+1", "users": ["EMPLOYEE_0026_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/131", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "7e053abf7252f0bd2b003d9d5c0ffaac", "ts": "1754559371.936369", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "\u0130\u015fte \u015fimdi ona dikkat ediyoruz hay\u0131rl\u0131s\u0131yla daha d\u00fczg\u00fcn \u00e7\u0131kacaz", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "100", "users": ["EMPLOYEE_0026_SLACK_ID"]}, {"count": 1, "name": "people_hugging", "users": ["EMPLOYEE_0026_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/134", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "b330693436410819c155de30af677621", "ts": "1754560018.264079", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Benim yapt\u0131\u011f\u0131m C_0003'\u00fcn \u00fczerine yap \u015fefim", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/135", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "5eab5edf909f34184ff89661c4d31aa4", "ts": "1754560040.472079", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Bu arada monsterlar haz\u0131r. [PERSON_NAME_123967] ve [USERNAME_3081] ilk dedik. Bu tamam. 3. hangisini verelim", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/140", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "4a43ebecc5dcd2cd4a8f99956c70a4a4", "ts": "1754560164.047779", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Footbolcuyu a\u011f\u0131r speed increase i\u00e7in saklar\u0131z Plumber geliyor", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/142", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "bc0a13000131735bbcd79e40455221c4", "ts": "1754560379.953009", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "G\u00f6nderdim ilk 3 monster'\u0131 hepsi boss hepsinin hp 100 ayarlad\u0131m. <@EMPLOYEE_0026_SLACK_ID> 'la ilk levelde kullanaca\u011f\u0131n\u0131z objelere g\u00f6re HP'sini ayarlayabilirsiniz. Di\u011ferleri onlar\u0131n \u00fczerinden incremental gelecek", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/143", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "2407239bd9d50928458f0d3d7fc788ba", "ts": "1754560388.466289", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Di\u011ferlerini de g\u00f6nderiyorum birazdan", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/145", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "ca7f9f1d88d4682587b45e0536c62743", "ts": "1754560951.660509", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "[PERSON_NAME_123973] zombi eksik", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/146", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "724b6ef0ceceaffbfa74778ccec252cd", "ts": "1754560969.653379", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "[PERSON_NAME_35423]'\u0131 unutmu\u015fum, \u015fu an gururum yerlerde, nas\u0131l yapabildim bunu nas\u0131l", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/147", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "f14c5e85255362cd0e2f4d4af56a398c", "ts": "1754561041.367579", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "[PERSON_NAME_35423]'\u0131n boss olmad\u0131\u011f\u0131 yerde bana hayat haram [USERNAME_3083]", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/148", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "a020d9197329e2d27378f2f63acdb29f", "ts": "1754561074.395199", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "\u015eefler edit\u00f6r\u00fcn\u00fczde \u015fu \u015fekilde. Di\u011fer her \u015feyi sildim h\u0131zl\u0131 giderken dalg\u0131nl\u0131k olmas\u0131n diye", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [{"created": 1754561061, "display_as_bot": false, "editable": false, "external_type": "", "file_access": "visible", "filetype": "png", "has_rich_preview": false, "id": "F099UAK2TGR", "is_external": false, "is_public": false, "is_starred": false, "media_display_type": "unknown", "mimetype": "image/png", "mode": "hosted", "name": "image.png", "original_h": 630, "original_w": 534, "permalink": "https://harmonygamesgroup.slack.com/files/EMPLOYEE_0038_SLACK_ID/F099UAK2TGR/image.png", "permalink_public": "https://slack-files.com/T04RZ2JAMM0-F099UAK2