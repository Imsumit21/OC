"user": "EMPLOYEE_0005_SLACK_ID", "text": "bilmiyorum \u015fu [USERNAME_26233]", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/15", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "011319eb7e9b8d99cd26425c4878abe2", "ts": "1754416907.988079", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "kabul edilece\u011fini d\u00fc\u015f\u00fcnememi\u015ftim [USERNAME_26234]", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/17", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "cd4c342caa52384dd9e289fc12a9b198", "ts": "1754416922.908089", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Ama birinizin tutorial yapmas\u0131 laz\u0131m ben hi\u00e7 [USERNAME_6968]", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/22", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "5071985cd97ad902655101a3a9352296", "ts": "1754417124.770229", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "[PERSON_NAME_138621] nas\u0131l dodgelad\u0131m sen levellere kar\u0131\u015fma diye [USERNAME_26236]", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "100", "users": ["EMPLOYEE_0026_SLACK_ID"]}, {"count": 1, "name": "people_hugging", "users": ["EMPLOYEE_0026_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/24", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "83aa0f8c036e7c1788bf69691bd32da4", "ts": "1754417137.034629", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "\u015firket tarihinin performans\u0131n\u0131 [USERNAME_26237]", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/28", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "1bc88097d9f4bc87a318bbf63cf97731", "ts": "1754417150.957379", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Seni istemiyorum diyorum hala diyo ki 4 ki\u015fi girelim s\u00fcper olur", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/32", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "78439bdbbcf341331b8035f0b0fadae3", "ts": "1754417319.497559", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Basically, \u015fey yapmaya \u00e7al\u0131\u015facam \u015fefler. Zombiler geliyor ya, zaman\u0131nda \u00f6ld\u00fcremezsen birikmeye ba\u015fl\u0131yorlar. O durumu yapmaya \u00e7al\u0131\u015facaz objektive bu", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/33", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "a66b8ba3c8ce9f5b661e450d7ba6730c", "ts": "1754417335.595479", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "\u015fu anda \u00e7\u00fcnk\u00fc sivrisinek gibi \u00f6l\u00fcyolar", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/37", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "6f7effc9faaa27fe5d8bcf88dddd88d9", "ts": "1754417349.376879", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "\u00d6ld\u00fcremedik\u00e7e birikme durumu yapmam\u0131z laz\u0131m", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/38", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "4dfd773083499f75ba1cc4198d0df6a6", "ts": "1754417352.301989", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Urgency i\u00e7in", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/41", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "13ffce8d21ffc36ba2530ae47faaa6d2", "ts": "1754417366.552059", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Onu becerirsek s\u00fcper. Item olay\u0131n\u0131 da zaten anlatt\u0131\u011f\u0131m gibi", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/42", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "b31908c5e39b4988a99ce3f8c50d234f", "ts": "1754417406.075619", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "75'den sonra falan da deck'te d\u00fczg\u00fcn item'\u0131n yoksa zorlanmaya ba\u015fl\u0131yosun ya da h\u0131zl\u0131 matchlemek zorundas\u0131n gibi bir vibe yapabilirsek, variant tamamlanm\u0131\u015f olur.", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "+1", "users": ["EMPLOYEE_0026_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/44", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "4d03a849974872d79ae156c9dfb716ee", "ts": "1754417447.902939", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Bi t\u0131k Gaza gelmedim de\u011fil, bu variant bence ba\u015far\u0131l\u0131 olabilir. En az\u0131ndan 35 falan ret getirse bizimkiler elleri iyi gider yat\u0131r\u0131m turuna", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/47", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "d16c70f496b2d8508e97db8244b72ac0", "ts": "1754417477.345869", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "aynen biraz sonraya. Gereksiz tutoriallar\u0131 da kald\u0131r\u0131r\u0131z. Olur biter", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "+1", "users": ["EMPLOYEE_0026_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/54", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "2ce4a3c0ce774c0f0a6c8add2050f885", "ts": "1754417990.248339", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Oyunu \u00f6\u011fretmeden tan\u0131t\u0131nca da \u00e7ok havada kal\u0131yo gibi", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/55", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "c60b441ab60975afd9bb630180d2d08b", "ts": "1754417993.942039", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "[PERSON_NAME_60304] [USERNAME_26241]", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "100", "users": ["EMPLOYEE_0026_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/58", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "dd7f3d7559f52f1943fcdfcf65ef2df2", "ts": "1754418062.082159", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Obje say\u0131s\u0131 y\u00fcz\u00fcnden pek o i\u015fe girebilir miyiz bilemiyorum \u015fefim", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/61", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "7ee38e8cce978fb2d2444805bf4eda6f", "ts": "1754418080.718699", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "\u00c7\u00fcnk\u00fc objelerin de \u00f6zellikleri belirlendi ya art\u0131k ona ellemek laz\u0131m o sefer", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/62", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "0cfe57abe9d4aec42d94a6aebbe1bc9d", "ts": "1754418091.116719", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "[USERNAME_26242]", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/68", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "ae0de2819177335e23a7ec3e89160e61", "ts": "1754418256.913959", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Ben bazlar\u0131 yapmaya ba\u015fliyim o zaman", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/69", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "075c7978f75a495eca1474c1ac115fb4", "ts": "1754418274.093699", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "En az\u0131ndan [PERSON_NAME_0092] tutoriallar\u0131 yapmaya ba\u015flayacak [PERSON_NAME_138614]", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "+1", "users": ["EMPLOYEE_0026_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/71", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "a2b8966f3b425685fba43085f32212be", "ts": "1754418359.510579", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Tutorial k\u0131sm\u0131n\u0131 hi\u00e7 d\u00fc\u015f\u00fcnmedim ben sadece level design stratejisi diye sunum yapacam diye yola \u00e7\u0131k\u0131p \u015fu an variantC testinde buldum kendimi [USERNAME_26243]", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/72", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "8c752a0eae5300e3ae99a3611b37fc8b", "ts": "1754418384.293879", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "[PERSON_NAME_45210] olabildi\u011fince k\u0131sa ve az tutar\u0131z i\u015fte, siz de fikir verirsiniz", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/73", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "32797d42bc7e33646d4be3f6e28ce562", "ts": "1754418409.975809", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "team design variant\u0131 \u00e7\u0131kar\u0131z in\u015fallah ba\u015far\u0131l\u0131 olur fundraising'e bizimkileri d\u00fczg\u00fcn bi metrikle g\u00f6ndersek s\u00fcper olabilir", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "100", "users": ["EMPLOYEE_0026_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/75", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "c51dd74edbabb2fe84023a0c2a822f15", "ts": "1754418480.878449", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Main'den \u00e7ekip branch a\u00e7aca\u011f\u0131m \u015fimdi", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/76", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "58a7ff425385484168ae482d35703fec", "ts": "1754418516.155139", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "<!here> \u015eefler, branch `[USERNAME_4583]`", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "pray", "users": ["EMPLOYEE_0026_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/80", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "04f36a5fb954730b05728057884bef43", "ts": "1754468498.754599", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "D\u00fc\u015f\u00fcn\u00fcyordum ama d\u00fc\u015f\u00fcnm\u00fcyorum art\u0131k. A\u011fustos sonu bi cuma izin al\u0131cam sadece", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/86", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "0263d8970c6dcdd2a7b72ece5aa4faa9", "ts": "1754474346.723659", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "A/B testlerinde de\u011fi\u015fik levelde unlock [USERNAME_21039] leaderboard vs", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-08.json", "pointer": "/91", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "7a4f08ef4f440b9f233f52a3975e8c4a", "ts": "1754553914.644329", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [{"access": "write", "canvas_creator_id": "EMPLOYEE_0005_SLACK_ID", "canvas_printing_enabled": true, "can