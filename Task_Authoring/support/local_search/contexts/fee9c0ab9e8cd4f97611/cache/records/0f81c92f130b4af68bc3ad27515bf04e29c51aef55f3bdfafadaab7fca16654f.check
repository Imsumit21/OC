ord": {"id": "harmonygames-Games/match3d#499", "repo_id": "harmonygames-Games/match3d", "number": 499, "title": "[PERSON_NAME_0019]/sep30levels", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0005_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Level5 order fix + difficulty labeling ", "base_ref": "main", "base_sha": "6c9b63d0a2b2d95bd1dc64e32fc05b4973ecf348", "head_ref": "[PERSON_NAME_0019]/sep30levels", "head_sha": "6937763b5f3d3e1d7d32007841e092ca36b50292", "additions": 142, "deletions": 97, "changed_files": 44, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-10-08T17:38:48Z", "updated_at": "2025-10-09T01:20:34Z", "merged_at": "2025-10-09T01:20:34Z", "closed_at": "2025-10-09T01:20:34Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2493", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#5", "repo_id": "harmonygames-Games/match3d", "number": 5, "title": "weapons size change", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "Changing the size of weapons during gameplay and changing the size of weapons on the platform", "base_ref": "main", "base_sha": "c083b5c3a8b422a40e49de1529153c190312fc1b", "head_ref": "Marcus/WeaponsScale", "head_sha": "01106d727f5b677667482fbfac01d5d52ca82d63", "additions": 28, "deletions": 28, "changed_files": 16, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0025_GITHUB_USERNAME", "EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-01-15T15:41:02Z", "updated_at": "2025-01-15T15:43:40Z", "merged_at": "2025-01-15T15:43:40Z", "closed_at": "2025-01-15T15:43:40Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2494", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#50", "repo_id": "harmonygames-Games/match3d", "number": 50, "title": "Light Change and material/shader change", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "Update the shader again, Main scene light rebake. Now we use Overlay blending of color for the grayscale material color change\r\n", "base_ref": "main", "base_sha": "d4dac55aa5fdd64ee85db5931e89574fb5a1a9e9", "head_ref": "Marcus/NewMonstersLIghtBake", "head_sha": "2f50eb2d5f3f81f015808e7d75c7471c5b707dc1", "additions": 1885, "deletions": 7, "changed_files": 11, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-03-07T13:56:15Z", "updated_at": "2025-07-10T09:29:59Z", "merged_at": "2025-03-07T13:57:02Z", "closed_at": "2025-03-07T13:57:02Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2495", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#500", "repo_id": "harmonygames-Games/match3d", "number": 500, "title": "ZOM-481: Zombie Health bar persists too long after death", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "PERSON_0003_GITHUB_USERNAME", "body": "- Reduce healthbar delay duration, reduce damage text fade duration\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n- Improvements\n  - Health bars hide faster by default (delay reduced from 0.3s to 0.1s).\n  - Boss health bars now hide sooner (additional delay reduced from +1.5s to +0.5s).\n  - Bars respond quicker when filling and auto-hiding due to updated timing defaults.\n  - Damage visual effects feel snappier: fade-out and scale animations shortened (2.0s to 1.0s), speeding up exit animations.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "12692beb78eb2cde5502685bbc8b9210cc4fbc93", "head_ref": "[PERSON_NAME_0067]/zom-481", "head_sha": "bafb72d0b6320cd314ad70f181223a86fb577b4e", "additions": 5, "deletions": 5, "changed_files": 2, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-10-08T20:22:32Z", "updated_at": "2025-10-10T17:58:30Z", "merged_at": "2025-10-10T17:58:30Z", "closed_at": "2025-10-10T17:58:30Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2496", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#501", "repo_id": "harmonygames-Games/match3d", "number": 501, "title": "Samuel/zom 602", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0004_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "-[ Implement a new end game loss screen with an extra text and button to item section of the game.](https://linear.app/harmonygames-games/issue/ZOM-602/implement-new-end-game-loss-screen-with-redirect-button)\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n- Bug Fixes\n  - Fixed occasional crashes/freezes when opening or interacting with the Upgrade screen if coin UI elements are unavailable.\n  - The app now safely skips related animations and sorting in these cases, preventing errors and ensuring smoother navigation.\n  - Improved stability during upgrade interactions with better safeguards against missing UI components.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "12692beb78eb2cde5502685bbc8b9210cc4fbc93", "head_ref": "Samuel/ZOM-602", "head_sha": "5ceebfaec4940d6e6b1324dfc968525335069671", "additions": 3019, "deletions": 610, "changed_files": 2, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-10-08T21:28:33Z", "updated_at": "2025-10-09T01:21:43Z", "merged_at": "2025-10-09T01:21:43Z", "closed_at": "2025-10-09T01:21:43Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2497", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#502", "repo_id": "harmonygames-Games/match3d", "number": 502, "title": "[PERSON_NAME_0029]/endless mode vfx implementation", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0003_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Adding Endless Horde Start Screen Vfx\r\nAdding Infinity Boss Start Screen Vfx\r\n\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n- New Features\n  - Progress bars on Endless and Infinite Boss screens now use sliders for clearer feedback.\n  - New loading bar variants (standard, green, yellow).\n  - Animated flame effect added to UI bars.\n  - Milestones show a green glow when completed but unclaimed.\n  - Minimap edge glow effect introduced.\n\n- Style\n  - Refreshed UI bar and minimap visuals with updated textures and atlas for improved consistency across platforms.\n\n- Chores\n  - Added supporting assets and metadata for new UI elements and animations.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "12692beb78eb2cde5502685bbc8b9210cc4fbc93", "head_ref": "[PERSON_NAME_0029]/EndlessMode_Vfx_implementation", "head_sha": "31744357bdf4812a6e1b6cfe9ec4e7149912486f", "additions": 50423, "deletions": 40, "changed_files": 72, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["PERSON_5877_GITHUB_USERNAME"], "created_at": "2025-10-08T22:22:52Z", "updated_at": "2025-10-09T01:28:48Z", "merged_at": "2025-10-09T01:28:48Z", "closed_at": "2025-10-09T01:28:48Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2498", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#503", "repo_id": "harmonygames-Games/match3d", "number": 503, "title": "ZOM-567: Endless Mode Core Game VFX", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "PERSON_0003_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **New Features**\n  * Added combo and power sliders to Endless and Infinite Boss mode bars, mirroring existing fill bars for clearer progress feedback and synchronized per-frame.\n\n* **Enhancements**\n  * Power and combo fill visuals now stay in sync with slider values during timers and reductions.\n  * Score/counter text now restarts an animation on update for stronger visual feedback.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "41f390d4c8b405bf9e7f947fdbabd7eeb7e8dbfb", "head_ref": "[PERSON_NAME_0067]/zom-567", "head_sha": "afe8dd01f247194a282318082e6f5b966d89f21e", "additions": 33, "deletions": 8, "changed_files": 5, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-10-08T23:13:46Z", "updated_at": "2025-10-10T20:07:44Z", "merged_at": "2025-10-10T20:07:44Z", "closed_at": "2025-10-10T20:07:44Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2499", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#504", "repo_id": "harmonygames-Games/match3d", "number": 504, "title": "ZOM-584: Infinite Boss Arena Vfx", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0004_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **New Features**\n  * Introduced a new power/rapid-fire bar in Infinite Boss mode with power buildup, charged state, particle effects, and a manual activation button.\n  * Added a combo multiplier system with timed decay and on-screen feedback.\n  * New debug panel submenu for Infinite Modes with a quick-start option for Infinite Boss mode.\n\n* **UX Improvements**\n  * Zombie progress bar is now hidden during Infinite Boss levels to reduce on-screen clutter and focus attention on the new mechanics.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "b031451fac6e6746397e6fac26d392664be4d1d2", "head_ref": "[PERSON_NAME_0067]/zom-584", "head_sha": "837cea7048a28917802d9ebe028e5739e9e740f6", "additions": 1152, "deletions": 705, "changed_files": 6, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-10-09T00:45:41Z", "updated_at": "2025-10-10T21:48:28Z", "merged_at": "2025-10-10T21:48:27Z", "closed_at": "2025-10-10T21:48:27Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2500", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#505", "repo_id": "harmonygames-Games/match3d", "number": 505, "title": "Discrete physics", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0025_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Set all objects to Discrete collision detection.\r\nTested and approved by Leonard.\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **New Features**\n  * Added two Editor tools under Developer Collider Tools:\n    - Find Objects With Multiple BoxColliders: scans prefabs, highlights ones with multiple BoxColliders, and logs counts by hierarchy path.\n    - Set Rigidbodies to Discrete: updates rigidbodies on Box/Sphere/Capsule colliders to Discrete collision detection with summary reporting.\n  * Supports optional filtering, skips unsupported assets, and avoids duplicate processing.\n  * Provides clear per-prefab reporting and ensures assets are saved and refreshed after changes.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "0ce84b0f557a04e165246ff35b058dfd801d1db5", "head_ref": "Blake/discretePhysics", "head_sha": "19ca5ba5c9cebea8701f3570bc5de4456ee23c7f", "additions": 7729, "deletions": 80, "changed_files": 1871, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-10-09T01:26:39Z", "updated_at": "2025-10-09T16:00:51Z", "merged_at": "2025-10-09T16:00:51Z", "closed_at": "2025-10-09T16:00:51Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2501", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#506", "repo_id": "harmonygames-Games/match3d", "number": 506, "title": "[PERSON_NAME_0029]/bug fixes", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0003_GITHUB_USERNAME", "merged_by_login": "PERSON_0003_GITHUB_USERNAME", "body": "Adding input block when claim reward for Boss arena and endless horde\r\nAdding more delay on input blocker\r\n\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n- Improvements\n  - Added a brief cooldown to the green action button in Endless and Infinite Boss menus to prevent accidental double taps; it re-enables after a short moment for more reliable interactions. This applies after key interactions such as joining or checking completed states.\n  - Smoothed reward animations by slightly increasing the interval between visual effect steps, improving clarity and overall visual pacing.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "0ce84b0f557a04e165246ff35b058dfd801d1db5", "head_ref": "[PERSON_NAME_0029]/BugFixes", "head_sha": "2a586202f549687aab5b9172b50c03741268a667", "additions": 47, "deletions": 2, "changed_files": 3, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-10-09T01:27:08Z", "updated_at": "2025-10-09T02:07:25Z", "merged_at": "2025-10-09T02:07:25Z", "closed_at": "2025-10-09T02:07:25Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2502", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#507", "repo_id": "harmonygames-Games/match3d", "number": 507, "title": "a quick fix for mailman, he was showing enraged all the time", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "PERSON_0396_GITHUB_USERNAME", "body": "", "base_ref": "main", "base_sha": "a484593767c5e8b166bcd9ca7abfc4e35e06ebbc", "head_ref": "Marcus/MailMan_Enrage_QuickFix", "head_sha": "43e68425a17a7388a993c82749ed3f52e0c2b6b4", "additions": 3, "deletions": 66, "changed_files": 1, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-10-09T11:15:25Z", "updated_at": "2025-10-09T11:16:24Z", "merged_at": "2025-10-09T11:15:45Z", "closed_at": "2025-10-09T11:15:45Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2503", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#508", "repo_