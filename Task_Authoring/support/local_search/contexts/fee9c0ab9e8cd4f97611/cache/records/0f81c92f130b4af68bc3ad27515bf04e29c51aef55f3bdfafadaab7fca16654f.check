ns": 5, "deletions": 1, "changed_files": 1, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-16T12:43:30Z", "updated_at": "2025-09-16T12:43:39Z", "merged_at": "2025-09-16T12:43:39Z", "closed_at": "2025-09-16T12:43:39Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2431", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#443", "repo_id": "harmonygames-Games/match3d", "number": 443, "title": "[PERSON_NAME_0120]/infinite boss fixes", "state": "closed", "merged": false, "draft": false, "locked": false, "author_login": "EMPLOYEE_0032_GITHUB_USERNAME", "merged_by_login": null, "body": "", "base_ref": "main", "base_sha": "37fad3f656f5b79a6d6d0ea19c67da4e87243638", "head_ref": "[PERSON_NAME_0120]/infinite-boss-fixes", "head_sha": "f70b028786831a903d3968636be06e2766f6ad9a", "additions": 3, "deletions": 3, "changed_files": 1, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-16T16:06:42Z", "updated_at": "2025-09-16T16:07:00Z", "merged_at": null, "closed_at": "2025-09-16T16:07:00Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2432", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#444", "repo_id": "harmonygames-Games/match3d", "number": 444, "title": "[PERSON_NAME_0120]/infinite levels", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0032_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n- **Balance**\n  - Adjusted coin rewards on the Infinite Boss Mode reward screen. Coin amounts are now calculated at one-quarter of the previous rate, reducing both the displayed reward and the amount granted when claiming.\n  - The reward presentation flow remains the same, and claiming still adds the shown coins and returns you to the main menu.\n  - No other gameplay, UI, or navigation behavior is affected.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "37fad3f656f5b79a6d6d0ea19c67da4e87243638", "head_ref": "[PERSON_NAME_0120]/infinite-levels", "head_sha": "5bca3d24c9b777a670af75cf4be070c0a6d0019f", "additions": 3, "deletions": 3, "changed_files": 2, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-16T16:07:18Z", "updated_at": "2025-09-16T16:23:13Z", "merged_at": "2025-09-16T16:23:13Z", "closed_at": "2025-09-16T16:23:13Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2433", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#445", "repo_id": "harmonygames-Games/match3d", "number": 445, "title": "Refactoring how time-based boosts are added, refactoring their state \u2026", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0003_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0003_GITHUB_USERNAME", "body": "\u2026checks\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **New Features**\n  * Extending Win Streak Freeze, Infinite Lives, and timed boosters now consistently adds time to the current remaining duration.\n\n* **Bug Fixes**\n  * Timers survive restarts and avoid stale schedules.\n  * Active/expired status now based on stored end timestamps for freezes, Infinite Lives, and boosters.\n  * Remaining-time calculations for timed boosters corrected.\n\n* **Refactor**\n  * Unified, timestamp-driven scheduling and persistence for time-limited features.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "3afab260a5ff6b3a0add177ea0b7535aef745fe5", "head_ref": "fix/time-rewards", "head_sha": "3445d4e527b1dbf37724a74795d2c8fcb3a67b3b", "additions": 51, "deletions": 75, "changed_files": 4, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-16T18:34:55Z", "updated_at": "2025-09-16T19:25:46Z", "merged_at": "2025-09-16T19:22:52Z", "closed_at": "2025-09-16T19:22:52Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2434", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#446", "repo_id": "harmonygames-Games/match3d", "number": 446, "title": "new liquid impact prefab vfx", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "the new liquid hit prefab is newLiquidImpact.prefab\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n- New Features\n  - Introduces a new liquid visual effects set, including splash and droplet sprites, a material, and an impact prefab for use in scenes.\n  - Adds color and normal textures to enhance lighting, depth, and realism of the liquid effects.\n  - Bundles droplet sprites into a sprite atlas to improve rendering efficiency across platforms.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "e93d95d1845554a2aa803efc62e1cf1ca2a390ca", "head_ref": "Marcus/NewLiquidHit_Vfx", "head_sha": "ecdf726ff9efec384f2e2b0c4c33cd2470de8c8c", "additions": 26166, "deletions": 0, "changed_files": 25, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0025_GITHUB_USERNAME", "EMPLOYEE_0016_GITHUB_USERNAME"], "created_at": "2025-09-16T19:54:07Z", "updated_at": "2025-10-09T09:39:05Z", "merged_at": "2025-09-17T01:25:23Z", "closed_at": "2025-09-17T01:25:23Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2435", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#447", "repo_id": "harmonygames-Games/match3d", "number": 447, "title": "[PERSON_NAME_0029]/vfx fixes", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0003_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0003_GITHUB_USERNAME", "body": "Fix New reward animations SFXs cannot be toggled off.\r\nFix Individual card rewards in zombie lane are not visible\r\nFix reward screen of chests animations that contains packs doesn't go away after opening the pack, it needs another click to claim those rewards\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **New Features**\n  * Reward box appears automatically after opening the final card pack via a dedicated \"open last pack\" flow.\n\n* **Bug Fixes**\n  * Reward and pack screens close reliably even when no active screen is present; hide logic now handles missing screens explicitly.\n  * Safer pack-opening with additional guards and warnings to prevent stuck or skipped screens when pack UI is unavailable.\n\n* **Improvements**\n  * Faster reward animations and transitions for snappier experience.\n  * More consistent reward screen open/close flow; intro menu briefly disabled during reward display.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "09d68ba856832d4ad7298c753ad69596af7c65a9", "head_ref": "[PERSON_NAME_0029]/VFX_Fixes", "head_sha": "7e11b31e36678bfbfb702c9e39ffc6c2e664d3f3", "additions": 457, "deletions": 32, "changed_files": 6, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-16T22:03:17Z", "updated_at": "2025-09-17T15:58:57Z", "merged_at": "2025-09-17T00:59:46Z", "closed_at": "2025-09-17T00:59:46Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2436", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#448", "repo_id": "harmonygames-Games/match3d", "number": 448, "title": "Now Glass shader comes with color tinting!", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n- New Features\n  - Added a URP Glass Shader with a ready-to-use material. Controls include tint, metallic/smoothness, normal strength, distortion tiling, reflection strength, and distortion strength.\n\n- Documentation\n  - Added a README with setup steps, feature overview, visuals, and demo links.\n\n- Chores\n  - Included MIT license for the new shader assets.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "90078b8812f6809db5931428c1b458337ab0785e", "head_ref": "Marcus/CeramicGlassVfx", "head_sha": "99ecc2e9b8f942c6d69d3222d4fc81519037340b", "additions": 6282, "deletions": 4, "changed_files": 12, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0016_GITHUB_USERNAME"], "created_at": "2025-09-17T11:52:22Z", "updated_at": "2025-09-17T12:06:38Z", "merged_at": "2025-09-17T12:06:38Z", "closed_at": "2025-09-17T12:06:38Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2437", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#449", "repo_id": "harmonygames-Games/match3d", "number": 449, "title": "Infinite boss fixes", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0032_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **Bug Fixes**\n  * Adjusted coin reward calculation on the Infinite Boss Mode reward screen in Endless Mode. Displayed and awarded coins are now lower and consistent with the updated balance. The reward animation and coin counter reflect the new totals, and claiming grants the adjusted amount. Other UI elements (zombie/time stats) and scene transitions remain unchanged.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "90078b8812f6809db5931428c1b458337ab0785e", "head_ref": "[PERSON_NAME_0120]/infinite-levels", "head_sha": "bc1d5009a54abe98a41384b5781a25e60b491045", "additions": 2, "deletions": 2, "changed_files": 2, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-17T12:04:22Z", "updated_at": "2025-09-17T12:08:06Z", "merged_at": "2025-09-17T12:04:33Z", "closed_at": "2025-09-17T12:04:33Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2438", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#45", "repo_id": "harmonygames-Games/match3d", "number": 45, "title": "[PERSON_NAME_0054]/level edit", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0016_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0016_GITHUB_USERNAME", "body": "", "base_ref": "main", "base_sha": "60800b838a0d06825ce7011787df9f1150591126", "head_ref": "[PERSON_NAME_0054]/LevelEdit", "head_sha": "2358fcbe0295d4bb84c568806fc161a9db5391ef", "additions": 6399633, "deletions": 216, "changed_files": 7327, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-03-06T09:29:24Z", "updated_at": "2025-03-06T09:29:42Z", "merged_at": "2025-03-06T09:29:42Z", "closed_at": "2025-03-06T09:29:42Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2439", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#450", "repo_id": "harmonygames-Games/match3d", "number": 450, "title": "Fix and New objects", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0009_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0016_GITHUB_USERNAME", "body": "Airplane toy as new prefab, new living room items. Texture changes, Chocolate can have multiple colors\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n- New Features\n  - Added new furniture 3D models: Book Skull, Coffee Table, and Rocking Chair.\n\n- Chores\n  - Updated asset metadata and refreshed identifiers for select food models and living room prefabs.\n  - Cleaned up import settings to remove obsolete warnings.\n\n- Changes\n  - Multiple \u201cToy Airplane Large\u201d color variants had their metadata removed; these variants may be temporarily unavailable until re-imported.\n\n- Notes\n  - No gameplay or UI changes; updates focus on content assets and project hygiene.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "3027345c8a9212f1ee701782179d4834ba02c6d0", "head_ref": "claire.morgan_ObjectsRevisions_07", "head_sha": "cf304ca8b6e28b6069c031800cdcda9d6619b3f5", "additions": 1011, "deletions": 3699, "changed_files": 85, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0016_GITHUB_USERNAME", "EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-09-17T13:28:37Z", "updated_at": "2025-09-17T20:55:18Z", "merged_at": "2025-09-17T20:55:18Z", "closed_at": "2025-09-17T20:55:18Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2440", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#451", "repo_id": "harmonygames-Games/match3d", "number": 451, "title": "Infinite/endless analytics, balance changes", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0032_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n- New Features\n  - End-of-level stats expanded:\n    - Endless: Nuke Damage Total, Level Name, Total Equipped Power.\n    - Boss Arena: Player Score, Rapid-Fire Items, Rapid-Fire Damage, Level Name, Total Equipped Power.\n\n- Balance\n  - Boss Arena coin rewards adjusted to grant fewer coins for the same damage output.\n\n- Improvements\n  - Level names now propagate to mode managers for clearer end-of-level reporting.\n\n- Chores\n  - Analytics event names and parameters updated to the new \u201cbossarena_*\u201d scheme with additional metrics.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "3027345c8a9212f1ee701782179d4834ba02c6d0", "head_ref": "[PERSON_NAME_0120]/infinite-levels", "head_sha": "70cda63b87114c25d3e4a1293952d33e63ad1772", "additions": 85, "deletions": 16, "changed_files": 11, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-17T14:53:55Z", "updated_at": "2025-09-17T14:59:14Z", "merged_at": "2025-09-17T14:55:02Z", "closed_at": "2025-09-17T14:55:02Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2441", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#452", "repo_id": "harmonygames-Games/match3d", "number": 452, "title": "[PERSON_NAME_0120]/infinite levels", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0032_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **Bug Fixes**\n  * Prevents life loss during Infinite Boss mode, aligning behavior with Endless mode. Lives are no longer deducted while this mode is active.\n  * Ensures standard life deductions continue as expected in other modes (e.g., after forced levels when infinite lives is off).\n  * Improves gameplay consistency and avoids unexpected game overs for players engaging in Infinite Boss runs.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "ec5f900316b3bf0fc78e59255963254720fd5c31", "head_ref": "[PERSON_NAME_0120]/infinite-levels", "head_sha": "198c71de325e709e97bbdab8cb6ad1d7256d0881", "additions": 1, "deletions": 0, "changed_files": 1, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-17T16:03:47Z", "updated_at": "2025-09-17T16:07:30Z", "merged_at": "2025-09-17T16:04:00Z", "closed_at": "2025-09-17T16:04:00Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2442", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#453", "repo_id": "harmonygames-Games/match3d", "number": 453, "title": "Manual refill logic", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0032_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **Bug Fixes**\n  * Ensures nukes consistently spawn from the top for more predictable gameplay.\n  * Improves Endless Mode object refill timing, reducing gaps and delays, especially around boss encounters.\n\n* **New Features**\n  * Adds behind-the-scenes capability to trigger an immediate refill, resulting in smoother pacing during extended sessions.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "1c556f703f4e25771151dabd343af317fe7b303f", "head_ref": "[PERSON_NAME_0120]/infinite-boss-refill-change", "head_sha": "b523a7936f387bac5190b3e140277b5cc446e2b7", "additions": 11, "deletions": 1, "changed_files": 2, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-18T14:44:49Z", "updated_at": "2025-09-22T16:13:04Z", "merged_at": "2025-09-22T16:13:04Z", "closed_at": "2025-09-22T16:13:04Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2443", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#454", "repo_id": "harmonygames-Games/match3d", "number": 454, "title": "Marcus/animated icons", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "PERSON_0003_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n- New Features\n  - Animated icons added to the main menu for Quests, Season Pass, Endless, Zombie Lane, and Plague Race.\n  - New animations and controller drive icon states with looping and clip overrides for each icon.\n\n- Chores\n  - Imported supporting textures, materials, and a sprite atlas for UI assets.\n  - Added prefabs and a sample scene to validate the animated icons.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "30f6c75f3db1c94ba4df75355ac31f43a52bdff9", "head_ref": "Marcus/Animated_Icons", "head_sha": "9bc8c9e0f91b8b15b99037aa0898d128def75ca2", "additions": 54572, "deletions": 12, "changed_files": 136, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-19T16:59:25Z", "updated_at": "2025-09-19T17:50:52Z", "merged_at": "2025-09-19T17:50:52Z", "closed_at": "2025-09-19T17:50:52Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2444", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#455", "repo_id": "harmonygames-Games/match3d", "number": 455, "title": "Fix NullReferenceException when tapping an empty deck slot on Upgrade\u2026", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0004_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0003_GITHUB_USERNAME", "body": "\u2026 screen\r\n\r\n- Fix crash when tapping an empty deck slot on Upgrades screen.\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **Bug Fixes**\n  * Improved reliability of card exchanges in the Upgrades screen, preventing rare crashes or errors during deck replacement.\n  * Ensures only valid cards can be selected and replaced, avoiding failed or partial swaps.\n  * Reduces unexpected errors after confirming an exchange when a target card isn\u2019t available.\n  * Guarantees the UI consistently updates after a successful replacement for accurate deck state display.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "e5818478685820de90b266d1faf1439fefc84108", "head_ref": "Samuel/FixCrashOnUpgradeScreen", "head_sha": "2bba1f3476c35869a4e923f06b614c98db7296fd", "additions": 5, "deletions": 1, "changed_files": 1, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-19T23:22:02Z", "updated_at": "2025-09-19T23:31:51Z", "merged_at": "2025-09-19T23:31:49Z", "closed_at": "2025-09-19T23:31:49Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2445", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#456", "repo_id": "harmonygames-Games/match3d", "number": 456, "title": "[PERSON_NAME_0029]/animated icons", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0003_GITHUB_USERNAME", "merged_by_login": "PERSON_0003_GITHUB_USERNAME", "body": "Added Icon Animation for:\r\n\r\n- Quest Icon\r\n- Season Pass Icon\r\n- Zombie Lane Icon\r\n- Plague Race Icon\r\n- Endless Mode Icon\r\n- Infinite Boss Icon\r\n\r\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n- New Features\n  - Animated attention indicators added to Endless, Plague Race, Quests, Season Pass, Zombie Lane, and Infinite Boss icons.\n  - Season Pass can now be deactivated with proper animation reset.\n\n- Bug Fixes\n  - Added null-safe checks to prevent errors when animations are unavailable.\n\n- Improvements\n  - More consistent warning-dot and animation behavior across icons; deactivation reliably resets animations.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "fdd2dc9a308c976fe695a74532bfe58b0622f8ab", "head_ref": "[PERSON_NAME_0029]/AnimatedIcons", "head_sha": "5684a5ae1012afb1839b2aae35b121475972b1dd", "additions": 174, "deletions": 39, "changed_files": 9, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-22T15:57:07Z", "updated_at": "2025-09-24T14:33:15Z", "merged_at": "2025-09-24T14:30:39Z", "closed_at": "2025-09-24T14:30:39Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2446", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#457", "repo_id": "harmonygames-Games/match3d", "number": 457, "title": "[PERSON_NAME_0120]/zombies animations test", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0032_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **Bug Fixes**\n  * Endless Mode spawning now yields per item, smoothing gameplay and reducing frame hitches during large waves.\n  * Minimap boss bar updates and animations are disabled to prevent UI glitches and improve stability.\n\n* **Chores**\n  * Projectile preloading is disabled, reducing upfront processing and improving initial responsiveness without altering core gameplay.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "bdcb1ca365fd48d13ab18f21b90e507fd6eec72d", "head_ref": "[PERSON_NAME_0120]/zombies-animations-test", "head_sha": "563d69bf2d5135233683425cf631fde52ca01a76", "additions": 10, "deletions": 10, "changed_files": 3, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-22T16:07:37Z", "updated_at": "2025-09-23T16:38:24Z", "merged_at": "2025-09-23T16:38:24Z", "closed_at": "2025-09-23T16:38:24Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2447", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#458", "repo_id": "harmonygames-Games/match3d", "number": 458, "title": "Infinite Boss Icon Animated", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "PERSON_0003_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n- New Features\n  - Added an animated Infinite Boss icon to the Main Menu.\n  - Implemented an Animator and animation clip for smooth, looping motion.\n\n- Style\n  - Introduced new Live Ops Infinite Boss Arena animated icon visuals (multiple layered textures) for richer presentation.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "30195782447028b9b4f7594611af0d2f05f1c271", "head_ref": "Marcus/Animated_Icons", "head_sha": "9a71268727ba2314e1c9d4fb170da43df69d3887", "additions": 3441, "deletions": 1, "changed_files": 19, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["PERSON_0003_GITHUB_USERNAME", "EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-09-22T16:28:18Z", "updated_at": "2025-10-09T09:40:07Z", "merged_at": "2025-09-22T17:10:19Z", "closed_at": "2025-09-22T17:10:19Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2448", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#459", "repo_id": "harmonygames-Games/match3d", "number": 459, "title": "[PERSON_NAME_0029]/queue manager", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0003_GITHUB_USERNAME", "merged_by_login": "PERSON_0003_GITHUB_USERNAME", "body": "Adding queue manager for\r\n-Level_end_animations\r\n-daily_gift\r\n-season_pass_event\r\n-tutorial\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n- New Features\n  - Centralized UI event queue orchestrates post-level VFX, Daily Login, Season Pass popups, and tutorials.\n  - Input is automatically blocked during reward animations and restored afterward.\n  - Tutorials can be paused/resumed via the queue; active status is exposed.\n\n- Improvements\n  - Season Pass start popup now launches reliably from the queue.\n  - Daily Gift advances the queue when ineligible, unclaimable, or closed.\n  - VFX sequencing waits for all animations to finish before proceeding, ensuring smoother flows.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "b421311ecd0fb7581c2dd58b60bc5326674449ee", "head_ref": "[PERSON_NAME_0029]/QueueManager", "head_sha": "696353ed993a1239e8d447239cc6b11384451139", "additions": 371, "deletions": 36, "changed_files": 9, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0003_GITHUB_USERNAME"], "created_at": "2025-09-23T23:32:43Z", "updated_at": "2025-09-24T23:06:25Z", "merged_at": "2025-09-24T23:06:25Z", "closed_at": "2025-09-24T23:06:25Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2449", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#46", "repo_id": "harmonygames-Games/match3d", "number": 46, "title": "VFX", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "I tryied to move the stuff in the third party and it was a mess for me so i just managed to get back the vfx. I made prefab variants of the efects i modified and i put them in the prefab folder in the vfx . I also put in some of the scriptable objects some of the vfx so we can see how it looks\r\n", "base_ref": "main", "base_sha": "a35a226a5213ab19f514273c5a9172885d00d397", "head_ref": "Marcus/Match3d_Vfx", "head_sha": "2adff1e5cbdf08bbe5f05206d09bce0a219e9784", "additions": 19010319, "deletions": 2688, "changed_files": 6430, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0025_GITHUB_USERNAME", "EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-03-06T23:34:10Z", "updated_at": "2025-03-07T01:12:24Z", "merged_at": "2025-03-07T01:12:24Z", "closed_at": "2025-03-07T01:12:24Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2450", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#460", "repo_id": "harmonygames-Games/match3d", "number": 460, "title": "New Objects", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0009_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0016_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **New Features**\n  * Added new 3D models and prefabs to the library: chopsticks (pair/single), sushi (salmon, veggie, sashimi), hand saw, and toys (abacus, atom, DNA, protractor, blackboard).\n  * Introduced size/color variants for several prefabs to expand placement options.\n  * Improved import settings to ensure consistent materials, normals/tangents, and mesh handling for better in\u2011scene appearance.\n\n* **Chores**\n  * Added metadata for new models and prefabs to enable proper import and usage in the editor.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "fdd2dc9a308c976fe695a74532bfe58b0622f8ab", "head_ref": "claire.morgan_NewObjects_10", "head_sha": "89777eac401a78952904cc19efeb72591e8da38b", "additions": 3093, "deletions": 11, "changed_files": 49, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-09-24T08:32:43Z", "updated_at": "2025-09-24T21:51:38Z", "merged_at": "2025-09-24T21:51:38Z", "closed_at": "2025-09-24T21:51:38Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2451", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#461", "repo_id": "harmonygames-Games/match3d", "number": 461, "title": "Fixes monster bar thickness", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0032_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "", "base_ref": "main", "base_sha": "5aa4db2043fe19e1ded20f2499cc810942a3539b", "head_ref": "[PERSON_NAME_0120]/monster-bar-thickness", "head_sha": "55d3379a4e993004df31a9d02d7ff277a94f1b25", "additions": 7, "deletions": 4, "changed_files": 1, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-24T14:37:52Z", "updated_at": "2025-09-24T16:37:56Z", "merged_at": "2025-09-24T16:37:56Z", "closed_at": "2025-09-24T16:37:56Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2452", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#462", "repo_id": "harmonygames-Games/match3d", "number": 462, "title": "Objects Revisions and Changes", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0009_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0016_GITHUB_USERNAME", "body": "", "base_ref": "main", "base_sha": "4eb036e0127aff6582994c52d336166fc9a798a1", "head_ref": "claire.morgan_ObjectRevisions_08", "head_sha": "af09539094fe12c290bf5600603a2982cb6e59ad", "additions": 77, "deletions": 18, "changed_files": 13, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0016_GITHUB_USERNAME", "EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-09-25T11:43:06Z", "updated_at": "2025-09-25T23:15:41Z", "merged_at": "2025-09-25T23:15:41Z", "closed_at": "2025-09-25T23:15:41Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2453", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#463", "repo_id": "harmonygames-Games/match3d", "number": 463, "title": "FPS and Force Kill Tracking", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0025_GITHUB_USERNAME", "merged_by_login": "PERSON_5877_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n- New Features\n  - Added lightweight in-game performance tracking on mobile, capturing scene FPS after initial gameplay.\n  - Detects and records unexpected app closures occurring shortly after launch.\n  - Tracks when visual quality is dynamically adjusted due to low frame rates.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "4eb036e0127aff6582994c52d336166fc9a798a1", "head_ref": "Blake/fpsAndForceKillTracking", "head_sha": "9b1603b3f436491e3b5c132fb61e53d93d15b1ae", "additions": 179, "deletions": 21, "changed_files": 6, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-25T16:48:38Z", "updated_at": "2025-09-26T00:08:03Z", "merged_at": "2025-09-26T00:08:03Z", "closed_at": "2025-09-26T00:08:03Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2454", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#464", "repo_id": "harmonygames-Games/match3d", "number": 464, "title": "[PERSON_NAME_0019]/sep30levels", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0005_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Levels up to 275 for Sep 25 build \n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n- New Features\n  - Added a large set of Variant C level objects and Level_266 assets, expanding upcoming content options.\n- Chores\n  - Introduced metadata for new assets and an Unassigned collection entry to streamline asset management.\n- Removed\n  - Cleaned up deprecated collection metadata (Day1\u2013Day4, CircuitSlayer, TheDeadlyEnsemble) to reduce clutter and potential conflicts.\n\nNo functional behavior changes; updates focus on content assets and project organization.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "4eb036e0127aff6582994c52d336166fc9a798a1", "head_ref": "[PERSON_NAME_0019]/sep30levels", "head_sha": "354935b57367c7dfd06a56482cec4e6e622452df", "additions": 55099, "deletions": 12641, "changed_files": 2288, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-25T18:29:53Z", "updated_at": "2025-09-25T20:37:57Z", "merged_at": "2025-09-25T20:37:57Z", "closed_at": "2025-09-25T20:37:57Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2455", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#465", "repo_id": "harmonygames-Games/match3d", "number": 465, "title": "[PERSON_NAME_0029]/queue manager", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0003_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Fix to not play coin animation again if user kills the app\r\nFix queue tutorials were not playing when the 1st one finishes\r\n\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n- New Features\n  - Queued tutorials now auto-play immediately after tutorials are unblocked, ensuring a smoother onboarding flow.\n\n- Bug Fixes\n  - Prevent duplicate level-completion reward VFX by tracking and showing rewards only once per level.\n  - Fix tutorial play-state handling so tutorials correctly mark as finished, reducing stuck or repeated tutorials.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "4eb036e0127aff6582994c52d336166fc9a798a1", "head_ref": "[PERSON_NAME_0029]/QueueManager", "head_sha": "169fbe219525a30603494f5a5bb0b57c7d555e52", "additions": 52, "deletions": 18, "changed_files": 3, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0025_GITHUB_USERNAME", "EMPLOYEE_0003_GITHUB_USERNAME"], "created_at": "2025-09-25T18:35:53Z", "updated_at": "2025-09-25T22:15:51Z", "merged_at": "2025-09-25T22:15:51Z", "closed_at": "2025-09-25T22:15:51Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2456", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#466", "repo_id": "harmonygames-Games/match3d", "number": 466, "title": "[PERSON_NAME_0092]/tutorial adjustments", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0003_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0003_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n- New Features\n  - Add tutorial skip with countdown and button.\n  - Expand tutorial coverage for boosters and effects; check availability before showing.\n- Improvements\n  - More resilient tutorial flow: actions can stop or continue on skip; improved popup, highlight, and message handling.\n  - Booster buttons now reflect whether a tutorial is available at unlock.\n  - Chest updates behave more reliably when data isn\u2019t loaded.\n  - Analytics events deduplicate parameters for cleaner reporting.\n- Bug Fixes\n  - Prevents spawning tutorial elements when not applicable.\n  - Pre-level booster selections now reset and visuals deactivate on exit.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "b644f4f4fc1eef632aa52894bdf679ca247ac560", "head_ref": "[PERSON_NAME_0092]/tutorial-adjustments", "head_sha": "30658be8a448be0e56483115967904a537570755", "additions": 870, "deletions": 113, "changed_files": 63, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-26T15:14:35Z", "updated_at": "2025-09-26T15:18:17Z", "merged_at": "2025-09-26T15:14:44Z", "closed_at": "2025-09-26T15:14:44Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2457", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#467", "repo_id": "harmonygames-Games/match3d", "number": 467, "title": "adding safety checks", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0003_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0003_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **Bug Fixes**\n  * Prevents occasional errors when clicking tutorial highlights by adding safety checks.\n  * Improves stability when skipping tutorial steps with safer event handling.\n  * Reduces risk of crashes during tutorial interactions.\n\n* **Refactor**\n  * Adjusted tutorial completion flow to clear state earlier for improved reliability; no functional changes expected.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "70971e91c350000dcfc125ad1b0da104b80159c1", "head_ref": "skip/fix", "head_sha": "901196a1a6a0501dc29b12f764d81ee1d0620b8c", "additions": 15, "deletions": 5, "changed_files": 3, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-26T18:58:25Z", "updated_at": "2025-09-26T19:00:55Z", "merged_at": "2025-09-26T18:58:33Z", "closed_at": "2025-09-26T18:58:33Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2458", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#468", "repo_id": "harmonygames-Games/match3d", "number": 468, "title": "Collect And Win", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **New Features**\n  * Added \"Collect & Win\" live event: collect tokens in levels, track progress, claim stage rewards and a grand prize; main screen, progress widget, info panel, stage/prize items, and level-end token display.\n\n* **Improvements**\n  * Tokens spawn in unlocked levels, persist on level win, can be saved/claimed; new VFX/animations and reward-screen queuing.\n\n* **Developer Tools**\n  * Debug panel options to add tokens and reset event data; new backend requests to support the flow.\n\n* **Chores**\n  * Added sprites, prefabs, materials and asset metadata for the event.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "f5c0bb3a977a2d9b4e6b9559cd382d65548cb6c0", "head_ref": "[PERSON_NAME_0067]/winAndCollect", "head_sha": "648e2c7b9c1d9e263f4b43a45e135ba9fa6002fd", "additions": 54216, "deletions": 32, "changed_files": 127, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-26T20:16:25Z", "updated_at": "2025-09-29T16:13:50Z", "merged_at": "2025-09-29T16:13:50Z", "closed_at": "2025-09-29T16:13:50Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2459", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#469", "repo_id": "harmonygames-Games/match3d", "number": 469, "title": "Unity 6000.2.6f1 + top part tex resoultion decrease", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0032_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n- New Features\n  - Added tile palette and transparency sorting importer options across PSB assets, enabling tile asset generation and palette layout configuration when needed (no default behavior change).\n- Refactor\n  - Reduced Monsters2D render texture resolution from 2048 to 1024.\n- Chores\n  - Standardized importer metadata across multiple sprites and textures for consistency.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "88879d8bb88eef8203be592f5189a76d17f3b782", "head_ref": "employee_0032/top-part-res", "head_sha": "362b7cc9b5fe369524efe69c83577f967e65a4d2", "additions": 1608, "deletions": 1213, "changed_files": 1116, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-29T16:42:35Z", "updated_at": "2025-10-24T15:53:49Z", "merged_at": "2025-09-30T01:50:16Z", "closed_at": "2025-09-30T01:50:16Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2460", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#47", "repo_id": "harmonygames-Games/match3d", "number": 47, "title": "[PERSON_NAME_0054]/level edit", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0016_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0016_GITHUB_USERNAME", "body": "", "base_ref": "main", "base_sha": "56d65e19c7aafebecc6520d53a14cd913cc72a18", "head_ref": "[PERSON_NAME_0054]/LevelEdit", "head_sha": "2be3c712957565f3935752c8c74fd55dfc03e75d", "additions": 5166, "deletions": 2155, "changed_files": 171, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-03-07T09:04:54Z", "updated_at": "2025-03-07T09:05:24Z", "merged_at": "2025-03-07T09:05:24Z", "closed_at": "2025-03-07T09:05:24Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2461", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#470", "repo_id": "harmonygames-Games/match3d", "number": 470, "title": "Collect And Win minor bugs fixes", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Fixes:\r\n* When the page opened, it shows placeholder images at first.\r\n* After level completion, it first shows placeholder icon and progress for the event, then shows the correct one\r\n* In every level, I got two errors both backend and client. \r\n* In Boss arena and endless mode, the c&w UI is visible. \n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n- Refactor\n  - Collect & Win screens now use pooled UI items for faster loading, smoother scrolling, reduced flicker, improved ordering and cleanup when refreshing content.\n- New Features\n  - Auto-scrolls to the first unclaimed reward/grand prize when opening the screen.\n  - Reward and grand-prize items now reflect claimed state (labels hidden for claimed stages).\n- Bug Fixes\n  - Next Reward icon visibility corrected based on event lock.\n  - Token counter/panel shown only when relevant (avoids Endless/Infinite Boss modes).\n  - UI elements remain hidden until data/initialization to prevent brief flashes.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "88879d8bb88eef8203be592f5189a76d17f3b782", "head_ref": "[PERSON_NAME_0067]/winAndCollectMinorBugs", "head_sha": "4935e9483a95d78b3a58d18794bacd97816787e8", "additions": 166, "deletions": 33, "changed_files": 10, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-29T21:22:50Z", "updated_at": "2025-09-30T15:51:15Z", "merged_at": "2025-09-30T15:51:15Z", "closed_at": "2025-09-30T15:51:15Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2462", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#471", "repo_id": "harmonygames-Games/match3d", "number": 471, "title": "Samuel/zom 498 536", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0004_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Fixing UI Elements - UI polishes.\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **New Features**\n  * Leaderboard toggle now updates its text shadow color based on state for clearer visual feedback.\n\n* **Chores**\n  * Increased texture resolution and adjusted compression for multiple booster icons to improve clarity.\n  * Added new sprite assets (e.g., tornado popup, blue bar) and updated Daily Gift sprite configuration.\n  * Updated platform-specific texture settings (including Windows Store) for more consistent visuals across devices.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "88879d8bb88eef8203be592f5189a76d17f3b782", "head_ref": "Samuel/ZOM-498-536", "head_sha": "ff5bee4c66194a87e0f4fb85ea5a5a9055c9b122", "additions": 10933, "deletions": 962, "changed_files": 37, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-29T22:00:53Z", "updated_at": "2025-09-30T15:52:24Z", "merged_at": "2025-09-30T15:52:24Z", "closed_at": "2025-09-30T15:52:24Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2463", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#472", "repo_id": "harmonygames-Games/match3d", "number": 472, "title": "Implement Win&Collect into Queue Manager", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0003_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Implement Win&Collect into Queue Manager\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **Bug Fixes**\n  * Prevents premature progression during reward animations by waiting for Collect & Win status when available.\n  * Reduces unnecessary delays, improving responsiveness and shortening input-block time after rewards.\n  * Adds a timeout guard to avoid stalls if visual effects don\u2019t complete promptly.\n\n* **Refactor**\n  * Streamlined reward VFX flow with clearer, coroutine-driven sequencing.\n  * Exposed an explicit method to trigger Collect & Win status checks, allowing more precise timing with UI updates and effects.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "88879d8bb88eef8203be592f5189a76d17f3b782", "head_ref": "[PERSON_NAME_0029]/ImplementQueueManager", "head_sha": "1e446a5726619a7f165f2ed7a50a4bf46fe4f42d", "additions": 36, "deletions": 21, "changed_files": 3, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["PERSON_5877_GITHUB_USERNAME"], "created_at": "2025-09-29T22:36:36Z", "updated_at": "2025-09-30T15:53:04Z", "merged_at": "2025-09-30T15:53:04Z", "closed_at": "2025-09-30T15:53:04Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2464", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#473", "repo_id": "harmonygames-Games/match3d", "number": 473, "title": "Addressables/sp", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0003_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0003_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* New Features\n  * Season Pass popups and screens now load asynchronously via Addressables for smoother UI transitions.\n  * Added end-of-season popup flow with proper queuing and cleanup.\n\n* Refactor\n  * Replaced direct prefab references with Addressable asset references across Season Pass UI.\n  * Updated UI flows to use async instantiation.\n\n* Chores\n  * Integrated Unity Addressables package.\n  * Added Addressables configuration and metadata assets to the project.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "71b657ee6bd679db76a4d8975e7f9dcbfee5488a", "head_ref": "addressables/sp", "head_sha": "645a87ca7f5ffaed0221ea5635e117fe3d3343f1", "additions": 749, "deletions": 1041, "changed_files": 34, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-30T15:41:05Z", "updated_at": "2025-09-30T15:43:58Z", "merged_at": "2025-09-30T15:41:20Z", "closed_at": "2025-09-30T15:41:20Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2465", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#474", "repo_id": "harmonygames-Games/match3d", "number": 474, "title": "Skip/fix", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0003_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0003_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **New Features**\n  * Added a visible skip countdown for skippable tutorials.\n\n* **Bug Fixes**\n  * Improved tutorial step timing for smoother, more predictable progression.\n  * More reliable skip handling to prevent missed or repeated steps.\n  * Tutorial UI behavior during skip is now consistent and no longer disappears abruptly.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "9d8ae960efc783790e9707161dd5f0ac8ecfba12", "head_ref": "skip/fix", "head_sha": "3fdd63e12ec4c29533597dfa3ccf3eee5712e995", "additions": 16, "deletions": 34, "changed_files": 4, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-30T15:41:39Z", "updated_at": "2025-09-30T15:48:19Z", "merged_at": "2025-09-30T15:48:10Z", "closed_at": "2025-09-30T15:48:10Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2466", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#475", "repo_id": "harmonygames-Games/match3d", "number": 475, "title": "[PERSON_NAME_0029]/animated icons", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0003_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Adding card pack animation\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n- New Features\n  - Added on-screen prompts and visuals when opening a card pack, including a \u201cTap anywhere to collect,\u201d background, and title.\n\n- Bug Fixes\n  - Improved closing sequence with smoother animations and proper timing.\n  - Temporarily disables the close button during transitions to prevent accidental skips.\n  - Ensures the final pack correctly reveals rewards before closing and restores UI elements afterward.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "95cf5e37fc29c21c96a6d58f386e8e2bee727435", "head_ref": "[PERSON_NAME_0029]/AnimatedIcons", "head_sha": "5dbf89b38aea5f709af274d351d7a61579d731b6", "additions": 6663, "deletions": 1135, "changed_files": 2, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-30T15:59:05Z", "updated_at": "2025-09-30T16:09:15Z", "merged_at": "2025-09-30T16:09:15Z", "closed_at": "2025-09-30T16:09:15Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2467", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#476", "repo_id": "harmonygames-Games/match3d", "number": 476, "title": "Vision bot", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0025_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "A computer vision bot that plays through the game based on a QA provided regression test list.\n\n<!-- CURSOR_SUMMARY -->\n---\n\n> [!NOTE]\n> Introduce a vision-driven test bot and AI-assisted level generation with UI overlays, editor integration, and supporting tools/assets, plus minor fixes and build updates.\n> \n> - **Vision Bot & Tools**:\n>   - Add `VisionDemo`, `OpenAIVisionClient`, and plan-based run workflow; new test scene `Scenes/Test/VisionBot.unity` and run viewer `VisionTool/vision.html`.\n>   - Add `ButtonOverlay` utility and expose debug toggles in `DebugPanel`.\n>   - Include run manifests/output structure under `VisionRuns/` and S3 upload script.\n> - **AI-assisted Level Design**:\n>   - Add `AILevelGeneration` and `AILevelDesignPanel` with `AIGen.prefab` UI.\n>   - Extend game events (`GameEventType.AILevelItemsCreated`, `AILevelMonstersCreated`) and handle them in `LevelDesignPanel`.\n> - **Editor/Gameplay Updates**:\n>   - Safely handle null refs in `LevelMonsterItem`/`LevelObjectItem`; guard `MonsterSpawner.LateUpdate` when `GameManager` is null.\n>   - Fix `GameEventsManager.SafeRemoveListener` to remove instead of add.\n>   - Enable Crashlytics collection in `AnalyticsManager`; trim noisy logs in `HarmonyInput`; expose helpers in `ZMBot`.\n>   - Add `LoadScene` helper and register `Scenes/Test/VisionBot.unity` in build settings.\n> - **Assets/Meta**:\n>   - Add supporting prefabs, UI, resources, and scene/meta files.\n> \n> <sup>Written by [Cursor Bugbot](https://cursor.com/dashboard?tab=bugbot) for commit 077e1ccfa22de4346c16360441bd35badaaeea46. This will update automatically on new commits. Configure [here](https://cursor.com/dashboard?tab=bugbot).</sup>\n<!-- /CURSOR_SUMMARY -->\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n- New Features\n  - AI-assisted level generation: generate items and monsters, with new editor panels and events.\n  - Vision Bot: run multi-step plans, overlay numbered UI buttons, and simulate clicks.\n  - Scene loading utility for quick scene transitions.\n  - Autoload current level option and manual Load Level action.\n\n- Improvements\n  - Debug Panel: Button Overlay submenu (show/clear/refresh).\n  - Enabled Crashlytics data collection.\n  - Added safeguards (null checks) in spawners and level editor UI.\n\n- Bug Fixes\n  - Corrected listener removal in Game Events manager.\n  - Removed noisy input debug logging.\n\n- Tools\n  - Vision Run Viewer web page.\n  - Editor runners/CLI for bot plans; sample instruction JSONs.\n\n- Chores\n  - Updated .gitignore and added metadata/script assets.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "fda817daf1779cbd15e877a925aeb23e06da0410", "head_ref": "Blake/visionBot", "head_sha": "fa7b701203c8ce08507897c27452fb086550a79e", "additions": 41629, "deletions": 1026, "changed_files": 65, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-30T18:54:32Z", "updated_at": "2025-10-02T16:40:52Z", "merged_at": "2025-10-02T16:40:52Z", "closed_at": "2025-10-02T16:40:52Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2468", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#477", "repo_id": "harmonygames-Games/match3d", "number": 477, "title": "Collect And Win Analytics and title change", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n- New Features\n  - App emits and tracks Collect & Win start and reward-claimed events (includes event duration, stage, and reward details).\n- Improvements\n  - Total event duration now computed from explicit start and end times for more accurate reporting.\n  - Screens update and report timing consistently across flows.\n- Bug Fixes\n  - Initial color/state corrected to avoid an unintended default on load.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "166dc182aad2c6de4df28992268ea65e9600754a", "head_ref": "[PERSON_NAME_0067]/collectAndWinAnalytics", "head_sha": "8544a28e108d2c870f1bd5b961e235ed566830df", "additions": 97, "deletions": 13, "changed_files": 9, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-09-30T22:26:30Z", "updated_at": "2025-10-02T16:44:58Z", "merged_at": "2025-10-02T16:43:03Z", "closed_at": "2025-10-02T16:43:03Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2469", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#478", "repo_id": "harmonygames-Games/match3d", "number": 478, "title": "[PERSON_NAME_0029]/bug fixes", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0003_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Bug Fixes:\r\nAdding more delay before starting tutorial\r\nFix Play button VFX can be triggered multiple times.\r\nFix Season pass icon anim plays even without a reward to claim\r\nHiding Zombie Lane screen when opening card pack reward\r\nImplement reward animations for boss arena\r\n\r\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n- **Bug Fixes**\n  - Season Pass claim indicator now reliably reflects unclaimed rewards, deactivates correctly, and stays in sync when icons or progress update.\n  - Card pack rewards are shown in the appropriate screen context, reducing unnecessary reward screens.\n  - Infinite Boss reward claims now open within the current event screen for a smoother, more consistent flow.\n  - Visual effects pause slightly increased to reduce overlap and brief input hiccups.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "6ec117bae82f7fe564bee698c4e399ff0caf2971", "head_ref": "[PERSON_NAME_0029]/BugFixes", "head_sha": "370f417b725b534c89ea832abc37c15f3fd7697c", "additions": 91, "deletions": 27, "changed_files": 6, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-10-01T16:59:15Z", "updated_at": "2025-10-02T16:45:17Z", "merged_at": "2025-10-02T16:45:17Z", "closed_at": "2025-10-02T16:45:17Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2470", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#479", "repo_id": "harmonygames-Games/match3d", "number": 479, "title": "New Objects", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0009_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n- New Features\n  - Added new 3D objects and prefabs to the library: a grandfather clock; sports items (dodgeball and multiple frisbee variants); tools (power drill, screw, screwdriver, wrench); and toys (arrow and piggy bank variants).\n  - Optimized import settings for materials, meshes, normals/tangents, and animations to ensure consistent visuals and behavior.\n  - Prefabs are ready for immediate placement and use in scenes.\n\n- Chores\n  - Initialized asset metadata to support reliable import and prefab management.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "fda817daf1779cbd15e877a925aeb23e06da0410", "head_ref": "claire.morgan_NewObjects_11", "head_sha": "3beab6ae86b5dfd74825f20201a339ca144dd2e8", "additions": 4105, "deletions": 4, "changed_files": 58, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0016_GITHUB_USERNAME", "EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-10-02T11:57:17Z", "updated_at": "2025-10-02T16:47:28Z", "merged_at": "2025-10-02T16:47:28Z", "closed_at": "2025-10-02T16:47:28Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2471", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#48", "repo_id": "harmonygames-Games/match3d", "number": 48, "title": "New Shader for the grayscale material", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "ive created a shader for the grayscale material that now uses LinearLightAddSub for blending of the main color, now the color variation pop like huba buba gum", "base_ref": "main", "base_sha": "06557358f20d699cd8c9bfc31f45c5245021676a", "head_ref": "Marcus/ObjectsMaterialShader", "head_sha": "75a5695f67ae59fd7c228ef1378b9943ab0c23ed", "additions": 3076, "deletions": 2, "changed_files": 3, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-03-07T12:38:45Z", "updated_at": "2025-03-07T13:07:33Z", "merged_at": "2025-03-07T13:07:33Z", "closed_at": "2025-03-07T13:07:33Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2472", "field": "repo_id", "value": "h