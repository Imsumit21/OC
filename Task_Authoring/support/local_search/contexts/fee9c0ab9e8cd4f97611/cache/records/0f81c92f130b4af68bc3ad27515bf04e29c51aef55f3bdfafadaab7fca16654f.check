ain", "base_sha": "b60c8ce469437c71370d57558fe92480ff372cf8", "head_ref": "Marcus/ShopAnimations", "head_sha": "6f902a1533e7123d610e2ce49b90c8358c2bbed9", "additions": 201, "deletions": 105, "changed_files": 14, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-06-23T13:59:11Z", "updated_at": "2025-07-10T10:11:28Z", "merged_at": "2025-06-23T14:55:24Z", "closed_at": "2025-06-23T14:55:24Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2208", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#242", "repo_id": "harmonygames-Games/match3d", "number": 242, "title": "[PERSON_NAME_0054]/game polish0620", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0016_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0016_GITHUB_USERNAME", "body": "", "base_ref": "main", "base_sha": "ce66c28a2b2da43c93bd05d8f8575af0d08c5e78", "head_ref": "[PERSON_NAME_0054]/GamePolish0620", "head_sha": "ac7f2c0d2b594c0550c6353bcf32fcba6e57445e", "additions": 76891, "deletions": 17112, "changed_files": 2183, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-06-23T23:51:00Z", "updated_at": "2025-07-10T13:45:18Z", "merged_at": "2025-06-23T23:51:07Z", "closed_at": "2025-06-23T23:51:08Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2209", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#243", "repo_id": "harmonygames-Games/match3d", "number": 243, "title": "ZOM-173 & ZOM-307", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0025_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Remove the legacy 2nd item count slider that was meant for. \r\nItem Set Count in editor not updating with difficulty tier changes\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n- **Refactor**\n  - Removed the \"Easy Quantity\" field from level objects, including all related UI elements and data handling.\n  - Simplified level object creation by eliminating the extra quantity parameter throughout the app.\n  - Updated the level designer interface to no longer display or manage \"Easy Quantity\" values.\n  - Improved clarity in the level objects panel by refining how set quantities are updated and displayed.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "2587afbf0ce33198f5b38898b42c36210e5ea399", "head_ref": "release/ZOM-173_ZOM-307", "head_sha": "36261f33e0c6d97bf76cea1f7ac44a9eaf6fff00", "additions": 22, "deletions": 839, "changed_files": 9, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-06-25T12:57:20Z", "updated_at": "2025-06-25T19:34:47Z", "merged_at": "2025-06-25T19:34:47Z", "closed_at": "2025-06-25T19:34:47Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2210", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#244", "repo_id": "harmonygames-Games/match3d", "number": 244, "title": "ZOM-303", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0025_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Dynamic Difficult Design Oversight Fix\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n- **New Features**\n  - Added real-time display of retry tier offsets and dynamic difficulty tier changes in debug panels, with color-coded indicators.\n  - Introduced clearer debug outputs for level start and end events, including separators and enhanced statistics.\n  - Implemented retry-based adjustments to dynamic difficulty, lowering level difficulty after repeated failures.\n\n- **Bug Fixes**\n  - Improved accuracy of dynamic difficulty tier calculations by accounting for retry outcomes.\n\n- **Chores**\n  - Enhanced debug panel outputs for better clarity during gameplay testing.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "d358b049b7a0a9efeb82e033655a485aa94864ff", "head_ref": "Blake/ZOM-303", "head_sha": "047ad96a4e4d1310d7a5cfdea577e8838b7ade5f", "additions": 44, "deletions": 1, "changed_files": 3, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-06-25T19:17:03Z", "updated_at": "2025-06-25T19:35:15Z", "merged_at": "2025-06-25T19:35:15Z", "closed_at": "2025-06-25T19:35:15Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2211", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#245", "repo_id": "harmonygames-Games/match3d", "number": 245, "title": "New Electronics", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0009_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **New Features**\n  * Added metadata for new 3D models: digital camera, laptop, mobile phone, smartwatch, tablet, and VR glasses.\n  * Added metadata for new prefabs: Digital Camera Medium Blue2, Laptop Medium Pink3, MobilePhone Small Green4, SmartWatch Small Red1, Tablet Medium Pink1, and VRGlasses Medium Purple1.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "f89b44f42a572082088f1843e32ec4681fa94f64", "head_ref": "NewObjects_Electronics_01", "head_sha": "f727b36136f9d7b15e742a05b93555014e568778", "additions": 1818, "deletions": 0, "changed_files": 24, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-06-26T09:24:07Z", "updated_at": "2025-06-26T16:27:53Z", "merged_at": "2025-06-26T16:27:53Z", "closed_at": "2025-06-26T16:27:53Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2212", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#246", "repo_id": "harmonygames-Games/match3d", "number": 246, "title": "Material adjustments ", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "PERSON_0396_GITHUB_USERNAME", "body": "Material adjustments on this shader to be like it was before but to also contain glow for the infusion effect", "base_ref": "main", "base_sha": "f89b44f42a572082088f1843e32ec4681fa94f64", "head_ref": "Marcus/ShaderWork", "head_sha": "be42b272494c579e937c463cccc227a0d48a6165", "additions": 3, "deletions": 3, "changed_files": 1, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0025_GITHUB_USERNAME", "EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-06-26T11:36:14Z", "updated_at": "2025-07-10T10:12:03Z", "merged_at": "2025-06-26T11:37:30Z", "closed_at": "2025-06-26T11:37:30Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2213", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#247", "repo_id": "harmonygames-Games/match3d", "number": 247, "title": "Origin/[PERSON_NAME_0029]/timer boost", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0003_GITHUB_USERNAME", "merged_by_login": "PERSON_0003_GITHUB_USERNAME", "body": "Added timer boost.\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **New Features**\n  * Introduced timed boosters for Trampoline and Glue, allowing activation for a set duration.\n  * Updated pre-level dialog UI to display countdown timers for active timed boosters.\n  * Added new timer visuals for boosters.\n\n* **Improvements**\n  * UI dynamically updates to reflect timed booster status, disabling toggles and buy buttons when active.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "169636ef86407b3ebbec1c545ef4ac4bdbe07d7b", "head_ref": "origin/[PERSON_NAME_0029]/TimerBoost", "head_sha": "8dedf75b1d1e900741a8c86c19ea247ac865cd12", "additions": 869, "deletions": 23, "changed_files": 7, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-06-26T15:00:47Z", "updated_at": "2025-06-26T15:45:18Z", "merged_at": "2025-06-26T15:45:17Z", "closed_at": "2025-06-26T15:45:18Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2214", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#248", "repo_id": "harmonygames-Games/match3d", "number": 248, "title": "Push notification", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0004_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "- Added Push Notification.\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **New Features**\n  * Introduced comprehensive push notification support for Android and iOS, including notification scheduling for lives recharge, tutorials, daily/weekly reminders, and special events.\n  * Added notification permission management and analytics tracking for notification-related events.\n  * Added a dispatcher utility to safely execute actions on Unity\u2019s main thread.\n* **Improvements**\n  * Exposed maximum lives and regeneration time as public properties.\n  * Added new constants for tutorial and feature unlock milestones.\n* **Dependencies**\n  * Integrated Firebase Messaging and Unity Push Notifications packages.\n  * Updated project dependencies and repositories to support new notification features.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "2538a1f2dae33da61a81892994f09875e68ce7e0", "head_ref": "PushNotification", "head_sha": "ae8fa709f20c5e6e175a8019cdb9f64b472ab895", "additions": 833, "deletions": 1, "changed_files": 20, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-06-26T15:43:34Z", "updated_at": "2025-06-26T21:23:32Z", "merged_at": "2025-06-26T21:23:32Z", "closed_at": "2025-06-26T21:23:32Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2215", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#249", "repo_id": "harmonygames-Games/match3d", "number": 249, "title": "Origin/[PERSON_NAME_0029]/timer boost", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0003_GITHUB_USERNAME", "merged_by_login": "PERSON_0003_GITHUB_USERNAME", "body": "Fix boost toggle\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **Bug Fixes**\n  * Improved the display logic for \"trampoline\" and \"glue\" timed boosters in the pre-level popup, ensuring timers and toggles accurately reflect booster status.\n  * Buy buttons and availability indicators now update correctly based on whether boosters are active or available.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "1406b563cff7af492b8f2181296820a30bf47c60", "head_ref": "origin/[PERSON_NAME_0029]/TimerBoost", "head_sha": "b1bc7fe3897b6241cdb84849e551881efd135c5e", "additions": 11, "deletions": 9, "changed_files": 2, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-06-26T20:16:52Z", "updated_at": "2025-06-26T20:22:02Z", "merged_at": "2025-06-26T20:22:02Z", "closed_at": "2025-06-26T20:22:02Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2216", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#25", "repo_id": "harmonygames-Games/match3d", "number": 25, "title": "Punk Zombie Walking", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "Zombie1 walk animation and bones and stuff, unity psd importer package, psd with punk zombie, animator", "base_ref": "main", "base_sha": "97119579596b23932e5a787574384097345d6ca5", "head_ref": "Marcus/2dZombie_Animations", "head_sha": "0100cd823a6756005fbdfc3b074586021c868693", "additions": 18839, "deletions": 1, "changed_files": 15, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-02-21T17:15:08Z", "updated_at": "2025-02-21T17:15:34Z", "merged_at": "2025-02-21T17:15:34Z", "closed_at": "2025-02-21T17:15:34Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2217", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#250", "repo_id": "harmonygames-Games/match3d", "number": 250, "title": "ZOM-249: Enhance damage display duration and visibility in game", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "- Updated Bar.cs to increase damage dealt duration and make bar stay visible on first hit\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **Bug Fixes**\n  * Improved the hiding animation so it only triggers when appropriate, preventing unintended hide sequences.\n* **Style**\n  * Extended the duration of damage text visual effects for a smoother fade-out and scale-down experience.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "35bce5d65f6b480596e7a21b92036d53b690c90c", "head_ref": "[PERSON_NAME_0067]/ZOM-249", "head_sha": "8a1f761ec2a250cdde5dcba2880f391b13e313fc", "additions": 3, "deletions": 3, "changed_files": 1, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME", "EMPLOYEE_0003_GITHUB_USERNAME"], "created_at": "2025-06-26T23:33:22Z", "updated_at": "2025-06-27T12:54:05Z", "merged_at": "2025-06-27T12:54:05Z", "closed_at": "2025-06-27T12:54:05Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2218", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#251", "repo_id": "harmonygames-Games/match3d", "number": 251, "title": "Request permissions for notifications once in main menu.", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0025_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0004_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **New Features**\n  * Introduced a new component to handle notification permission requests when activated in the scene.\n\n* **Refactor**\n  * Adjusted the initialization process for notifications to be triggered by the new component instead of automatically at startup.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "fa384b79cec0e51440181