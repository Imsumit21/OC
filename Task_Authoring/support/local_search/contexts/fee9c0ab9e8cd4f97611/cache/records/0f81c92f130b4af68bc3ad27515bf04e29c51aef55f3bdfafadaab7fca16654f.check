number": 324, "title": "[PERSON_NAME_0054]/game fixes0719", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0016_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0016_GITHUB_USERNAME", "body": "Icon and card FX assignment done bye [PERSON_NAME_0050]", "base_ref": "main", "base_sha": "fd71cba509ed6b93bd9fc1c2643cb2b1072462f1", "head_ref": "[PERSON_NAME_0054]/GameFixes0719", "head_sha": "55db4623a554af5bbd482ffc6b46886df4451005", "additions": 14427, "deletions": 14417, "changed_files": 7549, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-07-21T15:53:52Z", "updated_at": "2025-08-26T03:46:31Z", "merged_at": "2025-07-21T15:54:09Z", "closed_at": "2025-07-21T15:54:09Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2300", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#325", "repo_id": "harmonygames-Games/match3d", "number": 325, "title": "Marcus/new zombies", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "10 new zombies Ready to go! Work on the new background and it's stored in the sandbox scene. updated icon generator to have new zombies as well and generated new zombies icons. also updated the zombie definitions in level design\r\n\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **New Features**\n  * Introduced new animation controllers and visual effect animations for the Zombie Cheerleader, Zombie Boxer, and Zombie Mailman characters, including support for various status effects such as slow, blind, stunned, poisoned, fire, electric slow, and enraged.\n  * Added new animation clips for attack, idle, run, walk, take damage, die, and unique effect states for these characters.\n\n* **Enhancements**\n  * Improved animation transitions for Zombie Chef, Zombie FootBallPlayer, Zombie Karen, and Zombie Magician, providing smoother and more responsive state changes when taking damage and moving.\n\n* **Chores**\n  * Added and updated metadata files to support new and existing animation assets.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "ce07b58313290d2f5750872af96e9f0a0263f54b", "head_ref": "Marcus/New_Zombies", "head_sha": "cb09f5add77a9cf90c0ed2fe5526d911dabb3955", "additions": 1069057, "deletions": 21692, "changed_files": 272, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0025_GITHUB_USERNAME", "EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-07-21T18:52:42Z", "updated_at": "2025-07-24T15:54:45Z", "merged_at": "2025-07-24T15:54:45Z", "closed_at": "2025-07-24T15:54:45Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2301", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#326", "repo_id": "harmonygames-Games/match3d", "number": 326, "title": "[PERSON_NAME_0050]/item assinging", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0012_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0016_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **Chores**\n  * Added metadata files for various garden-related assets and their effects, improving asset management and recognition within the project. No user-facing features or functional changes are included.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "ce07b58313290d2f5750872af96e9f0a0263f54b", "head_ref": "[PERSON_NAME_0050]/item-assinging", "head_sha": "0a487619925a3aee52799ac8560b408747ef0682", "additions": 1639, "deletions": 276, "changed_files": 212, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-07-21T19:10:00Z", "updated_at": "2025-07-22T09:20:38Z", "merged_at": "2025-07-22T09:20:38Z", "closed_at": "2025-07-22T09:20:38Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2302", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#327", "repo_id": "harmonygames-Games/match3d", "number": 327, "title": "Samuel/eng 414", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0004_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "[Move iOS tracking permission popup to trigger after Level 20 completion.](https://linear.app/harmonygames-games/issue/ZOM-414/move-ask-app-not-to-track-pop-up-after-level-20-completion-on-ios)\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **Bug Fixes**\n  * Improved the handling of App Tracking Transparency (ATT) permission requests on iOS, ensuring the prompt appears only when appropriate.\n\n* **Refactor**\n  * Streamlined the logic for requesting notification and tracking permissions, resulting in a more reliable and predictable user experience.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "a961cce7dadfa1b0d46bdf38d58523a1c6781381", "head_ref": "Samuel/ENG-414", "head_sha": "492e9ff01cf7ea86eb98c8b53ce36b08d5c0b46f", "additions": 25, "deletions": 7, "changed_files": 2, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-07-21T21:26:43Z", "updated_at": "2025-07-22T01:12:48Z", "merged_at": "2025-07-22T01:12:47Z", "closed_at": "2025-07-22T01:12:47Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2303", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#328", "repo_id": "harmonygames-Games/match3d", "number": 328, "title": "[PERSON_NAME_0029]/daily login merge", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0003_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Fix displaying tooltip in Daily Login chest reward.\r\nAvoid displaying coin amount if pre level is active, and displaying again when closing daily login screen.\r\nChange chapter unlock for daily gift.\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **New Features**\n  * Improved daily gift animation and reward display, including enhanced tooltip behavior for chests.\n  * Tooltips now visually update to show rewards and reposition for the final chest in the progress bar.\n  * Added ability to reposition tooltips dynamically for better UI alignment.\n\n* **Bug Fixes**\n  * Fixed issues with canvas sorting during daily gift animations to ensure proper display order.\n\n* **Other Improvements**\n  * Adjusted the minimum chapter requirement for unlocking daily gifts.\n  * Enhanced debug logging for tooltip rewards.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "a961cce7dadfa1b0d46bdf38d58523a1c6781381", "head_ref": "[PERSON_NAME_0029]/DailyLoginMerge", "head_sha": "6e42acc9ea9a5a800987bf9297a7fa88de71e7fd", "additions": 66, "deletions": 16, "changed_files": 5, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-07-21T21:44:59Z", "updated_at": "2025-07-22T01:12:09Z", "merged_at": "2025-07-22T01:12:09Z", "closed_at": "2025-07-22T01:12:09Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2304", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#329", "repo_id": "harmonygames-Games/match3d", "number": 329, "title": "[PERSON_NAME_0054]/game polishes0722", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0016_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0016_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **Chores**\n  * Added metadata files for new assets, including Beer Mug, Pepperoni Pizza Slice, Pizza Box, and Xylophone, to improve asset management within the project. No changes to user-facing features or functionality.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "fa80533ab5cfcdf31b872a286c0900f4beb6f78a", "head_ref": "[PERSON_NAME_0054]/GamePolishes0722", "head_sha": "5214172852a0cf7a6654bd1106c91d107373c14e", "additions": 898, "deletions": 236, "changed_files": 80, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-07-22T14:29:38Z", "updated_at": "2025-07-22T14:29:53Z", "merged_at": "2025-07-22T14:29:46Z", "closed_at": "2025-07-22T14:29:46Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2305", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#33", "repo_id": "harmonygames-Games/match3d", "number": 33, "title": "monster 1 and variant", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "monster1 and variant of monster 1. mr brown pants. they dont have z moved bones they have diff order on the layer for their sprites. please add order group component thing to the base monster and change that during runtime!\r\nalso i made the psb settings inside of unity to use 512 instead of 2048 we dont need to zombie that big.", "base_ref": "main", "base_sha": "a8c4705ba190c8c9baa9b846043550a93cbd5ed9", "head_ref": "Marcus/2dZombie_Animations", "head_sha": "ea1e074102ef7cec348b0bf826c662d6e0cfb888", "additions": 2831, "deletions": 740, "changed_files": 7, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-02-25T14:21:15Z", "updated_at": "2025-02-25T14:45:46Z", "merged_at": "2025-02-25T14:45:45Z", "closed_at": "2025-02-25T14:45:45Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2306", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#330", "repo_id": "harmonygames-Games/match3d", "number": 330, "title": "Samuel/eng 420", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0004_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "[Fix inconsistent SFX on claim button](https://linear.app/harmonygames-games/issue/ZOM-420/achievement-and-quest-claims-doesnt-always-play-sfx).\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **New Features**\n  * Added a sound effect when claiming a completed quest.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "6da11d283e5dc6e43ac63a0763d8b5f4c5e3640c", "head_ref": "Samuel/ENG-420", "head_sha": "32dc88aa6096754bca4aae51c4bee26044a16011", "additions": 1, "deletions": 0, "changed_files": 1, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0003_GITHUB_USERNAME"], "created_at": "2025-07-22T20:29:55Z", "updated_at": "2025-07-22T20:54:54Z", "merged_at": "2025-07-22T20:54:54Z", "closed_at": "2025-07-22T20:54:54Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2307", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#331", "repo_id": "harmonygames-Games/match3d", "number": 331, "title": "[PERSON_NAME_0054]/game polishes0722", "state": "closed", "merged": false, "draft": false, "locked": false, "author_login": "EMPLOYEE_0016_GITHUB_USERNAME", "merged_by_login": null, "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **New Features**\n  * Added option to export level item data in a simplified CSV format with \"Level,Object\" headers.\n  * Introduced a toggle to include or exclude a summary of total object quantities across all levels.\n  * Added a \"Copy to Clipboard\" button for easy export output copying.\n\n* **Improvements**\n  * Export now groups objects by base names, removing color suffixes for clearer reporting.\n  * Summary section orders objects by descending total quantity for better readability.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "6b04175e1f9dc2af1c98f12e61ec334a1a5ebcb2", "head_ref": "[PERSON_NAME_0054]/GamePolishes0722", "head_sha": "c867bc820b867eba6c59708636622db2eaad1b66", "additions": 968, "deletions": 2277, "changed_files": 197, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-07-23T17:08:34Z", "updated_at": "2025-08-26T03:46:32Z", "merged_at": null, "closed_at": "2025-07-23T17:12:55Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2308", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#332", "repo_id": "harmonygames-Games/match3d", "number": 332, "title": "Render icons realtime", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0025_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **New Features**\n  * Introduced dynamic 3D object rendering for UI icons, replacing static sprites with real-time rendered textures.\n  * Added a new utility for rendering objects into texture atlases, enabling improved icon visuals and flexibility.\n  * Included a test component for previewing randomly rendered object icons in the UI.\n  * Added an AWS Lambda function to list and filter build files from S3 with pagination and platform filtering.\n\n* **Improvements**\n  * Updated various UI components to use dynamically rendered textures and UV mapping instead of static sprites.\n  * Enhanced bypass panel and minimap item displays to utilize the new rendering system.\n  * Improved resource management by clearing rendered objects when UI panels are disabled or destroyed.\n  * Expanded reward display logic to use unified rendering approach across multiple UI elements.\n\n* **Bug Fixes**\n  * Fixed issues related to icon updates and resource cleanup in UI panels.\n\n* **Refactor**\n  * Changed several UI image fields from static sprite types to support dynamic texture rendering.\n  * Simplified icon regeneration logic for improved performance and clarity.\n  * Updated build process scripts to align with newer Unity API standards.\n\n* **Chores**\n  * Added and updated asset metadata files for new textures, prefabs, and scripts.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "f970bdefcc55d259f1e0606d7e0f814a716e0fd7", "head_ref": "Blake/renderIcons", "head_sha": "f7c27283aa09caf430c8a45e460852f8dcda6e1a", "additions": 4598, "deletions": 342, "changed_files": 58, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-07-23T18:01:00Z", "updated_at": "2025-07-24T22:54:13Z", "merged_at": "2025-07-24T22:54:13Z", "closed_at": "2025-07-24T22:54:13Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2309", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#333", "repo_id": "harmonygames-Games/match3d", "number": 333, "title": "Samuel/zom 397", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0004_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "[Implement \"Rate Us\" popup in Zombie Match 3D.](https://linear.app/harmonygames-games/issue/ZOM-397/implement-rate-us-popup-in-zombie-match-3d)\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **New Features**\n  * Introduced a new in-game \"Rate Us\" popup with updated UI assets and prefabs.\n  * Added tracking for user responses to the rating prompt, including analytics for accepted and declined actions.\n  * Implemented per-level tracking to prevent showing the rating prompt to users who have already rated or declined.\n\n* **Enhancements**\n  * Updated the Apple App ID for rating functionality.\n\n* **Bug Fixes**\n  * Improved handling to ensure the rating popup does not reappear for users who have already responded.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "e46e8632857d6e98a60b979804bffa5bda264376", "head_ref": "Samuel/ZOM-397", "head_sha": "5b2af400e7439a2a2f08b06182e3915afcc27d39", "additions": 2495, "deletions": 14, "changed_files": 15, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-07-23T19:49:00Z", "updated_at": "2025-07-28T15:38:44Z", "merged_at": "2025-07-28T15:38:44Z", "closed_at": "2025-07-28T15:38:44Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2310", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#334", "repo_id": "harmonygames-Games/match3d", "number": 334, "title": "item tweaks and kitchen items are added.", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0012_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0016_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **Chores**\n  * Added metadata files for various kitchen-related assets, improving asset management within the project. No changes to user-facing functionality.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "6492a8a25948965f6b66061825e13a81afcc4d6c", "head_ref": "[PERSON_NAME_0050]-item-tweaks", "head_sha": "bab8d92eeecaa40412c179d65ae5ac4fa732a618", "additions": 2281, "deletions": 255, "changed_files": 218, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-07-23T23:23:08Z", "updated_at": "2025-07-31T16:02:08Z", "merged_at": "2025-07-31T16:02:08Z", "closed_at": "2025-07-31T16:02:08Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2311", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#335", "repo_id": "harmonygames-Games/match3d", "number": 335, "title": "New set of revisions", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0009_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **Chores**\n  * Updated material import settings for the Pancake 3D model to improve material handling.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "d4e5bc73b4216d4ccc0e75ed57239f1041fb5165", "head_ref": "ObjectRevisions_08", "head_sha": "92dea30fec21e09de34d4c8aae7f9853de08d078", "additions": 39, "deletions": 20, "changed_files": 10, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-07-24T14:53:45Z", "updated_at": "2025-07-24T15:55:12Z", "merged_at": "2025-07-24T15:55:11Z", "closed_at": "2025-07-24T15:55:11Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2312", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#336", "repo_id": "harmonygames-Games/match3d", "number": 336, "title": "Endless mode", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0032_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **New Features**\n  * Introduced Endless Mode gameplay with dedicated UI, reward screen, milestones, and analytics tracking.\n  * Added Endless Mode live event featuring daily and weekly leaderboards, milestone claiming, and progress updates.\n  * Implemented Endless Mode UI components: main screen, progress bar with milestones, leaderboard cells, and menu icon.\n  * Integrated tutorial highlights and onboarding specific to Endless Mode.\n\n* **Enhancements**\n  * Expanded leaderboard, stat tracking, and game manager logic to support Endless Mode mechanics and rewards.\n  * Added new asset and texture support for Endless Mode UI elements.\n  * Updated level variant management and analytics for Endless Mode sessions.\n\n* **Bug Fixes**\n  * Improved null checks and error handling in notification and event systems.\n  * Adjusted player damage and retry logic to accommodate Endless Mode scenarios.\n\n* **Style/Refactor**\n  * Refactored tutorial highlight positioning and animation for smoother UI experience.\n  * Enhanced leaderboard cell and positioner logic for Endless Mode compatibility.\n\n* **Chores**\n  * Added numerous metadata and configuration files for new Endless Mode assets, prefabs, and textures.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "f4547858822d64ec8b5b2412c0d20197a67dedf9", "head_ref": "[PERSON_NAME_0120]/endless-fixed", "head_sha": "24e45b060f8846396274b7676f8a64c653365659", "additions": 56328, "deletions": 686, "changed_files": 169, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-07-24T15:59:07Z", "updated_at": "2025-10-24T15:53:43Z", "merged_at": "2025-08-01T13:31:49Z", "closed_at": "2025-08-01T13:31:49Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2313", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#337", "repo_id": "harmonygames-Games/match3d", "number": 337, "title": "Update to latest google play billing.", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0025_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **Chores**\n  * Upgraded the in-app purchasing package to version 4.13.0.\n  * Updated the Android application bundle identifier.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "2c5f3c12d590250738618f52f7a06e7d25bcf34e", "head_ref": "Blake/updateBilling", "head_sha": "3fdf8335d71ce806a447067999c24098a4988441", "additions": 3, "deletions": 3, "changed_files": 3, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-07-24T23:11:16Z", "updated_at": "2025-07-24T23:24:05Z", "merged_at": "2025-07-24T23:24:04Z", "closed_at": "2025-07-24T23:24:05Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2314", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#338", "repo_id": "harmonygames-Games/match3d", "number": 338, "title": "Fix zombie lane icon and Quests", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0025_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **New Features**\n  * Reward icons now dynamically maintain their original aspect ratio when displayed.\n  * Display objects without icons are now shown in a consistent square format for improved visual consistency.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "df7967e383972f0075c6c1f72f91fb29cde2650c", "head_ref": "Blake/fixZombieLaneIcon", "head_sha": "2a6211f9bf098a8f34671229a77afd7436ae7e57", "additions": 310, "deletions": 183, "changed_files": 7, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-07-24T23:24:19Z", "updated_at": "2025-07-25T13:35:32Z", "merged_at": "2025-07-25T13:35:32Z", "closed_at": "2025-07-25T13:35:32Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2315", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#339", "repo_id": "harmonygames-Games/match3d", "number": 339, "title": "Level packs an Dev Boot Launcher", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0025_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Create levels in specific packs instead of one global list\r\nDev Boot Launcher to choose FTUE and server type\r\n\r\n<img width=\"184\" height=\"395\" alt=\"image\" src=\"https://github.com/user-attachments/assets/5494c4a6-a3b9-4f62-afdf-e309bb9afca0\" />\r\n\r\n<img width=\"362\" height=\"792\" alt=\"image\" src=\"https://github.com/user-attachments/assets/8a94b792-0810-4da9-85de-9e74bce93973\" />\r\n\r\n<img width=\"368\" height=\"782\" alt=\"image\" src=\"https://github.com/user-attachments/assets/a4ad8cee-4b80-471d-8016-7420a4a16dc8\" />\r\n\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **New Features**\n  * Added support for organizing and browsing levels in folders (level packs) within the level editor and debug panel.\n  * Introduced a developer boot launcher for selecting environments and level packs at startup.\n  * Added ability to check for existing development environment preferences.\n\n* **Improvements**\n  * Enhanced debug panel to display levels grouped by level packs.\n  * Level loading UI now supports folder navigation and per-pack level creation.\n  * Level list building now generates separate lists for each level pack.\n\n* **Bug Fixes**\n  * Improved handling of null values and safer UI interactions in debug and editor panels.\n\n* **Refactor**\n  * Removed legacy level importer and unused fields.\n  * Updated server environment detection and endpoint selection logic.\n\n* **Chores**\n  * Added and updated metadata files for new assets and scenes.\n  * Minor formatting and whitespace adjustments throughout the codebase.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "e46e8632857d6e98a60b979804bffa5bda264376", "head_ref": "Blake/levelPacks", "head_sha": "599321836fce2ffdbaba1564261783a2ec581ace", "additions": 3645, "deletions": 367, "changed_files": 26, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-07-26T01:25:41Z", "updated_at": "2025-07-28T15:39:05Z", "merged_at": "2025-07-28T15:38:26Z", "closed_at": "2025-07-28T15:38:26Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2316", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#34", "repo_id": "harmonygames-Games/match3d", "number": 34, "title": "Please approve Blake", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0016_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "", "base_ref": "main", "base_sha": "c0818b0af2eb0e50669772766527ea00b63aadce", "head_ref": "[PERSON_NAME_0054]/LevelEdit", "head_sha": "9ee3a37d91f1ff0ee74891c4a9b3f9f5e39fdace", "additions": 103, "deletions": 120, "changed_files": 43, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-02-25T18:46:17Z", "updated_at": "2025-02-25T18:50:05Z", "merged_at": "2025-02-25T18:50:05Z", "closed_at": "2025-02-25T18:50:05Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2317", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#340", "repo_id": "harmonygames-Games/match3d", "number": 340, "title": "Advanced Camera Capture Tool!", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Advanced Camera Capture Tool! Nice tool i've created with my friend Gemeni Pro. This tool let's you snapshot from any camera you choose and the results come with png with transparent background !\r\nIt has Anti-Aliasing support and Auto-Crop option!\r\nYou can choose the resolution also!\r\nYou can select several shots that you like and group them togheder and copy them in a folder all by pressing <Group # Selected>!\r\n Good for Marketing!\r\n\r\n![MarketingTool](https://github.com/user-attachments/assets/7279b0b5-c5e2-4ef7-806a-c56dca7c9c3f)\r\n\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **New Features**\n  * Introduced an \"Advanced Camera Capture\" tool in the Unity Editor for capturing images from scene cameras with advanced options such as custom resolutions, MSAA anti-aliasing, and auto-cropping of transparent pixels.\n  * Added a user interface for camera selection, output folder browsing, custom filenames, and image capture.\n  * Implemented a gallery for previewing, selecting, grouping, and managing captured images within the session.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "e46e8632857d6e98a60b979804bffa5bda264376", "head_ref": "Marcus/Marketing_Rec", "head_sha": "46486091a404bf00e6d762644e3cfa874a101973", "additions": 328, "deletions": 0, "changed_files": 2, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-07-28T15:16:06Z", "updated_at": "2025-07-28T18:39:37Z", "merged_at": "2025-07-28T18:39:37Z", "closed_at": "2025-07-28T18:39:37Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2318", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#341", "repo_id": "harmonygames-Games/match3d", "number": 341, "title": "[PERSON_NAME_0054]/mf35", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0016_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0016_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **New Features**\n  * Added metadata files for a variety of new level object assets.\n  * Added metadata files for new baked goods and breakfast object assets, including multiple color and style variations.\n  * Enhanced asset management and organization within the project for improved asset import and identification in the editor.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "67eada8d6384941361158c7a2db35aae75ed1b1a", "head_ref": "[PERSON_NAME_0054]/MF35", "head_sha": "0b74765b9999cabb291f34e96056efeed387c096", "additions": 29381, "deletions": 5505, "changed_files": 2163, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-07-28T17:12:54Z", "updated_at": "2025-07-28T17:13:20Z", "merged_at": "2025-07-28T17:13:06Z", "closed_at": "2025-07-28T17:13:06Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2319", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#342", "repo_id": "harmonygames-Games/match3d", "number": 342, "title": "New Background and light/reflection rebake", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **Chores**\n  * Updated texture import settings for several assets to increase maximum texture size and standardize platform-specific parameters.\n  * Improved metadata for reflection probe textures, including updated serialization versions and added placeholders for custom sprite metadata.\n  * Added a new metadata file for a parallax background prefab.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "d6a6089805ca0557a99d119297de896f1f185e97", "head_ref": "Marcus/Gameplay_BackgroundWork", "head_sha": "742801b9d811d40bca26fb557bb5d70f36fe89f0", "additions": 1910, "deletions": 974, "changed_files": 16, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-07-29T10:37:37Z", "updated_at": "2025-08-04T12:43:07Z", "merged_at": "2025-07-29T11:47:07Z", "closed_at": "2025-07-29T11:47:07Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2320", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#343", "repo_id": "harmonygames-Games/match3d", "number": 343, "title": "Envoirment prefab change. Reflection probes now have a custom cubemap.", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **New Features**\n  * Added new HDR texture assets for reflections, including billiard hall, brown photostudio, and rostock laage airport environments.\n  * Configured import settings for consistent texture quality and compatibility across multiple platforms.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "520a299e3c8f5cefc69b9bd13fe61d0d30b9b7f1", "head_ref": "Marcus/GameplayScene_Reflections", "head_sha": "a69640e4adc160af4d7df050d55d664d88662b0c", "additions": 519, "deletions": 4, "changed_files": 8, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-07-30T11:57:24Z", "updated_at": "2025-07-31T01:51:15Z", "merged_at": "2025-07-31T01:51:14Z", "closed_at": "2025-07-31T01:51:15Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2321", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#344", "repo_id": "harmonygames-Games/match3d", "number": 344, "title": "New bedroom and sports objects", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0009_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **New Features**\n  * Added new 3D models and corresponding prefabs for furniture items (bed, wardrobe) and sports equipment (American football, baseball bat, tennis ball, tennis racket).\n  * Introduced associated metadata for these assets to ensure proper import and configuration within the application.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "520a299e3c8f5cefc69b9bd13fe61d0d30b9b7f1", "head_ref": "ClaireNewObjects_01", "head_sha": "701e9ba92c37c13cda65a2f910cd8fda03ec683c", "additions": 1797, "deletions": 8, "changed_files": 30, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-07-30T13:10:52Z", "updated_at": "2025-07-31T01:51:43Z", "merged_at": "2025-07-31T01:51:43Z", "closed_at": "2025-07-31T01:51:43Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2322", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#345", "repo_id": "harmonygames-Games/match3d", "number": 345, "title": "Default to master levels after completing MF pack", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0025_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "After completing all of MF levels, the game will switch to using the normal level pack.\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **New Features**\n  * Added support for managing and loading multiple level packs, allowing levels to be played in a prioritized sequence with fallback to procedural generation when necessary.\n\n* **Improvements**\n  * Debug panel now displays the current level name dynamically in the options submenu.\n  * Enhanced developer tools to load and manage multiple level packs at once for easier testing and configuration.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "40cf0aedad7fa3e1f1804c43dd0a587688e6b3c4", "head_ref": "Blake/defaultToMasterLevelsAfterMF", "head_sha": "b6ffd9ea76bd6fdd3b9361ee9bbb41cb895c3d42", "additions": 64, "deletions": 51, "changed_files": 4, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0003_GITHUB_USERNAME"], "created_at": "2025-07-31T01:50:44Z", "updated_at": "2025-07-31T19:35:31Z", "merged_at": "2025-07-31T19:35:31Z", "closed_at": "2025-07-31T19:35:31Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2323", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#346", "repo_id": "harmonygames-Games/match3d", "number": 346, "title": "[PERSON_NAME_0029]/profile", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0003_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Added Profile screen in Main Screen.\r\nAdded Profile screen in LeaderBoard screen.\r\nDisplay Profile Stats and Inventory.\r\nStore Boost Inventory in server side when finishing a level.\r\n\r\nMerged [PERSON_NAME_0067]'s Teams Implementation in this branch\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **New Features**\n  * Introduced Nakama Unity client package with support for user accounts, chat, matchmaking, real-time multiplayer, and analytics.\n  * Added extensive documentation and code examples covering setup, authentication, session management, real-time features, and WebGL support.\n  * Provided sample scripts demonstrating device authentication, matchmaking, chat rooms, socket connections, and backend interactions.\n  * Included prefabs and metadata for team and leaderboard UI components.\n\n* **Documentation**\n  * Added comprehensive README, changelog, and integration guides for Nakama and Satori Unity clients.\n  * Included Apache 2.0 license documentation.\n\n* **Style/Chores**\n  * Added Unity meta files, assembly definitions, package manifest, and plugin configurations for seamless asset management and platform compatibility.\n  * Introduced WebSocket and HTTP adapters optimized for Unity and WebGL environments.\n  * Implemented logging integration with Unity\u2019s logging system.\n\nThese updates provide a complete backend integration framework for Unity projects, featuring robust samples, detailed guides, and platform-specific support.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "aee158b54f65f935957315406a0b2389b844289c", "head_ref": "[PERSON_NAME_0029]/Profile", "head_sha": "1eb46b6500fb1a83cb10ddadbb28ec74a7144742", "additions": 97108, "deletions": 3563, "changed_files": 454, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-07-31T04:57:38Z", "updated_at": "2025-08-03T21:54:32Z", "merged_at": "2025-08-03T21:54:32Z", "closed_at": "2025-08-03T21:54:32Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2324", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#347", "repo_id": "harmonygames-Games/match3d", "number": 347, "title": "Change the reflection to the monsters at the top back to the baked ref", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "PERSON_0396_GITHUB_USERNAME", "body": "", "base_ref": "main", "base_sha": "6492a8a25948965f6b66061825e13a81afcc4d6c", "head_ref": "Marcus/GameplayScene_Reflections", "head_sha": "01ffbfc9036ad79f55bdf809cec0db622910ac8e", "additions": 2, "deletions": 2, "changed_files": 1, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0025_GITHUB_USERNAME"], "created_at": "2025-07-31T15:11:36Z", "updated_at": "2025-09-02T14:31:14Z", "merged_at": "2025-07-31T15:12:04Z", "closed_at": "2025-07-31T15:12:04Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2325", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#348", "repo_id": "harmonygames-Games/match3d", "number": 348, "title": "Added Rate Us Pop Up in Tutorial Manager", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0004_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Added Rate Us Pop Up in Tutorial Manager.\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **Chores**\n  * Added new metadata files for Rate Us Pop Up assets to support AB testing.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "47828336dc9d8f261af9966ad5fd8207f8f4dc85", "head_ref": "Samuel/FixRateUs", "head_sha": "76be7031b5619bb8982f9c9286c82bdebc1ffe48", "additions": 120, "deletions": 0, "changed_files": 9, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-07-31T16:51:54Z", "updated_at": "2025-07-31T16:56:12Z", "merged_at": "2025-07-31T16:56:11Z", "closed_at": "2025-07-31T16:56:11Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2326", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#349", "repo_id": "harmonygames-Games/match3d", "number": 349, "title": "[PERSON_NAME_0054]/zombie swap", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0005_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0016_GITHUB_USERNAME", "body": "Background changed\r\nZombies swapped with new art \r\nThe football player prefab received a color change. \n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **Bug Fixes**\n  * Corrected animation clip names for multiple Zombie_Boxer animations, removing unnecessary trailing numbers for consistency.\n\n* **Improvements**\n  * Refined and enhanced the Zombie_Boxer_Run and Zombie_Boxer_TakeDamage animations with smoother transitions, improved keyframes, and more detailed motion.\n  * Significantly improved the Zombie_Mayor_Die animation with more detailed bone movements and smoother interpolation.\n  * Enhanced the Zombie_Karen_Die animation to activate the DeathSmoke visual effect during the death sequence.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "25351d9c5a4d68b53bf58757190daf36adf33f93", "head_ref": "[PERSON_NAME_0054]/ZombieSwap", "head_sha": "d16ca7889454b12e33b6ebe9a945391dfe8f6d68", "additions": 8481, "deletions": 6472, "changed_files": 1382, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-07-31T17:09:53Z", "updated_at": "2025-07-31T17:14:44Z", "merged_at": "2025-07-31T17:14:44Z", "closed_at": "2025-07-31T17:14:44Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2327", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#35", "repo_id": "harmonygames-Games/match3d", "number": 35, "title": "Update on the afro rig and animation and prefab", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "", "base_ref": "main", "base_sha": "e0ae72d313be93c5e7d361df357a1948ea0c165d", "head_ref": "Marcus/2dZombie_Animations", "head_sha": "586fd39fde9853d5c7712f0498c7c3102b033d03", "additions": 950, "deletions": 2274, "changed_files": 4, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-02-26T19:17:03Z", "updated_at": "2025-02-27T10:59:41Z", "merged_at": "2025-02-27T10:59:41Z", "closed_at": "2025-02-27T10:59:41Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2328", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#350", "repo_id": "harmonygames-Games/match3d", "number": 350, "title": "PR11,12,56,84 swap mistakes corrected", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0005_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Zombie swap fixes for 4 levels. Level files only  ", "base_ref": "main", "base_sha": "ae0668b884d707edc2e6b6adc599faf75158b182", "head_ref": "[PERSON_NAME_0054]/ZombieSwap", "head_sha": "d997901859c1558629429615cf2c280e952b8794", "additions": 35, "deletions": 60, "changed_files": 4, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-07-31T18:16:10Z", "updated_at": "2025-07-31T18:21:26Z", "merged_at": "2025-07-31T18:21:26Z", "closed_at": "2025-07-31T18:21:26Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2329", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#351", "repo_id": "harmonygames-Games/match3d", "number": 351, "title": "Remote config", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0025_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Remote config to control test variant and level packs.\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **New Features**\n  * Integrated Firebase Remote Config for real-time updates and A/B test group assignment.\n  * Added a manager for accessing and overriding remote config values.\n  * Splash screen now waits for Firebase initialization and applies remote config settings.\n  * Level packs and test variants can be set and parsed from remote config.\n\n* **Improvements**\n  * Level packs can be set by name for easier dynamic content management.\n  * AnalyticsManager supports setting A/B test group properties.\n  * Improved resource cleanup in object rendering for better memory management.\n\n* **Bug Fixes**\n  * Simplified and updated asset metadata for Firebase textures and plugins to reduce legacy settings.\n\n* **Documentation**\n  * Updated changelog and README with new installation instructions and recent updates.\n\n* **Chores**\n  * Added and updated configuration, manifest, and metadata files for Firebase dependencies and plugins.\n  * Updated project and Gradle settings to support Firebase Remote Config and enabled project export.\n\n* **Refactor**\n  * DevBootLauncher now uses remote config debug overrides instead of local level loading.\n  * Remote config keys reorganized for clarity.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "a4d6aceeed610ad34bc4319b2d567a6dda3b58df", "head_ref": "Blake/remoteConfig", "head_sha": "35293416b8644e816f5853eeb33e8f19046ae62c", "additions": 1900, "deletions": 2705, "changed_files": 74, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-07-31T20:48:58Z", "updated_at": "2025-07-31T21:34:32Z", "merged_at": "2025-07-31T21:34:32Z", "closed_at": "2025-07-31T21:34:32Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2330", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#352", "repo_id": "harmonygames-Games/match3d", "number": 352, "title": "Ipad top part resolution fix", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0032_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **New Features**\n  * Camera view dynamically adjusts to different device aspect ratios for improved gameplay experience.\n\n* **Improvements**\n  * Increased resolution of monster and background textures for enhanced visual quality.\n  * Disabled texture compression and increased maximum texture size for several background assets, resulting in sharper and clearer graphics across devices.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "f4547858822d64ec8b5b2412c0d20197a67dedf9", "head_ref": "[PERSON_NAME_0120]/texture-test", "head_sha": "0a209d8667428db78003f5664bc0a22f7774702f", "additions": 277, "deletions": 21, "changed_files": 9, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-08-01T12:22:03Z", "updated_at": "2025-08-02T20:09:36Z", "merged_at": "2025-08-02T20:09:36Z", "closed_at": "2025-08-02T20:09:36Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2331", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#353", "repo_id": "harmonygames-Games/match3d", "number": 353, "title": "Fixed UI for endless mode", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0032_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "", "base_ref": "main", "base_sha": "8bc141928353a7a21c2e65a3480cc9f1c35b5ee0", "head_ref": "[PERSON_NAME_0120]/endless-ui-fix", "head_sha": "6affeb7fef358fea4d38d083cb9d4b3bcfb3306d", "additions": 6, "deletions": 5, "changed_files": 2, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-08-01T16:54:14Z", "updated_at": "2025-08-02T20:12:29Z", "merged_at": "2025-08-02T20:12:29Z", "closed_at": "2025-08-02T20:12:29Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2332", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#354", "repo_id": "harmonygames-Games/match3d", "number": 354, "title": "Bike Kid Boss zombie,", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "PERSON_0396_GITHUB_USERNAME", "body": "Bike Kid Boss zombie, I've updated definitions also so designers can start working with him.\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **New Features**\n  * Introduced the Zombie_BikeKid character with a full suite of animations covering movement, combat, damage, death, and multiple status effects like enraged, slow, fire, stunned, poisoned, blind, and electric slow.\n  * Added new animation clips and visual effects enhancing the character\u2019s dynamic responses.\n  * Included new prefab and texture assets for Monster BikeKid and Zombie_BikeKid characters.\n  * Added new audio and material assets to enrich visual and sound effects.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "a0263058af8a597b9880daa46bf0f0c6346ee6f0", "head_ref": "Marcus/New_Zombies", "head_sha": "f4220511c1dc0514a00f7b2adc569e6f8088fd7f", "additions": 261364, "deletions": 115, "changed_files": 59, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-08-01T17:27:34Z", "updated_at": "2025-08-04T18:03:25Z", "merged_at": "2025-08-04T18:03:25Z", "closed_at": "2025-08-04T18:03:25Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2333", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#355", "repo_id": "harmonygames-Games/match3d", "number": 355, "title": "Play Through Bot", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0025_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **New Features**\n  * Introduced an automated bot to simulate user interactions, including navigating menus, tutorials, and gameplay.\n  * Added a toggle to enable or disable the bot and a visual effect for simulated touches.\n  * Implemented a unified input handler to support both user and bot-generated inputs.\n  * Added support for detecting scene changes and tutorial completion events.\n  * Exposed button identifiers for UI automation and improved inspector visibility.\n\n* **Improvements**\n  * Enhanced input handling by centralizing mouse input logic.\n  * Improved logging for bot actions and input events.\n\n* **Chores**\n  * Added metadata files for new prefabs, scripts, and textures related to the bot and UI elements.\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "e293b8f847cd68c9a091743514d6a4437bf9577f", "head_ref": "Blake/bot", "head_sha": "2f1b2206ef2f33861a0e86a95dd8d1aebf93c854", "additions": 3853, "deletions": 1835, "changed_files": 29, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-08-03T00:24:24Z", "updated_at": "2025-08-03T13:00:23Z", "merged_at": "2025-08-03T12:59:45Z", "closed_at": "2025-08-03T12:59:45Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/