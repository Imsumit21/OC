s": 19, "deletions": 16, "changed_files": 1, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-08-06T11:13:25Z", "updated_at": "2025-10-24T15:53:44Z", "merged_at": "2025-08-06T13:40:09Z", "closed_at": "2025-08-06T13:40:09Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2341", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#362", "repo_id": "harmonygames-Games/match3d", "number": 362, "title": "New Objects", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0009_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "Pool Balls and Cue\r\nAlphabet Set\r\nSoda Drinks\r\nBoiled Eggs (white and brown)\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **New Features**\n  * Added metadata files for new 3D models and prefabs, including food items, beverages, sports equipment, and alphabet letters.\n  * Introduced metadata for various small-sized letter and sports item prefabs, enabling their use and configuration in the Unity project.\n  * Added metadata for new beverage and breakfast prefabs to expand available object options.\n\n* **Chores**\n  * Included metadata files for new folders and assets to support asset organization and management within the project.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "66ac3679380a1ccb5f50e6f6654b7c71ece5a753", "head_ref": "ClaireNewObjects_02", "head_sha": "22ea8ef48d0bc2a1ac3ccb206fbd9c94e9f201e0", "additions": 13319, "deletions": 8, "changed_files": 190, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-08-06T11:38:14Z", "updated_at": "2025-08-06T11:39:54Z", "merged_at": "2025-08-06T11:39:54Z", "closed_at": "2025-08-06T11:39:54Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2342", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#363", "repo_id": "harmonygames-Games/match3d", "number": 363, "title": "Minimap icons", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0032_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **New Features**\n  * Added support for custom mini map icons for monsters, allowing each monster to display a unique icon on the mini map.\n  * Introduced a fallback icon for the mini map slider when a monster does not have a specific icon assigned.\n\n* **Improvements**\n  * Updated mini map slider logic to prioritize displaying a monster's custom mini map icon, improving visual clarity.\n\n* **Chores**\n  * Added new mini map icon textures and their metadata to the project.\n  * Removed an unused directive to clean up code.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "8eb4ab4ced5f31d4c5fe5940a7fdacb43df4b4a4", "head_ref": "[PERSON_NAME_0120]/minimap-icons", "head_sha": "af58a15eecf70b1741055f2aa33a68dad11c1958", "additions": 1834, "deletions": 4, "changed_files": 45, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-08-06T11:40:14Z", "updated_at": "2025-10-24T15:53:44Z", "merged_at": "2025-08-06T13:40:32Z", "closed_at": "2025-08-06T13:40:32Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2343", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#364", "repo_id": "harmonygames-Games/match3d", "number": 364, "title": "New endless level added to r