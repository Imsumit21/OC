onygames-Games/match3d#54", "repo_id": "harmonygames-Games/match3d", "number": 54, "title": "zombies and boss zombie update", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "", "base_ref": "main", "base_sha": "1efd34a71285b7369f48588c856587482bf0ab7a", "head_ref": "Marcus/OtherZombies_Animations", "head_sha": "9f3c20b66df7adfa576baae6881251c94c51ee61", "additions": 128588, "deletions": 51, "changed_files": 71, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-03-10T15:42:54Z", "updated_at": "2025-03-10T15:44:43Z", "merged_at": "2025-03-10T15:44:43Z", "closed_at": "2025-03-10T15:44:43Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2539", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#540", "repo_id": "harmonygames-Games/match3d", "number": 540, "title": "[PERSON_NAME_0029]/remove game modes", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0003_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0003_GITHUB_USERNAME", "body": "Remove Game Modes From the Event Icon System [ZOM-642](https://linear.app/harmonygames-games/issue/ZOM-642/remove-game-modes-from-the-event-icon-system)\r\nRemove Feats Of Strengths From Leaderboards [ZOM-666](https://linear.app/harmonygames-games/issue/ZOM-666/remove-feats-of-strengths-from-leaderboards)", "base_ref": "lite", "base_sha": "ccb548aee0e7c92a2b4464f61d30823ad4ef45ba", "head_ref": "[PERSON_NAME_0029]/RemoveGameModes", "head_sha": "bb96b3532312f2d90ba2f709b69106de52f88f20", "additions": 56, "deletions": 23, "changed_files": 4, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-10-22T20:43:38Z", "updated_at": "2025-10-22T22:39:32Z", "merged_at": "2025-10-22T22:39:25Z", "closed_at": "2025-10-22T22:39:25Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2540", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#541", "repo_id": "harmonygames-Games/match3d", "number": 541, "title": "Ads and no ads iap", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0032_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n## Summary by CodeRabbit\n\n* **New Features**\n  * Ad-based reward flows added across level end, loss, Endless and Infinite Boss modes\n  * Lifetime NoAds purchase and NoAds storefront/UI added\n  * Journey rotating gem content and purchase path added\n  * New \u201cwatch ad\u201d buttons and rewarded-ad shortcuts to restart/continue levels\n\n* **Chores**\n  * Updated AppLovin SDK and mediation adapters; dependency registry refreshed\n\n* **UI**\n  * Shop and store UI updated to surface NoAds and Journey items and reflect purchase state\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "3fdf80bf523ffca7cbcea3d90277b15aa6eac48b", "head_ref": "[PERSON_NAME_0120]/ads", "head_sha": "fae1e6881920cabd78af0b7197083a29634f1025", "additions": 21204, "deletions": 3254, "changed_files": 75, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-10-23T16:13:08Z", "updated_at": "2025-10-24T15:53:50Z", "merged_at": "2025-10-23T19:45:36Z", "closed_at": "2025-10-23T19:45:36Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2541", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#542", "repo_id": "harmonygames-Games/match3d", "number": 542, "title": "ZOM-668: Make sure event tokens are doubled", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_5877_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "- Updated GameManager, LevelManager and CollectAndWinTokenManager to duplicate all collected tokens on ad watched\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **New Features**\n  * Added token duplication functionality for collected rewards\n  * Added Season Pass score duplication capability\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "b1af3d9658ddf56e7f134d959a15365a490c343b", "head_ref": "[PERSON_NAME_0067]/ZOM-668", "head_sha": "27b4fc97e1585d99f70893964766cec3a65e60db", "additions": 13, "deletions": 7, "changed_files": 3, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-10-24T00:13:27Z", "updated_at": "2025-10-24T13:08:15Z", "merged_at": "2025-10-24T13:08:15Z", "closed_at": "2025-10-24T13:08:15Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2542", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#543", "repo_id": "harmonygames-Games/match3d", "number": 543, "title": "Samuel/add score boss arena fix endless score values", "state": "open", "merged": false, "draft": false, "locked": false, "author_login": "EMPLOYEE_0004_GITHUB_USERNAME", "merged_by_login": null, "body": "[Added BestScore/TotalScore in Infinite Boss and fix doubled values in Endless Mode.](https://linear.app/harmonygames-games/issue/ZOM-542/update-home-screen-and-victory-score-screen-for-game-modes)\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n## Release Notes\n\n* **Bug Fixes**\n  * Corrected score calculation in Endless Mode\u2014killed zombies are no longer doubled for returning players.\n  * Fixed best score tracking to update when earned score exceeds the previous record.\n\n* **New Features**\n  * Enhanced UI in Infinite Boss Mode to display best score and total score in separate text fields.\n\n* **Changes**\n  * Adjusted progress calculation in Endless Mode events to count only zombie kills, excluding boss kills.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "b1af3d9658ddf56e7f134d959a15365a490c343b", "head_ref": "Samuel/AddScoreBossArena-FixEndlessScoreValues", "head_sha": "d81810392cdb4b87f3604d8f2ff46d58d768efad", "additions": 2337, "deletions": 80, "changed_files": 6, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-10-24T01:40:25Z", "updated_at": "2025-10-24T01:45:03Z", "merged_at": null, "closed_at": null, "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2543", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#544", "repo_id": "harmonygames-Games/match3d", "number": 544, "title": "Animated Info Screens", "state": "open", "merged": false, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": null, "body": "", "base_ref": "main", "base_sha": "eeb8b3941f9e72473afa5f5bcd94293b82c42d2d", "head_ref": "Marcus/InfoScreenAnimations", "head_sha": "9901f2f8d5b3c518f0aad094cf3794f62ce62e67", "additions": 27428, "deletions": 12773, "changed_files": 29, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0003_GITHUB_USERNAME", "EMPLOYEE_0025_GITHUB_USERNAME"], "created_at": "2025-10-24T13:13:42Z", "updated_at": "2025-10-28T16:40:59Z", "merged_at": null, "closed_at": null, "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2544", "field": "repo_id", "valu