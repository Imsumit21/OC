E", "merged_by_login": "EMPLOYEE_0016_GITHUB_USERNAME", "body": "", "base_ref": "main", "base_sha": "e53a7beeeea71c0e7ad468cc18db28c09414a36e", "head_ref": "[PERSON_NAME_0054]/LevelEdit", "head_sha": "365aa83a2fd7bd7b9fbb83c0e32e2ad8f8b1932f", "additions": 2281, "deletions": 1263, "changed_files": 660, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-04-10T05:36:49Z", "updated_at": "2025-04-10T05:37:10Z", "merged_at": "2025-04-10T05:37:10Z", "closed_at": "2025-04-10T05:37:10Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2077", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#124", "repo_id": "harmonygames-Games/match3d", "number": 124, "title": "NewPowerUps&NewObjects", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0009_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "", "base_ref": "main", "base_sha": "ed14e7efce4ee9b4d70f103059821b5b6423dc5d", "head_ref": "PowerUpsAndNewItems", "head_sha": "6ddea72f83b93470d8d64b168779f5a54e277f50", "additions": 2571, "deletions": 123, "changed_files": 37, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-04-10T14:56:24Z", "updated_at": "2025-06-28T18:47:51Z", "merged_at": "2025-04-10T15:00:59Z", "closed_at": "2025-04-10T15:00:59Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2078", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#125", "repo_id": "harmonygames-Games/match3d", "number": 125, "title": "LoseScreen", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "LoseScreen.prefab and Game main scene because i put the canvas to be rendered by an UI camera. now the main cameras will use the camera stacking and UI camera as overlay. Please remember to feed in the push effect to the lose screen script  . it sits in the monster camera that prefab. Also remember to update life bar font with the fonts that i've created. they are two that needs to be updated\r\n", "base_ref": "main", "base_sha": "841d6a10a9beb4b54f4aefbc5f1a0db99f0d7702", "head_ref": "Marcus/EndScreen_Animations", "head_sha": "1fc81c599f1b7fa142993bcbaf625af947ed1cee", "additions": 18507, "deletions": 21, "changed_files": 42, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-04-10T16:20:57Z", "updated_at": "2025-04-11T09:36:04Z", "merged_at": "2025-04-11T09:36:04Z", "closed_at": "2025-04-11T09:36:04Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2079", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#126", "repo_id": "harmonygames-Games/match3d", "number": 126, "title": "trash bin sounds", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "Trash bin sounds and robotic arm sounds :) and falling zmobie part sounds. it's all in the animations no need for coding what so ever....\r\n", "base_ref": "main", "base_sha": "dd87a11674e32091bc817173ed1fb8e98759c8ab", "head_ref": "Marcus/TrashBins_SFX", "head_sha": "e0aa57682a79fd1d29ba204a934ebb7d76e7b977", "additions": 1834, "deletions": 0, "changed_files": 23, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0025_GITHUB_USERNAME", "EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-04-10T20:08:21Z", "updated_at": "2025-07-10T10:10:00Z", "merged_at": "2025-04-11T08:33:15Z", "closed_at": "2025-04-11T08:33