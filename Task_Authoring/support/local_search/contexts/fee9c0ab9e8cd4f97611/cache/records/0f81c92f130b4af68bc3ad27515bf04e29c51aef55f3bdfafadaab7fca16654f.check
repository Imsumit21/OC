: 117, "title": "pushBackVfx.prefab vfx ", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "pushBackVfx.prefab vfx for when you lose the game but get back and monsters push back. remember this vfx must sit inside of the camera to travel with it and also feed it to the loose screen vfx slot\r\n", "base_ref": "main", "base_sha": "64e6f05ca58cb24c6d1952274e521960ff824cff", "head_ref": "Marcus/PushBackMonsters_Vfx", "head_sha": "0dd1cf80667ba5b499de18f7258f1a2fa13e7f93", "additions": 22372, "deletions": 0, "changed_files": 5, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-04-09T15:39:18Z", "updated_at": "2025-07-10T10:12:18Z", "merged_at": "2025-04-09T15:40:06Z", "closed_at": "2025-04-09T15:40:06Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2070", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#118", "repo_id": "harmonygames-Games/match3d", "number": 118, "title": "Adding tutorial for when bar is full for the first time", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0003_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0003_GITHUB_USERNAME", "body": "", "base_ref": "main", "base_sha": "b044c7637653678f47c0fee98c669c6ba4a18ad3", "head_ref": "feature/tutorialevent", "head_sha": "d91a355882d12519934b3a6836fb9556cd167341", "additions": 4593, "deletions": 23, "changed_files": 83, "labels": [], "assignee_logins": [], "requested_reviewer_logins": [], "created_at": "2025-04-09T17:46:35Z", "updated_at": "2025-04-09T17:51:23Z", "merged_at": "2025-04-09T17:51:18Z", "closed_at": "2025-04-09T17:51:18Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2071", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#119", "repo_id": "harmonygames-Games/match3d", "number": 119, "title": "cycle offset parameter set", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "", "base_ref": "main", "base_sha": "05dea39f9fd6cdadc8de0ee3b57a9307431476d8", "head_ref": "Marcus/2dZombie_Animations", "head_sha": "96d0bc9140503012fe085270546ddc7be0de70c3", "additions": 2, "deletions": 2, "changed_files": 1, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-04-09T19:07:17Z", "updated_at": "2025-07-10T10:16:33Z", "merged_at": "2025-04-09T19:12:34Z", "closed_at": "2025-04-09T19:12:34Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2072", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#12", "repo_id": "harmonygames-Games/match3d", "number": 12, "title": "New smooth Food, ", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Introducing screenshot utility plugin (jost so i can make nice screenshots), Smooth Food Objects that fit inside 1 m cube in the fbx. New object data with food and put that to use in the main scene. Some of the food objects didnt exist and i had to create aditional data objects for them and to assign id's so they match with each other. They are all in food category. In the main scene i removed shadow setting for the monster light and in the pipeline asset i increased the shadow resolution to 2048, we probably gona have a quality setting for this one depending on the device.", "base_ref": "main", "base_sha": "552d32a557a132f3aac66abf3cba0b9f0f5aa595", "head_ref": "Marcus/ItemsScale", "head_sha": "4341466520dd794846794e3176909b502a39378d", "additions": 3728, "deletions": 39, "changed_files": 71, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-01-29T23:09:45Z", "updated_at": "2025-01-30T00:55:42Z", "merged_at": "2025-01-30T00:55:41Z", "closed_at": "2025-01-30T00:55:41Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2073", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#120", "repo_id": "harmonygames-Games/match3d", "number": 120, "title": "adding post processing on medium and low ", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "adding post processing on medium and low so game objects hiting the monsters will be visibile. we remove post processing in a different way . we just hide the global volume on the low and med.\r\n", "base_ref": "main", "base_sha": "55afa65a68e1e6bcbca4fbbae021731eaf774942", "head_ref": "Marcus/GameplayScene_Optimisation", "head_sha": "0fd5e2347afcbe0f04ffd891460dbcbc234090cb", "additions": 32, "deletions": 2, "changed_files": 3, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-04-09T19:54:46Z", "updated_at": "2025-07-10T10:13:48Z", "merged_at": "2025-04-09T19:59:33Z", "closed_at": "2025-04-09T19:59:33Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2074", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#121", "repo_id": "harmonygames-Games/match3d", "number": 121, "title": "100 Levels Completed!", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login