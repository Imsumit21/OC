Z", "closed_at": "2025-01-24T11:16:48Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2583", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#90", "repo_id": "harmonygames-Games/match3d", "number": 90, "title": "slow effect", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "I made a slow effect to all of the zombie characters. The bool in the animator to trigger it is : \"slow\"\r\nWe need to adjust the speed of the walking for the zombie when this bool will be true so they can walk verry slow", "base_ref": "main", "base_sha": "abea8c48565853ddec2489a326cac2d1987c55c6", "head_ref": "Marcus/Zombie_AditionalVfx_Animations", "head_sha": "d226098a8614c74199c89e92416ac5dede3a820f", "additions": 168227, "deletions": 22176, "changed_files": 21, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-03-26T13:31:18Z", "updated_at": "2025-03-26T13:55:02Z", "merged_at": "2025-03-26T13:55:02Z", "closed_at": "2025-03-26T13:55:02Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2584", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#91", "repo_id": "harmonygames-Games/match3d", "number": 91, "title": "blind effect", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "blind effect. turn on the blind effect by making the bool \"blind\" true in the zombie animator", "base_ref": "main", "base_sha": "2cdfeea9d3565c95112c704aaae9140d1b0d88e2", "head_ref": "Marcus/Zombie_AditionalVfx_Animations", "head_sha": "b2c070d42b126148a74f52a6bbec2b3f