ad_sha": "afccbb3e4b100e60c7dbbdcaf65601e1e783b1f0", "additions": 2808, "deletions": 2, "changed_files": 37, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-04-04T13:48:18Z", "updated_at": "2025-06-28T18:48:28Z", "merged_at": "2025-04-04T13:54:45Z", "closed_at": "2025-04-04T13:54:45Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2060", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#109", "repo_id": "harmonygames-Games/match3d", "number": 109, "title": "Adding tutorial system and first level tutorial asset working", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0003_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0003_GITHUB_USERNAME", "body": "", "base_ref": "main", "base_sha": "b49a0aa36ff756821c20bec089eb1bd490e06206", "head_ref": "feature/tutorial", "head_sha": "4a8e87302860aca0660749a6c2ffa31b634991f0", "additions": 14361, "deletions": 4, "changed_files": 315, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-04-07T07:29:50Z", "updated_at": "2025-04-07T07:37:27Z", "merged_at": "2025-04-07T07:37:23Z", "closed_at": "2025-04-07T07:37:23Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2061", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#11", "repo_id": "harmonygames-Games/match3d", "number": 11, "title": "Item Scale, Material Change", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "Scale Adjust, Material change! Now the materials we are using are SimpleLit so the objects are more visibile now with no shine on them and also it helps with frame processing", "base_ref": "main", "base_sha": "966440a204de3d7483bbb21034c225f73061ac25", "head_ref": "Marcus/ItemsScale", "head_sha": "4d3a937e68e2791e146ebcedbb9eea198ef30f2e", "additions": 153, "deletions": 61, "changed_files": 45, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-01-24T18:59:10Z", "updated_at": "2025-01-24T20:12:04Z", "merged_at": "2025-01-24T20:12:04Z", "closed_at": "2025-01-24T20:12:04Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2062", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#110", "repo_id": "harmonygames-Games/match3d", "number": 110, "title": "atackSpeed and animation event", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "PERSON_0396_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0032_GITHUB_USERNAME", "body": "atackSpeed float parameter added to the animators and set it as multiplier for the Atack animations. Also there is now in all the atack animation an Animation event at the right secont to trigger a function . [PERSON_NAME_0120] will add in the script component with the function\r\n", "base_ref": "main", "base_sha": "33b14541fc644268ef12f0c6caac73f71b30ba46", "head_ref": "Marcus/Zombie_AditionalVfx_Animations", "head_sha": "3377b1193e65f3a6186da2124249a1ed746d969c", "additions": 80, "deletions": 15, "changed_files": 10, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0032_GITHUB_USERNAME"], "created_at": "2025-04-07T12:42:52Z", "updated_at": "2025-07-10T10:10:26Z", "merged_at": "2025-04-07T12:43:27Z", "closed_at": "2025-04-07T12:43:28Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2063", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygame