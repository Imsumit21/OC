es by coderabbit.ai -->", "base_ref": "main", "base_sha": "1ece8026d775127b1eb6c5003adda409ca3ae275", "head_ref": "Marcus/CardsToInventory_VfxAnim", "head_sha": "39a82816c6a7f2621eb117202ff98a2c8dd99d08", "additions": 454998, "deletions": 0, "changed_files": 5, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["PERSON_0003_GITHUB_USERNAME"], "created_at": "2025-09-12T16:52:43Z", "updated_at": "2025-10-09T09:40:30Z", "merged_at": "2025-09-17T01:24:13Z", "closed_at": "2025-09-17T01:24:13Z", "html_url": null}}, {"file": "HarmonyGames_GitHub/Services_Data/github/data.json", "pointer": "/pull_requests/2418", "field": "repo_id", "value": "harmonygames-Games/match3d", "record": {"id": "harmonygames-Games/match3d#431", "repo_id": "harmonygames-Games/match3d", "number": 431, "title": "New Sweets", "state": "closed", "merged": true, "draft": false, "locked": false, "author_login": "EMPLOYEE_0009_GITHUB_USERNAME", "merged_by_login": "EMPLOYEE_0025_GITHUB_USERNAME", "body": "\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n## Summary by CodeRabbit\n\n* **New Features**\n  * Added new 3D food assets and prefabs: Candy (multiple variants), Lollipops (multiple variants), Chocolate Bar, Corn Dog, and Sandwich.\n  * Prefabs are ready for placement in scenes, enabling quick prototyping of sweets and fast-food items.\n  * Models include standard import settings for consistent appearance across materials and meshes.\n\n* **Chores**\n  * Introduced corresponding asset metadata to ensure proper import, identification, and management within the project.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->", "base_ref": "main", "base_sha": "ae9c5523a85be7a9c45da28335601ae187233491", "head_ref": "claire.morgan_NewObjects_09", "head_sha": "f4bd11e0b1e6ecc070b9fbe894a59c7cf7f83343", "additions": 3193, "deletions": 0, "changed_files": 44, "labels": [], "assignee_logins": [], "requested_reviewer_logins": ["EMPLOYEE_0025_GITH