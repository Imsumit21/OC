ber": 1063, "title": "Coin Dozer minigame UI tags", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-09-12T12:42:02Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 747772, "labels": [], "links": [], "relations": [], "is_archived": false, "created_at": "2024-07-01T17:58:00Z", "updated_at": "2024-09-12T12:42:02Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1049", "field": "creator_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "ENG-1207", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_PERSON_2218", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1207", "number": 1207, "title": "Change background for different game modes in the puzzle editor", "description": "We need to have the default background for the Edit Layout tab as we have it now. But when we switch to the train level-making mode, we need to have the train-level background for it. The snowy one will be great for now.", "priority": 1, "estimate": null, "due_date": "2024-08-30", "started_at": "2024-09-02T15:58:49Z", "completed_at": "2024-09-03T09:25:38Z", "canceled_at": null, "archived_at": "2025-03-11T07:30:39Z", "time_in_status_minutes": 760929, "labels": ["Puzzle Editor"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-08-26T12:18:35Z", "updated_at": "2024-09-10T11:17:43Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1057", "field": "creator_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "ENG-1214", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_49b9dfa5208d400d", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1214", "number": 1214, "title": "Tagging Minigame UIs to use in tutorial editor", "description": "We are changing the way minigame tutorials are handled. So, for each minigame, we have an infographic we'll show the first time the game is activated. I will use Show UI, Hide UI for this, so the infographics need to be tagged as UI. Let me know if you have any questions. \n\nThey UIs are here in the Figma file \n\n[[URL_50713])", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-09-02T16:06:29Z", "completed_at": "2024-09-11T16:03:32Z", "canceled_at": null, "archived_at": "2025-03-12T07:30:22Z", "time_in_status_minutes": 749011, "labels": ["Tutorial Editor"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-08-26T16:54:38Z", "updated_at": "2024-09-11T16:03:32Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1064", "field": "creator_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "ENG-1220", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_4e13bd40cc73d0fc", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1220", "number": 1220, "title": "Add new tutorial triggers and actions for the reworked bomb tile", "description": "Please add both action and trigger for when the bomb tile ignites.", "priority": 1, "estimate": null, "due_date": null, "started_at": "2024-08-29T04:28:35Z", "completed_at": "2024-09-10T12:40:07Z", "canceled_at": null, "archived_at": "2025-03-11T07:30:37Z", "time_in_status_minutes": 750654, "labels": ["Sprint 23 Baklava - Aug 30th", "Tutorial Editor"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-08-27T17:05:30Z", "updated_at": "2024-09-10T12:40:07Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1346", "field": "creator_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "ENG-1482", "project_id": null, "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_PERSON_3233", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1482", "number": 1482, "title": "Give Option To Add \"Tap to Continue\" To Dim Screens", "description": "The tutorial editor supports a dimming feature, and basically need another option with it that will show a Tap to Continue message. \n\n![image.png]([URL_51099])", "priority": 0, "estimate": null, "due_date": null, "started_at": "2024-09-19T18:55:09Z", "completed_at": "2024-09-29T09:48:12Z", "canceled_at": null, "archived_at": "2025-03-30T07:35:40Z", "time_in_status_minutes": 723466, "labels": ["Tutorial Editor"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-09-19T17:32:35Z", "updated_at": "2024-09-29T09:48:12Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1554", "field": "creator_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "ENG-1673", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1673", "number": 1673, "title": "Consider Tutorial Completed If Level Won", "description": "If a tutorial starts with a \"puzzle started\" trigger or level requirement trigger, the tutorial system should consider it complete if the level is won. This is for edge cases in which a player wins the level without completing the tutorial requirement, and subsequently, the tutorial order gets broken.", "priority": 1, "estimate": null, "due_date": null, "started_at": "2024-12-09T17:42:49Z", "completed_at": "2025-01-16T18:07:30Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 566007, "labels": ["Tutorial Editor"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-10-09T13:48:55Z", "updated_at": "2025-01-16T18:07:30Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1586", "field": "creator_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "ENG-1701", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Canceled", "cycle_id": null, "identifier": "ENG-1701", "number": 1701, "title": "Investigate If All Text Is Imported to I2Languages", "description": "To avoid localization bugs for hotfix, please create (or inform me of an existing) system that compares all text strings to the keys the localization asset uses.", "priority": 1, "estimate": null, "due_date": null, "started_at": null, "completed_at": null, "canceled_at": "2025-05-05T19:10:05Z", "archived_at": null, "time_in_status_minutes": 408984, "labels": [], "links": [], "relations": [], "is_archived": false, "created_at": "2024-10-11T16:21:53Z", "updated_at": "2025-05-05T19:10:05Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1628", "field": "creator_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "ENG-1747", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1747", "number": 1747, "title": "Tutorial highlights don't scale properly for tablets", "description": "2 issues regarding highlights in general \n\n1. During Leonardo we added the ability to play with highlight scales but they don't really work \n2. We got reports that highlights on tablets look too small (aka they don't rescale properly for different resolutions)", "priority": 3, "estimate": null, "due_date": null, "started_at": "2024-10-24T00:57:09Z", "completed_at": "2024-10-31T21:04:03Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 676710, "labels": ["Tutorial Editor"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-10-21T16:14:36Z", "updated_at": "2024-10-31T21:04:03Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1663", "field": "creator_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "ENG-1779", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1779", "number": 1779, "title": "Puzzle Editor Bot Next Steps", "description": "As discussed, here are the next steps to improve the puzzle editor bot.", "priority": 3, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2025-05-05T19:16:05Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 408978, "labels": ["Bot"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-10-28T15:24:32Z", "updated_at": "2025-05-05T19:16:05Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1665", "field": "creator_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "ENG-1780", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-1779", "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1780", "number": 1780, "title": "Bot can play vanishing tiles", "description": "In addition to its current logic, the bot should prioritize matching a vanishing tile where it can.", "priority": 3, "estimate": null, "due_date": null, "started_at": "2024-11-25T19:14:20Z", "completed_at": "2025-01-16T18:05:09Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 566009, "labels": [], "links": [], "relations": [], "is_archived": false, "created_at": "2024-10-28T15:24:32Z", "updated_at": "2025-01-16T18:05:09Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1666", "field": "creator_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "ENG-1781", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-1779", "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1781", "number": 1781, "title": "Puzzle editor can play bomb tiles", "description": "In addition to its current logic, the bot can play bomb levels in the following way. \n\n1. It prioritizes a fire token where it can\n2. It prioritizes blowing a bomb if it's lit", "priority": 3, "estimate": null, "due_date": null, "started_at": "2024-11-25T19:15:06Z", "completed_at": "2025-01-16T18:05:09Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 566009, "labels": ["Levels", "Puzzle Editor"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-10-28T15:24:32Z", "updated_at": "2025-01-16T18:05:09Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1667", "field": "creator_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "ENG-1782", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-1779", "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1782", "number": 1782, "title": "Match the bot with current data", "description": "We need to match our bot with the current data to figure out how accurately we can predict a win rate. I have two approaches for this: \n\n1. To compare simple win stats \n2. To match the \"moves\" event in metabase and report what players are doing differently than the bot. We can use the hardcoded level 2 as a pilot.", "priority": 3, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2025-05-05T19:16:08Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 408978, "labels": ["Nova Release"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-10-28T15:24:32Z", "updated_at": "2025-05-05T19:16:08Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1668", "field": "creator_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "ENG-1783", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-1779", "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Canceled", "cycle_id": null, "identifier": "ENG-1783", "number": 1783, "title": "Remote difficulty adjustment", "description": "We should be able to adjust\n\n1. number of deck tiles\n2. number of symbols\n3. number of chops \n   remotely.", "priority": 3, "estimate": null, "due_date": null, "started_at": null, "completed_at": null, "canceled_at": "2024-11-25T19:02:18Z", "archived_at": null, "time_in_status_minutes": 640832, "labels": [], "links": [], "relations": [], "is_archived": false, "created_at": "2024-10-28T15:24:32Z", "updated_at": "2024-11-25T19:02:18Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1669", "field": "creator_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "ENG-1784", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-1779", "assignee_id": "usr_bdf01b53c6a92c5e", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1784", "number": 1784, "title": "Puzzle editor performance improvement", "description": "The puzzle editor is essentially a scene in the engine and therefore performs very poorly over extended use which we have to frequently.", "priority": 3, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2025-05-05T19:16:08Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 408978, "labels": ["Puzzle Editor", "Improvement"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-10-28T15:25:37Z", "updated_at": "2025-05-05T19:16:08Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1670", "field": "creator_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "ENG-1785", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-1779", "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Canceled", "cycle_id": null, "identifier": "ENG-1785", "number": 1785, "title": "Try limiting same symbol tiles", "description": "We'll try limiting the same symbol tiles to see if we can overcome difficulty volatility and repeat tile mega tiles that way.", "priority": 3, "estimate": null, "due_date": null, "started_at": null, "completed_at": null, "canceled_at": "2025-05-05T19:14:36Z", "archived_at": null, "time_in_status_minutes": 408980, "labels": ["Puzzle Editor", "Improvement"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-10-28T15:26:29Z", "updated_at": "2025-05-05T19:14:36Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1680", "field": "creator_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "ENG-1794", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": null, "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1794", "number": 1794, "title": "Change the bookmark system into a \"rails\" system", "description": "We need a system that will replace the current bookmark system we're using with double tutorials. \n\n1. Add a box in the requirements section that determines whether that level is part of a rails system. \n2. If the box is checked the level ties to the next level instead of going to the saga map \n\n   ![image.png]([URL_51520])", "priority": 1, "estimate": null, "due_date": null, "started_at": "2024-11-04T19:04:21Z", "completed_at": "2024-11-05T12:12:08Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 670042, "labels": ["Sprint 25 Destiny - Nov 8th"], "links": [], "relations": [{"target": "ENG-1792", "type": "relates"}], "is_archived": false, "created_at": "2024-10-28T18:36:23Z", "updated_at": "2024-11-12T13:51:03Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1681", "field": "creator_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "ENG-1795", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-1794", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1795", "number": 1795, "title": "Clean up the current bookmarks", "description": "Clean up any event boxes that adhere to the bookmark", "priority": 1, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-12-30T11:56:44Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 590858, "labels": [], "links": [], "relations": [], "is_archived": false, "created_at": "2024-10-28T18:36:23Z", "updated_at": "2024-12-30T11:56:44Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/1682", "field": "creator_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "ENG-1796", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_ENG", "parent_id": "ENG-1794", "assignee_id": "usr_cc3e90160f490686", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "ENG-1796", "number": 1796, "title": "Create the rails system", "description": "1. Add a box in the requirements section that determines whether that level is part of a rails system. \n2. If the box is checked the level ties to the next level instead of going to the saga map", "priority": 1, "estimate": null, "due_date": null, "started_at": null, "comple