: "/issues/3837", "field": "creator_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "ZOM-85", "project_id": "dbab77c7-f871-4888-abf8-d98b52a41624", "team_id": "team_ZOM", "parent_id": "ZOM-82", "assignee_id": "usr_51f5f16d46e8cf55", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "ZOM-85", "number": 85, "title": "Intro Pop Up", "description": "![image.png]([URL_52434])\n\nThe pop up that will be shown at event start.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2025-05-06T15:06:19Z", "completed_at": "2025-06-13T01:19:01Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 353895, "labels": ["Live Ops and Monetization", "2D Art"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-04-29T14:50:33Z", "updated_at": "2025-06-13T01:19:01Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3838", "field": "creator_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "ZOM-86", "project_id": "dbab77c7-f871-4888-abf8-d98b52a41624", "team_id": "team_ZOM", "parent_id": "ZOM-82", "assignee_id": "usr_51f5f16d46e8cf55", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "ZOM-86", "number": 86, "title": "Fail Screen", "description": "![image.png]([URL_52435])\n\nTo be shown at the end of the event. To be updated by @[PERSON_NAME_0019] if consolation price is design approved.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2025-05-06T15:05:59Z", "completed_at": "2025-06-13T01:18:57Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 353895, "labels": ["Live Ops and Monetization", "2D Art"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-04-29T14:51:52Z", "updated_at": "2025-06-13T01:18:57Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3839", "field": "creator_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "ZOM-87", "project_id": "dbab77c7-f871-4888-abf8-d98b52a41624", "team_id": "team_ZOM", "parent_id": "ZOM-82", "assignee_id": "usr_51f5f16d46e8cf55", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "ZOM-87", "number": 87, "title": "Reward Screens", "description": "![image.png]([URL_52436])\n\nWe need a reward screen that is elements on a dark transparent background like we have for Domino Delights. The other screen with the purple box is ready, only the banner is needed.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2025-05-06T15:05:58Z", "completed_at": "2025-06-13T01:18:55Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 353895, "labels": ["Live Ops and Monetization", "2D Art"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-04-29T14:53:27Z", "updated_at": "2025-06-13T01:18:55Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3840", "field": "creator_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "ZOM-88", "project_id": "dbab77c7-f871-4888-abf8-d98b52a41624", "team_id": "team_ZOM", "parent_id": "ZOM-82", "assignee_id": "usr_51f5f16d46e8cf55", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "ZOM-88", "number": 88, "title": "Searching for opponents screen", "description": "![image.png]([URL_52437])\n\nExact \"search for opponents screen\" from River Rush with the new timer icon and text placement.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2025-05-06T15:05:47Z", "completed_at": "2025-06-13T01:19:00Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 353895, "labels": ["Live Ops and Monetization", "2D Art"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-04-29T14:54:21Z", "updated_at": "2025-06-13T01:19:00Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3841", "field": "creator_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "ZOM-89", "project_id": "dbab77c7-f871-4888-abf8-d98b52a41624", "team_id": "team_ZOM", "parent_id": "ZOM-82", "assignee_id": "usr_51f5f16d46e8cf55", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "ZOM-89", "number": 89, "title": "Create City Skylines", "description": "![image.png]([URL_52438])\n\nThe city skylines that will be displayed on the top of the screen as stages change.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2025-05-05T16:20:07Z", "completed_at": "2025-06-13T01:18:36Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 353896, "labels": ["Live Ops and Monetization", "2D Art"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-04-29T14:55:14Z", "updated_at": "2025-06-13T01:18:36Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/3842", "field": "creator_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "ZOM-90", "project_id": "dbab77c7-f871-4888-abf8-d98b52a41624", "team_id": "team_ZOM", "parent_id": "ZOM-82", "assignee_id": "usr_51f5f16d46e8cf55", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "ZOM-90", "number": 90, "title": "Text Display Area", "description": "![image.png]([URL_52439])\n\nOne such text display area. We agreed on a city sign or a highway traffic sign. This will be displayed on top of city skylines.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2025-05-06T15:05:43Z", "completed_at": "2025-06-13T01:18:56Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 353895, "labels": ["Live Ops and Monetization", "2D Art"], "links": [], "relations": [], "is_archived": false, "created_at": "2025-04-29T14:56:16Z", "updated_at": "2025-06-13T01:18:56Z"}}], "records_checked": 3852, "files_selected": 1, "files_completed": 1, "scan_complete": true, "errors": []}}, "files_read_this_call": 1, "sources": [{"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "manifest_sha256": "b299d01377efd99db02ba7f6bb072a6d539b00d970b492b9e79b68353d3f5310", "freshness": "582618486f6bf42cadf2f5773c59d065e6e938d2e6a872db0c1e27305c9165fd"}], "scan_complete": true, "persona_filtered": false, "backend": "grouped-record-scan", "scope_note": "Exact direct fields in selected arrays. No SQL is applied. Absence/uniqueness is supported only within complete declared scopes. Manifest hashes are declared provenance, not fresh full-content hashes."}, "checksum": "c84c8ebc4e55a4785f2c6149864b8b69bb61c51437f0ad19bbe87941643a7092"}