rello/data.json", "pointer": "/cards/469", "field": "idBoard", "value": "65eb4ec525346c8070ca638f", "record": {"id": "6699456ed5afea061bc73365", "name": "([PERSON_NAME_0067]) [PERSON_NAME_4102] foresighted tiles matchable and Level 40 Passive upgrade", "idBoard": "65eb4ec525346c8070ca638f", "idList": "65eb4f512e65625ed56c6321", "desc": "Ticket [HERE](https://linear.app/harmonygames-games/issue/ENG-1110/lexi-foresight-tiles-are-to-be-made-matchable \"\u200c\") to make it matachable\n\nPay attention to parent/child relationships.\n\n[PERSON_NAME_4102]\u2019s level 40 passive ability is \u201creveal the next tile in draw pile\u201d. This is a permanent effect and not a one time effect. This fires off when the game starts, and does not need further repeat VFX. The revealed draw tile is a constant state and remains that way for rest of the game.\n\nTicket [HERE](https://linear.app/harmonygames-games/issue/[OTHER_2352]/lexi-level-40-passive-ability-upgraded-reveal-next-draw-tile-to-be \"\u200c\")", "pos": 54107.93182373047, "closed": false, "due": null, "dueComplete": false, "idMembers": [], "idLabels": ["65eb4ec525346c8070ca6408"], "idShort": 108, "shortLink": null, "shortUrl": null, "url": "https://PERSON_6092_TRELLO_USERNAME.com/c/12LFGe4X/108-owen.baker-lexi-foresighted-tiles-matchable-and-level-40-passive-upgrade", "dateLastActivity": "2024-08-07T18:00:47Z", "cover": null, "badges": {"attachments": 0, "attachmentsByType": {"trello": {"board": 0, "card": 0}}, "checkItems": 0, "checkItemsChecked": 0, "checkItemsEarliestDue": null, "comments": 0, "description": true, "due": null, "dueComplete": false, "externalSource": null, "fogbugz": "", "lastUpdatedByAi": false, "location": false, "maliciousAttachments": 0, "start": null, "votes": 0}}}, {"file": "HarmonyGames_Other_Services/Services_Data/trello/data.json", "pointer": "/cards/470", "field": "idBoard", "value": "65eb4ec525346c8070ca638f", "record": {"id": "66994588ab585b1384465c48", "name": "([PERSON_NAME_0067]) [PERSO