ge", "image_bytes": 296020, "image_height": 220, "image_url": "https://media.tenor.com/_hUq1BSUsiMAAAAM/cat-cute.gif", "image_width": 220, "is_animated": true, "title": {"emoji": true, "text": "GIF", "type": "plain_text"}, "type": "image"}], "fallback": "shared a GIF", "id": 1}]}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05HMBQUC8Z/2025-09.json", "pointer": "/46", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "7fac92c0822634155a38d527cc8b9a62", "ts": "1758732083.691769", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "[PERSON_NAME_12097] [USERNAME_6322] k\u00fc\u00e7\u00fck obje olsun oyuncuyu hayat\u0131ndan bezdireyim [USERNAME_1826]", "channel": "D05HMBQUC8Z", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05HMBQUC8Z/2025-09.json", "pointer": "/52", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "63b4f49e5a6a1a4d714636d055aacc08", "ts": "1758732527.427869", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "o \u00e7ok komikti", "channel": "D05HMBQUC8Z", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "joy", "users": ["EMPLOYEE_0009_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05HMBQUC8Z/2025-09.json", "pointer": "/53", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "8c6ce543ee3aca23ad17cc9fdef14036", "ts": "1758732544.281119", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Benim akl\u0131m direk ojeye gitti MF'de oje var \u00e7ok kast\u0131r\u0131yor favorilerimden [USERNAME_6325]", "channel": "D05HMBQUC8Z", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05HYDTG5TJ/2025-09.json", "pointer": "/0", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "c272aef1dc265dcdde369a6760c5c278", "ts": "1756838837.147599", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "*Julia Lawson*  [9:46 PM]\nHey, guys. We just finished talking with [PERSON_NAME_0029]. And basically:\n\n\u2022 Don't use Domino Delights documents for Zombie Match features, please. The system can be the same but There are nuances that create edge cases. For example, with daily login, because we don't have a queue manager yet, he had to do something else with the animations and that was one of the issues in the last week's meetings. \n\u2022 Because [PERSON_NAME_0029] tends to do small tasks and they can be popping in and out, he struggles with prioritization. Please take extra care with his tickets and consider his other tickets when you set priority for a new ticket.\n\u2022 Engineers struggle when documents are incomplete in quantity, a simple reward on our document can mean a bigger task on the client or backend side we can't anticipate as designers, so please make sure your documents are completed in this regard before you kickoff a feature.\n\u2022 We did remind him we expect documents to be a guide of its own without additional tickets. So let's make sure our documentation is complete at best we can.  \n", "channel": "D05HYDTG5TJ", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05HYDTG5TJ/2025-09.json", "pointer": "/1", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "6e93104600e44c9456ae8812deff46b4", "ts": "1756838926.723329", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I sent this to the design team, [PERSON_NAME_0029]. We'll try to do better by you, and I think I made my concerns clear too. I'm sure we'll do better moving forward.", "channel": "D05HYDTG5TJ", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05HYDTG5TJ/2025-09.json", "pointer": "/4", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "09bc15c09faed12b47e45b5afd88dbf4", "ts": "1756840458.004859", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "It's just as an example so I think it's okay if the situation isn't exactly that all the time.", "channel": "D05HYDTG5TJ", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05HYDTG5TJ/2025-09.json", "pointer": "/5", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "a901c477713e9427be6794e9860efce4", "ts": "1756840483.898769", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "The main thing is the documents and the tickets right?", "channel": "D05HYDTG5TJ", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05QA585LTY/2025-09.json", "pointer": "/0", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "94ab13f2215fb496f0c390298ffc8291", "ts": "1756753646.480049", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "\u015eu an Neler oluyor [USERNAME_56308]", "channel": "D05QA585LTY", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05QA585LTY/2025-09.json", "pointer": "/6", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "042334b060a778edd971a3ffa31c1b14", "ts": "1756753717.837499", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Bi build gecesi de olays\u0131z ge\u00e7sin :laughing:", "channel": "D05QA585LTY", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05QA585LTY/2025-09.json", "pointer": "/8", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "5c85e851264df6e7671d40ded75d951f", "ts": "1756753953.553779", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Allegedly", "channel": "D05QA585LTY", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05QA585LTY/2025-09.json", "pointer": "/9", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "6e758e0043148a196ce5f6817367e6fc", "ts": "1756999919.088629", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "\u015eefim havu\u00e7tan posion m\u0131 kald\u0131rd\u0131k 27'de geldi\u011finde zehir vurmuyor kral", "channel": "D05QA585LTY", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05QA585LTY/2025-09.json", "pointer": "/13", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "b1fd404f6c8132b9ead56a9fefd57610", "ts": "1756999960.295609", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Ama posion introda gelmesi laz\u0131m [USERNAME_15819]", "channel": "D05QA585LTY", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05QA585LTY/2025-09.json", "pointer": "/14", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "b0c9b4d2f3a42f4a42f46e4d28d2c71e", "ts": "1756999987.783369", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Haaa bi saniye posion wine bottle oldu introda zaten leveli yapmam laz\u0131m yeniden", "channel": "D05QA585LTY", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05QA585LTY/2025-09.json", "pointer": "/17", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "0008af0de90daf9daad4766160472852", "ts": "1756999996.682459", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Tamam bo\u015fver hi\u00e7 sormad\u0131m ben bunu [USERNAME_15820]", "channel": "D05QA585LTY", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05QA585LTY/2025-09.json", "pointer": "/21", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "70f4ccacdde5deb59546bed95156ca95", "ts": "1757000071.244429", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Wine bottle da posion vurmuyor \u