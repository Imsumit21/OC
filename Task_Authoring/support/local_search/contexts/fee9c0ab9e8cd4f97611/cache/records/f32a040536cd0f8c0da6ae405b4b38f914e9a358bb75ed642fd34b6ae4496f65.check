ces/Services_Data/slack/messages/D05QESBD4HW/2025-09.json", "pointer": "/108", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "010b17eb18fc3f0fd1e93d990a22a551", "ts": "1756898656.515989", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "No worries, sorry I couldn't generate something better. See you tomorrow!", "channel": "D05QESBD4HW", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "pray", "users": ["EMPLOYEE_0033_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05QESBD4HW/2025-09.json", "pointer": "/110", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "c9f994f7b9afba0a04b23536836e6daf", "ts": "1756990515.979179", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I can open my eyes now so I think I'm improving", "channel": "D05QESBD4HW", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "pray", "users": ["EMPLOYEE_0033_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05QESBD4HW/2025-09.json", "pointer": "/111", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "5a002f57b960289e5f8c465c288a5085", "ts": "1756990518.087429", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "How are you?", "channel": "D05QESBD4HW", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05QESBD4HW/2025-09.json", "pointer": "/114", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "0718b2533ca047bd3e0ad84fad0be3a6", "ts": "1756995091.239689", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "That's very kind of you, thank you. I have no idea. First time I'm getting flu during summer in my life", "channel": "D05QESBD4HW", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05QESBD4HW/2025-09.json", "pointer": "/118", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "97d9905f1c76e1d1b9188f60f57a43ef", "ts": "1757086887.212329", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Sorted it out with Marcus", "channel": "D05QESBD4HW", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05SD5QLG94/2025-09.json", "pointer": "/1", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "da7070e487514b70911d07206b64acc5", "ts": "1758221343.478869", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Hey, [PERSON_NAME_0036]. [PERSON_NAME_0092] fished out the assets for the Domino playable before so I think he's your guy.", "channel": "D05SD5QLG94", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05SD5QLG94/2025-09.json", "pointer": "/2", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "3401b1c0959d53168d69d1ab78bc7e2e", "ts": "1758221397.722469", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I would also ask Marcus if you're going to use 2D zombie animations because he'd made them with bones.", "channel": "D05SD5QLG94", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05SD5QLG94/2025-09.json", "pointer": "/3", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "f7071c15521e23a6be7f2937f0404956", "ts": "1758221424.223519", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Last time we didn't give them access, we just put what they needed in a zip file and sent it over.", "channel": "D05SD5QLG94", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05TZ6N1QBH/2025-09.json", "pointer": "/4", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "1044cb8d15e0734437fd3f40034167c1", "ts": "1757086866.323939", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "That works", "channel": "D05TZ6N1QBH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "pray", "users": ["EMPLOYEE_0002_SLACK_ID"]}, {"count": 1, "name": "+1", "users": ["EMPLOYEE_0002_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05TZ6N1QBH/2025-09.json", "pointer": "/5", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "268b29a2397dc7311129a74286bb378d", "ts": "1757490917.638729", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Hey, Marcus. Can you ping me when you come online?", "channel": "D05TZ6N1QBH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05TZ6N1QBH/2025-09.json", "pointer": "/7", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "809839c6cd4fd35d41d10487513051c1", "ts": "1757493832.456449", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I know we reduced the cut out cost to make the zombies quick. I wonder what's quickest way to change them up a bit, like say adding a necklace or accessory to change them up just a bit.", "channel": "D05TZ6N1QBH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05TZ6N1QBH/2025-09.json", "pointer": "/8", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "feb0328b401402584dd1420f9dd2e248", "ts": "1757493840.294259", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "What would be the time cost of such an effort", "channel": "D05TZ6N1QBH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05TZ6N1QBH/2025-09.json", "pointer": "/10", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "808c8db6d98f3dba0177861a668699b3", "ts": "1757493880.949309", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Can you make an estimate and we can talk about it during the art meeting today?", "channel": "D05TZ6N1QBH", "thread_ts": "1757493880.949309", "reply_count": 1, "reply_users_count": 1, "latest_reply": "1757494252.447539", "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05TZ6N1QBH/2025-09.json", "pointer": "/23", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "2842e32225b012dc343638c62c55745a", "ts": "1757494233.553229", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "That would ideally be the case but Leonard said we can't afford it. So I decided to ask you for a consult. We can talk about this more in the art meeting. It's just a question of time and money, really. Otherwise everyone agrees we need new zombies.", "channel": "D05TZ6N1QBH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05TZ6N1QBH/2025-09.json", "pointer": "/26", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "2d779dfa0be769366ce8d180b01bbab6", "ts": "1757523685.644459", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "", "channel": "D05TZ6N1QBH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [{"created": 1757523677, "display_as_bot": false, "editable": false, "external_type": "", "file_access": "visible", "filetype": "png", "has_rich_preview": false, "id": "F09E5FRH771", "is_external": false, "is_public": false, "is_starred": false, "media_display_type": "unknown", "mimetype": "image/png", "mode": "hosted", "name": "image.png", "original_h": 800, "original_w": 1200, "permalink": "https://harmonygamesgroup.slack.com/files/EMPLOYEE_0038_SLACK_ID/F09E5FRH771/image.png", "permalink_public": "https://slack-files.com/T04RZ2JAMM0-F09E5FRH771-820560f8d8", "pretty_type": "PNG", "public_url_shared": false, "size": 1738110, "skipped_shares": true, "thumb_1024": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09E5FRH771-619c18a87a/image_1024.png?t=xoxb-REDACTED", "thumb_1024_h": 683, "thumb_1024_w": 1024, "thumb_160": 