80.273229", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I just asked for insertion to come only from cards but didn't spesify a pair amount", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/224", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "302efc593eb85c73265e68a05784a559", "ts": "1757347893.806129", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": ":confused:", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "frowning", "users": ["EMPLOYEE_0016_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/225", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "035b5a14d867adee629bdb21675f0468", "ts": "1757347996.692299", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [{"created": 1757347991, "display_as_bot": false, "editable": false, "external_type": "", "file_access": "visible", "filetype": "png", "has_rich_preview": false, "id": "F09E4JC23M4", "is_external": false, "is_public": false, "is_starred": false, "media_display_type": "unknown", "mimetype": "image/png", "mode": "hosted", "name": "image.png", "original_h": 1326, "original_w": 2448, "permalink": "https://harmonygamesgroup.slack.com/files/EMPLOYEE_0038_SLACK_ID/F09E4JC23M4/image.png", "permalink_public": "https://slack-files.com/T04RZ2JAMM0-F0