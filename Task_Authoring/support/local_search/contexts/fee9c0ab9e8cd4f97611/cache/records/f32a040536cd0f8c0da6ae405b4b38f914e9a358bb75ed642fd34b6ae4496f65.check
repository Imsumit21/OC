ck/messages/D05GU6L0XFH/2025-09.json", "pointer": "/226", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "73a80d26537b11572121ba6f7d4ad1e5", "ts": "1757347996.918669", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Found it", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/228", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "8933360f60e58dfe44a09ee788e4b4c7", "ts": "1757355700.840139", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "*Julia Lawson*  [7:59 PM]\nHey, [PERSON_NAME_5466]. I know you're busy. Just wanted to ask when you can make the different insertion for my branch :[USERNAME_23161]:\n\n*Blake*  [8:15 PM]\nI'll do it now. :D\n[8:15 PM] Blake\n\nOk so deck items just get added?\n\n*Julia Lawson*  [8:38 PM]\nYeppers\n\n*Blake*  [9:17 PM]\nHow are colors chosen?\n\n*Julia Lawson*  [9:18 PM]\nWe can keep it the same way.\n[9:19 PM] Julia Lawson\n\nRight now the system works so that it looks at the pile and chooses the closest color version. Is that right?\n\n*Blake*  [9:19 PM]\nI think it just looks at the item it replaced and tried to copy the color\n\n*Julia Lawson*  [9:19 PM]\nThat's fine by me\n\n*Blake*  [9:19 PM]\nwell we aren't replacing an item\n[9:19 PM] Blake\n\nso i will find a random color in the pile and try to copy that\n[9:20 PM] Blake\n\nlike you said", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/235", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "cb0b63aa27f3ca4a271962638f58d3a4", "ts": "1757356618.184009", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Okay, I fixed the error, I'll make the nuke fixes :[USERNAME_26053]:", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/236", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "8f9f97383a463ba29dcab3426b747211", "ts": "1757356620.803239", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Working on your branch", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/237", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "10fc6b6945286114bcfa5a05df4c7c65", "ts": "1757356638.956439", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "`int totalQuantity = Mathf.RoundToInt(totalLevelSets * 0.2f);`", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/238", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "40acf9617a97af635f2ec66596147ae2", "ts": "1757356664.599689", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "This practically means if the items are too low There might be 1 instead of 2", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/239", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "0e151edadda7658c32bf41fe171e7b87", "ts": "1757356671.820929", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Blake needs to take a look when he comes online", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/240", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "b59c3b5374d7c7c7f23919697982d33e", "ts": "1757356695.846579", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Seems so", "channel": "D05GU6L0XFH", "thread_ts": "1757356572.384829", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": "thread_broadcast", "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/241", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "054fa30c528cdf15a28dc03401c29c52", "ts": "1757361188.742149", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I'm nearly done with nuke levels", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/245", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "3147b310e2c60c51573869c2ec205c98", "ts": "1757361791.759329", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "About that. [PERSON_NAME_5466]'s afk. In case he doesn't come back before I go to sleep can you communicate with him?", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/246", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "26b67da9bce19d420ddc4c9e929dca9d", "ts": "1757362128.515899", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Until this CPM based nuke situation is sorted, let's avoid big track gaps. Nearly all the levels [PERSON_NAME_0050] reported have ranges", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/249", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "adc96abcaead54b3781416d9d28816ce", "ts": "1757362221.614139", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "[USERNAME_46252]", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/264", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "b739acff96ccf6374f7481aa7059e26f", "ts": "1757427451.179859", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "It never went live, the change was on the pool sizing branch only.", "channel": "D05GU6L0XFH", "thread_ts": "1757376808.688579", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/266", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "45a185c4f94a8233c5ac968ea2832800", "ts": "1757427519.420199", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I'm sorry if I came off as defensive and patronizing, my intention wasn't to give you an earful. It's not my personality, neither it's an attitude I'd take with my supervisor.", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/267", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "9607dd42ea4c61982a2b2d7db0f053a9", "ts": "1757427536.848589", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "It was changed on 21st of of August, it was the second time Leonard reported it actually.", "channel": "D05GU6L0XFH", "thread_ts": "1757376808.688579", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/270", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "25573a9124620d6b91f04a3674f8422b", "ts": "1757427571.150509", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I was aware of it, but I forgot to tell [PERSON_NAME_5466] to make a fix. That's totally on me and I'm really sorry", "channel": "D05GU6L0XFH", "thread_ts": "1757376808.688579", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/273", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "41ff7bf2fcc27b03ec70a1a7c2d365d4", "ts": "1757427626.547189", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "But that was always the plan. When I first made the presentation for the funnel I talked about this a lot as the monetization hook.", "channel": "D05GU6L0XFH", "thread_ts": "1757376808.688579", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/276", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "25c2cfb48294eddecb9430f31ebb1e8b", "ts": "1757427668.952279", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "And you even gave me a document about the insertion and in the pod meeting, I said since [PERSON_NAME_5466] is super busy just inserting card items will do for now.", "channel": "D05GU6L0XFH", "thread_ts": "1757376808.688579", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/279", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "1eafbeff9be0dfcbd62f099d4edde66c", "ts": "1757427686.238129", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "So I wasn't aware you're in the dark. I need to be more careful with this.", "channel": "D05GU6L0XFH", "thread_ts": "1757376808.688579", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/282", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "d7ee4cfbd5859edc8ba020faf4982223", "ts": "1757427771.184649", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I personally didn't see a problem with the levels, and I told you as much. But then you and Leonard agreed they were too difficult in that case, they needed to follow the guildeline more closely.", "channel": "D05GU6L0XFH", "thread_ts": "1757376808.688579", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/286", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "0c374d1ea38faa3171e53acb9a181621", "ts": "1757427846.251439", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I'm working on making a more detailed level design guide.", "channel": "D05GU6L0XFH", "thread_ts": "1757376808.688579", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/287", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "ba5d418ce7b4e7289dceede59cf547ae", "ts": "1757427859.951849", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I think it will sort out this issue", "channel": "D05GU6L0XFH", "thread_ts": "1757376808.688579", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/288", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "9bb0e65d4a8c56dbfbbbe96f146a96e5", "ts": "1757427906.526749", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I agree, for me levels are fine. This is a genre bending game and we're essentially shooting a d2 d3 funnel into a void. I'm expecting good results but players are the judge.", "channel": "D05GU6L0XFH", "thread_ts": "1757376808.688579", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/289", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "3a32f487a99a13adee16af1bdfd4bd66", "ts": "1757427932.993279", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "What matters to me are they are flexible enough for fast iteration.", "channel": "D05GU6L0XFH", "thread_ts": "1757376808.688579", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/290", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "72b14afc597ad0971129168f66a9d324", "ts": "1757427955.614009", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Nailing them down right now is not a possibility. We have little clue about user behaviour.", "channel": "D05GU6L0XFH", "thread_ts": "1757376808.688579", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/292", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "73810f533dac6f771a74a53948d1db15", "ts": "1757427980.030659", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "So I want to go out with a respectable curve that progresses over time on all fronts.", "channel": "D05GU6L0XFH", "thread_ts": "1757376808.688579", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/293", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "a4d07e6761511b2a01427e246c21e5f8", "ts": "1757428009.721799", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I'm sorry if me saying that offended you, I'll be more careful about comments like that in the future.", "channel": "D05GU6L0XFH", "thread_ts": "1757376808.688579", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/295", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "93f85319e6ad2ca24be2e850ad5c579f", "ts": "1757428057.192129", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I merely meant \"I want to make balance as easy for us as possible and if this problem is so major we should have never introduced it by that logic.\" Maybe it came off more aggressive than intented.", "channel": "D05GU6L0XFH", "thread_ts": "1757376808.688579", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/296", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "0ba7cbb08c0634aacb0470ba386b6038", "ts": "1757428068.911529", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I'll be always sorry if I'm shitting on team's mood", "channel": "D05GU6L0XFH", "thread_ts": "1757376808.688579", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/299", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "96e80c1b7565f2cac5ff648ba87e3b50", "ts": "1757428126.354979", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "My point is, let's throw this easy balance generic thing out There. Then we can optimize the shit out of whatever players seem to be responding too.", "channel": "D05GU6L0XFH", "thread_ts": "1757376808.688579", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/300", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "238a5285af36d1f4ae714bfcbf82a37b", "ts": "1757428154.132429", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "This isn't something we can fix in a spreadsheet.", "channel": "D05GU6L0XFH", "thread_ts": "1757376808.688579", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/301", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "1121f8df41ee0cc4ccfc65853b61c463", "ts": "1757428211.990569", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Hey, why are we having early pod meeting? Is everything okay?", "channel": "D05GU6L0XFH", "thread_ts": "1757376808.688579", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/305", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "e7da145b9a4834762707412b3f00bc13", "ts": "1757428276.228159", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "We just need one test with 150 levels, the rest can be automated better", "channel": "D05GU6L0XFH", "thread_ts": "1757376808.688579", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/308", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "1600237d413cfa83a9b02c55b6150a73", "ts": "1757428385.419499", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I know, forgetting to tell [PERSON_NAME_5466] a quantity was a major mistake and I'm sorry.", "channel": "D05GU6L0XFH", "thread_ts": "1757376808.688579", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/309", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "5b6d9e87265cf88d164c637126fb05f8", "ts": "1757428402.059589", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Especially since Leonard complained about it not just yesterday but even before", "channel": "D05GU6L0XFH", "thread_ts": "1757376808.688579", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/312", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "25f486bc68a8d7fc5bda42576a58dad4", "ts": "1757428601.935309", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Sure, like I said I'm making a better guide", "channel": "D05GU6L0XFH", "thread_ts": "1757376808.688579", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/313", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "be6076a8d46b43bca76dffd52739359d", "ts": "1757428613.936779", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Or rather more detailed", "channel": "D05GU6L0XFH", "thread_ts": "1757376808.688579", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/314", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "8d93794162691b23442d077009fd28f4", "ts": "1757428626.508679", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "About the visual stuff especially", "channel": "D05GU6L0XFH", "thread_ts": "1757376808.688579", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/316", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "ad9bedd26233afb824bc06ea951d6a47", "ts": "1757429210.385959", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Is something like this helpful about the vibe thing?", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [{"created": 1757429199, "display_as_bot": false, "editable": false, "external_type": "", "file_access": "visible", "filetype": "png", "has_rich_preview": false, "id": "F09E8DFAT0D", "is_external": false, "is_public": false, "is_starred": false, "media_display_type": "unknown", "mimetype": "image/png", "mode": "hosted", "name": "image.png", "original_h": 1446, "original_w": 2498, "permalink": "https://harmonygamesgroup.slack.com/files/EMPLOYEE_0038_SLACK_ID/F09E8DFAT0D/image.png", "permalink_public": "https://slack-files.com/T04RZ2JAMM0-F09E8DFAT0D-b50ff033dc", "pretty_type": "PNG", "public_url_shared": false, "size": 1018410, "skipped_shares": true, "thumb_1024": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09E8DFAT0D-3d63060eb6/image_1024.png?t=xoxb-REDACTED", "thumb_1024_h": 593, "thumb_1024_w": 1024, "thumb_160": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09E8DFAT0D-3d63060eb6/image_160.png?t=xoxb-REDACTED", "thumb_360": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09E8DFAT0D-3d63060eb6/image_360.png?t=xoxb-REDACTED", "thumb_360_h": 208, "thumb_360_w": 360, "thumb_480": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09E8DFAT0D-3d63060eb6/image_480.png?t=xoxb-REDACTED", "thumb_480_h": 278, "thumb_480_w": 480, "thumb_64": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09E8DFAT0D-3d63060eb6/image_64.png?t=xoxb-REDACTED", "thumb_720": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09E8DFAT0D-3d63060eb6/image_720.png?t=xoxb-REDACTED", "thumb_720_h": 417, "thumb_720_w": 720, "thumb_80": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09E8DFAT0D-3d63060eb6/image_80.png?t=xoxb-REDACTED", "thumb_800": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09E8DFAT0D-3d63060eb6/image_800.png?t=xoxb-REDACTED", "thumb_800_h": 463, "thumb_800_w": 800, "thumb_960": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09E8DFAT0D-3d63060eb6/image_960.png?t=xoxb-REDACTED", "thumb_960_h": 556, "thumb_960_w": 960, "thumb_tiny": "AwAcADDQYjdgh+e4zQrFvm2kYzxnrUEl6ill2yjB25CjrU0EomQsAwwcfMMGgCQZwMjB70U0yAPtAJOM8UnmDuCPXPagB9FJuG7GDmgHJIxigDPdcTSAN94nPOKs2X+qbBz83+FK1qrPuLv1zjj/AAqSKMRJtBJHvQPoAkQvtDDPpS71BI5J74BOKdRQIYHGAMknHTvTwc0UUAf/2Q==", "timestamp": 1757429199, "title": "image.png", "url_private": "https://files.slack.com/files-pri/T04RZ2JAMM0-F09E8DFAT0D/image.png?token=xoxb-REDACTED", "url_private_download": "https://files.slack.com/files-pri/T04RZ2JAMM0-F09E8DFAT0D/download/image.png?token=xoxb-REDACTED", "user": "EMPLOYEE_0005_SLACK_ID", "user_team": "T04RZ2JAMM0", "username": ""}], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/319", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "9d5c1b41590016f0d3a3eecf534e41f0", "ts": "1757429444.166689", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Okay, I'll add a bad example of it too :[USERNAME_26053]:", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/326", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "0e9238715664f43e9e2c9f43f6f656bf", "ts": "1757518598.387399", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I think the best thing we can do is to create more levels. After 150 I think we can pump the CPM another 5 points and see if it will hold up.", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/327", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "721f98cafb805f6e94e9a705801ccb64", "ts": "1757518614.819459", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I'll get to it when I finish this guideline", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/331", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "d2e012422af96ee45041f75929f5c51a", "ts": "1757518669.007099", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "We might have to change 100 to 150 based on data, the CPM I mean. But if we'll make more levels we should bump up another 5 points", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "+1", "users": ["EMPLOYEE_0016_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/333", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "a4edcaa2f1d63e0be72bda64ad39b17b", "ts": "1757518729.755259", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "That's true too. But I think we'll get a different reaction on a 75 CPM Monochrome level and a 75CPM analogue level so I'm not sure what that gap will be", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/334", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "e6c3fe93a86514d33218d0b007d7701f", "ts": "1757518756.867869", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "But I don't expect it to be dramatic, because the learning curve levels didn't reveal anything dramatic in the first funnel test", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/335", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "31f5a19bd275a303b193895c8fcf168d", "ts": "1757518814.252179", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I think we can aim for at least 200 levels by Friday that's a good target. We can do much more but just as a \"just in case someone dies in flu scenerio\"", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/336", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "a80b0418fe5e020b22502ddfed9b873f", "ts": "1757518952.733619", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Do you also want to bump unique item threshold by 1 after 150?", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/337", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "1ae1f49c38570567dd13fd0587acdcad", "ts": "1757518996.091879", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "By the way, tablets have Microsoft sound. Isn't that a copyright violation thing?", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/347", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "80880157ea9c045fb618dde65ac7c1f1", "ts": "1757519404.212539", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I think that [USERNAME_40121] is the Windows operating system error sound too", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/350", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "53f98258b15559193a17feffa7eb4207", "ts": "1757519898.287159", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I'm probably describing the wrong sound, I'll point it out when I hear it again", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/352", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "8b717ae0c8bd0c446c6933f5f3a60181", "ts": "1757608183.758209", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I want to go over the first 150 and mend the bridge to 200. Do you want to take the stuff after 200?", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/353", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "b46203f68e1002be7b10d1e5b42b3688", "ts": "1757608208.788129", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I want to label levels a bit better in the ones we have", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/354", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "ecb7f03a650f8e8221804a0ba9cb71de", "ts": "1757608266.076639", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "<https://docs.google.com/presentation/d/18GdSRwiLy0y23hT5sOjYTMox85Qk1vunQ2XE7gplz1U/edit?slide=id.p#slide=id.p>", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/355", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "a56d6fdac46fe4b95c965fae459ee697", "ts": "1757608271.982569", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "And here is the visual guide", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/360", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "c1851d6013d4d62c34e1023aa4f6a29d", "ts": "1757609523.893999", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I'm adding one more thing to the slide, I forgot to write about [USERNAME_39920].", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/361", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "7ddf4289ea39f4403a0e70a42d7d7751", "ts": "1757609547.633249", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "It'd we awesome if you started 200+ levels.", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/362", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "030325d883d6c4947bf0f95113854b35", "ts": "1757609565.623409", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I'll mend the gap until 200 and we'll have however many you added on top basically.", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_