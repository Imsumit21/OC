", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "432f214b1e41af3aeb61aabec45ad2b6", "ts": "1759155154.496399", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Ama arada b\u00f6yle bi case falan yapmak iyi olur zaten", "channel": "D076RBM29JS", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D076RBM29JS/2025-09.json", "pointer": "/136", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "8573726bb411843e9b246be016e29248", "ts": "1759155175.703709", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "2-3 sene o ortamlardan uzak kal\u0131p birden cidden ihtiya\u00e7 olunca yapmak zorunda kalmakla, sekt\u00f6r nerelerde onu bilmek daha iyi olur.", "channel": "D076RBM29JS", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D076RBM29JS/2025-09.json", "pointer": "/139", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "ad25a48a597b20a9f3787ff63a865b64", "ts": "1759155665.859969", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Tamamd\u0131r \u015fefim. Kolay [USERNAME_45422]", "channel": "D076RBM29JS", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D07GMT8T0AY/2025-09.json", "pointer": "/0", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "710547e4f6a454abcff9d647403317fe", "ts": "1757431832.953229", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Hey, the pod meeting is early. We're waiting for you :[USERNAME_26053]:", "channel": "D07GMT8T0AY", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D07GMT8T0AY/2025-09.json", "pointer": "/5", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "d8296a944f819a6689b7594663b766ed", "ts": "1758638615.596169", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "It's something we want to get in as soon as you had a minute, if you can do it for today that's great.", "channel": "D07GMT8T0AY", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "saluting_face", "users": ["EMPLOYEE_0003_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D07GMT8T0AY/2025-09.json", "pointer": "/9", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "18cc7a275ef4e35fd36da95b3113982e", "ts": "1758728214.266269", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Hey, [PERSON_NAME_0022]. I never done a level for it. Please ask [PERSON_NAME_0054]", "channel": "D07GMT8T0AY", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}], "records_checked": 21657, "files_selected": 149, "files_completed": 149, "scan_complete": true, "errors": []}}, "files_read_this_call": 149, "sources": [{"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C04RYU8TJ8K/2025-09.json", "manifest_sha256": "9675b817ab315b1ab3cd4f34c5973266df1cecf9830e54f079f143c7ff483ecc", "freshness": "6b5a09011deb038c099edc05a6b63a00f6087e091a338d9bb889a9c5fa95aed1"}, {"file": "HarmonyG