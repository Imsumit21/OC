er": "/188", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "173063605285dd63098463f1e80466a4", "ts": "1757114763.888199", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "You know sounds better", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/191", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "3f6fd9e1ff953092281bd53b0dcab7fc", "ts": "1757114796.025309", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "No I just copy pasted it to make an object for level 1 that's why", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/194", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "fc2de165b5fb040db8594ed9d6630e9e", "ts": "1757114807.963939", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Sure", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/198", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "ec3322b33a6fabe79e155678d9b2fd78", "ts": "1757114832.460709", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "That'd be mega awesome", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/199", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "9a68893d43ea040dff1086f447cf2f43", "ts": "1757114858.987469", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "[PERSON_NAME_0022] told me [PERSON_NAME_0120] needs to do that but if we can help it ourselves, even better :[USERNAME_26053]:", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/205", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "d32c0d1eb5892b12c9720b7977138cf1", "ts": "1757115259.961859", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "That's still a massive improvement. Thank you", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/207", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "e8bbfda4a6e266b4cbbbf0acffc5eb30", "ts": "1757115275.689739", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "It looks awesome", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/211", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id":