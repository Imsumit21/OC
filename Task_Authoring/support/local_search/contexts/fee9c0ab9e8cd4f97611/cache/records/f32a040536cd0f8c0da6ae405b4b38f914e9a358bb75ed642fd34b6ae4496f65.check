annel": "D05GU6L0XFH", "client_msg_id": "9fdd8e29-c7d2-4593-bc84-de42fece9eb2", "reactions": [{"count": 1, "name": "+1", "users": ["EMPLOYEE_0016_SLACK_ID"]}], "source_team": "T04RZ2JAMM0", "team": "T04RZ2JAMM0", "text": "Didn't notice any other so far", "ts": "1758923915.220159", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "user_profile": {"avatar_hash": "<IMAGE_REDACTED>", "display_name": "julia", "first_name": "julia", "image_72": "<IMAGE_REDACTED>", "is_restricted": true, "is_ultra_restricted": true, "name": "julia", "real_name": "julia", "team": "T04RZ2JAMM0"}, "user_team": "T04RZ2JAMM0"}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/670", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "b87514ef29294d3ac5da40c4b5e601bf", "ts": "1759082338.536199", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Will do :[USERNAME_26053]:", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/673", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "ad1ffe424e55a16f7f261b658210bb48", "ts": "1759222275.797279", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Yeppers I tried the games :[USERNAME_26053]: I already tried Fortress Merge before but I gave it another go as well", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/674", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "6fa4bdacb2b9817fc0d8bce6613e5f07", "ts": "1759222304.387739", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Yeah, I'm not thrilled but you know, I could be wrong. I hope it works", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/677", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "545afcac267057798ddfccce371eed2b", "ts": "1759248381.072499", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "We need to increase level duration and in level meta I think", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/679", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "05cad5bb62b94c24075bbc3f2ea41640", "ts": "1759248400.636929", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "For example for those who are confident they can add a boss to the track for extra gold", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/682", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "2f77460b9f0944c26ce58724cc21714e", "ts": "1759248559.651049", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "They have no reason to at the moment, it's just the first 150 levels, we make it easy for them", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/683", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "1d6901b6428db6c515cb3762a5535c09", "ts": "1759248564.737359", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "And the pile usually have the counters", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/687", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "b567351784cd9ad0cee1b7f9d57109f6", "ts": "1759248610.024569", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I think we need more as an RPG", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/689", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "70b5aa6efd18c56cfbee40a868b24a42", "ts": "1759248630.985019", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "clear visual immunity, throwing back items, bosses locking deck slot etc", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/692", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "69fd5fbac55ad31023fe652353e2799b", "ts": "1759248686.317139", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "No they did exactly what I suggested which is to spice up the idle watching", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/693", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "2dc5f1ff4fd4ab6529ac698126079b7c", "ts": "1759248705.646719", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "What do you mean by 2 layers?", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/698", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "c180a8da04717ad34744cdd2a15d4762", "ts": "1759248813.982939", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Yeah but it's all part of the same win condition. The thing you suggest requires accomplishing one thing as a prerequsite to the next", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/701", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "7a0c9be43fb3fedae160e1d8d44b1ae8", "ts": "1759248848.508539", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "We have the additional \"matching skill under time\" situati\u0131n", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/702", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "7326c488aa6be5c3458e88e5c61e4182", "ts": "1759248866.846309", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Like in What The Luck, you don't merge stuff and then enter into a wave.", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/704", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "1f31aa8cf50e4dfe4fd896334af4317e", "ts": "1759249013.287699", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I'm talking about the prototype idea you showed in our 1-1", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/705", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "325115a02c2892143c99547dc06cb873", "ts": "1759249027.799989", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Our game is mostly fine now from core perspective I think", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/708", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "8faf7d83d3b2799c945293daf8912909", "ts": "1759249112.344429", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "The issue is even if you nail the match bit, you might still fail so that's the issue", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/709", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "64968e35451dc742c7057d544a31e58f", "ts": "1759249156.361859", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Matching is a challenge in itself so if you nail that you shouldn't be in a position you could still lose", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/712", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "ea700dc859ead888a926d7b12b10f3c2", "ts": "1759265165.398269", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "No worries :[USERNAME_26053]:", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05H5QL09PX/2025-09.json", "pointer": "/0", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "f1d07602515ea05c781c003ebea84afd", "ts": "1757345953.843949", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Hey, [PERSON_NAME_5466]. Where can I play with the counts of the inserted items? :[USERNAME_26053]:", "channel": "D05H5QL09PX", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05H5QL09PX/2025-09.json", "pointer": "/2", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "a019c38502ec23cde99e82aad1fc5e94", "ts": "1757351517.077669", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I couldn't find it, do you mind taking a look? It's urgent :confused:", "channel": "D05H5QL09PX", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05H5QL09PX/2025-09.json", "pointer": "/5", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "51625c433f04f40a7207b8d8e56e6713", "ts": "1757361842.896169", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I changed the quantity There but it doesn't always produce 3 sets. Basically I just want the cards to bring 3 sets of items into the level. Do you mind taking a look at that when you come back to the PC?", "channel": "D05H5QL09PX", "thread_ts": "1757361842.896169", "reply_count": 1, "reply_users_count": 1, "latest_reply": "1757432015.722249", "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05H5QL09PX/2025-09.json", "pointer": "/7", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "bb13395e710c6fa74ffd3b319cfbb2dc", "ts": "1757431949.039589", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "What am I testing for? Reproing the bug?", "channel": "D05H5QL09PX", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05H5QL09PX/2025-09.json", "pointer": "/10", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "b5d1c05c6233db8c60633a875194ae5a", "ts": "1757432398.019449", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "You said in the meeting I needed to test something because There is a bug. I was refering to that.", "channel": "D05H5QL09PX", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05H5QL09PX/2025-09.json", "pointer": "/11", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "8c18e99f45301f5f949faaf7a2d59f86", "ts": "1757432471.834959", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Yes all of them. If they have one card equipped - 3 sets of that item.  2 cards equipped 3 of the first and 3 of the second and so on.", "channel": "D05H5QL09PX", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05H5QL09PX/2025-09.json", "pointer": "/12", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "da0950dadaef16d10e7ecf5fb96306e4", "ts": "1757432541.278089", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Basically I want insertion items to come from cards only to force players to monetize. When they change items in the board it becomes difficult to balance that level. So fingers crossed, this iteration will work better.", "channel": "D05H5QL09PX", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05H5QL09PX/2025-09.json", "pointer": "/14", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "4686f3df09394de9fd16700f520982c3", "ts": "1757432762.718969", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Heh, sorry. Too eager lol", "channel": "D05H5QL09PX", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05H5QL09PX/2025-09.json", "pointer": "/16", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "1ac7f28af408c73436e3d9e6c5c6689f", "ts": "1757434611.366409", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Will do in an hour if that's okay.", "channel": "D05H5QL09PX", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "100", "users": ["EMPLOYEE_0025_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05H5QL09PX/2025-09.json", "pointer": "/19", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "621f75f3f18f1fc04c5c44f7b514a8f6", "ts": "1758259910.707059", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Good morning, [PERSON_NAME_5466]. I got this error. I'm not sure it's something I should be worrying about so sharing with you.", "channel": "D05H5QL09PX", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [],