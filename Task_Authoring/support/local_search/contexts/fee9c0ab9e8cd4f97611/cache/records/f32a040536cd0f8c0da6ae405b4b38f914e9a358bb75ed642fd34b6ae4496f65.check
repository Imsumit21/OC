Services/Services_Data/slack/messages/D076RBM29JS/2025-09.json", "pointer": "/64", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "2341eae08a1d8f7d3e852ce39da5aab3", "ts": "1757344125.862519", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "K\u0131z\u0131 bir iki level oynatiim olmad\u0131", "channel": "D076RBM29JS", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D076RBM29JS/2025-09.json", "pointer": "/66", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "95eac33059028d992093e9daa95670a7", "ts": "1757348834.675909", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "[PERSON_NAME_0092], senden bir \u015fey Rica [USERNAME_39664]?", "channel": "D076RBM29JS", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D076RBM29JS/2025-09.json", "pointer": "/68", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "2807e353faa47272185cb3424a697855", "ts": "1757348881.615449", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "LevelObjectHelper scriptine bi bakar m\u0131\u0131sn?", "channel": "D076RBM29JS", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D076RBM29JS/2025-09.json", "pointer": "/69", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "c6dcc59655e710a3f2cbbb37c44cebe5", "ts": "1757348889.003149", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Ordaki insertion rule do\u011fru \u00e7al\u0131\u015fm\u0131yor san\u0131r\u0131m", "channel": "D076RBM29JS", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D076RBM29JS/2025-09.json", "pointer": "/71", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "bfbd250aea802c3ac8b666fd35c21cb1", "ts": "1757348909.837039", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "```//Find the total sets of items in the level, for example, 68.\n//Multiply that number by 20 %, so 68 * 0.2 = 13.6.\n//We round 13.6 \u2192 14\n//We divide this number by the number of item insertions, let's assume we are inserting 3 items: A B and C.In this scenario we'll have 2 items inserted with quantity of 5 and 1 item with quantity of 4.So 5 + 5 + 4 = 14 total sets inserted.```\n\u015e\u00f6yle comment [USERNAME_43530]", "channel": "D076RBM29JS", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D076RBM29JS/2025-09.json", "pointer": "/72", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "7a58f6c5785d5986998d35b806bd311a", "ts": "1757348936.922399", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Main'de var \u015fu an poolresizing'i [USERNAME_43531]", "channel": "D076RBM29JS", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D076RBM29JS/2025-09.json", "pointer": "/74", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "7cbe895fd4eeb2a9467433336608b67e", "ts": "1757349052.610349", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Bi de DeckManager var ama san\u0131r\u0131m ordan item count alm\u0131yor zaten", "channel": "D076RBM29JS", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D076RBM29JS/2025-09.json", "pointer": "/76", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "05d61c007d4ea2ff445cdaf8718ad960", "ts": "1757351953.819009", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Buldun mu bir \u015fey?", "channel": "D076RBM29JS", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D076RBM29JS/2025-09.json", "pointer": "/79", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "65a33431403451a86575e8a14d4b1b11", "ts": "1757352193.481039", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Bir kart ka\u00e7 set item [USERNAME_43533] onu", "channel": "D076RBM29JS", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D076RBM29JS/2025-09.json", "pointer": "/80", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "f2f8b2729a844367b80b6d5ea5e721a9", "ts": "1757352197.874439", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "1'den 3'e y\u00fckseltmemiz laz\u0131m", "channel": "D076RBM29JS", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D076RBM29JS/2025-09.json", "pointer": "/81", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "652629bdb223b7718cd494993ed06717", "ts": "1757352434.492089", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Blake da diyo ki \"LevelObjectHelpers\" bu script'e bak. \u00c7ok yard\u0131mc\u0131 oldu a\u015fslkdl\u015faksld", "channel": "D076RBM29JS", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D076RBM29JS/2025-09.json", "pointer": "/82", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "a31c6062b19525eab4dd73e81e9ef769", "ts": "1757352436.113559", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Orda demek ki", "channel": "D076RBM29JS", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D076RBM29JS/2025-09.json", "pointer": "/84", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "8625b8567053b4921af2cdbe764787cc", "ts": "1757352588.462859", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "[USERNAME_15472]", "channel": "D076RBM29JS", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D076RBM29JS/2025-09.json", "pointer": "/89", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "10ad38770fbe649baf6a9c4d242c44cd", "ts": "1757352894.048319", "type": "message", 