, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-09.json", "pointer": "/36", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "7019c72365b1a2c6ccccc64118a7a253", "ts": "1756988432.575799", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "4'er saat arayla aferin'leri \u00e7ak\u0131nca kuyrdu\u011fu diktim, \u015fimdi sadece terliyorum :smile:", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-09.json", "pointer": "/42", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "dcf3113cb290c0abc6c520de794ead77", "ts": "1757006806.191829", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Tamamd\u0131r, hay\u0131rd\u0131r s\u0131k\u0131nt\u0131l\u0131 bi durum mu var?", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-09.json", "pointer": "/44", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "6118499fcebebd7e1a4beb8e540958c6", "ts": "1758558396.349789", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Playtest cloud videolar\u0131 inan\u0131lmaz sinir bozucu [USERNAME_31811]", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-09.json", "pointer": "/45", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "4a99a887f121e2fe04edcd62d58cb257", "ts": "1758558400.563689", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Siz ba\u015flad\u0131n\u0131z m\u0131 izlemeye", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-09.json", "pointer": "/52", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "8ce7f4daea6eaa4227a841b3d89b1d05", "ts": "1758558456.729499", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "[PERSON_NAME_32942] ba\u015flad\u0131m. Araplardan bize fayda yok hi\u00e7bir alanda a\u015flsdk\u015faskd\u015f", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-09.json", "pointer": "/60", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "2c27fcee278d0584d268b2547c350fb7", "ts": "1758558625.540789", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Bu Saud da zombilere ate\u015f att\u0131\u011f\u0131n\u0131 3. [PERSON_NAME_70797] ke\u015ffetti diyor \u00e7ok s\u0131k\u0131c\u0131 a\u015fslkd\u015fasd", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-09.json", "pointer": "/63", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "b33cfb7b84b9ec3a5c0565ae9bdb9658", "ts": "1758558680.227309", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "[PERSON_NAME_98804] mundane de\u011fildir ama bu mundane diyor. 4. levelde diyor bunu levelleri MF'den kopyalad\u0131k amk", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "sweat_smile", "users": ["EMPLOYEE_0012_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-09.json", "pointer": "/64", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "bc256e77e0cd840eb8aa54a1b63b3301", "ts": "1758558682.675839", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Ne diyon reyiz", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-09.json", "pointer": "/66", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "5d535deeac52642b1e9e6bd6111cf84b", "ts": "1758640740.955449", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Videolar o kadar k\u00f6t\u00fc de\u011filmi\u015f ya en be\u011fenmeyenlerden biriyle ba\u015flam\u0131\u015f\u0131m", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-09.json", "pointer": "/67", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "dc1ba1ae1c32079112a0e9f1e789e0b7", "ts": "1758640748.203369", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "[USERNAME_17873]", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-09.json", "pointer": "/69", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "5aef0e104665a78b16ab759ef81c94fe", "ts": "1758644838.359229", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Ve MHP'nin 40.c\u0131 y\u0131l\u0131", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-09.json", "pointer": "/72", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "05b1d20f44e3b5c5c70640486c35cafb", "ts": "1758644888.781429", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "yok daha de\u011fil", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-09.json", "pointer": "/73", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "d594a29792946bbbe39e097dd3a31a1d", "ts": "1758644902.937689", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Menderes d\u00f6neminin sonras\u0131n\u0131n mam\u00fcl\u00fc onlar", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-09.json", "pointer": "/74", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "59bce1aa66a632b3cef55d0b5f388f8a", "ts": "1758644929.112939", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Gen X'le ayn\u0131 ya\u015ftalar [USERNAME_17519]", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-09.json", "pointer": "/80", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "31373110cdbe610357d2b25e2cf457a1", "ts": "1758807072.251269", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Niye ev bak\u0131yorsunuz ta\u015f\u0131nacak misiniz?", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-09.json", "pointer": "/84", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "fdcd7ab338d41ed27d4b1e1086e174e9", "ts": "1758807158.360419", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Hee in\u015fallah g\u00f6nl\u00fcn\u00fcze g\u00f6re olur \u015fefim", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "pray", "users": ["EMPLOYEE_0026_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/0", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "8652071aadf1c56d55c2a33f0357ebf4", "ts": "1756742819.251089", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Hey did you Push 60 to 80?", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/3", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "749601d5ebb8a71b41a7faff5c61283a", "ts": "1756749530.896419", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "[USERNAME_29513]", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/4", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "04643e0704d2674ebaf8ff1db183c635", "ts": "1756753200.981039", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Do you want 100-110 or some other range?", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/7", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "fc71d41253ebeac2f07decb6c5a3c6d9", "ts": "1756753248.639069", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Okay, I'll take 120 onward until you're with 101-120", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/10", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "21a2080e86489884156f05cabe59fdbf", "ts": "1756917071.553169", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "<https://play.google.com/store/apps/details?id=com.popve.dicevmonster|https://play.google.com/store/apps/details?id=com.popve.dicevmonster>", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": [{"fallback": "Dice vs Monsters: Roguelike TD - Apps on Google Play", "from_url": "https://play.google.com/store/apps/details?id=com.popve.dicevmonster", "id": 1, "image_bytes": 376834, "image_height": 512, "image_url": "https://play-lh.googleusercontent.com/vQVg_2Ss6y34ahQA3VGE92hTBULdzw8KaWExwM-SYz5ajUeGZoUc0-ZVEppWRv2Fsg", "image_width": 512, "original_url": "https://play.google.com/store/apps/details?id=com.popve.dicevmonster", "service_icon": "http://www.gstatic.com/android/market_images/web/favicon_v3.ico", "service_name": "play.google.com", "text": "Roll and defend! Conquer enemies with arcane magic and tower defense strategy!", "title": "Dice vs Monsters: Roguelike TD - Apps on Google Play", "title_link": "https://play.google.com/store/apps/details?id=com.popve.dicevmonster"}]}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/12", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "283ea8406c271d6ff497c3b022929982", "ts": "1757003540.890859", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I alreayd pushed 0-30 new monster tracks. I'm doing 30-50 now. If you can take on from 50 and do however much you can that'll be awesome.", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/13", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "0fbb0bdb6051120d47765c791f17f203", "ts": "1757003592.357679", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Please keep an eye on for any levels that have no monster or optional monster before the prelevel timer. Those produce the bug of premature win", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/19", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "d8b9bbe69f5c894509b84cd85bb49851", "ts": "1757006137.859379", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "It's pinned on the chat but I'll update it and pin it to the design channel as well", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/23", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "f11bd0b8761367b3737c1cea8650943e", "ts": "1757055503.738209", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "How far did you come for balancing", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/29", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "bfa81143814db931a265b222c97ceef1", "ts": "1757055730.736599", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Okay, I'll let you know where I am when you wake up and we can finish it off together", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/30", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "423a6480b3d559b4b52e77bd65de9146", "ts": "1757055748.798809", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I'm nearly done with 50, I'll start working now", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/31", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "c61ef176e9e8d25a9a617fc6c7cf186e", "ts": "1757094333.332269", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Can you check one level? I don't understand why Karens won't spawn in that level", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/32", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "7b0d2467c5f20e760b6ec0c35c8f7ac5", "ts": "1757094337.565159", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "It's 140", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/41", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "3a41ed1efed328eea19f9e831b1d442f", "ts": "1757096227.469699", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "It's so weird, this is the first time this happened to me", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/42", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "5803002602b2f22078ccd7773694e248", "ts": "1757096240.126859", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I thought maybe I fucked something up but it's just a track", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/48", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "3b488e33c27cd0d0b1f30b06074fa7b0", "ts": "1757096410.694769", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I see, I'll test it at 70 or something. It should work fine but just to make sure", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/54", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "daf06245008efebe7b2576b732ba00ac", "ts": "1757096461.707209", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "[USERNAME_35532]", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/55", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "a6a06d934f98e8b7cdcf0109076f3e22", "ts": "1757096465.279659", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Can they fix it?", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/63", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "8a82d39d453eed6b3a209661b525c1ff", "ts": "1757096958.340069", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Mine follow the guidelines too", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/64", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "c7dd75ee90864d2ec1fdb1803871b486", "ts": "1757097007.218399", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "It's okay, we can balance it with the monsters.", "channel": "D05GU6L0XFH", "thread_ts": "1757096825.823209", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/65", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "b662c44655de930bc1023a95479fd86d", "ts": "1757097018.819789", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Can you start the balance now or are you still busy?", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/66", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "48449f804b5bcd2784e388c0d736db85", "ts": "1757097180.051049", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "This is why I don't like multiple people doing levels. There's bound to be differences no matter how tight the guidelines are.", "channel": "D05GU6L0XFH", "thread_ts": "1757096825.823209", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/72", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "a19fa106b88940e7086919dc11e6cec3", "ts": "1757097593.474999", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Okay but which levels are you doing?", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/75", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "7e0eb16ada3bd6e39bfd089b9795191e", "ts": "1757097630.942369", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "No, I didn't test them to any other CPM. If the board is nearly empty at the target CPM that's enough for monetization.", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/77", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "e4a7b127e9137380d1927b8529b85b05", "ts": "1757097652.961999", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Oh, okay. I'm about to finish my levels. I'll Push those and join you for the balance", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/80", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "c5e537697edb0d0639d5b3c3ed405583", "ts": "1757097667.656219", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "They need to be easy, it's the first day content for the most part", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/86", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "d4d971bfbcf29883ea0f07bbce1bcdd9", "ts": "1757097769.031359", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "CPM target is just the constant I'm using to make a curve.", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/87", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "dc02870c51f93e335e6af35c6fe0fab7", "ts": "1757097808.391039", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "And we have 5 difficulty tiers so There should be a variety", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/88", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "5bc5779d3a8e60ecb97696cb09d40973", "ts": "1757097856.536469", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "The point is, if that target CPM isn't hit more or less zombies become more difficult to deal with. That's the actual goal", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/91", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "8a50f3ecb7e5c786275d960958647690", "ts": "1757097955.451409", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I don't think it swinging. up and down. It's the first 100 levels. We're building muscle for the player. A little challenge and monsters piling up the more they slow down is the experience we want.", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/93", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "a05160461a1ac6c696bcc541e04b6128", "ts": "1757097995.086199", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "And we don't even know how to players will respond to that", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/94", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "de974a1d3d45a0bfc8f86efc4f5279d3", "ts": "1757098006.139139", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Which level?", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/97", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "f41b700927de7ff7655ac6fa6f16ff81", "ts": "1757098045.914659", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "It's a constant for a curve. The players won't play as the bot. They will blunder and wait between matches.", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/102", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "8325eb3edc23bffaae5e3c2aae5dbe89", "ts": "1757098211.119769", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [{"created": 1757098130, "display_as_bot": false, "duration_ms": 17817, "editable": false, "external_type": "", "file_access": "visible", "filetype": "mov", "has_rich_preview": false, "hls": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09DQQ5CJER-1f4755f633/file.m3u8?_xcb=d72fc&t=xoxb-REDACTED", "hls_embed": "data:application/vnd.apple.mpegurl;base64,", "id": "F09DQQ5CJER", "is_external": false, "is_public": false, "is_starred": false, "is_transcription_region_supported": true, "media_display_type": "video", "mimetype": "video/quicktime", "mode": "hosted", "mp4": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09DQQ5CJER-1f4755f633/screen_recording_2025-09-05_at_21.48.23.mp4?t=xoxb-REDACTED", "mp4_low": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09DQQ5CJER-1f4755f633/screen_recording_2025-09-05_at_21.48.23_trans.mp4?t=xoxb-REDACTED", "name": "Screen Recording 2025-09-05 at 21.48.23.mov", "permalink": "https://harmonygamesgroup.slack.com/files/EMPLOYEE_0038_SLACK_ID/F09DQQ5CJER/screen_recording_2025-09-05_at_21.48.23.mov", "permalink_public": "https://slack-files.com/T04RZ2JAMM0-F09DQQ5CJER-4206d1362e", "pretty_type": "QuickTime Movie", "public_url_shared": false, "size": 62404320, "skipped_shares": true, "thumb_video": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09DQQ5CJER-1f4755f633/screen_recording_2025-09-05_at_21.48.23_thumb_video.jpeg?t=xoxb-REDACTED", "thumb_video_h": 1778, "thumb_video_w": 2952, "timestamp": 1757098130, "title": "Screen Recording 2025-09-05 at 21.48.23.mov", "transcription": {"status": "none"}, "url_private": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09DQQ5CJER-1f4755f633/screen_recording_2025-09-05_at_21.48.23.mp4?t=xoxb-REDACTED", "url_private_download": "https://files.slack.com/files-pri/T04RZ2JAMM0-F09DQQ5CJER/download/screen_recording_2025-09-05_at_21.48.23.mov?token=xoxb-REDACTED", "user": "EMPLOYEE_0005_SLACK_ID", "user_team": "T04RZ2JAMM0", "username": ""}], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/104", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "871b9e760da2f6b325779bca7db06e37", "ts": "1757098225.258039", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "It's neither. 70 and onward the level should be passable. 70 and down the level should become increasingly more difficult.", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/105", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "5923630db8c3378dcf1019fefc12d728", "ts": "1757098255.471599", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Not to mention that's a monochromatic level with 2 toys looking identical. It's hard. So that level is more than fair.", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/107", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "f0e82543e07e3e462350fa20844da302", "ts": "1757098300.595119", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Huddle?", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/111", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "d2e9275c0c322d707f7066637b3981e4", "ts": "1757100546.442099", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Should we just get rid of the nuke and force win if the board is cleared? It's been buggy since it was implemented.", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/114", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "062f6062d523e4cb60570d730eda0b44", "ts": "1757102338.264849", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I agree it's so good", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/115", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "400910b70f067916b05c2214097afd57", "ts": "1757102348.791709", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I pushed the 150. Now I will Push the missing intro levels", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/116", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "f544fa9d4e75b774ed9e21668fcb557b", "ts": "1757102382.593519", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "We're missing the iron level at 57 and the slipper level at 87. Otherwise all good", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/119", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "f68c6be15734789e4cca9f5405a33299", "ts": "1757102598.902589", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "That was with wrong item and at level 7 so it's discarded", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/120", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "629644343745dddeda04a0771147139f", "ts": "1757102605.202839", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Why doesn't the iron burn though", "channel": "D05GU6L0XFH", "thread_ts": "1757102605.202839", "reply_count": 5, "reply_users_count": 2, "latest_reply": "1757103938.720379", "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/121", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "b2a4427a25dd5022cce82c652d7045c1", "ts": "1757102908.779949", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I placed the missing intro levels too. I'll just go through the intro levels again and make sure they all have the correct item", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "