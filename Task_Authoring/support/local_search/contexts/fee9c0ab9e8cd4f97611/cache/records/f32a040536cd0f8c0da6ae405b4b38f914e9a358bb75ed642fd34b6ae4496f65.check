: {"id": "7dd5507db8e568a2d201eebeb72a99ef", "ts": "1757954940.390999", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Adding new levels There", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "+1", "users": ["EMPLOYEE_0016_SLACK_ID"]}, {"count": 1, "name": "100", "users": ["EMPLOYEE_0016_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/385", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "1b897b2caf25daf5c13b6fc03b38888e", "ts": "1757955032.137219", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "[USERNAME_29513]", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/386", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "73d16a23ac5fec814d08136fd378e478", "ts": "1758211858.994669", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Can you look at this one level? It's giving the Chef bug without having a chef in it.", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/387", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "d4d5ab2f5d10130bebf96ead048752f9", "ts": "1758211879.040619", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I'll Push it now but please don't merge because I didn't finish the level", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/388", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "a2ead5a3d1f60f0a71a3a3a98232b2c4", "ts": "1758212025.099119", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Nevermind I used legacy Karen...", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/390", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "55428f7ad50a13b35f75977c70cd07fd", "ts": "1758215579.981679", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "yeah", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/392", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "5d5e3153a897878b792b9f82925076df", "ts": "1758296122.738859", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "No worries, I don't really have anything to bring up, so if you want, we can just cancel and you can move around more relaxed", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/393", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "a9881e4b22dfd14c20b28dbe065ef163", "ts": "1758296255.017629", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Do you have any more levels you'll Push?", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/397", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "df3dc0b9d75173aecb71e40d5efed33a", "ts": "1758297752.746549", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "No worries, I can top them off, I have mine ready", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "pray", "users": ["EMPLOYEE_0016_SLACK_ID"]}, {"count": 1, "name": "100", "users": ["EMPLOYEE_0016_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/398", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "5ad6a591d9285b56edb74e71ee285f1d", "ts": "1758297766.214229", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "and I had some laying around so it should be oka y", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/403", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "a8e88f08f6460f0b88fda82b182b679f", "ts": "1758299020.510829", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I made some flip flop beach levels", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/404", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "dbde3d99fe881630ad63608a8088039f", "ts": "1758299038.836649", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "By the way, I'm going through your levels and they are inconsistent", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/405", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "329606e6a1b0aa79f1bbbd58dedb1fff", "ts": "1758299052.146159", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Level 214 has 12 unique items :[USERNAME_23610]:", "channel": "D05GU6L0XFH", "thread_ts": "1758299052.146159", "reply_count": 3, "reply_users_count": 2, "latest_reply": "1758304905.382029", "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/407", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "68a9d163836b2349e0ee2f0ebd8c8d8e", "ts": "1758302710.141769", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "With 4 cards on top it makes 16 unique items", "channel": "D05GU6L0XFH", "thread_ts": "1758299052.146159", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/408", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "a353765e0fab971f47954921c0dcaa78", "ts": "1758303451.683319", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Some of the levels are really blend. Some of them have 3 colors of the same item and sometimes multiple sets of same item different color. Do you mind if I change them up a bit?", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/411", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "e9063d760a257011933c91d5027c982e", "ts": "1758303471.923599", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": ":[USERNAME_7156]:", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/417", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "c369a010fb274e7534e22b4751cce663", "ts": "1758348317.817249", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I didn't go too far either, I got sleepy :[USERNAME_23161]:", "channel": "D05GU6L0XFH", "thread_ts": "1758328136.357919", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/418", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "99e71bb4012f9dfd302438cfb09b9e58", "ts": "1758348323.971959", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Which ones?", "channel": "D05GU6L0XFH", "thread_ts": "1758330252.210929", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/423", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "9695db6241154ffb0c3e0be8b8ad99dc", "ts": "1758390975.226519", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Yeah, I think it's a good point to crank up the heat but data will say more", "channel": "D05GU6L0XFH", "thread_ts": "1758330252.210929", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/424", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "9beabd317ee7d039dc8b5225c49eeece", "ts": "1758391086.614569", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I think you should go back through your levels, boss. They are sometimes lacking thought behind them and sometimes have monster tracks that have a very large interval. \u0130t's worth a look", "channel": "D05GU6L0XFH", "thread_ts": "1758328136.357919", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/425", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "b370b234b62375c00aed97bcddecd827", "ts": "1758391113.054069", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "They shouldn't contain too much of a same item different color trick at those levels.", "channel": "D05GU6L0XFH", "thread_ts": "1758328136.357919", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/428", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "859f3d2aa31ff7cf276365d8e99375ae", "ts": "1758391143.651469", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I touched up 230-235. Didn't do anything else.", "channel": "D05GU6L0XFH", "thread_ts": "1758328136.357919", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/430", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "576f9310be8e83e0dd02cd999414a3ad", "ts": "1758391532.402759", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Did they fix the issue?", "channel": "D05GU6L0XFH", "thread_ts": "1758391532.402759", "reply_count": 1, "reply_users_count": 1, "latest_reply": "1758392315.656889", "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/431", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "c398df5206190e657e2c34b881ad080c", "ts": "1758392293.149049", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "MF started making levels like we are doing them. These are 2000+", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [{"created": 1758392276, "display_as_bot": false, "editable": false, "external_type": "", "file_access": "visible", "filetype": "jpg", "has_rich_preview": false, "id": "F09H34URJRE", "is_external": false, "is_public": false, "is_starred": false, "media_display_type": "unknown", "mimetype": "image/jpeg", "mode": "hosted", "name": "1758392276256.jpeg", "original_h": 2400, "original_w": 1080, "permalink": "https://harmonygamesgroup.slack.com/files/EMPLOYEE_0038_SLACK_ID/F09H34URJRE/1758392276256.jpeg", "permalink_public": "https://slack-files.com/T04RZ2JAMM0-F09H34URJRE-dd165e337f", "pretty_type": "JPEG", "public_url_shared": false, "size": 192102, "skipped_shares": true, "thumb_1024": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09H34URJRE-1c1f101139/1758392276256_1024.jpg?t=xoxb-REDACTED", "thumb_1024_h": 1024, "thumb_1024_w": 461, "thumb_160": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09H34URJRE-1c1f101139/1758392276256_160.jpg?t=xoxb-REDACTED", "thumb_360": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09H34URJRE-1c1f101139/1758392276256_360.jpg?t=xoxb-REDACTED", "thumb_360_h": 360, "thumb_360_w": 162, "thumb_480": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09H34URJRE-1c1f101139/1758392276256_480.jpg?t=xoxb-REDACTED", "thumb_480_h": 480, "thumb_480_w": 216, "thumb_64": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09H34URJRE-1c1f101139/1758392276256_64.jpg?t=xoxb-REDACTED", "thumb_720": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09H34URJRE-1c1f101139/1758392276256_720.jpg?t=xoxb-REDACTED", "thumb_720_h": 720, "thumb_720_w": 324, "thumb_80": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09H34URJRE-1c1f101139/1758392276256_80.jpg?t=xoxb-REDACTED", "thumb_800": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09H34URJRE-1c1f101139/1758392276256_800.jpg?t=xoxb-REDACTED", "thumb_800_h": 1778, "thumb_800_w": 800, "thumb_960": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09H34URJRE-1c1f101139/1758392276256_960.jpg?t=xoxb-REDACTED", "thumb_960_h": 960, "thumb_960_w": 432, "thumb_tiny": "AwAwABaHygIt2OcZzu/+tTPLIUkkHBAqXC+WPmOe4PTFPVS2eWIAyeeKrYLMgaIqgY45OODTMVZaMmMNnr0Gaj8s/wCc0gsSquThSDgcc0c4ygPB6j/GhgwiBwpGB0pmWyAN3zdccZosUJL0GOnpnOKj5qaQ/KN2c1F8vvTuJjxI3qOmOmaA7c/N160xDkHLAEdM96cdu1vnGe3SgV2JId/WmbB6D8qWQ4OAwI65FNzSEf/Z", "timestamp": 1758392276, "title": "1758392276256.jpeg", "url_private": "https://files.slack.com/files-pri/T04RZ2JAMM0-F09H34URJRE/1758392276256.jpeg?token=xoxb-REDACTED", "url_private_download": "https://files.slack.com/files-pri/T04RZ2JAMM0-F09H34URJRE/download/1758392276256.jpeg?token=xoxb-REDACTED", "user": "EMPLOYEE_0005_SLACK_ID", "user_team": "T04RZ2JAMM0", "username": ""}], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/436", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "474c97d4ffe3d85ddb6dc0807bc8c760", "ts": "1758689583.961269", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "For real? I always thought he was super cute :[USERNAME_7156]:", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/437", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "b3c17934c9bde5ec5a5417c84f01bd06", "ts": "1758689601.882269", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "And maybe a little stereotypical and offensive :[USERNAME_7156]:", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/441", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "866467c01b313d22b0c2858bcadd6cf5", "ts": "1758689739.175439", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "It's always the age old question isn't it. Is it still racism if the stereotype is performed by the said race :laughing:", "channel": "D05GU6L0XFH", "thread_ts": "1758689739.175439", "reply_count": 3, "reply_users_count": 2, "latest_reply": "1758690928.001969", "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/442", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "0bffc3c53b33ebffd5051126343aa6a4", "ts": "1758689770.035079", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Still I wouldn't dare go to Western market with that chef. Just wouldn't risk it as cute as he may ve", "channel": "D05GU6L0XFH", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/444", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "8201ad7e1462124a771967acb47731f6", "ts": "1758690165.886239", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Yeah but intent is perceived differently too. It's just a mess", "channel": "D05GU6L0XFH", "thread_ts": "1758689739.175439", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/448", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"blocks": [{"block_id": "9OftU", "elements": [{"elements": [{"text": "The levels are coming along good I think. Im doing about 10-15 a day. Got a little sidetracked watching the videoa. For September 30rd deadline I'm on track to exceed 300 easily (which will most likely happen today)", "type": "text"}], "type": "rich_text_section"}], "type": "rich_text"}], "channel": "D05GU6L0XFH", "client_msg_id": "eb75e3a1-25be-4f75-b5ee-ba8119fcbbd8", "source_team": "T04RZ2JAMM0", "team": "T04RZ2JAMM0", "text": "The levels are coming along good I think. Im doing about 10-15 a day. Got a little sidetracked watching the videoa. For September 30rd deadline I'm on track to exceed 300 easily (which will most likely happen today)", "ts": "1758879805.560559", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "user_profile": {"avatar_hash": "<IMAGE_REDACTED>", "display_name": "julia", "first_name": "julia", "image_72": "<IMAGE_REDACTED>", "is_restricted": true, "is_ultra_restricted": true, "name": "julia", "real_name": "julia", "team": "T04RZ2JAMM0"}, "user_team": "T04RZ2JAMM0"}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/449", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"blocks": [{"block_id": "dI6kc", "elements": [{"elements": [{"text": "And don't worry about your levels, I went over them", "type": "text"}], "type": "rich_text_section"}], "type": "rich_text"}], "channel": "D05GU6L0XFH", "client_msg_id": "93d505c4-8cab-4fc3-a9a5-a4371e635e57", "source_team": "T04RZ2JAMM0", "team": "T04RZ2JAMM0", "text": "And don't worry about your levels, I went over them", "ts": "1758879819.233489", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "user_profile": {"avatar_hash": "<IMAGE_REDACTED>", "display_name": "julia", "first_name": "julia", "image_72": "<IMAGE_REDACTED>", "is_restricted": true, "is_ultra_restricted": true, "name": "julia", "real_name": "julia", "team": "T04RZ2JAMM0"}, "user_team": "T04RZ2JAMM0"}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/450", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"blocks": [{"block_id": "JCN6Z", "elements": [{"elements": [{"text": "I know you're super busy with administrative work and side products. I got the levels covered ", "type": "text"}, {"name": "saluting_face", "type": "emoji", "unicode": "1fae1"}], "type": "rich_text_section"}], "type": "rich_text"}], "channel": "D05GU6L0XFH", "client_msg_id": "b740c238-7880-4abe-9008-9af098e74685", "source_team": "T04RZ2JAMM0", "team": "T04RZ2JAMM0", "text": "I know you're super busy with administrative work and side products. I got the levels covered :[USERNAME_26053]:", "ts": "1758879846.090329", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "user_profile": {"avatar_hash": "<IMAGE_REDACTED>", "display_name": "julia", "first_name": "julia", "image_72": "<IMAGE_REDACTED>", "is_restricted": true, "is_ultra_restricted": true, "name": "julia", "real_name": "julia", "team": "T04RZ2JAMM0"}, "user_team": "T04RZ2JAMM0"}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/D05GU6L0XFH/2025-09.json", "pointer": "/451", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"blocks": [{"block_id": "dpc5W", "elements": [{"elements": [{"text": "I can add the new items myself if you want. I just might screw up rotations so maybe a tutorial by you or going over my work quickly could help", "type": "text"}], "type": "rich_text_section"}], "type": "rich_text"}], "channel": "D05GU6L0XFH", "client_msg_id": "487ff88d-2eee-4567-aa2a-0e2a5ebbe9d8", "source_team": "T04RZ2JAMM0", "team": "T04RZ2JAMM0", "text": "I can add the new items myself if you want. I just might screw up rotations so maybe a tutorial by you or going over my work quickly could help", "ts": "1758879877.475439", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "user_profile": {"avatar_hash": "<IMAGE_REDACTED>", "display_name": "julia", "first_