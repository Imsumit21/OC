es-pri/T04RZ2JAMM0-F09FNGKPDBK/image.png?token=xoxb-REDACTED", "url_private_download": "https://files.slack.com/files-pri/T04RZ2JAMM0-F09FNGKPDBK/download/image.png?token=xoxb-REDACTED", "user": "EMPLOYEE_0005_SLACK_ID", "user_team": "T04RZ2JAMM0", "username": ""}], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/378", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "338df97aa9ae8e736d4329dc115650b9", "ts": "1757948120.358159", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "That level is supposed to teach two item can be different colors so I want to keep the Apple orange thing. Here is the Match Factory version of it. So I can make a red item that stands out more and give less of it to really highlight. And give more time.", "channel": "C090N54TG79", "thread_ts": "1757713225.482519", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [{"created": 1757948081, "display_as_bot": false, "editable": false, "external_type": "", "file_access": "visible", "filetype": "png", "has_rich_preview": false, "id": "F09F77XSEHK", "is_external": false, "is_public": false, "is_starred": false, "media_display_type": "unknown", "mimetype": "image/png", "mode": "hosted", "name": "image.png", "original_h": 754, "original_w": 454, "permalink": "https://harmonygamesgroup.slack.com/files/EMPLOYEE_0038_SLACK_ID/F09F77XSEHK/image.png", "permalink_public": "https://slack-files.com/T04RZ2JAMM0-F09F77XSEHK-f66b0865f4", "pretty_type": "PNG", "public_url_shared": false, "size": 489099, "skipped_shares": true, "thumb_160": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09F77XSEHK-23f8b33f34/image_160.png?t=xoxb-REDACTED", "thumb_360": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09F77XSEHK-23f8b33f34/image_360.png?t=xoxb-REDACTED", "thumb_360_h": 360, "thumb_360_w": 217, "thumb_480": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09F77XSEHK-23f8b33f34/image_480.png?t=xoxb-REDACTED", "thumb_480_h": 480, "thumb_480_w": 289, "thumb_64": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09F77XSEHK-23f8b33f34/image_64.png?t=xoxb-REDACTED", "thumb_720": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09F77XSEHK-23f8b33f34/image_720.png?t=xoxb-REDACTED", "thumb_720_h": 720, "thumb_720_w": 434, "thumb_80": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09F77XSEHK-23f8b33f34/image_80.png?t=xoxb-REDACTED", "thumb_tiny": "", "timestamp": 1757948081, "title": "image.png", "url_private": "https://files.slack.com/files-pri/T04RZ2JAMM0-F09F77XSEHK/image.png?token=xoxb-REDACTED", "url_private_download": "https://files.slack.com/files-pri/T04RZ2JAMM0-F09F77XSEHK/download/image.png?token=xoxb-REDACTED", "user": "EMPLOYEE_0005_SLACK_ID", "user_team": "T04RZ2JAMM0", "username": ""}], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/379", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "6f11ef233011b9ebba3cbc868587bb20", "ts": "1757948154.703219", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Okay, I'll simplify the level more as well as the monster track :[USERNAME_26053]:", "channel": "C090N54TG79", "thread_ts": "1757713225.482519", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/386", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "d9d1e2e0f2931f35275a2bb55bf380b4", "ts": "1757949251.650129", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Yes, that's what I'm leaning towards. I'll make a version with tomato and bell peppers instead of round shape.", "channel": "C090N54TG79", "thread_ts": "1757713225.482519", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/413", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "d4e1c44c9b2baf5e540fd41c3c7d6702", "ts": "1757956957.236759", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Thanks for the overview, it was very beneficial to read :[USERNAME_26053]:", "channel": "C090N54TG79", "thread_ts": "1757949785.655269", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/416", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "8a961ac53e3536685411fb9be606ed45", "ts": "1757957084.312719", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Level 4 zombies are too many and too close. I think that's the main issue", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "+1", "users": ["EMPLOYEE_0038_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/417", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "31dc44e4fbdcfeae96d1a9ea63b3d3ad", "ts": "1757957184.029949", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "With blunders and enrage it's virtually impossible", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/419", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "87afde49659998c6b6be0f3ce1a48d49", "ts": "1757957236.882079", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Yeah the zombies are so close they would panic for sure :smile:", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/423", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "223f152bf9b22f57108035930b5b50b9", "ts": "1757957607.676129", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Now with enrage in the beginning and slow match, it will still hold up.", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [{"created": 1757957532, "display_as_bot": false, "duration_ms": 57190, "editable": false, "external_type": "", "file_access": "visible", "filetype": "mov", "has_rich_preview": false, "hls": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09FQQ8E42V-460f06116f/file.m3u8?_xcb=f60e8&t=xoxb-REDACTED", "hls_embed": "data:application/vnd.apple.mpegurl;base64,", "id": "F09FQQ8E42V", "is_external": false, "is_public": false, "is_starred": false, "is_transcription_region_supported": true, "media_display_type": "video", "mimetype": "video/quicktime", "mode": "hosted", "mp4": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09FQQ8E42V-460f06116f/screen_recording_2025-09-15_at_20.30.52.mp4?t=xoxb-REDACTED", "mp4_low": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09FQQ8E42V-460f06116f/screen_recording_2025-09-15_at_20.30.52_trans.mp4?t=xoxb-REDACTED", "name": "Screen Recording 2025-09-15 at 20.30.52.mov", "permalink": "https://harmonygamesgroup.slack.com/files/EMPLOYEE_0038_SLACK_ID/F09FQQ8E42V/screen_recording_2025-09-15_at_20.30.52.mov", "permalink_public": "https://slack-files.com/T04RZ2JAMM0-F09FQQ8E42V-3ddad203ea", "pretty_type": "QuickTime Movie", "public_url_shared": false, "size": 57560099, "skipped_shares": true, "thumb_video": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09FQQ8E42V-460f06116f/screen_recording_2025-09-15_at_20.30.52_thumb_video.jpeg?t=xoxb-REDACTED", "thumb_video_h": 1150, "thumb_video_w": 588, "timestamp": 1757957532, "title": "Screen Recording 2025-09-15 at 20.30.52.mov", "transcription": {"status": "none"}, "url_private": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09FQQ8E42V-460f06116f/screen_recording_2025-09-15_at_20.30.52.mp4?t=xoxb-REDACTED", "url_private_download": "https://files.slack.com/files-pri/T04RZ2JAMM0-F09FQQ8E42V/download/screen_recording_2025-09-15_at_20.30.52.mov?token=xoxb-REDACTED", "user": "EMPLOYEE_0005_SLACK_ID", "user_team": "T04RZ2JAMM0", "username": ""}], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/445", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "d985145913921ea1631ba9728a7ce4f3", "ts": "1757959167.948899", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "That's overdoing it. If I adjust the monsters in such a manner pepople who play normally won't experience the level at all", "channel": "C090N54TG79", "thread_ts": "1757958047.215619", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/446", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "5935234d2e74426e9de1df02ca0cd670", "ts": "1757959175.695419", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "It's the wrong kind of safety valve", "channel": "C090N54TG79", "thread_ts": "1757958047.215619", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "+1", "users": ["EMPLOYEE_0038_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/447", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "b70e1dcf32c6883aedfede6b5501df9c", "ts": "1757959383.428889", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "<@EMPLOYEE_0038_SLACK_ID> <@EMPLOYEE_0016_SLACK_ID> I made level4 like this.", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "gratitude-thank-you", "users": ["EMPLOYEE_0038_SLACK_ID"]}], "files": [{"created": 1757959372, "display_as_bot": false, "editable": false, "external_type": "", "file_access": "visible", "filetype": "png", "has_rich_preview": false, "id": "F09FB7LSHFY", "is_external": false, "is_public": false, "is_starred": false, "media_display_type": "unknown", "mimetype": "image/png", "mode": "hosted", "name": "image.png", "original_h": 658, "original_w": 496, "permalink": "https://harmonygamesgroup.slack.com/files/EMPLOYEE_0038_SLACK_ID/F09FB7LSHFY/image.png", "permalink_public": "https://slack-files.com/T04RZ2JAMM0-F09FB7LSHFY-7c114f4a46", "pretty_type": "PNG", "public_url_shared": false, "size": 417055, "skipped_shares": true, "thumb_160": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09FB7LSHFY-b14b1e47b5/image_160.png?t=xoxb-REDACTED", "thumb_360": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09FB7LSHFY-b14b1e47b5/image_360.png?t=xoxb-REDACTED", "thumb_360_h": 360, "thumb_360_w": 271, "thumb_480": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09FB7LSHFY-b14b1e47b5/image_480.png?t=xoxb-REDACTED", "thumb_480_h": 480, "thumb_480_w": 362, "thumb_64": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09FB7LSHFY-b14b1e47b5/image_64.png?t=xoxb-REDACTED", "thumb_80": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09FB7LSHFY-b14b1e47b5/image_80.png?t=xoxb-REDACTED", "thumb_tiny": "", "timestamp": 1757959372, "title": "image.png", "url_private": "https://files.slack.com/files-pri/T04RZ2JAMM0-F09FB7LSHFY/image.png?token=xoxb-REDACTED", "url_private_download": "https://files.slack.com/files-pri/T04RZ2JAMM0-F09FB7LSHFY/download/image.png?token=xoxb-REDACTED", "user": "EMPLOYEE_0005_SLACK_ID", "user_team": "T04RZ2JAMM0", "username": ""}], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/448", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "6d897f0abfff0a9660b719f1a97b0c15", "ts": "1757959419.960019", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "But with this we're bound to get another churn the level following. This is way too simple.", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/452", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "a9f712bef2b21de296e6846fa87ab5a1", "ts": "1757959520.347449", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "The point of this level is to have 2 colors of the same item. So bell peppers are good for that. They are not red and orange so they distunguish better.", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/453", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "455c54bb1e19566da3281894f99b38f9", "ts": "1757959550.965969", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I can put some strawberries I guess, one second", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/457", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "f4caf11cbe180b7b45e10954ed3b6e2c", "ts": "1757959677.095859", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I think it looks good now", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "+1", "users": ["EMPLOYEE_0038_SLACK_ID"]}, {"count": 1, "name": "100", "users": ["EMPLOYEE_0038_SLACK_ID"]}, {"count": 1, "name": "partying_face", "users": ["EMPLOYEE_0038_SLACK_ID"]}], "files": [{"created": 1757959671, "display_as_bot": false, "editable": false, "external_type": "", "file_access": "visible", "filetype": "png", "has_rich_preview": false, "id": "F09FB8J87RU", "is_external": false, "is_public": false, "is_starred": false, "media_display_type": "unknown", "mimetype": "image/png", "mode": "hosted", "name": "image.png", "original_h": 660, "original_w": 500, "permalink": "https://harmonygamesgroup.slack.com/files/EMPLOYEE_0038_SLACK_ID/F09FB8J87RU/image.png", "permalink_public": "https://slack-files.com/T04RZ2JAMM0-F09FB8J87RU-0fb0ededef", "pretty_type": "PNG", "public_url_shared": false, "size": 449713, "skipped_shares": true, "thumb_160": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09FB8J87RU-69d22676bf/image_160.png?t=xoxb-REDACTED", "thumb_360": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09FB8J87RU-69d22676bf/image_360.png?t=xoxb-REDACTED", "thumb_360_h": 360, "thumb_360_w": 273, "thumb_480": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09FB8J87RU-69d22676bf/image_480.png?t=xoxb-REDACTED", "thumb_480_h": 480, "thumb_480_w": 364, "thumb_64": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09FB8J87RU-69d22676bf/image_64.png?t=xoxb-REDACTED", "thumb_80": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09FB8J87RU-69d22676bf/image_80.png?t=xoxb-REDACTED", "thumb_tiny": "", "timestamp": 1757959671, "title": "image.png", "url_private": "https://files.slack.com/files-pri/T04RZ2JAMM0-F09FB8J87RU/image.png?token=xoxb-REDACTED", "url_private_download": "https://files.slack.com/files-pri/T04RZ2JAMM0-F09FB8J87RU/download/image.png?token=xoxb-REDACTED", "user": "EMPLOYEE_0005_SLACK_ID", "user_team": "T04RZ2JAMM0", "username": ""}], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/458", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "e321e0ce159866a0604615cc1ea772d6", "ts": "1757959702.204739", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Bellpeppers still get the job done and enough texture from grape and strawberry to avoid blunder", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "100", "users": ["EMPLOYEE_0038_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/459", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "1fa2e0b4783d9dcaaf700625e0edce09", "ts": "1757959992.127429", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "[PERSON_NAME_57565], I made a PR :[USERNAME_26053]:", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/504", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "4129f1357aeed1bc3a09a016d41d2007", "ts": "1758209516.994269", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "The main issue is that we have it tied up with the card tutorial. Introducing effects earlier can be tested (which I think anything earlier than 17 will just confuse the players because it's before they learn the core game), but I don't think it will perform very good. Because it's not just the effect, it's the whole card system too.", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/505", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "024096bd0b107adc7828097aa9ec89c8", "ts": "1758209585.672149", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I mean we had that churn in level 4 which is so simple if you know the core game, but people clearly struggle and panic into enraging. Do we really want to add a card system around those times of the learning curve?", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/528", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "0e3a5277c7f750932fd1ea0deba0169c", "ts": "1758302465.958889", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "<@EMPLOYEE_0016_SLACK_ID> Do you want me to go through your 200-230 or wrap up to 250?", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/529", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "619f71b612339ece68cd995647413177", "ts": "1758302543.832289", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Also should I revert the level 4 then?", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/532", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "4584da2035a33595372e7e97b0fd543e", "ts": "1758302682.866369", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I simplified level 4 because we thought it might be a difficulty issue. I can revert it to my first difficulty iteration.", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/533", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "f198f087c6ff631d8f2c98a3612b6c6c", "ts": "1758302752.063689", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "[PERSON_NAME_57565], I'll go over your levels until they fix the issue then. I also made up to 235 so let's see where we end up. I'll try to do both, the night is young", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "+1", "users": ["EMPLOYEE_0016_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/547", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "2e91cb6f5448606af6bb8f9e71d0aa53", "ts": "1758565802.426629", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "No, but we can ask around. There's gotta be a mutual acquaintance somewhere", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/549", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "5f5caae5549664936910be5219cadac9", "ts": "1758565844.892959", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "See? Found the acquaintance :laughing:", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "rolling_on_the_floor_laughing", "users": ["EMPLOYEE_0026_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/559", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "490432971a416989d4808282d6cd635c", "ts": "1758568261.546739", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "It attracts more hardcore users to a currently casual funnel. What is the benefit in that?", "channel": "C090N54TG79", "thread_ts": "1758567201.262949", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/562", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "6fb187dcbdb665a2332365c3700de9cf", "ts": "1758568988.777449", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Yep, I'll make your level ASAP when the guys make their decision. What exactly do you need?", "channel": "C090N54TG79", "thread_ts": "1758567201.262949", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/567", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "e072d546c2bd1d9d54b278028ae0a492", "ts": "1758569491.223089", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "<@EMPLOYEE_0016_SLACK_ID> Techically, we'll get better d1-d3 from casuals and better long term from hardcores. I'm just worried, since we simplified the funnel with VariantC hardcores won't retain early and won't give us d7 either. But people are likely to stick out 17 levels to see the cards and the liveops so we can go either way you want. That's my best guess", "channel": "C090N54TG79", "thread_ts": "1758567201.262949", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/570", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "619656c3826a666ea57c9e4e8e5184db", "ts": "1758569629.722849", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "We won't get a reliable hardcore audience test with the current levels we have. So going generic in the playable will perform better in terms of retention.", "channel": "C090N54TG79", "thread_ts": "1758567201.262949", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/573", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "e0f831567d86a1db41b17bcb52525fc6", "ts": "1758569707.508219", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Oh.. Yeah in that case, let's do a more hardcore friendly playable and see how they do with the funnel. I get it now, sorry for the confusion", "channel": "C090N54TG79", "thread_ts": "1758567201.262949", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/575", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "ac7c8728f08bff0cdc5d27b56f3faa99", "ts": "1758569824.148029", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Do you want to try a cute level with lots of grenades and shruiken then? Total guy focus", "channel": "C090N54TG79", "thread_ts": "1758567201.262949", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/583", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "00f77ad224d76c723e2e740061d2e0c6", "ts": "1758570117.998139", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I think the game is at least a solid 6 in terms of complexity. Multiple objectives in the core game and card layer. That's pretty hardcore for casuals.", "channel": "C090N54TG79", "thread_ts": "1758567201.262949", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "man-shrugging", "users": ["EMPLOYEE_0016_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/593", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "7f4e5b0557c5adfb3eca80607a1c8421", "ts": "1758581286.916739", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "It sucks as FTUE summary too. Summary says poor instructions but players always figure things out", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/597", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "7a8e510d8e9cedb40fa8823915fc0db6", "ts": "1758581347.975559", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "It's okay if they confused by the color. That's the point of the game kind of, lol", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/599", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "c1888e60df68a6bff9a7490aa1a5891b", "ts": "1758581371.163929", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Yeah AI summary sucks but they still gave poor star rating etc", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/601", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "18fc52c35aeb34ad696613d853f82c48", "ts": "1758581410.318509", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "It's just the core game consolidation. Whatever complaint they have boils down to that for the most cases", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/607", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "fa2c6b3f6341148167d9acce36d277a3", "ts": "1758581471.083759", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I'm getting \"cute idea but doesn't really make me addicted\" vibes.", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/612", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "ce9dadd940d56994109aa0e6798a8fc1", "ts": "1758581525.000559", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I think when we make this Play loud videos it's always watching how they play more then what they say", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/617", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "2e662aa1f3bb13b5a7a25a30c23ea3e9", "ts": "1758581560.579679", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I mostly look at their inputs and behaviors. It was like this in the first Playlist cloud too.", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/620", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "0219bb91cc9202494e17234fb7892297", "ts": "1758581597.133819", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "They probably tell them to comment on things or think out loud as a part of the guidelines", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/626", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "e6a91393854458ad70331ef478952136", "ts": "1758581651.167799", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "We should focus on figuring out why it doesn't give them a kick of joy to figure things out. So far, i haven't the clue", "channel": "C090N54TG79", "thread_ts": "1758581651.167799", "reply_count": 15, "reply_users_count": 2, "latest_reply": "1758582083.678989", "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/627", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "49b762ce78919b8573304cbec8c991c5", "ts": "1758581659.733259", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "But I keep watching :laughing:", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/636", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "f178ce2f72eca2d19b887bd728f20577", "ts": "1758581817.541299", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Well so far they didn't give me a halelujah this is a great hook for the game. I'm just happy the game is self explanatory enough", "channel": "C090N54TG79", "thread_ts": "1758581651.167799", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/637", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "ca1d19357107c9df1a1b1f7e225fb5cc", "ts": "1758581832.871979", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "We had that issue with DD, so we did better this time it seems", "channel": "C090N54TG79", "thread_ts": "1758581651.167799", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/644", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "3315ee71725aec08e7e9f10950d178b7", "ts": "1758582083.678989", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "It's still useful to watch their behavior. It's not too different from making a loved one play it. They are playing to please us and wouldn't touch it otherwise. And they react with how irritable they are in the moment :laughing:", "channel": "C090N54TG79", "thread_ts": "1758581651.167799", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/646", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "dc95b9fe11cbddad46115c52acf9730b", "ts": "1758582126.210789", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Well the platform is for figuring out what's wrong for your game so, that's fair, I guess.", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/673", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "da8eeaa5e5419ca3f43af0414f6ea6f6", "ts": "1758689839.300009", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Agreed, I will stop level making at 300 which I'm close to. But I want to have more content for September 30 release just in case :[USERNAME_26053]:", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/674", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "bbcc044c8321856232f1c2001dc85f48", "ts": "1758690035.923739", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I personally wouldn't sweat zombie scaling right now. The bigger issues are item size, and damage. Players seem to want a correlation between them. Can we squeeze the bigger HP bar thing in and see how that feels?", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "100", "users": ["EMPLOYEE_0016_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/697", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "b42f6c469bfe6c9fec4a2eae1be2a5f3", "ts": "1758809221.864789", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "It looks good, we just need to adjust the numbers", "channel": "C090N54TG79", "thread_ts": "1758796815.758229", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/705", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "555abc1961cd0f6a2479c6f6fec9309d", "ts": "1758825258.755199", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I like it", "channel": "C090N54TG79", "thread_ts": "1758796815.758229", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "+1", "users": ["EMPLOYEE_0016_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/732", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "58b22f2aff024c9f3d05b60e8839c5f3", "ts": "1759172119.133819", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Okay, I'll simplify it and make a level from just 2 ice-creams. What level did you decide to put it? By the way, I'll just throw my two cents for the record. In a funnel where we're questioning people's simplest blunders, throwing that mechanic will not do anything for the funnel and most likely affect it very negatively.", "channel": "C090N54TG79", "thread_ts": "1759172119.133819", "reply_count": 9, "reply_users_count": 1, "latest_reply": "1759172434.532439", "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/736", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "9b0dd8cbaaeb6bcbaa0793132abb656f", "ts": "1759172172.623159", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "That's for games that don't have multiple layers in the core.", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/738", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "ae59da021042950d02830b61f5d2ff52", "ts": "1759172197.310709", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "oki doki, I'll make the Push now", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/749", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "31f6f9c00890cfcf0e8cd2442cca86aa", "ts": "1759172367.979939", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "The main differentiating factor for this game is the zombies. This is a massive design mistake but I'll love to be Proven wrong", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/756", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "3d1964e6454a3e6c62f73053492974ca", "ts": "1759172516.511459", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "My comment is about Leonard's statement that \"differentiating factor of this game comes in too late\"", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/761", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "a322e19c7d32dd2259ece2d9c7b3aa55", "ts": "1759172603.417709", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "We can't simultenuosly make levels easier because people don't understand the blunder and make the game more appealing for hardcore players.", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/766", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "6a5f3f1582107431957144a2d35f3044", "ts": "1759172892.935369", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Again, if enrage is too complex for the average user, are we iterating for the average user or the hardcore user?", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/767", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "91492e4fa03bc5ea5f41f63ce4959607", "ts": "1759172937.229039", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I turned the level into this. This is just enough icecream to kill the chef. The level doesn't have the white icecream, I put it There to show how it look when the card is equipped and level is entered.", "channel": "C090N54TG79", "thread_ts": "1759172937.229039", "reply_count": 4, "reply_users_count": 2, "latest_reply": "1759173139.940419", "is_activity_message": false, "subtype": null, "reactions": [], "files": [{"created": 1759172901, "display_as_bot": false, "editable": false, "external_type": "", "file_access": "visible", "filetype": "png", "has_rich_preview": false, "id": "F09HNR80E0M", "is_external": false, "is_public": false, "is_starred": false, "media_display_type": "unknown", "mimetype": "image/png", "mode": "hosted", "name": "image.png", "original_h": 1636, "original_w": 1436, "permalink": "https://harmonygamesgroup.slack.com/files/EMPLOYEE_0038_SLACK_ID/F09HNR80E0M/image.png", "permalink_public": "https://slack-files.com/T04RZ2JAMM0-F09HNR80E0M-a443cde05c", "pretty_type": "PNG", "public_url_shared": false, "size": 1639637, "skipped_shares": true, "thumb_1024": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09HNR80E0M-123d836ae1/image_1024.png?t=xoxb-REDACTED", "thumb_1024_h": 1024, "thumb_1024_w": 899, "thumb_160": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09HNR80E0M-123d836ae1/image_160.png?t=xoxb-REDACTED", "thumb_360": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09HNR80E0M-123d836ae1/image_360.png?t=xoxb-REDACTED", "thumb_360_h": 360, "thumb_360_w": 316, "thumb_480": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09HNR80E0M-123d836ae1/image_480.png?t=xoxb-REDACTED", "thumb_480_h": 480, "thumb_480_w": 421, "thumb_64": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09HNR80E0M-123d836ae1/image_64.png?t=xoxb-REDACTED", "thumb_720": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09HNR80E0M-123d836ae1/image_720.png?t=xoxb-REDACTED", "thumb_720_h": 720, "thumb_720_w": 632, "thumb_80": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09HNR80E0M-123d836ae1/image_80.png?t=xoxb-REDACTED", "thumb_800": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09HNR80E0M-123d836ae1/image_800.png?t=xoxb-REDACTED", "thumb_800_h": 911, "thumb_800_w": 800, "thumb_960": "https://files.slack.com/files-tmb/T04RZ2JAMM0-F09HNR80E0M-123d836ae1/image_960.png?t=xoxb-REDACTED", "thumb_960_h": 960, "thumb_960_w": 843, "thumb_tiny": "AwAwACuuWJ6NjgfnTw6gDhW470zz5PUUefJ6iiw+bsPLAc9eenbvUhYhQYyoyRkD/wCvUHnyeoo8+T1FLlFzEskjbU+Yhuc4NOUrtG6Q592xUH2iT1FHnyeoo5QuRgU4A9iacBTwO/pVkAihRuc5/wBnJ5FR4b1P51KOSAB7UpA6UkxtFcrSYqUimYqhCg1KhG4Z6d6rg1Im0g7mx6UgJM9OeB2oLNtwScZzim4T5f3nX7w9KQqu4gSAjscUKwO73AmmZppNJmmB/9k=", "timestamp": 1759172901, "title": "image.png", "url_private": "https://files.slack.com/files-pri/T04RZ2JAMM0-F09HNR80E0M/image.png?token=xoxb-REDACTED", "url_private_download": "https://files.slack.com/files-pri/T04RZ2JAMM0-F09HNR80E0M/download/image.png?token=xoxb-REDACTED", "user": "EMPLOYEE_0005_SLACK_ID", "user_team": "T04RZ2JAMM0", "username": ""}], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/768", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "037dc6720a99bb0e39f1712dc8c54e09", "ts": "1759172950.703589", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I'll Push if this is good", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/773", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "830248adde0209a56901b20a54f55882", "ts": "1759173085.757379", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "<@EMPLOYEE_0016_SLACK_ID> Is this okay?", "channel": "C090N54TG79", "thread_ts": "1759172937.229039", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/775", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "6aa7abf4d8ce3ee9a8963791c135391c", "ts": "1759173115.631829", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Yep me too.", "channel": "C090N54TG79", "thread_ts": "1759172937.229039", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/776", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "c1cd390120667981d359d7f828629bae", "ts": "1759173139.940419", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Okay sending it the level design branch", "channel": "C090N54TG79", "thread_ts": "1759172937.229039", "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "+1", "users": ["EMPLOYEE_0016_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/777", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "2dc52b1b913d5c106b05085e056842f1", "ts": "1759173180.192809", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "<@EMPLOYEE_0026_SLACK_ID> You can work on  the tutorial level is There `[PERSON_NAME_0019]/sep30levels`", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "+1", "users": ["EMPLOYEE_0026_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/780", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "ff02c24c3e19207e205453aff531e11c", "ts": "1759173247.603649", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Also, you need to make the level ordering again. Before I did it manually but now we probably need some sort of script for it.", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/783", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "f595d9070003814c00aa0dcc9469460c", "ts": "1759173386.589489", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Yeah, I agree with [PERSON_NAME_0092]. We decided on a casual approach because liveops engine was going to be the backbone of the fundraising. I'm fine with iterating, obviously but but I don't understand why we're doing it for the hardcore players.", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/790", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "2bbb1f6dd6795a183e5da7827dfab478", "ts": "1759173509.076179", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "We never had a preference between casual or midcore, it was upto you guys. We're just reminding that we're doing multiple things for multiple targets.", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "100", "users": ["EMPLOYEE_0026_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/792", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "27097fd8e948abe150be9025119f4938", "ts": "1759173561.454829", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Needless to mention, I have 300 casual levels and nothing geared to midcore play", "channel": "C090N54TG79", "thread_ts": "1759173561.454829", "reply_count": 4, "reply_users_count": 1, "latest_reply": "1759173667.219099", "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/793", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "09f0c50228a8a896daf15e34a6d93819", "ts": "1759173632.306909", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "If you're confident we should yolo, it's just one test and one level swap, cheaper then A/B", "channel": "C090N54TG79", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/804", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "b825c48ad4aa4ec437e3edd70e16953b", "ts": "1759173698.236239", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "For one thing we'd make the levels so that they would have deck building blocks and not put the baseline at CPM and win streak free win.", "channel": "C090N54TG79", "thread_ts": "1759173698.236239", "reply_count": 2, "reply_users_count": 1, "latest_reply": "1759173795.560059", "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "+1::skin-tone-3", "users": ["EMPLOYEE_0038_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C090N54TG79/2025-09.json", "pointer": "/807", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "6c5d035b0ec8e62606caec2579f46768", "ts": "1759173778.362129", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Very well, in that case, from now on if someone complains a level is \"too hard\" I'll just ignore them :smile:", "channel": "C090N54TG79", "thread_ts": "1759173778.362129", "reply_count": 1, "reply_users_count": 1, "latest_reply": "1759173807.722729", "is_activity_message": false, "subtype": null, "reactions": [{"count": 2, "name": "joy", "users": ["EMPLOYEE_0012_SLACK_ID", "EMPLOYEE_0026_SLACK_ID"]}, {"count": 1, "name": "100", "users": ["EMPLOYEE_0012_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C09ATAJ220H/2025-09.json", "pointer": "/7", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "61d29d583d9efd2e2bcac82fd8203720", "ts": "1756913816.320139", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Can you try making it more of a throw instead of touching with a wand?", "channel": "C09ATAJ220H", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 2, "name": "+1", "users": ["EMPLOYEE_0033_SLACK_ID", "EMPLOYEE_0002_SLACK_ID"]}, {"count": 1, "name": "100", "users": ["EMPLOYEE_0002_SLACK_ID"]}], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C165CC59D478/2025-09.json", "pointer": "/5", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "8de0995632bea5fdb2e1a09e5b7477e0", "ts": "1757436639.093759", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Did anyone make changes to level 11", "channel": "C165CC59D478", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C165CC59D478/2025-09.json", "pointer": "/10", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "77f2fcd9487953c5cc7405b5fd96fe1f", "ts": "1757436727.769109", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Okay, I'll fix that one", "channel": "C165CC59D478", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C165CC59D478/2025-09.json", "pointer": "/11", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "69f45f1dec83716d0eb6ceea33a0e8c7", "ts": "1757436749.216099", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "We really need to stop using time ranges", "channel": "C165CC59D478", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C165CC59D478/2025-09.json", "pointer": "/13", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "ca219b0321a005b71e4f7daab24a493b", "ts": "1757438301.842579", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Like for example 5 monsters to spawn in within 20-40 range", "channel": "C165CC59D478", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C165CC59D478/2025-09.json", "pointer": "/14", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "fab4c4bbdc1201a8039bb92d1e160d81", "ts": "1757438314.477999", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "They make those problematic levels even more volatile", "channel": "C165CC59D478", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C165CC59D478/2025-09.json", "pointer": "/20", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "f2249e3e1b9368ea784e5b2e43a4e0ee", "ts": "1757438486.274719", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I feel better spawning them at exact times, works better for me personally", "channel": "C165CC59D478", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C165CC59D478/2025-09.json", "pointer": "/21", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "9eb31e405207d27d1052fd9921760d6f", "ts": "1757438517.210709", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Otherwise, especially if There are splash items things can get volatile.", "channel": "C165CC59D478", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C165CC59D478/2025-09.json", "pointer": "/24", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "183ff499db8ade4437c48f4686d96979", "ts": "1757438605.497519", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Maybe I'm not using it properly, I'll try more when I have some free time", "channel": "C165CC59D478", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C51199DFF013/2025-09.json", "pointer": "/0", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "af7a451e6d1ce34cd7aa323b9c6c3938", "ts": "1756716272.559509", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I'm happy to talk with him and address his concerns going through examples.", "channel": "C51199DFF013", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C51199DFF013/2025-09.json", "pointer": "/1", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "14b86634faaf9e726ef8b965ae022353", "ts": "1756716283.314419", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I'll shoot him a meeting for tomorrow", "channel": "C51199DFF013", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C7C55336DE44/2025-09.json", "pointer": "/0", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "098e05ffc16d901b125067af006db7e2", "ts": "1756813095.328219", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Hey, guys. Starting this group chat for animations we need for the intro popup screens", "channel": "C7C55336DE44", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C7C55336DE44/2025-09.json", "pointer": "/1", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "c77fbb17ecab1bfe8528af01369515f2", "ts": "1756813123.423419", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "I think you guys have some ideas already. For me, I'm okay if they look visually appealing.", "channel": "C7C55336DE44", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C7C55336DE44/2025-09.json", "pointer": "/5", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "634bddf416bce4eadd5b17a02faacd64", "ts": "1756813285.525639", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "<@EMPLOYEE_0002_SLACK_ID> Can you advice something when you come online?", "channel": "C7C55336DE44", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C7C55336DE44/2025-09.json", "pointer": "/8", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "6c9afb78b9604747d8517db17ce67d77", "ts": "1756813348.944419", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "He also wants the text animated but I don't know how we can do that with blind and multishot etc so I think we can do your approach it's better", "channel": "C7C55336DE44", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C7C55336DE44/2025-09.json", "pointer": "/42", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "45160184678497e7bcf9fa3a77907520", "ts": "1756821158.962959", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "<@EMPLOYEE_0002_SLACK_ID> Its [PERSON_NAME_0022]'s task you can sync with him to decide what scene to use", "channel": "C7C55336DE44", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C7C55336DE44/2025-09.json", "pointer": "/45", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "8e6b61c476dce4612932ca06765ea1d5", "ts": "1756821358.856289", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "After prelevel dialogue", "channel": "C7C55336DE44", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C7C55336DE44/2025-09.json", "pointer": "/46", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "e6723bea8f52bf454c506bf49956a428", "ts": "1756821370.980939", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Before level start", "channel": "C7C55336DE44", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/C7C55336DE44/2025-09.json", "pointer": "/47", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "10aa683b7f3b81df2def98400528a7c8", "ts": "1756821386.652659", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "We asked it to be a part of the FTUE", "channel": "C7C55336DE44", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-09.json", "pointer": "/15", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "7b34b13d9ee220a4c93732548707295d", "ts": "1756889161.637999", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "[USERNAME_47573] ate\u015fim \u00e7\u0131kt\u0131", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-09.json", "pointer": "/16", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "731212bf870d283705ab2cb6e8a5a494", "ts": "1756889175.395479", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "1-2 saat daha direnicem ama izin al\u0131cam muhtemelen", "channel": "CC43664F351E", "thread_ts": "1756889175.395479", "reply_count": 2, "reply_users_count": 2, "latest_reply": "1756897032.392159", "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-09.json", "pointer": "/19", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "64916839a3c6b907a26e87100e2d3849", "ts": "1756889273.612899", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Aynen \u00f6yle", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-09.json", "pointer": "/20", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "0ea576760d2b0b871b6b17ecc408c7dd", "ts": "1756890040.154879", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Sizin kartlara \u00e7ekti\u011finiz yeni ayar ne \u015fimdi?", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-09.json", "pointer": "/21", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "f86dff77ec781497837777cb53f95d90", "ts": "1756890047.842419", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "[PERSON_NAME_0054] rare \u00e7ok artt\u0131 falan yazm\u0131\u015f", "channel": "CC43664F351E", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}}, {"file": "HarmonyGames_Other_Services/Services_Data/slack/messages/CC43664F351E/2025-09.json", "pointer": "/27", "field": "user", "value": "EMPLOYEE_0005_SLACK_ID", "record": {"id": "5ddfb600a679a8eccdc3d59dabef499b", "ts": "1756897032.392159", "type": "message", "user": "EMPLOYEE_0005_SLACK_ID", "text": "Eyvallah [USERNAME_38880]", "channel": "CC43664F351E", "thread_t