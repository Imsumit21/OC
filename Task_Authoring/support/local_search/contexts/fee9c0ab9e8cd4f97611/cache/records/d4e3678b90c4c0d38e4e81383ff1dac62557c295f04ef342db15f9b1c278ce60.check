{"signature": "3827ffbf3f748cd43d8908d171a2491c7d7f504472330adaa669ff6b0ec99f0e", "result": {"checks": {"check": {"scope": {"id": "check", "service": "linear", "file": "data.json", "pointer": "/issues", "field": "assignee_id", "values": ["usr_8140f09bf9f1b94c"]}, "matches": [{"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/599", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-108", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": null, "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-108", "number": 108, "title": "Nathan Tutorial", "description": "We need a tutorial for Nathan. When players first get a Nathan token, that's when it will trigger the start of the FTUE specifically for Nathan\n\n1. After they get their first Nathan token, we show them how to unlock\n2. We then make them go to a pre level dialog, and show them how to change character on that dialog\n\nFlow is something like:\n\n1. User receives Nathan token\n2. \"Congrats, I think we have enough to unlock Nathan to help us on our journey, let's go to the character home\"\n3. \"This is how you unlock a new character once you have collected enough tokens!\"\n4. \"Nathan is now unlocked, let's return to our adventure and see what Nathan can do for us!\"\n5. Player gets redirected back to Saga map, we prompt a pre level dialog and we say \"Oh oops, we forgot to actually bring Nathan along for the ride, we can quickly change characters here\"\n6. We show them how to change characters from pre-level dialog.\n7. We make them play a level with Nathan\n8. At beginning of that level, we highlight the streak bar and streak bonus icon on bottom and say \"Remember, different characters have different abilities! Pay attention and see what Nathan can do!\"\n\nEnd tutorial.", "priority": 3, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-06-13T15:05:11Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 878669, "labels": ["FTUE"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-04-22T05:48:39Z", "updated_at": "2024-06-13T15:05:11Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/601", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-11", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "EPI-20", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-11", "number": 11, "title": "Define Streak System Detailed Mechanics in GDD", "description": "Explained Here: [[URL_13518])", "priority": 2, "estimate": null, "due_date": null, "started_at": "2023-08-03T18:15:09Z", "completed_at": "2023-08-03T21:34:11Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1331880, "labels": ["Streak System", "UI/UX"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-08-03T18:13:12Z", "updated_at": "2023-08-09T00:14:56Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/602", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-110", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "ENG-848", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-110", "number": 110, "title": "In Depth River Tile Game FTUE", "description": "Instead of just a simple one text box FTUE for river tile game, let's break it down into step by step full FTUE with explicit instructions.", "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-06-13T15:18:00Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 878656, "labels": ["FTUE"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-04-22T06:07:54Z", "updated_at": "2024-06-13T15:18:00Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/603", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-111", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "ENG-848", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-111", "number": 111, "title": "New Vanishing Tile FTUE", "description": "Let's force the player to \"fail\" matching a vanishing tile.\n\nWe create a level where vanishing tile is impossible to be matched (we hand code this)\n\nHowever players CAN still use wild tiles to force match the vanishing tile. If this happens, this event based tutorial is omitted and marked as complete so it will not cause other errors.\n\nIn the case this tutorial does trigger, what we want is to have vanishing tile disappear on the player, and have them witness their hand tiles being stolen. We also use text prompt to explain what has transpired so they have a full understanding of vanishing tile.", "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-06-13T15:17:54Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 878656, "labels": ["FTUE"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-04-22T06:10:13Z", "updated_at": "2024-06-13T15:17:54Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/604", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-112", "project_id": null, "team_id": "team_DES", "parent_id": null, "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_65c76e0b87aa7e9b", "state_id": "Done", "cycle_id": null, "identifier": "DES-112", "number": 112, "title": "List Events & Triggers for Leonardo Tutorials", "description": "'- [ ] Nathan Unlock Tutorial\n- [X] Vanishing Tile Tutorial\n- [X] Conveyor Belt Tutorial\n- [X] Time Boost Tutorial (?)\n- [X] Ability to dim, highlight or change radius of advanced tiles, right? @julia.lawson \n- [X] New dialogue boxes", "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-06-13T15:04:37Z", "canceled_at": null, "archived_at": "2024-12-14T07:20:23Z", "time_in_status_minutes": 878670, "labels": ["Sprint 17 - May 10th", "Gameplay"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-04-22T13:09:43Z", "updated_at": "2024-06-13T15:04:37Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/608", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-116", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": null, "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "DES-116", "number": 116, "title": "Making Layouts", "description": "Make Layouts For 1200 Levels", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-06-13T15:35:29Z", "completed_at": "2024-07-05T10:47:41Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 847247, "labels": ["Sprint 20 - July 5th"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-06-13T15:35:29Z", "updated_at": "2024-07-05T10:47:41Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/609", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-117", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "DES-116", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "DES-117", "number": 117, "title": "