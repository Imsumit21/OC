, "state_id": "Done", "cycle_id": null, "identifier": "DES-143", "number": 143, "title": "Create Puzzles For 1200 Levels", "description": null, "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-06-13T15:40:59Z", "completed_at": "2024-07-05T10:56:36Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 847238, "labels": ["Sprint 20 - July 5th", "Gameplay"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-06-13T15:40:59Z", "updated_at": "2024-07-05T10:56:36Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/639", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-144", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": null, "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Canceled", "cycle_id": null, "identifier": "DES-144", "number": 144, "title": "QA Puzzles", "description": "QA 1200 levels for difficulty nodes, objectives, and board/deck tile", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-06-13T15:43:42Z", "completed_at": null, "canceled_at": "2025-05-05T17:35:14Z", "archived_at": null, "time_in_status_minutes": 409079, "labels": ["Sprint 20 - July 5th"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-06-13T15:43:42Z", "updated_at": "2025-05-05T17:35:14Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/640", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-145", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": null, "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-145", "number": 145, "title": "Extend Chapter Selection Tutorial", "description": "So after they finish chapter 1, let's put them on rails and force them to go to selection screen, select chapter 2, and enter it there and then have assist start prompt them the pre-level dialogue.\n\nThis is to minimize any drop offs.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-06-13T17:13:28Z", "completed_at": "2024-07-10T12:46:55Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 839927, "labels": ["FTUE"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-06-13T17:13:27Z", "updated_at": "2024-07-10T12:46:55Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/646", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-150", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "ENG-1047", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-150", "number": 150, "title": "Create a train level in editor", "description": "Create test level for train\n\nPolish level", "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-07-05T10:47:31Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 847247, "labels": ["Sprint 21 Baklava - Aug 2nd", "Main Game"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-06-26T15:27:47Z", "updated_at": "2024-07-19T01:25:32Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/689", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-19", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "DES-7", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-19", "number": 19, "title": "Design Conveyor Belt Lore and Background", "description": "Hey guys, some lore ideas for the minigames. I hope they can serve as a jumping point for us. Please give me your feedback and tell me what you think! ^^\n\n1. **Saga Map - Minigame Lore Fit**\n   We can make mini game lores corresponding with the saga map they will appear on.\n\nBackground: Tiles flowing on a river in the Mushroom village.\n\nOur mushroom village has residents that look like the Toad as a throwback to classic Mario series. These little tricksters can be seen carrying tiles to the river.\n\n**2\\. Universal Lore Fit**\n\nSince we\u2019re aiming for a natural theme without any industrial elements we can skip lore for each mini game and have them appear in different sections of the game like rivers, clouds, forests, etc.\n\nExample: We can have a cloud theme where tiles simply fly, or we can add a wind element that\u2019s supposedly moving the tiles in our direction.\n\n**3\\. Universal Lore Sectional Fit**\n\nMinigames can be a lore of their own. In the GoD Universe lives fairy-like creatures who like to present challenges for the players. In this case, all mini games will have the same lore, and background will be magical forest scenes for all of them.", "priority": 2, "estimate": null, "due_date": "2023-08-11", "started_at": "2023-08-07T17:27:17Z", "completed_at": "2023-08-11T12:58:09Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1310589, "labels": ["Sprint 1 - August 18th", "Mini Game"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-08-07T17:24:35Z", "updated_at": "2023-08-18T16:25:00Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/693", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-20", "project_id": null, "team_id": "team_DES", "parent_id": null, "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Canceled", "cycle_id": null, "identifier": "DES-20", "number": 20, "title": "Move UX to the general Figma Board", "description": "Per our agreement with the art team, we will move our UX after they've been approved. They will be as rough mock-ups. The elements are listed as subtasks and will take priority after documentation organization for Sprint 1 - August 18th. \n\nSandbox Figma board: \n\n[[URL_13522])\n\nGoD Figma Board: \n\n[[URL_13521])", "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": null, "canceled_at": "2023-08-18T16:55:10Z", "archived_at": "2024-02-19T00:06:31Z", "time_in_status_minutes": 1310559, "labels": ["Sprint 1 - August 18th", "UI/UX"], "links": [], "relations": [], "is_archived": true, "created_at": "2023-08-07T21:53:53Z", "updated_at": "2023-08-18T16:55:10Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/695", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-22", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "DES-23", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "DES-22", "number": 22, "title": "Rethink Vanishing tile", "description": "We have a concern with our vanishing tile. We need to think of elevating it or creating some alternatives for it", "priority": 0, "estimate": null, "due_date": "2023-08-18", "started_at": "2023-08-10T15:56:31Z", "completed_at": "2023-08-16T14:52:47Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1310181, "labels": ["Sprint 1 - August 18th", "Main Game"], "links": [], "relations": [{"target": "ENG-620", "type": "relates"}], "is_archived": false, "created_at": "2023-08-09T21:46:31Z", "updated_at": "2024-03-12T17:52:31Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/726", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-262", "project_id": null, "team_id": "team_DES", "parent_id": null, "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_fc22d5941b2aeb5c", "state_id": "Canceled", "cycle_id": null, "identifier": "DES-262", "number": 262, "title": "Profil Spec Tutorial", "description": "[[URL_50704])", "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": null, "canceled_at": "2025-04-29T11:55:10Z", "archived_at": "2025-10-30T03:03:01Z", "time_in_status_minutes": 418059, "labels": [], "links": [], "relations": [], "is_archived": true, "created_at": "2024-08-21T15:50:22Z", "updated_at": "2025-04-29T11:55:10Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/734", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-27", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "DES-23", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-27", "number": 27, "title": "Design FTUE", "description": "Working doc [HERE]([URL_13524])\n\nPossibly might need to be broken down into sub tasks.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2024-01-03T06:04:02Z", "completed_at": "2024-01-15T18:41:32Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1094453, "labels": ["Submission Blocker", "Improvement", "Main Game"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-08-10T20:22:58Z", "updated_at": "2024-01-15T18:41:33Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/746", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-281", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": null, "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-281", "number": 281, "title": "Add pop-up screen after chapter 2 level 6 for mini-game", "description": "So we used to have a tutorial pop up when mini games are unlocked. It's no longer there. Now that we unlock memory and river tile game after chapter 2 level 6, can we show a tutorial on the saga map again where it said something like \"You've unlocked mini games!\"\n\n@Leonard said:\n\n> Show a pop-up screen after chapter 2 level 6 (mini-game unlocked) that pop-up goes away when player either hit the x button. The pop-up has 2 options, play mini-games OR stay. Hitting X is the same as \u201cstay\u201d", "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-10-14T18:47:12Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 701327, "labels": ["Bug"], "links": [], "relations": [], "is_archived": false, "created_at": "2024-09-13T18:57:15Z", "updated_at": "2024-10-14T18:47:12Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/758", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-293", "project_id": null, "team_id": "team_DES", "parent_id": null, "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Canceled", "cycle_id": null, "identifier": "DES-293", "number": 293, "title": "Organize Localization Files Better", "description": "Organize localization file", "priority": 1, "estimate": null, "due_date": null, "started_at": null, "completed_at": null, "canceled_at": "2025-04-15T11:20:07Z", "archived_at": "2025-10-16T02:49:34Z", "time_in_status_minutes": 438254, "labels": [], "links": [], "relations": [], "is_archived": true, "created_at": "2024-10-14T18:57:25Z", "updated_at": "2025-04-15T11:20:07Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/759", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-294", "project_id": null, "team_id": "team_DES", "parent_id": null, "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Canceled", "cycle_id": null, "identifier": "DES-294", "number": 294, "title": "FTUE Improvements", "description": "Organize the alltutorials.json \n~~Chapter 1 end tutorial (input blocker)~~\n~~Vanishing Tile Tutorial (block the deck)~~\n~~Tutorial wishlist (multiple highlight)~~\n~~Enter proper event names~~ \n~~Check all fade boxes~~ \nTutorial editor document \nUpdate tutorial master sheet", "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": null, "canceled_at": "2025-04-29T11:55:10Z", "archived_at": "2025-10-30T03:03:01Z", "time_in_status_minutes": 418059, "labels": [], "links": [], "relations": [], "is_archived": true, "created_at": "2024-10-14T19:00:51Z", "updated_at": "2025-04-29T11:55:10Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/760", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-295", "project_id": null, "team_id": "team_DES", "parent_id": null, "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "DES-295", "number": 295, "title": "Check Individual Data for the early funnel", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-10-28T15:48:54Z", "canceled_at": null, "archived_at": "2025-04-29T08:10:20Z", "time_in_status_minutes": 681345, "labels": ["Data"], "links": [], "relations": [], "is_archived": true, "created_at": "2024-10-14T19:01:46Z", "updated_at": "2024-10-28T15:48:54Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/761", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-296", "project_id": null, "team_id": "team_DES", "parent_id": null, "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "In Review", "cycle_id": null, "identifier": "DES-296", "number": 296, "title": "Bot Discussion With Joe", "description": "Finalize the list of features \nRemote Difficulty", "priority": 0, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-10-28T15:49:00Z", "canceled_at": null, "archived_at": "2025-04-29T08:10:21Z", "time_in_status_minutes": 681345, "labels": [], "links": [], "relations": [], "is_archived": true, "created_at": "2024-10-14T19:03:09Z", "updated_at": "2024-10-28T15:49:00Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/789", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-42", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "DES-45", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-42", "number": 42, "title": "Record Statistics on Symbols Frequency", "description": "Let's see if there are weights involved with the frequency of each symbols appearing.\n\nGoogle doc [HERE]([URL_13532]) tracking this.", "priority": 0, "estimate": null, "due_date": null, "started_at": "2023-08-11T17:24:29Z", "completed_at": "2023-08-23T04:54:53Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1290398, "labels": ["Puzzle Editor", "Sprint 1 - August 18th"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-08-11T17:24:28Z", "updated_at": "2023-09-04T18:13:41Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/790", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-43", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "EPI-9", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-43", "number": 43, "title": "Design Tasks for Puzzle Editor", "description": null, "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2024-01-26T17:07:58Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1078706, "labels": ["Puzzle Editor"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-08-11T17:38:13Z", "updated_at": "2024-01-26T17:07:59Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/791", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-44", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "DES-43", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-44", "number": 44, "title": "Create nomenclature on level naming", "description": "How do we want to name the levels in the file output? We want level #, but what else? If it's FTE do we want to label it? If it's boss level/hard level do we want to label it? Let's decide on a naming scheme that captures all the useful information while not overwhelming the name.\n\nMight want to consult with Blake as well.", "priority": 2, "estimate": null, "due_date": null, "started_at": null, "completed_at": "2023-08-16T13:24:48Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1290398, "labels": ["Puzzle Editor"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-08-11T17:44:56Z", "updated_at": "2023-09-01T16:56:17Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/792", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-45", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "DES-43", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-45", "number": 45, "title": "Define parameters needed for the JSON file output", "description": "Star objectives, what's 2 star, 3 star? We need to specify this in JSON\n\nIf we do things other than number of tiles left in draw pile, what are they? Need to define those in the star system design. Need to be unblocked by other ticket first.\n\nDetails in related ticket [HERE](https://linear.app/harmonygames-games/issue/DES-37/star-system-objectives-list)", "priority": 2, "estimate": null, "due_date": "2023-08-18", "started_at": "2023-08-11T19:55:19Z", "completed_at": "2023-08-16T13:27:16Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1310179, "labels": ["Puzzle Editor", "Sprint 1 - August 18th"], "links": [], "relations": [{"target": "DES-37", "type": "blocks"}], "is_archived": false, "created_at": "2023-08-11T17:46:23Z", "updated_at": "2023-08-18T23:15:23Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/795", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-48", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "DES-47", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-48", "number": 48, "title": "Win Streak Mechanics and UI", "description": "How does win streak impact repeat play that we are allowing? How does the mechanic here work? Is this going into Alpha?\n\nSome of the win streak boosts we can provide:\n\nRandomly convert a tile into an explosive dynamite tile\n\nRandomly flip a tile face up\n\nPretty much any character abilities/advance tiles can be part of the win streak boosts.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2023-08-18T16:48:45Z", "completed_at": "2023-09-01T16:58:41Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1265164, "labels": ["Sprint 2 - September 1st", "Main Game"], "links": [], "relations": [{"target": "ART-100", "type": "relates"}], "is_archived": false, "created_at": "2023-08-15T22:16:26Z", "updated_at": "2023-09-19T05:30:06Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/797", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-50", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "EPI-5", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-50", "number": 50, "title": "Decide on Mini Game #2", "description": "We will be building the \"memory\" game as our second mini game, using domino tiles.", "priority": 2, "estimate": null, "due_date": "2023-08-23", "started_at": "2023-08-17T17:51:29Z", "completed_at": "2023-08-23T04:54:58Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1291382, "labels": ["Sprint 2 - September 1st", "Mini Game"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-08-16T20:49:41Z", "updated_at": "2023-09-01T00:31:52Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/799", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-52", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "ENG-38", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-52", "number": 52, "title": "Tweak Puzzle Sequence Difficulty Using Symbol Weights", "description": "Goal is to create two new tweakable parameters that can affect level difficulty:\n\n1) Board pieces symbol frequency weights\n\n2) Draw pieces symbol frequency weights\n\nDocumentation on symbol weights can be found [HERE]([URL_13532])\n\nConclusion:\n\nBoard pieces \u2192 Weighted, approximate distribution from most to least:\n\n| 15.42% |\n| 13.24% |\n| 12.23% |\n| 11.26% |\n| 10.48% |\n| 9.88% |\n| 8.90% |\n| 7.70% |\n| 6.14% |\n| 4.74% |\n\nDraw pile pieces \u2192 Weighted, approximate distribution from most to least:\n\n| 18.75% |\n| 15.42% |\n| 13.13% |\n| 12.29% |\n| 9.79% |\n| 9.38% |\n| 7.71% |\n| 6.46% |\n| 4.58% |\n| 2.50% |\n\nI propose we create a few levels using any level on the map to do the following level tests:\n\n1. The weights of the draw pile matches the weights of the board pieces. With same weights on same symbols.\n2. The weights of the draw pile matches the weights of the board pieces. With different weights on DIFFERENT symbols. Let's try the complete inverse, meaning the heaviest weighted board piece is the least weighted piece in the draw pile and so on\u2026\n3. The weights of the draw pile is equally random, 10% chance per symbol. ZERO weights.\n4. The weights of the draw pile is more concentrated (more skewed) like it is in our data set, where the top frequency of the draw pile exceed those of the board. Matching symbols. We can maybe shift 20% of each weights to the heavier weights. So if A, B, C is 18%, 15%, 12%, then after weight shifted it A is now 18% + (15% \\* 0.2) = 21%\n\n   B is now 12% (3% went to A) + (12% \\* 0.2) = 14.4%\n\n   C is now 9.6% (2.4% went to B) + (D \\* 0.2) = \u2026.\n\n   So on..\n5. The weights of the draw pile is less concentrated, where the top frequency symbol in the draw pile is significantly lower than the frequency of that same symbol in the board pieces. Same as #4 but shift everything to the right by 20%.", "priority": 0, "estimate": null, "due_date": null, "started_at": "2023-09-19T05:31:12Z", "completed_at": "2023-09-22T17:09:07Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1265524, "labels": ["Sprint 4 - September 29th", "Main Game"], "links": [], "relations": [{"target": "DES-63", "type": "relates"}], "is_archived": false, "created_at": "2023-08-18T16:34:58Z", "updated_at": "2023-09-22T17:09:07Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/800", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-53", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "DES-46", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-53", "number": 53, "title": "Write a detailed engineering GDD for Star System Objectives List", "description": null, "priority": 3, "estimate": null, "due_date": null, "started_at": "2023-08-28T16:22:41Z", "completed_at": "2023-08-30T17:20:55Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1265164, "labels": ["Sprint 2 - September 1st", "World Map"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-08-18T16:45:47Z", "updated_at": "2023-09-19T05:29:57Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/801", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-54", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "EPI-6", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-54", "number": 54, "title": "Create the first 10 levels of main game", "description": "Revised to 10 levels because some editor feature isn't robust enough, mostly features involving layering (parent/child).", "priority": 1, "estimate": null, "due_date": "2023-09-01", "started_at": "2023-08-30T17:21:04Z", "completed_at": "2023-09-01T14:17:43Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1290398, "labels": ["Puzzle Editor", "Sprint 2 - September 1st", "Main Game"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-08-18T16:51:10Z", "updated_at": "2023-09-01T16:56:44Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/802", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-56", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "EPI-6", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-56", "number": 56, "title": "Design Tasks for FTUE", "description": "We currently have a simple wireframe [HERE]([URL_13524])\n\nIt does list the various steps we want in the FTUE. However we do not have the layout ready, so that should be a sub task, but I think that's also related to designing the first 30 levels.", "priority": 2, "estimate": null, "due_date": null, "started_at": "2023-08-23T04:46:20Z", "completed_at": "2023-08-28T16:22:38Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1265164, "labels": ["Sprint 2 - September 1st", "Main Game"], "links": [], "relations": [{"target": "DES-54", "type": "blocks"}], "is_archived": false, "created_at": "2023-08-21T08:17:30Z", "updated_at": "2023-09-19T05:30:04Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/803", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-57", "project_id": null, "team_id": "team_DES", "parent_id": null, "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "DES-57", "number": 57, "title": "Make 3 test levels for Wednesday's Test", "description": "A few levels for testing tiles", "priority": 0, "estimate": null, "due_date": null, "started_at": "2023-08-22T15:39:13Z", "completed_at": "2023-08-23T14:42:13Z", "canceled_at": null, "archived_at": "2024-03-01T00:37:08Z", "time_in_status_minutes": 1291382, "labels": ["Levels", "Sprint 2 - September 1st"], "links": [], "relations": [], "is_archived": true, "created_at": "2023-08-22T15:39:13Z", "updated_at": "2023-09-01T00:32:09Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/804", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-58", "project_id": null, "team_id": "team_DES", "parent_id": null, "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "DES-58", "number": 58, "title": "Balance Conveyor Belt", "description": "Iterate and balance conveyor belt to be ready for the final test", "priority": 0, "estimate": null, "due_date": null, "started_at": "2023-08-22T15:39:43Z", "completed_at": "2023-08-23T14:42:15Z", "canceled_at": null, "archived_at": "2024-03-01T00:37:09Z", "time_in_status_minutes": 1291382, "labels": ["Sprint 2 - September 1st", "Mini Game"], "links": [], "relations": [], "is_archived": true, "created_at": "2023-08-22T15:39:43Z", "updated_at": "2023-09-01T00:32:08Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/809", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-63", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "DES-42", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-63", "number": 63, "title": "Create ~5 Test Levels With modified tile weights", "description": "I would say this can be part of the play test on Wednesday, September 13th\n\nDocument of findings can be found [HERE]([URL_13532]), but does not need to be read. See below for test plan.\n\nConclusion:\n\nBoard pieces \u2192 Weighted, approximate distribution from most to least:\n\n| 15.42% |\n| 13.24% |\n| 12.23% |\n| 11.26% |\n| 10.48% |\n| 9.88% |\n| 8.90% |\n| 7.70% |\n| 6.14% |\n| 4.74% |\n\nDraw pile pieces \u2192 Weighted, approximate distribution from most to least:\n\n| 18.75% |\n| 15.42% |\n| 13.13% |\n| 12.29% |\n| 9.79% |\n| 9.38% |\n| 7.71% |\n| 6.46% |\n| 4.58% |\n| 2.50% |\n\nI propose we create a few levels using any level on the map to do the following level tests:\n\n1. The weights of the draw pile matches the weights of the board pieces. With same weights on same symbols.\n2. The weights of the draw pile matches the weights of the board pieces. With different weights on DIFFERENT symbols. Let's try the complete inverse, meaning the heaviest weighted board piece is the least weighted piece in the draw pile and so on\u2026\n3. The weights of the draw pile is equally random, 10% chance per symbol. ZERO weights.\n4. The weights of the draw pile is more concentrated (more skewed) like it is in our data set, where the top frequency of the draw pile exceed those of the board. Matching symbols. We can maybe shift 20% of each weights to the heavier weights. So if A, B, C is 18%, 15%, 12%, then after weight shifted it A is now 18% + (15% \\* 0.2) = 21%\n\n   B is now 12% (3% went to A) + (12% \\* 0.2) = 14.4%\n\n   C is now 9.6% (2.4% went to B) + (D \\* 0.2) = \u2026.\n\n   So on..\n5. The weights of the draw pile is less concentrated, where the top frequency symbol in the draw pile is significantly lower than the frequency of that same symbol in the board pieces. Same as #4 but shift everything to the right by 20%.\n\nOther notes:\n\nEach level has 12 draw pieces, including the starting piece that's already drawn and face up. We need a layout that has \\~24 pieces.\n\nWe can use a same layout we all agree on, I would say on average it should have 3-4 tiles facing up at beginning of the level, maybe @julia.lawson can just use one of her levels.\n\nWe can maybe test this at level 10, 11, 12, 13, 14, 15, to not interfere with other levels we are testing in the first 10 levels.", "priority": 3, "estimate": null, "due_date": "2023-09-22", "started_at": "2023-09-19T05:31:43Z", "completed_at": "2023-10-09T16:07:28Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1235727, "labels": ["Puzzle Engine", "Sprint 4 - September 29th", "Main Game"], "links": [], "relations": [{"target": "DES-52", "type": "relates"}], "is_archived": false, "created_at": "2023-08-23T03:58:50Z", "updated_at": "2023-10-09T16:07:28Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/810", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-64", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "EPI-6", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-64", "number": 64, "title": "Create around ~5 levels testing variations in # of branches and other tweakable parameters in today's puzzle editor.", "description": "As discussed let's create 5 levels maybe 10-14 on the world map by messing with the extreme values on the tweakable parameters in the puzzle editor. For example the # of branches. What happens if we have 0 vs. let's say 6? Go up to 10 levels if we must. We should know behind the scenes what the parameters are set at, and we play test this next Wednesday September 6th middle of sprint 3 and gather feedback on difficulty and feelings from internal people.", "priority": 2, "estimate": null, "due_date": "2023-09-06", "started_at": "2023-09-06T10:51:12Z", "completed_at": "2023-09-06T19:55:11Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1283019, "labels": ["Sprint 3 - September 15th", "Main Game"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-09-01T00:37:54Z", "updated_at": "2023-09-06T19:55:11Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/812", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-66", "project_id": null, "team_id": "team_DES", "parent_id": null, "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "DES-66", "number": 66, "title": "Create 30 Levels for FF Build", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": "2023-09-08T16:55:34Z", "completed_at": "2023-09-14T13:31:52Z", "canceled_at": null, "archived_at": "2024-03-15T00:37:19Z", "time_in_status_minutes": 1271882, "labels": ["Levels"], "links": [], "relations": [], "is_archived": true, "created_at": "2023-09-08T16:55:34Z", "updated_at": "2023-09-14T13:31:52Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/813", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-67", "project_id": null, "team_id": "team_DES", "parent_id": null, "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-67", "number": 67, "title": "FTUE Levels and overall design", "description": "We have to take this doc here: [[URL_13547])\n\nAnd distill it into components/elements for engineers to build for example:\n\n\\-Hovering Hand\n\n\\-Dimming Curtains\n\n\\-Text Overlay\n\n\\-Preload Specific Items Into Inventory\n\nThen as we create the tutorial, we specify the triggers (I.E app launch, level 2 complete, first time running out of moves, etc.)\n\nEach tutorial will consist of:\n\n1) The trigger\n\n2) The steps where each component is invoked and how it's used.", "priority": 0, "estimate": null, "due_date": null, "started_at": "2023-09-22T17:09:25Z", "completed_at": "2023-09-27T16:44:45Z", "canceled_at": null, "archived_at": "2024-03-28T00:47:34Z", "time_in_status_minutes": 1252970, "labels": ["Main Game"], "links": [], "relations": [], "is_archived": true, "created_at": "2023-09-15T16:47:22Z", "updated_at": "2023-09-27T16:44:45Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/814", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-68", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "DES-23", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-68", "number": 68, "title": "Think About F&F Metrics We Want to Collect", "description": "We add them [HERE]([URL_13548])", "priority": 0, "estimate": null, "due_date": null, "started_at": "2023-09-18T14:18:03Z", "completed_at": "2023-09-22T17:09:06Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1260145, "labels": ["Sprint 4 - September 29th", "Main Game"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-09-15T16:59:50Z", "updated_at": "2023-09-22T17:09:06Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/818", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-71", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": "EPI-6", "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_Robert", "state_id": "Done", "cycle_id": null, "identifier": "DES-71", "number": 71, "title": "Data Dictionary of Events we want to track", "description": null, "priority": 0, "estimate": null, "due_date": "2023-09-22", "started_at": "2023-09-19T05:31:20Z", "completed_at": "2023-10-31T08:56:50Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1204477, "labels": ["Sprint 4 - September 29th"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-09-18T17:17:10Z", "updated_at": "2023-10-31T08:56:50Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/819", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-73", "project_id": "1061a4f4-bc6a-45ca-a5b6-7f73d5e0abe2", "team_id": "team_DES", "parent_id": null, "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_63fffeb4fab5233e", "state_id": "Done", "cycle_id": null, "identifier": "DES-73", "number": 73, "title": "Gameplay: Flipped tile", "description": "Some tiles are flipped open when the chapters starts (see example). We need to flip them back.\n\nThe known chapters.\n\nChapter 1:\n\nLvl: 4, 5 (megatile broken level), 13 (so friggin hard), 29 \n\nChapter 3:\n\nLevel 1, lvl 3 broken\n\n![IMG_3655.jpg]([URL_49927])", "priority": 1, "estimate": 0, "due_date": null, "started_at": null, "completed_at": "2024-01-03T06:02:26Z", "canceled_at": null, "archived_at": null, "time_in_status_minutes": 1112492, "labels": ["Sprint 5 - October 13th", "Improvement", "Marketing"], "links": [], "relations": [], "is_archived": false, "created_at": "2023-10-07T00:02:40Z", "updated_at": "2024-01-03T06:02:26Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/820", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-74", "project_id": null, "team_id": "team_DES", "parent_id": null, "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "DES-74", "number": 74, "title": "Create a puzzle editor whishlist.", "description": null, "priority": 0, "estimate": null, "due_date": null, "started_at": "2023-10-09T16:07:52Z", "completed_at": "2023-11-09T16:47:41Z", "canceled_at": null, "archived_at": "2024-05-10T00:58:33Z", "time_in_status_minutes": 1191047, "labels": [], "links": [], "relations": [], "is_archived": true, "created_at": "2023-10-09T16:07:52Z", "updated_at": "2023-11-09T16:47:41Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/linear/data.json", "pointer": "/issues/821", "field": "assignee_id", "value": "usr_8140f09bf9f1b94c", "record": {"id": "DES-75", "project_id": null, "team_id": "team_DES", "parent_id": null, "assignee_id": "usr_8140f09bf9f1b94c", "creator_id": "usr_8140f09bf9f1b94c", "state_id": "Done", "cycle_id": null, "identifier": "DES-75", "number": 75, "title": "Fix FF2 layouts.", "description": null, "priority": 1, "estimate": null, "due_date": null, "started_at": "2023-10-09T16:08:28Z", "completed_at": "2023-11-09T16:47:39Z", "canceled_at": null, "archived_at": "2024-05-10T00:58:33Z", "time_in_status_minut