TRELLO_USER_ID", "idBoard": "6851a6569f3bf818760632ab", "idCard": "6870e7c55044b9e59ee25b86", "data": {"board": {"id": "6851a6569f3bf818760632ab", "name": "ZM ROADMAP", "shortLink": "HSqnngwQ"}, "card": {"id": "6870e7c55044b9e59ee25b86", "idShort": 40, "name": "Introduce a mode that rewards bones currency. Bones will be used to buy bone packs, as well as wildcards. We might limit the amount of wildcards one can buy with bone pack. This is TBD.", "shortLink": "D14xJNAu"}, "list": {"id": "6851a674975da1fe76e70d93", "name": "Aug 15"}}}}, {"file": "HarmonyGames_Other_Services/Services_Data/trello/data.json", "pointer": "/actions/4907", "field": "idMemberCreator", "value": "PERSON_6095_TRELLO_USER_ID", "record": {"id": "6870e7e9120ea636530930ec", "type": "updateCard", "date": "2025-07-11T10:31:05Z", "idMemberCreator": "PERSON_6095_TRELLO_USER_ID", "idBoard": "6851a6569f3bf818760632ab", "idCard": "6870e794d185b2dba4ebcf51", "data": {"board": {"id": "6851a6569f3bf818760632ab", "name": "ZM ROADMAP", "shortLink": "HSqnngwQ"}, "card": {"id": "6870e794d185b2dba4ebcf51", "idShort": 39, "name": "Introduce wild cards of each rarity. These can be used as materials to upgrade any cards of that rarity. Need UI, need to show players their balance somewhere, etc. Wild cards are obtained by spending bones, and we can also introduce them to be dropped in packs.", "shortLink": "OUot0jXo"}, "list": {"id": "6851a674975da1fe76e70d93", "name": "Aug 15"}, "old": {"name": "Introduce wild cards of each rarity. These can be used as materials to upgrade any cards of that rarity. Need UI, need to show players their balance somewhere, etc."}}}}, {"file": "HarmonyGames_Other_Services/Services_Data/trello/data.json", "pointer": "/actions/4981", "field": "idMemberCreator", "value": "PERSON_6095_TRELLO_USER_ID", "record": {"id": "68768e2f7e06d5cd1ee008cd", "type": "updateCard", "date": "2025-07-15T17:21:51Z", "idMemberCreator": "PERSON_6095_TRELLO_USER_ID", "idBoard": "6851a6569f3bf818760632ab", "idCar