USER_ID", "record": {"id": "6855edbcf66dd9c4d8e88c5b", "type": "updateCard", "date": "2025-06-20T23:24:44Z", "idMemberCreator": "PERSON_6095_TRELLO_USER_ID", "idBoard": "6851a6569f3bf818760632ab", "idCard": "6851a713aa4e4da6cb2c2227", "data": {"board": {"id": "6851a6569f3bf818760632ab", "name": "ZM ROADMAP", "shortLink": "HSqnngwQ"}, "card": {"id": "6851a713aa4e4da6cb2c2227", "idShort": 2, "name": "Bug Fixes, VFX Improvements and Misc. Optimizations", "pos": 140737488273408, "shortLink": "RFmlCeMv"}, "list": {"id": "6851a6608b76856437112e45", "name": "Jun 30th"}, "old": {"pos": 140737488371712}}}}, {"file": "HarmonyGames_Other_Services/Services_Data/trello/data.json", "pointer": "/actions/4750", "field": "idMemberCreator", "value": "PERSON_6095_TRELLO_USER_ID", "record": {"id": "6855ef9d077771bb46c16054", "type": "updateCard", "date": "2025-06-20T23:32:45Z", "idMemberCreator": "PERSON_6095_TRELLO_USER_ID", "idBoard": "6851a6569f3bf818760632ab", "idCard": "6851a713aa4e4da6cb2c2227", "data": {"board": {"id": "6851a6569f3bf818760632ab", "name": "ZM ROADMAP", "shortLink": "HSqnngwQ"}, "card": {"id": "6851a713aa4e4da6cb2c2227", "idShort": 2, "name": "[Bugs] Gameplay Related Bugs", "shortLink": "RFmlCeMv"}, "list": {"id": "6851a6608b76856437112e45", "name": "Jun 30th"}, "old": {"name": "Bug Fixes, VFX Improvements and Misc. Optimizations"}}}}, {"file": "HarmonyGames_Other_Services/Services_Data/trello/data.json", "pointer": "/actions/4751", "field": "idMemberCreator", "value": "PERSON_6095_TRELLO_USER_ID", "record": {"id": "6855f0769bd273e3f577785b", "type": "updateCard", "date": "2025-06-20T23:36:22Z", "idMemberCreator": "PERSON_6095_TRELLO_USER_ID", "idBoard": "6851a6569f3bf818760632ab", "idCard": "6851a713aa4e4da6cb2c2227", "data": {"board": {"id": "6851a6569f3bf818760632ab", "name": "ZM ROADMAP", "shortLink": "HSqnngwQ"}, "card": {"desc": "The bugs we\u2019ve been putting off is starting to catch up to us now that we have 50 levels of solid play.\n\nGameplay issues:\n\n- Level ends prematurely where as a boss spawns right as the win screen appears.\n- Sometimes a boss would double spawn, throwing off level balance.\n- Hard to reproduce, but sometimes a level will start and immediately end with zero monsters spawned (victory), and zero items spawned. This seems to happen depending on how the LAST level ended. This happens in editor and also live build.\n- DoT effects applied incorrectly, burn for example deals 1st tick damage on contact unlike poison where the first tick damage happens at 1st second _after_ impact. Shock is unknown how it\u2019s dealing damage.\n- The damage numbers are off sometimes, it\u2019s almost taking an aggregate amount from various sources but applying it as a single number during kill cam.\n- Enrage doesn\u2019t apply to newly spawned monsters, unless enrage happens after the monster has spawned. (Behavior should be pre-enraged)\n- Refill health and push monster back should reset ALL enrage status. Right now monsters do not get buffed, however a single enrage will buff them to the previous enraged level, whatever that might be.", "id": "6851a713aa4e4da6cb2c2227", "idShort": 2, "name": "[Bugs] Gameplay Related Bugs", "shortLink": "RFmlCeMv"}, "list": {"id": "6851a6608b76856437112e45", "name": "Jun 30th"}, "old": {"desc": ""}}}}, {"file": "HarmonyGames_Other_Services/Services_Data/trello/data.json", "pointer": "/actions/4752", "field": "idMemberCreator", "value": "PERSON_6095_TRELLO_USER_ID", "record": {"id": "6855f156b9003831b393c30c", "type": "updateCard", "date": "2025-06-20T23:40:06Z", "idMemberCreator": "PERSON_6095_TRELLO_USER_ID", "idBoard": "6851a6569f3bf818760632ab", "idCard": "6853557e7a5699418850c6e4", "data": {"board": {"id": "6851a6569f3bf818760632ab", "name": "ZM ROADMAP", "shortLink": "HSqnngwQ"}, "card": {"id": "6853557e7a5699418850c6e4", "idShort": 34, "name": "Implement Time based preload boost. (Does not work right now and it's an IAP)", "shortLink": "380A4Hks"}, "list": {"id": "6851a6608b76856437112e45", "name": "Jun 30th"}, "old": {"name": "Implement time based preload boost. (Does not work right now and it's IAP)"}}}}, {"file": "HarmonyGames_Other_Services/Services_Data/trello/data.json", "pointer": "/actions/4753", "field": "idMemberCreator", "value": "PERSON_6095_TRELLO_USER_ID", "record": {"id": "6855f17cde388923773c0b07", "type": "updateCard", "date": "2025-06-20T23:40:44Z", "idMemberCreator": "PERSON_6095_TRELLO_USER_ID", "idBoard": "6851a6569f3bf818760632ab", "idCard": "6853557e7a5699418850c6e4", "data": {"board": {"id": "6851a6569f3bf818760632ab", "name": "ZM ROADMAP", "shortLink": "HSqnngwQ"}, "card": {"desc": "[Boost] Players can purchase 30 minutes infinite trampoline preload boosts and/or glue preload boosts.\n\nNeither of them are actually functional.", "id": "6853557e7a5699418850c6e4", "idShort": 34, "name": "Implement Time based preload boost. (Does not work right now and it's an IAP)", "shortLink": "380A4Hks"}, "list": {"id": "6851a6608b76856437112e45", "name": "Jun 30th"}, "old": {"desc": ""}}}}, {"file": "HarmonyGames_Other_Services/Services_Data/trello/data.json", "pointer": "/actions/4754", "field": "idMemberCreator", "value": "PERSON_6095_TRELLO_USER_ID", "record": {"id": "6855f189c3ae50a708c39b8f", "type": "updateCard", "date": "2025-06-20T23:40:57Z", "idMemberCreator": "PERSON_6095_TRELLO_USER_ID", "idBoard": "6851a6569f3bf818760632ab", "idCard": "6853557e7a5699418850c6e4", "data": {"board": {"id": "6851a6569f3bf818760632ab", "name": "ZM ROADMAP", "shortLink": "HSqnngwQ"}, "card": {"id": "6853557e7a5699418850c6e4", "idShort": 34, "name": "[Boost] Implement Time based preload boost", "shortLink": "380A4Hks"}, "list": {"id": "6851a6608b76856437112e45", "name": "Jun 30th"}, "old": {"name": "Implement Time based preload boost. (Does not work right now and it's an IAP)"}}}}, {"file": "HarmonyGames_Other_Services/Services_Data/trello/data.json", "pointer": "/actions/4755", "field": "idMemberCreator", "value": "PERSON_6095_TRELLO