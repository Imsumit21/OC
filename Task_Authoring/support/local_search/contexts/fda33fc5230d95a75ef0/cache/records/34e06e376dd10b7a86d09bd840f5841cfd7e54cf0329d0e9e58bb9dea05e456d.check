856437112e45", "name": "Jun 30th"}, "old": {"dueComplete": false}}}}, {"file": "HarmonyGames_Other_Services/Services_Data/trello/data.json", "pointer": "/actions/4836", "field": "idMemberCreator", "value": "PERSON_6095_TRELLO_USER_ID", "record": {"id": "68598af6763200aaf8cee97a", "type": "updateCard", "date": "2025-06-23T17:12:22Z", "idMemberCreator": "PERSON_6095_TRELLO_USER_ID", "idBoard": "6851a6569f3bf818760632ab", "idCard": "6851a7c6bcff16c2842dc232", "data": {"board": {"id": "6851a6569f3bf818760632ab", "name": "ZM ROADMAP", "shortLink": "HSqnngwQ"}, "card": {"dueComplete": false, "id": "6851a7c6bcff16c2842dc232", "idShort": 12, "name": "[Design] Level 100-500 One way or another", "shortLink": "XprDyrrq"}, "list": {"id": "6851a6608b76856437112e45", "name": "Jun 30th"}, "old": {"dueComplete": true}}}}, {"file": "HarmonyGames_Other_Services/Services_Data/trello/data.json", "pointer": "/actions/4837", "field": "idMemberCreator", "value": "PERSON_6095_TRELLO_USER_ID", "record": {"id": "68598af98a3e1404c46e388c", "type": "updateCard", "date": "2025-06-23T17:12:25Z", "idMemberCreator": "PERSON_6095_TRELLO_USER_ID", "idBoard": "6851a6569f3bf818760632ab", "idCard": "6851a7c6bcff16c2842dc232", "data": {"board": {"id": "6851a6569f3bf818760632ab", "name": "ZM ROADMAP", "shortLink": "HSqnngwQ"}, "card": {"closed": true, "dateClosed": "2025-06-23T17:12:25.733Z", "id": "6851a7c6bcff16c2842dc232", "idShort": 12, "name": "[Design] Level 100-500 One way or another", "shortLink": "XprDyrrq"}, "list": {"id": "6851a6608b76856437112e45", "name": "Jun 30th"}, "old": {"closed": false}}}}, {"file": "HarmonyGames_Other_Services/Services_Data/trello/data.json", "pointer": "/actions/4838", "field": "idMemberCreator", "value": "PERSON_6095_TRELLO_USER_ID", "record": {"id": "6859a76f0912c4c717d09d96", "type": "updateCard", "date": "2025-06-23T19:13:51Z", "idMemberCreator": "PERSON_6095_TRELLO_USER_ID", "idBoard": "6851a6569f3bf818760632ab", "idCard": "6851aaf52fe5548a10258090", "data": {"board": {"id": "6851a6569f3bf818760632ab", "name": "ZM ROADMAP", "shortLink": "HSqnngwQ"}, "card": {"desc": "- The set count needs to update properly when switching between difficulty tier tabs\n- Need a function that can copy a monster track settings from one difficulty tier to another. Need that same function for items as well. Currently this is done via manually deleting the added tier difficulty element in the scriptable object and re-adding the tier to \u201cclone\u201d\n- Need a function that can easily swap the name and level location of 2 levels. Currently it\u2019s an unclean and risky renaming fest where we set temporary level names to one of the levels being swapped, and we rename the next file, and go back and rename the temp named file. Doing this action on the scriptable level object itself will cause errors.\n- Need a function to delete difficulty tiers or reassign them to a specific tier (-1, 0, 1, etc.)\n- Consider migrating the list of items and list of monsters to be added to a third display. Freeing up the entire primary display for list of items and list of monsters when editing the monster or item tabs.\n- Clicking on monster icons should add the monster just like with items instead of having to click the small '+' sign\n- Remove the legacy 2nd item count slider that was meant for.\n- Badass feature would be to allow ctrl click multiple difficulty tier tabs. When this is done, all the edits are applied to all checked tier tabs. So adding items or monsters would make changes to all\n  ![image.png](https://PERSON_6092_TRELLO_USERNAME.com/1/cards/6851aaf52fe5548a10258090/attachments/6855fe7d601b4d836a46055b/download/image.png)\n\n  Also added a delete button", "id": "6851aaf52fe5548a10258090", "idShort": 21, "name": "[Improvement] QoL Features for Level Design Tool (Blake)", "shortLink": "oYisH1Uu"}, "list": {"id": "6851a6608b76856437112e45", "name": "Jun 30th"}, "old": {"desc": "- The set count needs to update properly when switching between difficulty tier tabs\n- Need a function that can copy a monster track settings from one difficulty tier to another. Need that same function for items as well. Currently this is done via manually deleting the added tier difficulty element in the scriptable object and re-adding the tier to \u201cclone\u201d\n- Need a function that can easily swap the name and level location of 2 levels. Currently it\u2019s an unclean and risky renaming fest where we set temporary level names to one of the levels being swapped, and we rename the next file, and go back and rename the temp named file. Doing this action on the scriptable level object itself will cause errors.\n- Need a function to delete difficulty tiers or reassign them to a specific tier (-1, 0, 1, etc.)\n- Consider migrating the list of items and list of monsters to be added to a third display. Freeing up the entire primary display for list of items and list of monsters when editing the monster or item tabs.\n- Clicking on monster icons should add the monster just like with items instead of having to click the small '+' sign\n- Remove the legacy 2nd item count slider that was meant for.\n- Badass feature would be to allow ctrl click multiple difficulty tier tabs. When this is done, all the edits are applied to all checked tier tabs. So adding items or monsters would make changes to all\n  ![image.png](https://PERSON_6092_TRELLO_USERNAME.com/1/cards/6851aaf52fe5548a10258090/attachments/6855fe7d601b4d836a46055b/download/image.png)\n  Also added a delete button"}}}}, {"file": "HarmonyGames_Other_Services/Services_Data/trello/data.json", "pointer": "/actions/4839", "field": "idMemberCreator", "value": "PERSON_6095_TRELLO_USER_ID", "record": {"id": "6859af33f38299b6e6cd79ea", "type": "updateCard", "date": "2025-06-23T19:46:59Z", "idMemberCreator": "PERSON_6095_TRELLO_USER_ID", "idBoard": "6851a6569f3bf818760632ab", "idCard": "6851a713aa4e4da6cb2c2227", "data": {"board": {"id": "6851a6569f3bf818760632ab", "name": "ZM ROADMAP", "shortLink": "HSqnngwQ"}, "card": {"desc": "Super ticket [HERE](https://linear.app/harmonygames-games/issue/ZOM-294/gameplay-related-bug-fixes \"\u200c\")\n\nThe bugs we\u2019ve been putting off is starting to catch up to us now that we have 50 levels of solid play.\n\nGameplay issues:\n\n- Level ends prematurely where as a boss spawns right as the win screen appears.\n- Sometimes a boss would double spawn, throwing off level balance.\n- Hard to reproduce, but sometimes a level will start and immediately end with zero monsters spawned (victory), and zero items spawned. This seems to happen depending on how the LAST level ended. This happens in editor and also live build.\n- DoT effects applied incorrectly, burn for example deals 1st tick damage on contact unlike poison where the first tick damage happens at 1st second _after_ impact. Shock is unknown how it\u2019s dealing damage.\n- The damage numbers are off sometimes, it\u2019s almost taking an aggregate amount from various sources but applying it as a single number during kill cam.\n- Enrage doesn\u2019t apply to newly spawned monsters, unless enrage happens after the monster has spawned. (Behavior should be pre-enraged)\n- Refill health and push monster back should reset ALL enrage status. Right now monsters do not get buffed, however a single enrage will buff them to the previous enraged level, whatever that might be.", "id": "6851a713aa4e4da6cb2c2227", "idShort": 2, "name": "[Bugs] Gameplay Related Bugs", "shortLink": "RFmlCeMv"}, "list": {"id": "6851a6608b76856437112e45", "name": "Jun 30th"}, "old": {"desc": "The bugs we\u2019ve been putting off is starting to catch up to us now that we have 50 levels of solid play.\n\nGameplay issues:\n\n- Level ends prematurely where as a boss spawns right as the win screen appears.\n- Sometimes a boss would double spawn, throwing off level balance.\n- Hard to reproduce, but sometimes a level will start and immediately end with zero monsters spawned (victory), and zero items spawned. This seems to happen depending on how the LAST level ended. This happens in editor and also live build.\n- DoT effects applied incorrectly, burn for example deals 1st tick damage on contact unlike poison where the first tick damage happens at 1st second _after_ impact. Shock is unknown how it\u2019s dealing damage.\n- The damage numbers are off sometimes, it\u2019s almost taking an aggregate amount from various sources but applying it as a single number during kill cam.\n- Enrage doesn\u2019t apply to newly spawned monsters, unless enrage happens after the monster has spawned. (Behavior should be pre-enraged)\n- Refill health and Push monster back should reset ALL enrage status. Right now monsters do not get buffed, however a single enrage will buff them to the previous enraged level, whatever that might be."}}}}, {"file": "HarmonyGames_Other_Services/Services_Data/trello/data.json", "pointer": "/actions/4840", "field": "idMemberCreator", "value": "PERSON_6095_TRELLO_USER_ID", "record": {"id": "6859afe5a6f6ab82d4c140e3", "type": "updateCard", "date": "2025-06-23T19:49:57Z", "idMemberCreator": "PERSON_6095_TRELLO_USER_ID", "idBoard": "6851a6569f3bf818760632ab", "idCard": "6851a713aa4e4da6cb2c2227", "data": {"board": {"id": "6851a6569f3bf818760632ab", "name": "ZM ROADMAP", "shortLink": "HSqnngwQ"}, "card": {"id": "6851a713aa4e4da6cb2c2227", "idShort": 2, "name": "[Bugs] Gameplay Related Bugs - [PERSON_NAME_0120]", "shortLink": "RFmlCeMv"}, "list": {"id": "6851a6608b76856437112e45", "name": "Jun 30th"}, "old": {"name": "[Bugs] Gameplay Related Bugs"}}}}, {"file": "HarmonyGames_Other_Services/Services_Data/trello/data.json", "pointer": "/actions/4841", "field": "idMemberCreator", "value": "PERSON_6095_TRELLO_USER_ID", "record": {"id": "6859afea8395a87fe98b2fd8", "type": "updateCard", "date": "2025-06-23T19:50:02Z", "idMemberCreator": "PERSON_6095_TRELLO_USER_ID", "idBoard": "6851a6569f3bf818760632ab", "idCard": "6853557e7a5699418850c6e4", "data": {"board": {"id