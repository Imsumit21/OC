vices/Services_Data/trello/data.json", "pointer": "/actions/3011", "field": "idMemberCreator", "value": "PERSON_6095_TRELLO_USER_ID", "record": {"id": "6699c4807ac7ccae734f8aa7", "type": "updateCard", "date": "2024-07-19T01:42:24Z", "idMemberCreator": "PERSON_6095_TRELLO_USER_ID", "idBoard": "65eb4ec525346c8070ca638f", "idCard": "6699456ed5afea061bc73365", "data": {"board": {"id": "65eb4ec525346c8070ca638f", "name": "Product Roadmap", "shortLink": "Yg3yTuCR"}, "card": {"desc": "Ticket [HERE](https://linear.app/harmonygames-games/issue/ENG-1110/lexi-foresight-tiles-are-to-be-made-matchable \"\u200c\") to make it matachable\n\nPay attention to parent/child relationships.\n\nLexi\u2019s level 40 passive ability is \u201creveal the next tile in draw pile\u201d. This is a permanent effect and not a one time effect. This fires off when the game starts, and does not need further repeat VFX. The revealed draw tile is a constant state and remains that way for rest of the game.\n\nTicket [HERE](https://linear.app/harmonygames-games/issue/ENG-1111/lexi-level-40-passive-ability-upgraded-reveal-next-draw-tile-to-be \"\u200c\")", "id": "6699456ed5afea061bc73365", "idShort": 108, "name": "([PERSON_NAME_0067]) Lexi foresighted tiles matchable and Level 40 Passive upgrade", "shortLink": "12LFGe4X"}, "list": {"id": "65eb4f512e65625ed56c6321", "name": "Baklava (August)"}, "old": {"desc": "Ticket [HERE](https://linear.app/harmonygames-games/issue/ENG-1110/lexi-foresight-tiles-are-to-be-made-matchable \"\u200c\") to make it matachable\n\nPay attention to parent/child relationships."}}}}, {"file": "HarmonyGames_Other_Services/Services_Data/trello/data.json", "pointer": "/actions/3012", "field": "idMemberCreator", "value": "PERSON_6095_TRELLO_USER_ID", "record": {"id": "6699c48edc7c47f8c97112e6", "type": "updateCard", "date": "2024-07-19T01:42:38Z", "idMemberCreator": "PERSON_6095_TRELLO_USER_ID", "idBoard": "65eb4ec525346c8070ca638f", "idCard": "6699456ed5afea061bc73365", "data": {"board