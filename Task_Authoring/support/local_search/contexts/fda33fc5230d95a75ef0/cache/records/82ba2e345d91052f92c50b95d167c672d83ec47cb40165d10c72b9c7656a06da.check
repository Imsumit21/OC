{"signature": "a854b871033d83133e39e8b459eadbb51f8d0f44078f903a318859d1f42d0a15", "result": {"checks": {"check": {"scope": {"id": "check", "service": "confluence", "file": "confluence_working.json", "pointer": "/comments", "field": "page_id", "values": ["page_api_reference", "page_backend_services", "page_eng_home", "page_live_ops_engine"]}, "matches": [{"file": "HarmonyGames_Other_Services/Services_Data/confluence/confluence_working.json", "pointer": "/comments/4", "field": "page_id", "value": "page_live_ops_engine", "record": {"id": "comment_live_ops_engine_c1", "page_id": "page_live_ops_engine", "author_id": "user_EMPLOYEE_0025", "parent_id": null, "body": "The single-scheduler design has bothered me since we shipped it. Twelve-plus hours with no alert is the real failure here - the stall itself is recoverable, but nobody knew until revenue told us. Watchdog + heartbeat should jump ahead of leader election on the list; it's a fraction of the effort and covers the worst case.", "created_at": "2025-07-28T09:12:00Z", "updated_at": "2025-07-28T09:12:00Z"}}, {"file": "HarmonyGames_Other_Services/Services_Data/confluence/confluence_working.json", "pointer": "/comments/5", "field": "page_id", "value": "page_live_ops_engine", "record": {"id": "comment_live_ops_engine_c2", "page_id": "page_live_ops_engine", "author_id": "user_EMPLOYEE_0031", "parent_id": "comment_live_ops_engine_c1", "body": "Agreed, Arthur Blake. I've reordered remediation so the heartbeat + external watchdog is first. Decoupling lives from event firing is the bigger refactor but it's what actually stops one stall from becoming two outages - I'll scope that after the watchdog lands.", "created_at": "2025-07-28T15:47:00Z", "updated_at": "2025-07-28T15:47:00Z"}}], "records_checked": 12, "files_selected": 1, "files_completed": 1, "scan_complete": true, "errors": []}}, "files_read_this_call": 1, "sources": [{"file": "HarmonyGames_Other_Services/Services_Data/confluence/confluence_working.json", "manifest_sha256": "e6840608051cf49e37aeb94a719fed78e0d38eb902d30f86805b84ea0d67adb6", "freshness": "b35dd7cfda8fb6d599db1b9a38b36fce84bda68229af7b0e0409eeaed1fc5c06"}], "scan_complete": true, "persona_filtered": false, "backend": "grouped-record-scan", "scope_note": "Exact direct fields in selected arrays. No SQL is applied. Absence/uniqueness is supported only within complete declared scopes. Manifest hashes are declared provenance, not fresh full-content hashes."}, "checksum": "c78248073ba3fc89b87fcf07b078349033ee976e45e9f35368f58aaedb1250a0"}