[{"id": "8729a13ef47e61149937613fb2983125", "ts": "1756223629.429589", "type": "message", "user": "EMPLOYEE_0038_SLACK_ID", "text": "Hello guys - we need your help with our next playable for Zombie Match 3D game! Domino Delights didn\u2019t work out from CPI &amp; LTV perspective so we\u2019ll grow that game either with a publisher or organically. We are very excited about our next game, Zombie Match 3D though.", "channel": "C08H78VJG80", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}, {"id": "3231f36f0826b5d1461a22e70b119854", "ts": "1756223719.209699", "type": "message", "user": "PERSON_3937_SLACK_ID", "text": "Hi Leonard, it\u2019s great to hear from you again. Sure, we\u2019d be happy to do a kick off whenever you\u2019d like. How\u2019s your availability tomorrow? <@EMPLOYEE_0038_SLACK_ID>", "channel": "C08H78VJG80", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}, {"id": "fb2a220aba8c4c2b3a26641e3b7dfe8c", "ts": "1756223732.061829", "type": "message", "user": "PERSON_6078_SLACK_ID", "text": "<@PERSON_6078_SLACK_ID> has joined the channel", "channel": "C08H78VJG80", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": "channel_join", "reactions": [], "files": [], "attachments": []}, {"id": "2d29ceefea16fe63dfadbeb1e10cfee3", "ts": "1756223752.673249", "type": "message", "user": "EMPLOYEE_0038_SLACK_ID", "text": "Android: <https://play.google.com/store/apps/details?id=com.calmplay.zombie&amp;hl=en_US>\nIOS: <https://apps.Apple.com/us/app/zombie-match-3d/id6743495619>", "channel": "C08H78VJG80", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}, {"id": "b7640a0533e6f0d8c31add16a1db5c42", "ts": "1756223785.608099", "type": "message", "user": "EMPLOYEE_0038_SLACK_ID", "text": "What would be most helpful is if you guys play the game up until level 40 - it should take less than hour end to end", "channel": "C08H78VJG80", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}, {"id": "f86ab5a81bc12fe3b012ffcf7b19ec83", "ts": "1756223807.684429", "type": "message", "user": "EMPLOYEE_0038_SLACK_ID", "text": "for me it takes 20 mins to get There so 3x time estimate should be more than enough :slightly_smiling_face:", "channel": "C08H78VJG80", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}, {"id": "7ca75cfd88c72964943ef5a32226851a", "ts": "1756223848.512149", "type": "message", "user": "EMPLOYEE_0038_SLACK_ID", "text": "Once you guys review the game, then I think meeting would be more productive since we can focus more on the brief", "channel": "C08H78VJG80", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}, {"id": "04dcb475c62f4c2eefb23a30f3a112e1", "ts": "1756223880.038499", "type": "message", "user": "PERSON_3937_SLACK_ID", "text": "Sure, we\u2019ll review and play the game and have an internal discussion about what we can do. In the meantime, could you share any competitors you have in this genre? We\u2019d like to take a look at their top performing ads as well.", "channel": "C08H78VJG80", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}, {"id": "9544330ff0a851c609be962b43cdad19", "ts": "1756223892.790609", "type": "message", "user": "EMPLOYEE_0038_SLACK_ID", "text": "Match Factory [USERNAME_18759]", "channel": "C08H78VJG80", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [{"count": 1, "name": "nerd_face", "users": ["PERSON_3937_SLACK_ID"]}], "files": [], "attachments": []}, {"id": "2cb5f5e03eeb19b15ea2770409fe97d6", "ts": "1756223944.467589", "type": "message", "user": "PERSON_3937_SLACK_ID", "text": "We also recently created a playable for a game in a similar genre :slightly_smiling_face:", "channel": "C08H78VJG80", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}, {"id": "a10cf8566b21dbc6b32b94b185635314", "ts": "1756223949.995939", "type": "message", "user": "EMPLOYEE_0038_SLACK_ID", "text": "I think this brief would help", "channel": "C08H78VJG80", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [], "attachments": []}, {"id": "975a6f7106b08beb7c45d163c0102fe2", "ts": "1756223954.141059", "type": "message", "user": "EMPLOYEE_0038_SLACK_ID", "text": "", "channel": "C08H78VJG80", "thread_ts": null, "reply_count": 0, "reply_users_count": 0, "latest_reply": null, "is_activity_message": false, "subtype": null, "reactions": [], "files": [{"created": 1756223950, "display_as_bot": false, "editable": false, "external_type": "", "file_access": "visible", "filetype": "png", "has_rich_preview": false, "id": "F09BZG00CTD", "is_external": false, "is_public": false, "is_starred": false, "media_display_type": "unknown", "mimetype": "image/png", "mode": "hosted", "name": "image.png", "original_h": 886, "original_w": 1572, "permalink": "https://harmonygamesgroup.slack.com/files/EMPLOYEE_0038_SLACK_ID/F09BZG00CTD/im