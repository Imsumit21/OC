> VALUES ('leonard.hayes@harmonygames.co/<CAPBs_aLeDrdRoqOb0LrQ1AfGvbpmR-YdoG8A6PGmPay5Sc-ng=@mail.gmail.com>', 'leonard.hayes@harmonygames.co/1856961760270377901', 'leonard.hayes@harmonygames.co', '["SENT", "Label_b19fb8d1b3"]', 'Hi Akin, I wanted you to hear this from me directly. We are closing Harmony Games. We told the team yesterday, and Robert and I are working ', 1770936737000, '2026-02-12T22:52:17Z', 1193, 'Harmony', 'leonard.hayes@harmonygames.co', 'leonard hayes', '["Akin <PERSON_8862_EMAIL>"]', '[]', '[]', '[]', E'Hi Akin,\r\n\r\nI wanted you to hear this from me directly. We are closing Harmony Games. We told the team yesterday, and Robert and I are working through the wind-down over the next few weeks.\r\n\r\nThank you for backing us from the start. I''ll be in touch once the details are settled.\r\n\r\nLeonard\r\n', NULL, '[{"name": "Message-ID", "value": "<CAPBs_aLeDrdRoqOb0LrQ1AfGvbpmR-YdoG8A6PGmPay5Sc-ng=@mail.gmail.com>"}, {"name": "Date", "value": "Thu, 12 Feb 2026 22:52:17 +0000"}, {"name": "Subject", "value": "Harmony"}, {"name": "From", "value": "leonard hayes <leonard.hayes@harmonygames.co>"}, {"name": "To", "value": "Akin <PERSON_8862_EMAIL>"}]', NULL, NULL, NULL, '[]');
