 {
  "?column?": "public._changelog",
  "to_jsonb": "{\"id\": 43, \"row_id\": \"f_7bacf15c4e8eea1a52dcd4\", \"summary\": \"Inserted: {\\\"title\\\": \\\"UA spend buckets (Q4)\\\", \\\"body_text\\\": \\\"UA spend buckets (Q4)\\\\nFred, Sep 16, after Monday's exec chat.\\\\nFundraising bucket: incent spend that moves the D1/D7 numbers investors ask about. Adjo\", \"operation\": \"INSERT\", \"timestamp\": \"2026-11-04T10:42:53.408699+00:00\", \"table_name\": \"docs_documents\", \"schema_name\": \"gdocs\", \"changed_fields\": {\"title\": \"UA spend buckets (Q4)\", \"body_text\": \"UA spend buckets (Q4)\\nFred, Sep 16, after Monday's exec chat.\\nFundraising bucket: incent spend that moves the D1/D7 numbers investors ask about. Adjoe for now. This is the only UA spend that runs until the raise.\\nReal UA bucket: Unity, Meta, playables. Budgets set week by week until we know about the raise; playables count here, not in the fundraising bucket.\\nReview the split at the exec sync every Monday.\", \"visibility\": \"private\", \"document_id\": \"f_7bacf15c4e8eea1a52dcd4\", \"owner_email\": \"frederick.stone@harmonygames.co\", \"revision_id\": \"474162b554\", \"created_time\": \"2025-09-16T17:00:00+00:00\", \"drive_file_id\": \"f_7bacf15c4e8eea1a52dcd4\", \"modified_time\": \"2025-09-16T17:00:00+00:00\", \"style_runs_json\": \"[{\\\"start\\\": 0, \\\"end\\\": 22, \\\"named_style\\\": \\\"TITLE\\\", \\\"list_id\\\": null, \\\"list_nesting\\\": 0}, {\\\"start\\\": 22, \\\"end\\\": 409, \\\"named_style\\\": \\\"NORMAL_TEXT\\\", \\\"list_id\\\": null, \\\"list_nesting\\\": 0}]\", \"text_style_runs_json\": null, \"shared_with_emails_json\": \"[\\\"leonard.hayes@harmonygames.co\\\"]\"}}"
 },
 {
  "?column?": "public._changelog",
  "to_jsonb": "{\"id\": 44, \"row_id\": \"f_3b06917a41dd59308d890b\", \"summary\": \"Inserted: {\\\"title\\\": \\\"ESG Law - agreement intake checklist\\\", \\\"body_text\\\": \\\"ESG Law - agreement intake checklist\\\\nFrom ESG's call with Leonard, Sep 24. One email per agreement to ESG Law intake.\\\\nInclude\\\\n- the c\", \"operation\": \"INSERT\", \"timestamp\": \"2026-11-04T10:42:53.408699+00:00\", \"table_name\": \"docs_documents\", \"schema_name\": \"gdocs\", \"changed_fields\": {\"title\": \"ESG Law - agreement intake checklist\", \"body_text\": \"ESG Law - agreement intake checklist\\nFrom ESG's call with Leonard, Sep 24. One email per agreement to ESG Law intake.\\nInclude\\n- the company and what the agreement is\\n- the term and any automatic renewal\\n- any exclusivity or licence of our IP\\n- what it costs us, if anything\\n- the date they need it by\\n- who would sign it (Leonard or Arthur)\", \"visibility\": \"private\", \"document_id\": \"f_3b06917a41dd59308d890b\", \"owner_email\": \"leonard.hayes@harmonygames.co\", \"revision_id\": \"d96589f49d\", \"created_time\": \"2025-09-25T16:20:00+00:00\", \"drive_file_id\": \"f_3b06917a41dd59308d890b\", \"modified_time\": \"2025-09-25T16:20:00+00:00\", \"style_runs_json\": \"[{\\\"start\\\": 0, \\\"end\\\": 37, \\\"named_style\\\": \\\"TITLE\\\", \\\"list_id\\\": null, \\\"list_nesting\\\": 0}, {\\\"start\\\": 37, \\\"end\\\": 118, \\\"named_style\\\": \\\"NORMAL_TEXT\\\", \\\"list_id\\\": null, \\\"list_nesting\\\": 0}, {\\\"start\\\": 118, \\\"end\\\": 126, \\\"named_style\\\": \\\"HEADING_2\\\", \\\"list_id\\\": null, \\\"list_nesting\\\": 0}, {\\\"start\\\": 126, \\\"end\\\": 340, \\\"named_style\\\": \\\"NORMAL_TEXT\\\", \\\"list_id\\\": null, \\\"list_nesting\\\": 0}]\", \"text_style_runs_json\": null, \"shared_with_emails_json\": \"[\\\"robert@harmonygames.co\\\", \\\"arthur.blake@harmonygames.co\\\", \\\"frederick.stone@harmonygames.co\\\"]\"}}"
 },
 {
  "?column?": "public._changelog",
