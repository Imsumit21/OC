 {
  "?column?": "public._changelog",
  "to_jsonb": "{\"id\": 290, \"row_id\": \"cmt_c9a6660d81e067ad1de7\", \"summary\": \"Inserted: {\\\"id\\\": \\\"cmt_c9a6660d81e067ad1de7\\\", \\\"body\\\": \\\"Tried to order the kits today. The portal won't take an order yet: the Global ToS and NDA still needs our agreement approver to accept it, and that has to b\", \"operation\": \"INSERT\", \"timestamp\": \"2026-11-04T10:42:53.408699+00:00\", \"table_name\": \"linear_comments\", \"schema_name\": \"linear\", \"changed_fields\": {\"id\": \"cmt_c9a6660d81e067ad1de7\", \"body\": \"Tried to order the kits today. The portal won't take an order yet: the Global ToS and NDA still needs our agreement approver to accept it, and that has to be a company officer from their own login. Fred is only set up as administrator, so the 'NDA Effective 09/04' on his registration mail is just the start date it will carry. It's Nintendo's standard click-through: no fee, no fixed term, no exclusivity, nothing about our IP, and either side can end it. It has to be accepted by Oct 15 or the request lapses. The kits can wait until after the raise; leaving the acceptance for Leonard or me.\", \"issue_id\": \"ZOM-567\", \"sequence\": 1, \"author_id\": \"usr_cc3e90160f490686\", \"is_edited\": false, \"parent_id\": null, \"created_at\": \"2025-09-25T18:20:00Z\", \"updated_at\": \"2025-09-25T18:20:00Z\"}}"
 },
