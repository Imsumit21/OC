 {
  "?column?": "public._changelog",
  "to_jsonb": "{\"id\": 42, \"row_id\": \"f_b98287f6f80fe431a71209\", \"summary\": \"Inserted: {\\\"title\\\": \\\"Runway guardrails - Q4 commitments\\\", \\\"body_text\\\": \\\"Runway guardrails - Q4 commitments\\\\nLeonard, Sep 26. Until we know where the raise lands, this is how we handle anything outside the inves\", \"operation\": \"INSERT\", \"timestamp\": \"2026-11-04T10:42:53.408699+00:00\", \"table_name\": \"docs_documents\", \"schema_name\": \"gdocs\", \"changed_fields\": {\"title\": \"Runway guardrails - Q4 commitments\", \"body_text\": \"Runway guardrails - Q4 commitments\\nLeonard, Sep 26. Until we know where the raise lands, this is how we handle anything outside the investor work that wants money, a signature or an answer from us.\\nHow to decide\\nGo top to bottom and stop at the first one that fits.\\n1. Already answered. If one of us has already given them an answer, don't write to them again. Note who answered and when. If the answer was \\\"later\\\", it comes back at the January commitments review I'll put on our calendars too.\\n2. Cash test. Anything that would cost us cash between Oct 1 and Dec 31 ends now: say no, or cancel it in writing the way their paper or notice asks. A trial or pilot that turns into a paid plan inside that window counts as cash, and so does an offer we would have to take up and pay for before January. Travel and event costs count only when we book them ourselves.\\n3. Keep. The cash test has one exception: anything on Arthur's keep-running list on our board stays, even if it costs money. Tell them we're staying.\\n4. Sign. If it costs nothing before January but taking it means someone has to accept terms or sign for the company, it goes the way ESG's note says. Tell them it's with Leonard or Arthur to sign, and with our lawyers first when ESG has to see it.\\n5. Park. Everything else that's free until January, including offers we could still take up after that. Tell them we'll pick it up in January; it comes back at the January commitments review I'll put on our calendars (first week of January).\\nAnswers\\nEveryone who is waiting to hear from us gets a written answer. Portals and no-reply notices don't need one.\", \"visibility\": \"private\", \"document_id\": \"f_b98287f6f80fe431a71209\", \"owner_email\": \"leonard.hayes@harmonygames.co\", \"revision_id\": \"0d3b4ff7c7\", \"created_time\": \"2025-09-26T16:00:00+00:00\", \"drive_file_id\": \"f_b98287f6f80fe431a71209\", \"modified_time\": \"2025-09-26T18:00:00+00:00\", \"style_runs_json\": \"[{\\\"start\\\": 0, \\\"end\\\": 35, \\\"named_style\\\": \\\"TITLE\\\", \\\"list_id\\\": null, \\\"list_nesting\\\": 0}, {\\\"start\\\": 35, \\\"end\\\": 198, \\\"named_style\\\": \\\"NORMAL_TEXT\\\", \\\"list_id\\\": null, \\\"list_nesting\\\": 0}, {\\\"start\\\": 198, \\\"end\\\": 212, \\\"named_style\\\": \\\"HEADING_2\\\", \\\"list_id\\\": null, \\\"list_nesting\\\": 0}, {\\\"start\\\": 212, \\\"end\\\": 1502, \\\"named_style\\\": \\\"NORMAL_TEXT\\\", \\\"list_id\\\": null, \\\"list_nesting\\\": 0}, {\\\"start\\\": 1502, \\\"end\\\": 1510, \\\"named_style\\\": \\\"HEADING_2\\\", \\\"list_id\\\": null, \\\"list_nesting\\\": 0}, {\\\"start\\\": 1510, \\\"end\\\": 1617, \\\"named_style\\\": \\\"NORMAL_TEXT\\\", \\\"list_id\\\": null, \\\"list_nesting\\\": 0}]\", \"text_style_runs_json\": null, \"shared_with_emails_json\": \"[\\\"robert@harmonygames.co\\\", \\\"arthur.blake@harmonygames.co\\\", \\\"frederick.stone@harmonygames.co\\\"]\"}}"
