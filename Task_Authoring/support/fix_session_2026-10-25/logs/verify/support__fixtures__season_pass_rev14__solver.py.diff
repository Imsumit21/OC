+"""Season Pass revision-14 solver: a fixture wrapper (E2E, 2026-10-25). Development fixture.
+
+It gives the frozen revision-14 oracle the oracle_kit contract and declares what that oracle leaves implicit. The
+oracle is support/backtests/season_pass/rev14/working_files/hardening_rev14/oracle.py, imported as a library under
+python3 -B (rev14/README.md, "Safe use"); the snapshot is never edited.
+  - Rule ids are the oracle's flags, so `disable` keeps its meaning. The revision-12 flags take whole-rule disables
+    only, so a (rule, key set) disable is spliced: those keys come from a solve with the rule off.
+  - The revision-14 mechanisms of plans/Rev14_Preregistration.md are rules M1-M4: value_notes, process_findings,
+    owner_calls and claims. Their nodes and families come from the revision-14 manifest (traps T40-T47, chains C12-C15
+    with root causes A14, A16, A15 and A1).
+  - Controls are the pre-registered ones of rev14_platform_runs/analyze_rev14.py:
+    - M2: SP-110, SP-119 and SP-123, the seeded records of trap T45. Its expected wrong reading is "count a dismissed
+      request, a request on another artifact or a source-lane request as a process finding". The over-application
+      operator over:process_findings demotes those members from READY to WATCH, which is what the rule does to a true
+      finding.
+    - M4: SP-009 and SP-019, agreeing controls. The claim agrees with their records, so trusting it gives their true
+      values and no over-application operator exists; their trials are HELD, with any error noted.
+value_notes decides no register column; its effect is the tracker's Value notes list, which only the surface sees.
+Complexity channels (F1) the revision-14 runs show, declared for the replay:
+  - scale:groups: a component left out of one of its blocker groups in the tracker (r1, r3: assertions / review 27 of
+    28). Its degrade drops the component's last group and keeps its class: the register is right, the group counts
+    are not.
+  - tool_surface:register: the register written as a native Sheet instead of the CSV upload (r3, r6): slot S01.
+Parses the SQL as data (the oracle's base_check.parse_sql); never executes it. Read-only.
+"""
+from __future__ import annotations
+
+import collections
+import hashlib
+import importlib.util
+import json
+import sys
+from pathlib import Path
+
+TASK = "season_pass"
+KEY_REGEX = r"SP-\d{3}"
+FIELDS = ["component key", "issue", "PR", "failed assertions", "test artifact", "receipt artifact", "receipt ring",
+          "review state", "reviewed artifact", "billing hold at snapshot", "handoff class"]
+GROUPS = ("assertions", "artifact", "review", "billing", "missing")
+CLASS_FIELD, GROUPS_FIELD = "handoff class", "groups"
+SNAPSHOT = "2026-02-12T18:00:00Z"
+CONTROL_SHEET = "f_7d4307eb29c34530f083ad"
+OWNER_CALLS_RECORD = "cmt_3f0ae94ca322f64d0929"
+CLAIM_RECORD = "cceb345fbba87a410565e061c992280c"
+HANDOFF_PAGE = "ver_page_season_pass_handoff_v5"
+ORACLE = (Path(__file__).resolve().parents[2] / "backtests" / "season_pass" / "rev14" / "working_files"
+          / "hardening_rev14" / "oracle.py")
+REVISIONS = ("rev14",)
+KNOWN_SQL = {"38781f13": "rev14", "b15b1102": "rev14"}      # canonical and comment-free (rev14/README.md)
+
+RULES = {
+    "validation": {"mechanism": "A17", "family": "A17", "requirement": "R1", "since": "rev14",
+                   "nodes": ["T21", "T22", "T23", "C6"], "decides": ["failed assertions", "test artifact"],
+                   "natural_reading": "take the latest comment that prints failed assertions, whatever its suite or "
+                                      "run status", "authority": ["698f7000692c3588d1022036"],
+                   "source": "scope control card", "signature": r"abort|diagnostic|smoke|run_status|incomplete"},
+    "receipt": {"mechanism": "A13", "family": "A13", "requirement": "R3", "since": "rev14",
+                "nodes": ["T24", "T25", "T26", "C7"], "decides": ["receipt artifact", "receipt ring"],
+                "natural_reading": "take the latest posted receipt; a withdrawal or copy changes nothing",
+                "authority": ["harmonygames-Games/match3d#545#c_3"], "source": "receipt-format note",
+                "signature": r"withdraw"},
+    "review": {"mechanism": "A15", "family": "A15", "requirement": "R1", "since": "rev14",
+               "nodes": ["T27", "T28", "T29", "T32", "C8"], "decides": ["review state", "reviewed artifact"],
+               "natural_reading": "take the latest submitted review, whatever its lane", "authority": [CONTROL_SHEET],
+               "source": "control sheet", "signature": r"\blanes?\b|source[- ](?:only|lane|review)|transfer[- ]review"},
