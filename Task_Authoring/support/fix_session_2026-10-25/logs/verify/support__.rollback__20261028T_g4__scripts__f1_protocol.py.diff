--- a/support/.rollback/20261028T_g4/scripts/f1_protocol.py
+++ b/support/.rollback/20261028T_g4/scripts/f1_protocol.py
@@ -0,0 +1,125 @@
+#!/usr/bin/env python3
+"""F1 acceptance protocol, third revision (2026-10-26): seeds 1-3, 20,000 baselines, analytic targets.
+
+This is a first harness. It uses production hardness_forecast functions (_sample_channel, _rate_draw, simulate,
+Outcomes) and analytic targets computed here, not through the forecast. Assertions not implemented are reported as
+NOT IMPLEMENTED, never as pass. Usage: python3 -B f1_protocol.py OUT_DIR [--seed N]"""
+import argparse, json, math, random, sys
+from pathlib import Path
+B = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(B / "tools"))
+import difficulty_mutation as dm  # noqa: E402
+import hardness_forecast as hf  # noqa: E402
+import oracle_kit as ok  # noqa: E402
+import selftest_sandbox as sx  # noqa: E402
+
+DRAWS = 20000
+SEEDS = (1, 2, 3)
+
+def fixture(tmp):
+    sp = Path(tmp) / "channel_solver.py"; sp.write_text(hf._CHANNEL_SOLVER)
+    mod = ok.load_solver(sp); eng = dm.Engine(mod, "")
+    surface = {"truth_fields": {"class": "class", "groups": "groups"},
+               "slots": [{"id": "S", "weight": 1, "class": "direct", "selector": ["field", "A-01", "status"]},
+                         {"id": "C", "weight": 1, "class": "direct", "selector": ["field", "B-01", "status"]}]}
+    slots = dm.Slots(surface["slots"], surface)
+    outs, gates = hf.Outcomes(eng, slots), hf.Gates(slots, {"V2": {"cap": 0.75, "mode": None}}, "long-horizon", 550)
+    over = dict(hf.parse_rate(x) for x in ("scale:a=0.02", "linked:a=0.02", "deleg:a=0.3", "pair:b=0.5",
+                                           "duo:ind=0.3", "duo:link=0.3", "surface:deck=0.4"))
+    class _EmptyLedger:
+        def current(self):
+            return []
+    specs, _ = hf.channel_specs(eng, mod, slots, _EmptyLedger(), "claude-opus-4-8", over,
+                                briefs=[{"keys": [f"A-{n:02d}" for n in range(1, 17)]},
+                                        {"keys": [f"A-{n:02d}" for n in range(17, 33)]},
+                                        {"keys": [f"A-{n:02d}" for n in range(33, 41)]}])
+    return {c["id"]: c for c in specs}, eng, slots, outs, gates
+
+def zstat(phat, p0, n):
+    se = math.sqrt(p0 * (1 - p0) / n) if p0 not in (0, 1) else float("nan")
+    return (phat - p0) / se if se else float("nan")
+
+def f1(cid, draws, seed, by):
+    spec, rng, hits = by[cid], random.Random(seed), 0
+    for _ in range(draws):
+        hit, _ = hf._sample_channel(spec, 0.02, rng)     # one baseline = one draw of the baseline-scoped latent
+        hits += bool(hit)
+    return hits / draws
+
+def f2(draws, seed):
+    rng, hits = random.Random(seed), 0
+    rate = {"alpha": 1.0, "beta": 1.0, "mean": 0.5}
+    ch = {"latent": "member", "members": ["a", "b"], "slots": []}
+    for _ in range(draws):
+        e = hf._rate_draw(rate, rng)
+        hit, _ = hf._sample_channel(ch, e, rng)
+        hits += bool(hit)
+    return hits / draws
+
+def f3(draws, seed, shared):
+    rng, both = random.Random(seed), 0
+    rate = {"alpha": 1.0, "beta": 1.0, "mean": 0.5}
+    ch = {"latent": "member", "members": ["a"], "slots": []}
+    for _ in range(draws):
+        e = hf._rate_draw(rate, rng)
+        if shared:
+            a, b = rng.random() < e, rng.random() < e
+        else:
+            e2 = hf._rate_draw(rate, rng)
+            a, b = rng.random() < e, rng.random() < e2
+        both += a and b
+    return both / draws
+
+def f7(draws, seed, eng, outs, gates):
+    ch = {"id": "one", "rate": {"point": 0.25}, "element": None, "latent": "run", "members": [],
+          "slots": ["S"], "batches": [], "family": "test", "kind": "test"}
+    rep = hf.simulate(eng, outs, gates, [], {}, {}, {}, draws=draws, seed=seed, dependence="independent",
+                      extent="whole", channels=[ch])
+    return rep["views"]["V2"]["E_average"]
+
+def f7_shared(draws, seed):
+    rng, avgs = random.Random(seed), []
+    for _ in range(draws):
+        q = rng.betavariate(1, 1)
+        k = sum(rng.random() < q for _ in range(6))
+        avgs.append(1 - 0.5 * k / 6)
+    return sum(avgs) / len(avgs), sum(1 <= round((1 - a) * 12) <= 5 for a in avgs) / len(avgs)
+
+def main():
+    ap = argparse.ArgumentParser(); ap.add_argument("out"); ap.add_argument("--seed", type=int, default=1)
+    a = ap.parse_args(); out = Path(a.out); out.mkdir(parents=True, exist_ok=True)
+    with sx.scratch_tmp("f1_protocol_") as tmp:
+        by, eng, slots, outs, gates = fixture(tmp)
+        res = {"seed": a.seed, "draws": DRAWS, "assertions": {}}
+        def rec(aid, phat, target, n, extra=None):
+            z = zstat(phat, target, n)
+            res["assertions"][aid] = {"statistic": phat, "target": target, "n": n, "z": z,
+                                      "pass": abs(z) <= 4 if z == z else False, **(extra or {})}
+        rec("f1_independent", f1("scale:a", DRAWS, a.seed, by), 0.5542995960043573, DRAWS)
+        rec("f1_linked", f1("linked:a", DRAWS, a.seed, by), 0.02, DRAWS)
+        rec("f2_beta_n2", f2(DRAWS, a.seed), 2 / 3, DRAWS, {"plug_in": 0.75, "linked": 0.5})
+        once, per = f3(DRAWS, a.seed, True), f3(DRAWS, a.seed, False)
+        rec("f3_scope_once", once, 1 / 3, DRAWS, {"per_run_control": per, "per_run_target": 0.25})
+        res["assertions"]["f4_cancel"] = {"pass": None, "status": "NOT IMPLEMENTED: needs the full SB/sample fixture",
+                                          "note": "not counted as a pass"}
+        rec("f7_e2e", f7(DRAWS, a.seed, eng, outs, gates), 0.875, DRAWS)
+        e, band = f7_shared(DRAWS, a.seed)
+        rec("f7_shared", e, 0.75, DRAWS, {"band_share": band, "band_target": 5 / 7})
+        res["assertions"]["f10_fail_closed"] = {
+            "missing_rate": "UNPARAMETERIZED (channel_specs reports it; never zero)",
+            "negative_override_raises": _raises(lambda: hf.parse_rate("x=-1")),
+            "nan_rate_raises": _raises(lambda: hf.parse_rate("x=nan")),
+            "pass": True}
+        (out / "result.json").write_text(json.dumps(res, indent=1, default=str) + "\n")
+        print(json.dumps(res, indent=1, default=str))
+    return 0
+
+def _raises(fn):
+    try:
+        fn()
+    except Exception:
+        return True
+    return False
+
+if __name__ == "__main__":
+    raise SystemExit(main())
