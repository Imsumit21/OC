# Whitelist: only the authoring/eval tooling is tracked.
# Universe data (HarmonyGames_*), "archived task/" and loose root files stay local.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/.agents/
!/.claude/
!/claude/
!/Evals/
!/Task_Authoring/
!/learnings

# .agents: only the skill links
/.agents/*
!/.agents/skills/

# Task inputs and batch runs, at any depth

batch*/

# Universe data, if a copy ever lands inside a tracked tree
HarmonyGames_*/

# Regenerable caches
/Evals/.cache/
Task_Authoring/support/local_search/cache/
__pycache__/
*.py[cod]

# OS junk
.DS_Store
._*

# Local-only Task_Authoring data: regenerable caches, logs and frozen/archive backtests
Task_Authoring/support/archive/
Task_Authoring/support/scratch/
Task_Authoring/support/backtests/
Task_Authoring/support/.rollback/
Task_Authoring/support/audit/
Task_Authoring/support/pending_edits/
Task_Authoring/support/analysis/
Task_Authoring/support/hardness_ledger/
Task_Authoring/support/fixtures/season_pass_rev13/
